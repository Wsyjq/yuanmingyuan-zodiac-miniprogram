<block wx:if="{{guide}}">
  <button class="ag-fab" bindtap="onFab" aria-label="语音导览">
    <image src="/plate21/module/assets/img/icons/ic-play-ink.png" mode="aspectFit" />
  </button>

  <view wx:if="{{open}}" class="ag-panel {{closing ? 'overlay-out' : ''}}">
    <view class="ag-head">
      <view>
        <view class="ag-kicker">AUDIO GUIDE · 站点讲解</view>
        <view class="ag-title serif">{{guide.title}}</view>
      </view>
      <button class="ag-close" bindtap="close" aria-label="关闭语音导览">×</button>
    </view>

    <view wx:if="{{hasAudio}}" class="ag-player">
      <button class="ag-play" bindtap="onTogglePlay">{{playing ? '暂停' : '播放'}}</button>
      <view class="ag-track"><view class="ag-track-fill" style="width: {{progress}}%;"></view></view>
    </view>
    <view wx:else class="ag-pending note-hand">音频导览即将上线，先读文稿。</view>

    <scroll-view scroll-y class="ag-script">
      <view wx:for="{{guide.script}}" wx:key="index" class="ag-line kaiti">{{item}}</view>
    </scroll-view>
  </view>
</block>
