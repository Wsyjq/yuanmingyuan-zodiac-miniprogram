<block wx:if="{{guide}}">
  <button wx:if="{{!open}}" class="ag-fab" bindtap="onFab" aria-label="语音导览">
    <image src="/plate21/module/assets/img/icons/ic-play-ink.png" mode="aspectFit" />
  </button>

  <view wx:if="{{open}}" class="ag-panel {{closing ? 'overlay-out' : ''}}">
    <view class="ag-head">
      <view class="ag-head-copy">
        <view class="ag-kicker">AUDIO GUIDE</view>
        <view class="ag-kicker-sub">本站讲解 · 覆盖本站各页</view>
        <view class="ag-title serif">{{guide.title}}</view>
      </view>
      <button class="ag-close" bindtap="close" aria-label="关闭语音导览">×</button>
    </view>

    <!-- 全局音频开关：背景音乐 / 人声讲述（与手册页同一状态，即关即停） -->
    <view class="ag-switches">
      <view class="ag-switch {{bgmOn ? 'on' : ''}}" bindtap="onToggleBgm" role="button" aria-label="切换背景音乐">
        <text class="ag-switch-name">背景音乐</text>
        <text class="ag-switch-state">{{bgmOn ? '开' : '关'}}</text>
      </view>
      <view class="ag-switch {{voiceOn ? 'on' : ''}}" bindtap="onToggleVoice" role="button" aria-label="切换人声讲述">
        <text class="ag-switch-name">人声讲述</text>
        <text class="ag-switch-state">{{voiceOn ? '开' : '关'}}</text>
      </view>
    </view>

    <view wx:if="{{hasAudio}}" class="ag-player">
      <button class="ag-play" bindtap="onTogglePlay">{{playing ? '暂停' : '播放'}}</button>
      <view class="ag-track"><view class="ag-track-fill" style="width: {{progress}}%;"></view></view>
    </view>
    <view wx:else class="ag-pending note-hand">音频导览即将上线，先读文稿。</view>

    <scroll-view scroll-y class="ag-script">
      <view wx:for="{{guide.script}}" wx:key="index" class="ag-line kaiti">{{item}}</view>
    </scroll-view>

    <!-- v2 深讲层：永远折叠，玩家主动展开，绝不自动播 -->
    <view wx:if="{{hasDeep}}" class="ag-deep">
      <button class="ag-deep-toggle" bindtap="onToggleDeep" aria-label="展开深讲">
        {{deepOpen ? '收起深讲' : '再听一段 · 深讲'}}
      </button>
      <block wx:if="{{deepOpen}}">
        <view wx:if="{{guide.deepAudio}}" class="ag-player">
          <button class="ag-play" bindtap="onToggleDeepPlay">{{deepPlaying ? '暂停深讲' : '播放深讲'}}</button>
        </view>
        <scroll-view scroll-y class="ag-script ag-deep-script">
          <view wx:for="{{guide.deepScript}}" wx:key="index" class="ag-line kaiti">{{item}}</view>
        </scroll-view>
        <view wx:if="{{guide.guestPostcard && guest}}" class="ag-guest">
          <view class="ag-guest-tag">上一手留下的明信片</view>
          <view class="ag-guest-text kaiti">{{guest.text}}</view>
        </view>
      </block>
    </view>
  </view>
</block>
