/* 半屏实地导引抽屉：延续「旧纸档案」token，不引入新色值 */
.md-mask {
  position: fixed;
  inset: 0;
  z-index: 118;
  background: rgba(46, 31, 13, 0.45);
}
.md-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  height: 82vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  border-top: 2rpx solid rgba(70, 56, 42, 0.55);
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(46, 31, 13, 0.3);
  animation: md-up 0.28s ease both;
}
@keyframes md-up {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.md-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
}
.md-kicker {
  font-family: "Courier New", monospace;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--coffee);
}
.md-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--ink-deep);
}
.md-close {
  width: 56rpx;
  height: 56rpx;
  font-size: 34rpx;
  color: var(--ink60);
  display: flex;
  align-items: center;
  justify-content: center;
}

.md-map {
  width: 100%;
  height: 44vh;
  flex: none;
}

.md-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 28rpx 24rpx;
  min-height: 0;
}
.md-next {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(70, 56, 42, 0.18);
}
.md-next-label {
  font-size: 22rpx;
  color: var(--olive);
  letter-spacing: 3rpx;
}
.md-next-name {
  font-size: 30rpx;
  color: var(--ink-deep);
}
.md-next-dist {
  margin-left: auto;
  font-family: "Courier New", monospace;
  font-size: 22rpx;
  color: var(--patina);
}
.md-loc-tip {
  padding-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink60);
  border-bottom: 1rpx solid rgba(70, 56, 42, 0.18);
}
.md-loc-tip.warn { color: var(--cinnabar); }

.md-sites {
  flex: 1;
  min-height: 0;
  margin-top: 8rpx;
}
.md-site {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx dashed rgba(138, 122, 96, 0.3);
}
.md-site-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 2rpx solid var(--brass);
  background: var(--paper);
  flex: none;
}
.md-site-dot.done { background: var(--patina); border-color: var(--patina); }
.md-site-dot.cur {
  background: var(--brass);
  box-shadow: 0 0 0 6rpx rgba(169, 143, 95, 0.2);
}
.md-site-name { font-size: 26rpx; color: var(--ink-deep); }
.md-site.is-next .md-site-name { color: var(--patina); font-weight: 700; }
.md-site-badge {
  font-size: 20rpx;
  color: var(--cinnabar);
  border: 1rpx solid var(--cinnabar);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  transform: rotate(-4deg);
}
.md-site-badge.arrive { color: var(--patina); border-color: var(--patina); }
.md-site-dist {
  margin-left: auto;
  font-family: "Courier New", monospace;
  font-size: 20rpx;
  color: var(--ink60);
}

.md-actions {
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.md-nav { width: 100%; }
.md-sub { width: 100%; }
