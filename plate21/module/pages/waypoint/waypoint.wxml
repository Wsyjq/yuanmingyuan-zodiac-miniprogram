<!-- v2 顺路支线站（可选）：不设判定、不做裁判；留白即内容。V2.2 讲述版：旁白＋人声＋纸。
     步进分页（issue #0029）：开场→各拍→尾屏一屏一拍；隐藏步 display:none 保留在 DOM。 -->
<nav-back />
<page-overlays audio-station="{{site.audioStation}}" />
<bgm-ambience station="{{site.audioStation}}" />
<view class="page page-shell paper-grain" wx:if="{{site}}">
  <view class="binder"></view>
  <view class="tag-no page-no">{{site.no}}</view>

  <block wx:if="{{site.scored}}">
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
      <view class="title serif">{{site.title}}</view>
      <view class="wp-intro kaiti"><gloss-text wx:if="{{site.introParts}}" parts="{{site.introParts}}" bind:glossary="onGlossary" /><block wx:else>{{site.intro}}</block></view>
      <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" dock="{{true}}" />
      <view wx:if="{{site.image}}" class="wp-plate double-frame">
        <view class="tape" style="top:-20rpx; left:50%; margin-left:-90rpx;"></view>
        <image class="wp-plate-img" src="{{site.image}}" mode="widthFix" />
      </view>
      <view wx:if="{{site.imageNote}}" class="note-hand olive wp-plate-note tilt-l">{{site.imageNote}}</view>
      <view class="act-strip" wx:if="{{site.quiz.action}}"><text class="act-strip-tag">做</text><text class="act-strip-text">{{site.quiz.action}}</text></view>
      <view wx:if="{{site.quiz.listenFile && !followup}}" class="wp-listen">
        <audio-clip src="{{listenSrc}}" label="听 · 约三十秒" kind="clip" bind:play="onListenPlay" />
        <view class="note-hand olive">{{site.quiz.listenNote}}</view>
      </view>
      <view wx:if="{{!followup}}" class="quiz">
        <view class="hatch-divider wp-hatch"></view>
        <view class="q-title serif">{{site.quiz.prompt}}</view>
        <view
          wx:for="{{site.quiz.options}}"
          wx:key="key"
          class="wp-opt {{item.on ? 'on' : ''}} {{solved && !item.on ? 'wp-opt-dim' : ''}}"
          data-key="{{item.key}}"
          bindtap="onToggle"
          role="button"
          aria-pressed="{{item.on}}"
        >
          <text class="wp-opt-key">{{item.key}}</text>
          <text class="wp-opt-text">{{item.text}}</text>
        </view>
        <view wx:if="{{hint}}" class="hint note-hand">{{hint}}</view>
        <button class="btn-seal wp-confirm-btn" bindtap="onQuizConfirm" disabled="{{!selected.length || solved}}">{{revealed ? '记 下 了' : '就 是 这 些'}}</button>
      </view>
      <view wx:if="{{followup}}" class="followup">
        <view class="wp-line kaiti" wx:for="{{site.quiz.followup}}" wx:key="index"><gloss-text wx:if="{{item.parts}}" parts="{{item.parts}}" bind:glossary="onGlossary" /><block wx:else>{{item}}</block></view>
        <!-- 站尾文本谜题（飞书 v3 rev5614 §谐奇趣：两半字拼出黄花阵） -->
        <block wx:if="{{site.textPuzzle}}">
          <view class="wp-line kaiti">{{site.textPuzzle.prompt}}</view>
          <view class="note-hand olive">{{site.textPuzzle.lead}}</view>
          <view class="wp-plate double-frame">
            <image class="wp-plate-img" src="/plate21/module/assets/img/IMG-ENVELOPE-FRONT.png" mode="widthFix" />
          </view>
          <view class="wp-plate double-frame">
            <image class="wp-plate-img" src="/plate21/module/assets/img/IMG-ENVELOPE-BACK.png" mode="widthFix" />
          </view>
          <block wx:if="{{!textSolved}}">
            <input class="answer-input" value="{{textInput}}" bindinput="onTextInput" placeholder="{{site.textPuzzle.placeholder}}" maxlength="8" />
            <view wx:if="{{textHint}}" class="hint note-hand">{{textHint}}</view>
            <button class="btn-seal wp-confirm-btn" bindtap="onTextSubmit" disabled="{{!textInput}}">就 是 这 里</button>
          </block>
          <view wx:else class="wp-line kaiti">{{site.textPuzzle.solvedText}}</view>
        </block>
        <button wx:if="{{!site.textPuzzle || textSolved}}" class="btn-seal wp-next" bindtap="onNext">{{site.nextLabel}}</button>
      </view>
    </scroll-view>
    <history-card
      visible="{{showHistory}}"
      title="{{site.quiz.historyTitle}}"
      source="圆明园西洋楼景区史料"
      lines="{{site.quiz.historyLines}}"
      btn-text="继 续"
      bind:next="onCloseHistory"
      bind:close="onCloseHistory"
      bind:glossary="onGlossary"
    />
    <!-- 术语史料卡（从主卡内的铜绿术语点入，返回即回主卡） -->
    <history-card
      wx:if="{{gloss}}"
      visible="{{!!gloss}}"
      title="{{gloss.title}}"
      source="{{gloss.source}}"
      lines="{{gloss.lines}}"
      btn-text="学到了"
      bind:next="onGlossClose"
      bind:close="onGlossClose"
    />
  </block>

  <!-- 步 0：到站开场 -->
  <block wx:else>
  <view class="wp-step {{step === 0 ? '' : 'wp-step-off'}}">
    <view class="title serif">{{site.title}}</view>
    <view class="wp-intro kaiti"><gloss-text wx:if="{{site.introParts}}" parts="{{site.introParts}}" bind:glossary="onGlossary" /><block wx:else>{{site.intro}}</block></view>
    <!-- 本页讲述保持行内：散页已有语音导览悬浮钮（audio-guide FAB），不再叠 dock -->
    <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" />
    <view class="hatch-divider wp-rule"></view>
  </view>

  <!-- 各拍：一拍一屏 -->
  <view
    wx:for="{{site.beats}}"
    wx:for-index="bi"
    wx:key="kicker"
    class="wp-step {{step === bi + 1 ? '' : 'wp-step-off'}}"
  >
    <view class="wp-beat {{item.prop ? 'wp-prop' : ''}}">
      <view class="wp-kicker">{{item.kicker}}</view>
      <view wx:if="{{item.fadeCard}}" class="wp-fade-card">
        <view class="wp-fade-name serif">容妃</view>
      </view>
      <view wx:if="{{item.image}}" class="wp-plate double-frame">
        <image class="wp-plate-img" src="{{item.image}}" mode="widthFix" />
      </view>
      <view wx:if="{{item.imageNote}}" class="note-hand olive wp-plate-note">{{item.imageNote}}</view>
      <view wx:if="{{item.action}}" class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">{{item.action}}</text></view>
      <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="wp-line kaiti">{{line}}</view>
      <view wx:if="{{item.parts}}" class="wp-line kaiti"><gloss-text parts="{{item.parts}}" bind:glossary="onGlossary" /></view>
      <view wx:for="{{item.quotes}}" wx:for-item="quote" wx:key="*this" class="wp-quote kaiti">{{quote}}</view>
      <dialogue-block
        wx:for="{{item.dialogues}}"
        wx:for-item="dlg"
        wx:key="clipId"
        speaker="{{dlg.speaker}}"
        aside="{{dlg.aside}}"
        text="{{dlg.text}}"
        clip-id="{{dlg.clipId}}"
        note="{{dlg.note}}"
      />
      <view wx:if="{{item.stageNote}}" class="wp-stage note-hand">{{item.stageNote}}</view>
      <dialogue-block
        wx:for="{{item.dialogues2}}"
        wx:for-item="dlg"
        wx:key="clipId"
        speaker="{{dlg.speaker}}"
        aside="{{dlg.aside}}"
        text="{{dlg.text}}"
        clip-id="{{dlg.clipId}}"
        note="{{dlg.note}}"
      />
      <button wx:if="{{item.confirm && !confirmed}}" class="btn-line wp-confirm" bindtap="onConfirm">我拼好了</button>
      <!-- 蓄水楼：拼合确认后，卡条背面注释随本拍展开（不移到页尾） -->
      <view wx:if="{{item.confirm && revealLines.length}}" class="wp-reveal">
        <view class="wp-kicker">拼对后才看 · 卡条背面注释</view>
        <view wx:for="{{revealLines}}" wx:for-item="rl" wx:key="*this" class="wp-line kaiti">{{rl}}</view>
      </view>
    </view>
  </view>

  <!-- 谐奇趣：双声道成品曲试听（先左后右再合，还原「左右同响」） -->
  <view wx:if="{{bgmSrc}}" class="wp-step {{step === site.beats.length + 1 ? '' : 'wp-step-off'}}">
    <view class="wp-beat wp-prop">
      <view class="wp-kicker">现场 · 听 · 当年两边同时响</view>
      <view class="wp-line kaiti">喷泉声、少数民族音乐和西洋音乐</view>
      <audio-clip src="{{bgmSrc}}" label="听 · 左右同响" kind="bgm" />
    </view>
  </view>

  <!-- 尾屏：这一页的话 + 收好夹页 -->
  <view class="wp-step {{step === steps.length - 1 ? '' : 'wp-step-off'}}">
    <view wx:if="{{site.motif}}" class="wp-motif kaiti">{{site.motif}}</view>
    <view class="wp-note note-hand olive">路上的页 · 翻多久由你决定，不翻也不缺什么。</view>
    <button class="btn-seal wp-next" bindtap="onNext">{{site.nextLabel}}</button>
  </view>

  <!-- 分页导航：随时可前进（可跳过红线），随时可回看 -->
  <view class="wp-pager">
    <view class="wp-pager-pos note-hand olive">{{step + 1}} / {{steps.length}}</view>
    <view class="wp-pager-btns">
      <button wx:if="{{step > 0}}" class="btn-line wp-prev" bindtap="onStepPrev">上一节</button>
      <button wx:if="{{step < steps.length - 1}}" class="btn-seal wp-step-next" bindtap="onStepNext">继 续</button>
    </view>
  </view>

  <!-- 术语史料卡（散页/叙事站内的铜绿术语点入，如 容妃 SL-10、五竹亭 SL-11） -->
  <history-card
    wx:if="{{gloss}}"
    visible="{{!!gloss}}"
    title="{{gloss.title}}"
    source="{{gloss.source}}"
    lines="{{gloss.lines}}"
    btn-text="学到了"
    bind:next="onGlossClose"
    bind:close="onGlossClose"
  />
  </block>
</view>
