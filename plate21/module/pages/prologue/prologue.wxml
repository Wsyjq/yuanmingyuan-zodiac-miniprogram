<view class="page page-shell paper-grain paper-real">
  <!-- v1.3.1 手账：左侧活页装订孔列（叙事页） -->
  <view class="binder"></view>
  <nav-back />
<bgm-ambience />
  <novel-view
    style="flex: 1; min-height: 0; height: 0;"
    title="序章"
    paragraphs="{{paragraphs}}"
    finish-text="翻完这一册档案"
    bind:pagechange="onNovelPage"
    bind:finish="onNovelFinish"
    bind:glossary="onGlossary"
  />
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 序章讲述" dock="{{true}}" />

  <!-- 术语史料卡（正文铜绿词点入，如《西洋楼铜版图》SL-01） -->
  <history-card
    wx:if="{{gloss}}"
    visible="{{!!gloss}}"
    title="{{gloss.title}}"
    source="{{gloss.source}}"
    lines="{{gloss.lines}}"
    btn-text="学到了"
    bind:next="onGlossClose"
    bind:close="onGlossClose"
  />

  <!-- 叙事结束：档案交接清点（飞书 v3 序章：档案袋＋日记）。 -->
  <view wx:if="{{showHandover}}" class="pack">
    <view class="pack-sheet archive-sheet">
      <view class="physical-label archive-tab">线下道具 · 档案袋</view>
      <view class="pack-title serif">西洋楼现场考察资料</view>
      <view class="archive-rule"></view>
      <view class="pack-note">里面有一封信、一张手绘路线图、几张空白记录页，以及几件用于现场记录的工具。</view>
      <view class="pack-map">
        <image class="pack-map-img img-aged" src="/plate21/module/assets/img/IMG-RUNTIME-MAP.jpg" mode="widthFix" />
      </view>
      <view class="pack-items">
        <view wx:for="{{props}}" wx:key="*this" class="pack-item">{{item}}</view>
      </view>
      <button class="btn-seal pack-btn record-action" bindtap="onTakeArchive">档案已收好</button>
      <button id="coachGo" class="btn-seal pack-btn record-action" bindtap="onGoS1" disabled="{{advancing}}">{{advancing ? '正在保存档案……' : '前 往 西 洋 楼 入 口'}}</button>
    </view>
  </view>

  <stamp-toast id="stamp" />
</view>
<coach-spot
  class="coach-host"
  style="top: {{coachWin.top}}px; left: {{coachWin.left}}px; width: {{coachWin.windowWidth}}px; height: {{coachWin.windowHeight}}px;"
  visible="{{showCoach}}"
  closing="{{coachClosing}}"
  index="{{coachIndex}}"
  total="{{coachSteps.length}}"
  step="{{coachStep}}"
  hole="{{coachHole}}"
  win="{{coachWin}}"
  bind:next="onCoachNext"
  bind:skip="onCoachSkip"
/>
