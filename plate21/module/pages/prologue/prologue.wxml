<view class="page page-shell paper-grain paper-real">
  <!-- v1.3.1 手账：左侧活页装订孔列（叙事页） -->
  <view class="binder"></view>
  <nav-back />
  <novel-view
    title="序章"
    paragraphs="{{paragraphs}}"
    finish-text="翻完这一册档案"
    bind:finish="onNovelFinish"
  />
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 序章讲述" />

  <!-- 叙事结束：档案交接清点。信不拆——到遗址门口再拆（V2.1）。 -->
  <view wx:if="{{showHandover}}" class="pack">
    <view class="pack-sheet archive-sheet">
      <view class="physical-label archive-tab">线下道具 · 档案夹与信</view>
      <view class="pack-title serif">清点交到你手上的东西</view>
      <view class="archive-rule"></view>
      <view class="pack-note">这册档案跟着你走完全程。信先别拆——到了遗址门口再拆。</view>
      <view class="pack-items">
        <view wx:for="{{props}}" wx:key="*this" class="pack-item">{{item}}</view>
      </view>
      <button class="btn-seal pack-btn record-action" bindtap="onTakeArchive">档案已收好，信先封着</button>
      <button class="btn-seal pack-btn record-action" bindtap="onGoS1" disabled="{{advancing}}">{{advancing ? '正在保存档案……' : '前 往 西 洋 楼 入 口'}}</button>
    </view>
  </view>

  <stamp-toast id="stamp" />
</view>
