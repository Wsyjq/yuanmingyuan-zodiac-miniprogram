/* P01 序章 */
/* 叙事图片样式由 novel-view 提供，archive-illustration 保留降级能力。 */

/* v1.3.1 手账根容器：旧纸纹底 + 真纸纹叠加 + 活页装订孔让位 */
.page {
  position: relative;
  min-height: 100vh;
  padding-left: 52rpx;
}

/* 实体道具引导层：底部滑出，小程序只展示操作步骤与剧情结果。 */
.pack {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  background: linear-gradient(180deg, var(--paper3), var(--paper2));
  border-top: 3rpx double rgba(46, 31, 13, 0.48);
  box-shadow: 0 -12rpx 32rpx rgba(46, 31, 13, 0.16);
  padding: 46rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 78vh;
  overflow-y: auto;
  animation: pack-up 0.4s ease both;
}
.pack::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 72rpx;
  height: 5rpx;
  margin-left: -36rpx;
  border-radius: 4rpx;
  background: rgba(70, 56, 42, 0.22);
}
.pack-sheet {
  padding: 48rpx 30rpx 28rpx;
}
@keyframes pack-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.physical-label {
  white-space: nowrap;
}
.pack-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink-deep);
  margin: 0 0 8rpx;
}
.pack-note {
  color: var(--ink60);
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.step-list {
  padding: 4rpx 0;
}
.step-row {
  display: flex;
  align-items: flex-start;
  padding: 13rpx 0;
}
.step-no {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  flex: none;
  margin-right: 18rpx;
  border: 1rpx solid var(--ink-deep);
  border-radius: 50%;
  text-align: center;
  font-family: "Courier New", monospace;
  font-size: 20rpx;
}
.step-copy {
  padding-top: 2rpx;
  font-size: 28rpx;
  line-height: 1.65;
}
.letter-copy {
  margin: 28rpx 0;
  padding: 24rpx 22rpx;
  border-left: 5rpx solid var(--cinnabar);
  background: var(--paper);
  font-size: 31rpx;
  line-height: 1.9;
}
.decision-copy {
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.8;
}
.props-title {
  margin-top: 30rpx;
  font-size: 30rpx;
}
.pack-items {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
  border-top: 1rpx dashed rgba(70, 56, 42, 0.3);
  border-bottom: 1rpx dashed rgba(70, 56, 42, 0.3);
}
.pack-item {
  margin: 7rpx 14rpx 7rpx 0;
  padding: 9rpx 18rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.3);
  background: var(--paper);
  font-size: 24rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.pack-btn {
  width: 100%;
  margin: 28rpx 0 0;
}
