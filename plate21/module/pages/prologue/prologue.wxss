/* P01 序章 */
/* 叙事图片样式由 novel-view 提供，archive-illustration 保留降级能力。 */

/* v1.3.1 手账根容器：旧纸纹底 + 真纸纹叠加 + 活页装订孔让位 */
.page.page-shell {
  position: relative;
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-left: 52rpx;
}
.narr-bar {
  flex-shrink: 0;
  padding: 200rpx 28rpx 8rpx 0;
}
/* 交接面板里的路线图：档案卡纸底 + 细框，与 pack-sheet 同一语言 */
.pack-map {
  margin: 4rpx 0 14rpx;
  padding: 10rpx;
  background: var(--paper);
  border: 1rpx solid rgba(70, 56, 42, 0.35);
}
.pack-map-img {
  display: block;
  width: 100%;
}
.pack-route {
  margin: 0 0 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

/* 实体道具引导层：底部滑出，小程序只展示操作步骤与剧情结果。 */
.pack-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(46, 31, 13, 0.45);
}
.pack {
  position: relative;
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 40rpx 36rpx 32rpx;
  background: #FBF6EA;
  border: 4rpx solid #2E1F0D;
  box-shadow: inset 0 0 0 8rpx #FBF6EA, inset 0 0 0 10rpx rgba(110, 36, 28, 0.45);
}
.pack-sheet {
  padding: 48rpx 30rpx 28rpx;
}
@keyframes pack-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.physical-label {
  white-space: nowrap;
}
.pack-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink-deep);
  margin: 0 0 8rpx;
}
.pack-note {
  color: var(--ink60);
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.step-list {
  padding: 4rpx 0;
}
.step-row {
  display: flex;
  align-items: flex-start;
  padding: 13rpx 0;
}
.step-no {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  flex: none;
  margin-right: 18rpx;
  border: 1rpx solid var(--ink-deep);
  border-radius: 50%;
  text-align: center;
  font-family: "Courier New", monospace;
  font-size: 20rpx;
}
.step-copy {
  padding-top: 2rpx;
  font-size: 28rpx;
  line-height: 1.65;
}
.letter-copy {
  margin: 28rpx 0;
  padding: 24rpx 22rpx;
  border-left: 5rpx solid var(--cinnabar);
  background: var(--paper);
  font-size: 31rpx;
  line-height: 1.9;
}
.decision-copy {
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.8;
}
.props-title {
  margin-top: 30rpx;
  font-size: 30rpx;
}
.pack-items {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
  border-top: 1rpx dashed rgba(70, 56, 42, 0.3);
  border-bottom: 1rpx dashed rgba(70, 56, 42, 0.3);
}
.pack-item {
  margin: 7rpx 14rpx 7rpx 0;
  padding: 9rpx 18rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.3);
  background: var(--paper);
  font-size: 24rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.pack-btn {
  width: 100%;
  margin: 28rpx 0 0;
}
