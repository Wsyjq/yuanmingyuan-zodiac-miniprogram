<view bindtouchstart="onUserInteraction" class="p21-page {{playId === 'quiz-hour' ? 'canvas-page' : ''}}">
  <scroll-view wx:if="{{restartScreen}}" scroll-y class="restart-screen">
    <view class="restart-paper"><text class="restart-eyebrow">第廿一图 · 再访</text><view class="restart-mark">廿一</view><view class="restart-title">再走一遍，
会看见什么？</view><text class="restart-prose">旧图仍在，新的足迹尚未落下。
带上档案，再次走进西洋楼。</text><view class="restart-rule"></view><text class="restart-note">已完成的作品会保留。
这次尚未完成的考察将从头开始。</text><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" bindtap="onConfirmRestart" disabled="{{busy || loading}}" loading="{{busy}}">重新启程<i class="entry-arrow">→</i></button><button class="text-button restart-cancel" bindtap="onCancelRestart" disabled="{{busy}}">回到这份档案</button></view>
  </scroll-view>
  <block wx:else>
  <view wx:if="{{pageId && !loading}}" class="narration-bar">
    <view class="narration-heading"><text>{{listenMode === 'listen' ? '随声入园' : '静读档案'}}</text><button class="text-button mode-switch" bindtap="onChooseModeOpen">切换</button></view>
    <audio-clip wx:if="{{narrClips.length}}" id="narration" clips="{{narrClips}}" context-key="{{narrationKey}}" listen-key="{{listenKey}}" compact active="{{pageVisible && !drawer && !showModeChoice && !restartScreen && !busy}}" label="听这一段" bind:state="onNarrationState" bind:ended="onNarrationEnded" bind:error="cancelAuto" />
    <view wx:if="{{autoSeconds}}" class="narration-countdown"><text>{{autoSeconds}} 秒后继续</text><button class="text-button" bindtap="cancelAuto">留在这一页</button></view>
  </view>
  <view class="toolbar">
    <button class="text-button" bindtap="onBack" disabled="{{busy || loading}}">‹ 返回</button>
    <text class="brand">第廿一图</text>
    <button class="text-button" data-name="history" bindtap="onDrawer">考察簿 ☰</button>
  </view>
  <view wx:if="{{loading}}" class="empty">正在打开考察档案…</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button wx:if="{{!pageId}}" bindtap="load">重新打开</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{letterScene}}" class="letter-stage"><letter-scene chapter="{{pageId}}" heading="{{screen.sectionTitle}}" lines="{{letterLines}}" cursor="{{letterCursor || 0}}" scene="{{letterSceneImage}}" active="{{pageVisible && !drawer}}" busy="{{busy}}" bind:progress="onLetterProgress" bind:complete="onLetterComplete" /></view>
  <!-- Native Canvas uses page scrolling, avoiding a nested native scroll layer. -->
  <view wx:if="{{pageId && !letterScene && playId === 'quiz-hour'}}"><include src="walk-content.wxml" /></view>
  <scroll-view wx:elif="{{pageId && !letterScene}}" scroll-y class="reading" scroll-top="{{scrollTop}}" bindscroll="onScroll">
    <include src="walk-content.wxml" />
  </scroll-view>
  <view wx:if="{{pageId && !letterScene && !screen.play}}" class="footer"><button class="primary" bindtap="onPrimary" disabled="{{busy}}" loading="{{busy}}">{{review ? screen.primary : completed && pageId === 'FN4' ? '查看我的作品' : pageId === 'LT8' ? '读完来信，查看作品' : screen.primary || '继续'}}<i class="entry-arrow">→</i></button><button wx:if="{{screen.showSkip && !review}}" class="text-button skip" bindtap="onSkip" disabled="{{busy}}">{{screen.skipLabel || '这题跳过'}}</button></view>
  <view wx:if="{{pageId && !drawer}}" class="nav-float" style="left:{{navX}}px;top:{{navY}}px" catchtouchstart="onNavStart" catchtouchmove="onNavMove" catchtouchend="onNavEnd" catchtouchcancel="onNavCancel" role="button" aria-label="实地导引，可拖动"><view class="nav-symbol"></view><text>导引</text></view>
  <view wx:if="{{drawer}}" class="overlay" bindtap="onCloseDrawer"><view class="drawer" catchtap="noop"><view class="row"><text class="subheading">{{drawer === 'history' ? '考察簿 · 史料' : drawer === 'route' ? '实地导引' : drawer === 'explanation' ? '互动解读' : '考察设置'}}</text><button class="text-button" bindtap="onCloseDrawer">关闭 ✕</button></view>
    <scroll-view wx:if="{{drawer === 'history' && card}}" scroll-y class="drawer-scroll" scroll-top="{{drawerScrollTop}}" scroll-into-view="{{cardAnchor}}" bindscroll="onDrawerScroll"><include src="history-card.wxml" /></scroll-view>
    <scroll-view wx:else scroll-y class="drawer-scroll" scroll-top="{{drawerScrollTop}}" bindscroll="onDrawerScroll">
      <block wx:if="{{drawer === 'explanation'}}"><text class="caption">可以带着解读再试一次，也可以跳过本题继续；跳过会如实记录。</text><text wx:for="{{explanation}}" wx:key="index" class="paragraph">{{item}}</text><button class="primary" bindtap="onCloseDrawer">回去再试一次</button><button class="text-button" bindtap="onSkip" disabled="{{busy}}">跳过本题，继续考察</button></block>
      <block wx:elif="{{drawer === 'route'}}">
        <view class="route-current"><text class="caption">当前考察进度</text><view class="subheading">{{routeCurrent}}</view></view>
        <map wx:if="{{location}}" class="field-map" latitude="{{location.latitude}}" longitude="{{location.longitude}}" scale="16" show-location />
        <button class="secondary locate-btn" bindtap="onLocate" loading="{{locating}}" disabled="{{locating}}">{{location ? '刷新我的实际位置' : '查看我的实际位置'}}</button>
        <text wx:if="{{locationError}}" class="caption">{{locationError}}</text>
        <text class="caption">请循实体地图与沿途路标前行。</text>
        <view class="route-stop {{item.current ? 'route-active' : ''}}" wx:for="{{routeRows}}" wx:key="id"><text class="route-number">{{index + 1}}</text><view class="route-copy"><text>{{item.title}}</text><text wx:if="{{item.state}}" class="caption">{{item.state}}</text></view><button class="text-button" data-page="{{item.openPageId}}" bindtap="onOpenPage" disabled="{{!item.canOpen}}">{{item.current ? '继续' : item.canOpen ? '回看' : '待考察'}}</button></view>
      </block>

      <block wx:elif="{{drawer === 'history'}}">
        <block>
          <text wx:if="{{!historyCards.length}}" class="caption">随着考察进行，遇见的史料会收录在这里。</text>
          <button wx:for="{{historyCards}}" wx:key="key" class="choice" data-key="{{item.key}}" bindtap="onOpenCard">{{item.label}}</button>
          <button class="text-button" data-name="menu" bindtap="onDrawer">音频、作品与考察设置</button>
        </block>
      </block>
      <block wx:else><view class="row"><text>讲述音频</text><switch checked="{{voiceEnabled}}" bindchange="onVoice" color="#627d77"/></view><button class="text-button" bindtap="onMuteAll">暂停全部声音</button>
        <button class="choice" bindtap="onResume">回到当前考察进度</button><button class="choice" data-name="history" bindtap="onDrawer">已遇见的史料</button>
        <view wx:for="{{rows}}" wx:key="id" class="progress-row"><button class="text-button" data-page="{{item.openPageId}}" bindtap="onOpenPage" disabled="{{!item.canOpen}}">{{item.title}}{{item.state ? ' · ' + item.state : ''}}</button><view class="caption" wx:for="{{item.puzzles}}" wx:for-item="puzzle" wx:key="playId">{{puzzle.state}}<button wx:if="{{puzzle.canOpen}}" class="text-button" data-page="{{puzzle.reopenPageId}}" bindtap="onOpenPage">回看互动</button></view></view>
        <view class="subheading">已完成的作品</view><text wx:if="{{!archives.length}}" class="caption">完成考察后，作品会保存在这里。</text><button wx:for="{{archives}}" wx:key="id" class="choice" data-id="{{item.id}}" bindtap="onReport">{{item.name}} · {{item.date}}</button>
        <button class="secondary" bindtap="onRestart">重新考察</button><button class="text-button" bindtap="onExit">收好档案</button>
      </block>
    </scroll-view>
  </view></view>
  </block>
  <view wx:if="{{showModeChoice && !restartScreen}}" class="mode-overlay" catchtouchmove="noop"><view class="mode-paper"><text class="eyebrow">翻开档案之前</text><view class="mode-title">你想怎样走进这段故事？</view><button class="mode-choice" data-mode="listen" bindtap="onChooseMode"><text class="mode-choice-title">以听为主</text><text class="mode-choice-copy">听完停留三秒自动继续，互动页暂停。</text></button><button class="mode-choice" data-mode="read" bindtap="onChooseMode"><text class="mode-choice-title">以阅读为主</text><text class="mode-choice-copy">手动翻页，可随时播放录音。</text></button></view></view>
</view>
