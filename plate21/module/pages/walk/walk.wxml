<view class="p21-page {{playId === 'quiz-hour' ? 'canvas-page' : ''}}">
  <view class="toolbar">
    <button class="text-button" bindtap="onBack" disabled="{{busy || loading}}">‹ 返回</button>
    <text class="brand">第廿一图</text>
    <button class="text-button" data-name="history" bindtap="onDrawer">考察簿 ☰</button>
  </view>
  <view wx:if="{{loading}}" class="empty">正在打开考察档案…</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button wx:if="{{!pageId}}" bindtap="load">重新打开</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{letterScene}}" class="letter-stage"><letter-scene chapter="{{pageId}}" heading="{{screen.sectionTitle}}" lines="{{screen.lines}}" cursor="{{ui.letterCursor || 0}}" scene="{{letterSceneImage}}" active="{{pageVisible && !drawer}}" busy="{{busy}}" bind:progress="onLetterProgress" bind:complete="onLetterComplete" /></view>
  <view wx:if="{{letterScene && narrClips.length}}" class="letter-audio"><audio-clip clips="{{narrClips}}" active="{{pageVisible && !drawer}}" label="听老师读信" /></view>
  <!-- Native Canvas uses page scrolling, avoiding a nested native scroll layer. -->
  <view wx:if="{{pageId && !letterScene && playId === 'quiz-hour'}}"><include src="walk-content.wxml" /></view>
  <scroll-view wx:elif="{{pageId && !letterScene}}" scroll-y class="reading" scroll-top="{{scrollTop}}" bindscroll="onScroll">
    <include src="walk-content.wxml" />
  </scroll-view>
  <view wx:if="{{pageId && !letterScene}}" class="footer"><button class="primary" bindtap="onPrimary" disabled="{{busy}}" loading="{{busy}}">{{review ? '继续回看 / 返回进度' : completed && pageId === 'FN4' ? '查看我的作品' : pageId === 'LT8' ? '读完来信，查看作品' : screen.primary || '继续'}}</button><button wx:if="{{screen.showSkip && !review}}" class="text-button skip" bindtap="onSkip" disabled="{{busy}}">{{screen.skipLabel || '这题跳过'}}</button></view>
  <view wx:if="{{pageId && !drawer}}" class="nav-float" style="left:{{navX}}px;top:{{navY}}px" catchtouchstart="onNavStart" catchtouchmove="onNavMove" catchtouchend="onNavEnd" catchtouchcancel="onNavCancel" role="button" aria-label="实地导引，可拖动"><text class="nav-symbol">⌖</text><text>导引</text></view>
  <view wx:if="{{drawer}}" class="overlay" bindtap="onCloseDrawer"><view class="drawer" catchtap="noop"><view class="row"><text class="subheading">{{drawer === 'history' ? '考察簿 · 史料' : drawer === 'route' ? '实地导引' : drawer === 'script' ? '剧本创作说明' : '考察设置'}}</text><button class="text-button" bindtap="onCloseDrawer">关闭 ✕</button></view>
    <scroll-view wx:if="{{drawer === 'history' && card}}" scroll-y class="drawer-scroll" scroll-top="{{drawerScrollTop}}" scroll-into-view="{{cardAnchor}}" bindscroll="onDrawerScroll"><include src="history-card.wxml" /></scroll-view>
    <scroll-view wx:else scroll-y class="drawer-scroll" scroll-top="{{drawerScrollTop}}" bindscroll="onDrawerScroll">
      <block wx:if="{{drawer === 'route'}}">
        <view class="route-current"><text class="caption">当前考察进度</text><view class="subheading">{{routeCurrent}}</view><text class="caption">站点状态依据考察记录，不代表 GPS 到访。</text></view>
        <map wx:if="{{location}}" class="field-map" latitude="{{location.latitude}}" longitude="{{location.longitude}}" scale="16" show-location />
        <button class="secondary" bindtap="onLocate" loading="{{locating}}" disabled="{{locating}}">{{location ? '刷新我的实际位置' : '查看我的实际位置'}}</button>
        <text wx:if="{{locationError}}" class="caption">{{locationError}}</text>
        <text class="caption">对照实体地图与现场标识步行。站点坐标尚未核实，暂不显示距离及精确导航。</text>
        <view class="route-stop {{item.current ? 'route-active' : ''}}" wx:for="{{routeRows}}" wx:key="id"><text class="route-number">{{index + 1}}</text><view class="route-copy"><text>{{item.title}}</text><text class="caption">{{item.state}}</text></view><button class="text-button" data-page="{{item.openPageId}}" bindtap="onOpenPage" disabled="{{!item.canOpen}}">{{item.current ? '继续' : item.canOpen ? '回看' : '待考察'}}</button></view>
      </block>

      <block wx:elif="{{drawer === 'script'}}"><text wx:for="{{scriptAppendix}}" wx:key="index" class="paragraph">{{item}}</text></block>
      <block wx:elif="{{drawer === 'history'}}">
        <block>
          <text wx:if="{{!historyCards.length}}" class="caption">随着考察进行，遇见的史料会收录在这里。</text>
          <button wx:for="{{historyCards}}" wx:key="key" class="choice" data-key="{{item.key}}" bindtap="onOpenCard">{{item.label}}</button>
          <button wx:if="{{completed}}" class="text-button" data-name="script" bindtap="onDrawer">剧本创作说明</button>
          <button class="text-button" data-name="menu" bindtap="onDrawer">音频、作品与考察设置</button>
        </block>
      </block>
      <block wx:else><view class="row"><text>讲述音频</text><switch checked="{{voiceEnabled}}" bindchange="onVoice" color="#627d77"/></view><button class="text-button" bindtap="onMuteAll">暂停全部声音</button><text class="caption">{{isDemo ? '本地演示 · 记录保存在本设备' : '官方接入模式'}} · {{syncState}}</text>
        <button class="choice" bindtap="onResume">回到当前考察进度</button><button class="choice" data-name="history" bindtap="onDrawer">已遇见的史料</button>
        <view wx:for="{{rows}}" wx:key="id" class="progress-row"><button class="text-button" data-page="{{item.openPageId}}" bindtap="onOpenPage" disabled="{{!item.canOpen}}">{{item.title}} · {{item.state}}</button><view class="caption" wx:for="{{item.puzzles}}" wx:for-item="puzzle" wx:key="playId">{{puzzle.state}}<button wx:if="{{puzzle.canOpen}}" class="text-button" data-page="{{puzzle.reopenPageId}}" bindtap="onOpenPage">回看互动</button></view></view>
        <view class="subheading">已完成的作品</view><text wx:if="{{!archives.length}}" class="caption">完成考察后，作品会保存在这里。</text><button wx:for="{{archives}}" wx:key="id" class="choice" data-id="{{item.id}}" bindtap="onReport">{{item.name}} · {{item.date}}</button>
        <button class="secondary" bindtap="onRestart">重新考察</button><button class="text-button" bindtap="onExit">保存并退出模块</button>
      </block>
    </scroll-view>
  </view></view>
</view>
