<view class="p21-page {{playId === 'quiz-hour' ? 'canvas-page' : ''}}">
  <view class="toolbar">
    <button class="text-button" bindtap="onBack" disabled="{{busy || loading}}">‹ 返回</button>
    <text class="brand">第廿一图</text>
    <button class="text-button" data-name="menu" bindtap="onDrawer">考察簿 ☰</button>
  </view>
  <view wx:if="{{loading}}" class="empty">正在打开考察档案…</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button wx:if="{{!pageId}}" bindtap="load">重新打开</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{letterScene}}" class="letter-stage"><letter-scene chapter="{{pageId}}" lines="{{screen.lines}}" cursor="{{ui.letterCursor || 0}}" scene="{{letterSceneImage}}" active="{{pageVisible && !drawer}}" busy="{{busy}}" bind:progress="onLetterProgress" bind:complete="onLetterComplete" /></view>
  <view wx:if="{{letterScene && narrClips.length}}" class="letter-audio"><audio-clip clips="{{narrClips}}" active="{{pageVisible && !drawer}}" label="听老师读信" /></view>
  <!-- Native Canvas uses page scrolling, avoiding a nested native scroll layer. -->
  <view wx:if="{{pageId && !letterScene && playId === 'quiz-hour'}}"><include src="walk-content.wxml" /></view>
  <scroll-view wx:elif="{{pageId && !letterScene}}" scroll-y class="reading" scroll-top="{{scrollTop}}" bindscroll="onScroll">
    <include src="walk-content.wxml" />
  </scroll-view>
  <view wx:if="{{pageId && !letterScene}}" class="footer"><button class="primary" bindtap="onPrimary" disabled="{{busy}}" loading="{{busy}}">{{review ? '继续回看 / 返回进度' : completed && pageId === 'FN4' ? '查看我的作品' : pageId === 'LT8' ? '读完来信，查看作品' : screen.primary || '继续'}}</button><button wx:if="{{screen.showSkip && !review}}" class="text-button skip" bindtap="onSkip" disabled="{{busy}}">{{screen.skipLabel || '这题跳过'}}</button></view>
  <view wx:if="{{drawer}}" class="overlay" bindtap="onCloseDrawer"><view class="drawer" catchtap="noop"><view class="row"><text class="subheading">{{drawer === 'history' ? '史料夹' : '我的考察簿'}}</text><button class="text-button" bindtap="onCloseDrawer">关闭 ✕</button></view>
    <scroll-view scroll-y class="drawer-scroll">
      <block wx:if="{{drawer === 'history'}}"><block wx:if="{{card}}"><view class="title small">{{card.title}}</view><image wx:if="{{card.image}}" src="{{card.image}}" mode="widthFix" class="illustration"/><text class="caption">{{card.caption}}</text><view wx:if="{{card.years.length}}" class="notice">相关年份：<text wx:for="{{card.years}}" wx:key="*this">{{item}}　</text></view><text class="paragraph" wx:for="{{card.layers}}" wx:key="index">{{item}}</text><text wx:if="{{card.answerHidden}}" class="caption">与谜题答案相关的史料，将在完成对应互动后展示。</text></block><button wx:for="{{historyCards}}" wx:key="key" class="choice" data-key="{{item.key}}" bindtap="onOpenCard">{{item.label}}</button></block>
      <block wx:else><view class="row"><text>讲述音频</text><switch checked="{{voiceEnabled}}" bindchange="onVoice" color="#627d77"/></view><button class="text-button" bindtap="onMuteAll">暂停全部声音</button><text class="caption">{{isDemo ? '本地演示 · 记录保存在本设备' : '官方接入模式'}} · {{syncState}}</text>
        <button class="choice" bindtap="onResume">回到当前考察进度</button><button class="choice" data-name="history" bindtap="onDrawer">已遇见的史料</button>
        <view wx:for="{{rows}}" wx:key="id" class="progress-row"><button class="text-button" data-page="{{item.openPageId}}" bindtap="onOpenPage" disabled="{{!item.canOpen}}">{{item.title}} · {{item.state}}</button><view class="caption" wx:for="{{item.puzzles}}" wx:for-item="puzzle" wx:key="playId">{{puzzle.state}}<button wx:if="{{puzzle.canOpen}}" class="text-button" data-page="{{puzzle.reopenPageId}}" bindtap="onOpenPage">回看互动</button></view></view>
        <view class="subheading">已完成的作品</view><text wx:if="{{!archives.length}}" class="caption">完成考察后，作品会保存在这里。</text><button wx:for="{{archives}}" wx:key="id" class="choice" data-id="{{item.id}}" bindtap="onReport">{{item.name}} · {{item.date}}</button>
        <button class="secondary" bindtap="onRestart">重新考察</button><button class="text-button" bindtap="onExit">保存并退出模块</button>
      </block>
    </scroll-view>
  </view></view>
</view>
