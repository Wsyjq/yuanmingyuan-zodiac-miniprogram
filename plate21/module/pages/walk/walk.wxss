idth:190rpx;height:190rpx}.relay-photo{width:100%;height:340rpx}.route-card{padding:32rpx 24rpx;background:#e5e4d3;line-height:1.8}.route-destination{font-size:44rpx;margin:14rpx 0}.route-strip{display:flex;flex-wrap:wrap;gap:12rpx;margin:30rpx 0}.route-stop{font-size:24rpx;padding:10rpx 12rpx;background:#f5f0e2}.route-stop.current{background:#62756a;color:white}.page-end{text-align:center;margin:50rpx 0 0;font-size:23rpx;color:#a49b88;letter-spacing:5rpx}.overlay{position:fixed;inset:0;background:rgba(32,34,29,.45);z-index:99;display:flex;align-items:flex-end}.drawer{width:100%;background:#f4efe3;border-radius:24rpx 24rpx 0 0;padding:24rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-sizing:border-box}.drawer-scroll{height:68vh}.small{font-size:38rpx}.progress-row{border-bottom:1rpx solid #d5ccb8;padding:12rpx 0}.audio-row{margin:20rpx 0}

.ruins-line{position:absolute;inset:0;background:#e9e2cc}.column{position:absolute;bottom:60rpx;width:35rpx;height:170rpx;border:3rpx solid #827d64;background:repeating-linear-gradient(90deg,#ccc5ac 0,#ccc5ac 4rpx,#dfd7bc 5rpx,#dfd7bc 9rpx)}.c1{left:12%;height:140rpx}.c2{left:31%;height:205rpx}.c3{right:31%;height:205rpx}.c4{right:12%;height:130rpx}.arch{position:absolute;width:27%;height:100rpx;left:36.5%;bottom:185rpx;border:10rpx solid #9c957e;border-bottom:0;border-radius:90rpx 90rpx 0 0}.ruins-line text{position:absolute;bottom:12rpx;width:100%;text-align:center;font-size:22rpx;color:#82765f}

.canvas-page{height:auto;min-height:100vh}

.letter-stage{flex:1;height:0;min-height:0}

.letter-audio{padding:8rpx 24rpx;background:#f4efe3;flex-shrink:0}

/* Incremental field tools: retain the existing paper, ink and typography. */
.history-link{color:#486e65;border-bottom:2rpx solid #7b9488;font-weight:600}.history-levels{display:flex;gap:12rpx;flex-wrap:wrap;margin:24rpx 0}.history-levels .level-active{background:#627d77;color:#fff}.nav-float{position:fixed;z-index:80;width:56px;height:64px;border:1px solid #b9b19b;border-radius:28px;background:#f4efe3;box-shadow:0 4rpx 18rpx #302f2926;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#486e65;font-size:22rpx}.nav-symbol{width:56rpx;height:56rpx;background:url("data:image/svg+xml;base64,") no-repeat center/contain}.field-map{width:100%;height:380rpx;border-radius:12rpx;margin:20rpx 0}.route-current{padding:24rpx;background:#e7e8db;border-radius:12rpx;margin-bottom:20rpx}.route-stop{display:flex;align-items:center;gap:22rpx;padding:22rpx 0;border-bottom:1rpx solid #d8d0be}.route-number{border:1rpx solid #a7b3a5;color:#627d77;width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border-radius:50%}.route-copy{display:flex;flex:1;flex-direction:column}.route-active{color:#486e65;font-weight:600}.route-active .route-number{background:#627d77;color:#fff}

.history-back{margin:0 0 20rpx;display:inline-flex;align-self:flex-start;align-items:center;min-height:76rpx;padding:16rpx 28rpx;font-size:26rpx;background:#f9f5ec;border:1rpx solid #c5baa2;border-radius:6rpx;color:#746746}.history-section{padding-top:30rpx;border-top:1rpx solid #d8d0be;margin-top:24rpx}.history-level-title{display:flex;align-items:center;gap:16rpx;color:#486e65;font-weight:600;margin-bottom:22rpx}.history-level-number{display:inline-block;width:42rpx;height:42rpx;line-height:42rpx;text-align:center;background:#e7e8db;border-radius:50%}.history-end{display:block;text-align:center;margin:30rpx 0}

.interaction-module{margin:36rpx 0;padding:30rpx 26rpx;background:#ecebdf;border:1rpx solid #c8cebf;border-radius:16rpx}.interaction-heading{font-size:30rpx;font-weight:600;color:#486e65;border-bottom:1rpx solid #c8cebf;padding-bottom:22rpx;margin-bottom:26rpx}.interaction-module .activity{margin-top:24rpx}.interaction-actions{margin-top:30rpx;padding-top:22rpx;border-top:1rpx solid #c8cebf}.interaction-module .prop{margin-top:0}.interaction-copy .paragraph{font-size:28rpx;line-height:1.85}

/* Field readability and clear task hierarchy; retain the paper palette. */
.task-summary{padding:0 0 24rpx;margin-bottom:24rpx;border-bottom:1rpx solid #c8cebf}.task-label{display:block;font-size:24rpx;color:#58665d;margin-bottom:12rpx}.task-title{display:block;font-size:32rpx;font-weight:600;line-height:1.6;color:#334e45}.task-summary .caption{margin-bottom:0}.caption{color:#676458;font-size:26rpx}.eyebrow{color:#716650}.interaction-actions .text-button{min-height:88rpx}.interaction-module .primary{min-height:96rpx}.paper{padding-bottom:170rpx}.route-strip .route-stop{display:inline-block;padding:10rpx 14rpx;border:0}.history-levels .chip{min-height:76rpx;padding:16rpx 30rpx;font-size:26rpx!important;display:flex;align-items:center;justify-content:center;border-radius:6rpx;background:#f9f5ec;border:1rpx solid #c5baa2;color:#716346}

.restart-screen{flex:1;height:0}.restart-paper{padding:76rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));font-family:serif}.restart-eyebrow{color:#6f7566;font-size:24rpx;letter-spacing:6rpx}.restart-mark{width:130rpx;height:130rpx;border:2rpx solid #a79977;color:#85774f;display:flex;align-items:center;justify-content:center;font-size:42rpx;letter-spacing:8rpx;margin:60rpx 0 40rpx;transform:rotate(-4deg)}.restart-title{white-space:pre-line;font-size:52rpx;line-height:1.55;color:#344b40}.restart-prose{display:block;white-space:pre-line;font-size:30rpx;line-height:2;margin-top:30rpx}.restart-rule{width:76rpx;height:2rpx;background:#a79977;margin:44rpx 0}.restart-note{display:block;white-space:pre-line;font-size:25rpx;line-height:1.8;color:#706c5e;margin-bottom:36rpx}.restart-cancel{width:100%;margin-top:20rpx!important}

.narration-bar{flex-shrink:0;padding:8rpx 24rpx 12rpx;background:#f4efe3;border-bottom:1rpx solid #d8d0be}.narration-heading{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:#50695e;letter-spacing:2rpx}.mode-switch{font-size:23rpx!important;min-height:58rpx!important;padding:8rpx 14rpx!important}.narration-countdown{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;color:#536e60}.narration-hint{display:block;font-size:24rpx;color:#756c5a;line-height:1.6}.mode-overlay{position:fixed;inset:0;z-index:150;background:rgba(32,40,32,.48);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}.mode-paper{width:100%;max-width:650rpx;max-height:85vh;overflow:auto;background:#f4efe3;padding:44rpx 32rpx;border:1rpx solid #c8bea8;border-radius:12rpx;box-shadow:0 18rpx 70rpx #24332633}.mode-title{font-size:38rpx;line-height:1.6;margin:20rpx 0 32rpx}.mode-choice{display:block;width:100%;text-align:left;border:1rpx solid #a9b6a5;background:#ebeddf;color:#344f43;padding:26rpx!important;margin-top:20rpx!important}.mode-choice-title{display:block;font-size:32rpx;margin-bottom:10rpx}.mode-choice-copy{display:block;font-size:25rpx;line-height:1.8;color:#6b7061}
