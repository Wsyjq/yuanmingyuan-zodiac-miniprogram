.p21-page{height:100vh;display:flex;flex-direction:column;background:#f4efe3;color:#302f29;font-family:serif;box-sizing:border-box;font-size:30rpx}.p21-page button{font-family:inherit;border-radius:6rpx;box-sizing:border-box;font-size:28rpx;line-height:1.6;margin:0}.p21-page button::after{border:0}.toolbar{display:flex;align-items:center;justify-content:space-between;flex-shrink:0;padding:12rpx 24rpx;border-bottom:1rpx solid #cfc5af;background:#ede6d5}.brand{font-size:30rpx;letter-spacing:6rpx}.text-button{background:transparent;color:#746746;padding:12rpx;min-height:68rpx}.reading{flex:1;height:0;min-height:0}.paper{padding:48rpx 38rpx 70rpx}.eyebrow{font-family:sans-serif;font-size:22rpx;letter-spacing:3rpx;color:#887c65}.title{font-size:48rpx;line-height:1.4;margin:18rpx 0 38rpx;font-weight:600;letter-spacing:3rpx}.seal{display:inline-block;margin-left:22rpx;padding:2rpx 6rpx;border:2rpx solid #a45442;color:#a45442;font-size:20rpx;vertical-align:middle;transform:rotate(-5deg)}.paragraph{display:block;margin:0 0 28rpx;line-height:1.95;white-space:pre-wrap}.subheading{display:block;font-size:32rpx;font-weight:600;margin:14rpx 0 24rpx}.caption{display:block;color:#7d796c;line-height:1.7;font-size:24rpx;margin:12rpx 0}.prop{border-left:5rpx solid #89734d;padding:22rpx 24rpx;margin:24rpx 0 34rpx;background:#e8dfca}.prop-title{font-size:24rpx;color:#73623e;letter-spacing:4rpx;margin-bottom:12rpx}.prop-item text{display:block;line-height:1.8}.prop-what{font-weight:600}.activity{padding:24rpx 0;margin:16rpx 0;border-top:1rpx solid #cbbfa8}.choices{display:flex;flex-direction:column;gap:16rpx;margin:30rpx 0}.choice,.secondary{background:#f9f5ec;border:1rpx solid #b7ad96;padding:24rpx 28rpx;text-align:left;width:100%;margin:10rpx 0!important}.selected{background:#ddd6bd!important;border-color:#786c49!important;color:#383e31}.choice[disabled],.pattern[disabled]{color:#7c7769}.terms,.pieces{display:flex;flex-wrap:wrap;gap:12rpx;margin:22rpx 0}.chip{background:#eae3d2;color:#716346;font-size:24rpx!important;padding:14rpx 20rpx;border:1rpx solid #c5baa2}.footer{flex-shrink:0;padding:18rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #cfc5af;background:#f4efe3}.primary{background:#4a615a;color:#fffdf7;padding:24rpx;width:100%;font-size:30rpx!important}.primary[disabled]{background:#8f9a93;color:#fff}.skip{width:100%;font-size:24rpx!important;min-height:50rpx}.notice,.error{padding:20rpx 24rpx;background:#ebe2ca;line-height:1.6;font-size:26rpx;margin:12rpx 0}.error{color:#8b4737;background:#efe0d5}.success{display:block;color:#476f56;padding:12rpx 0}.empty{padding:80rpx 40rpx;color:#746b59}.p21-page input,.p21-page textarea{box-sizing:border-box;width:100%;background:#fffaf0;border:1rpx solid #b8ab91;padding:22rpx;font-family:inherit;font-size:30rpx;margin:18rpx 0;border-radius:4rpx}.p21-page input{height:92rpx}.p21-page textarea{height:220rpx;line-height:1.7}.input-group label{font-size:26rpx}.pattern-grid,.spot-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:24rpx 0}.pattern,.spot{padding:12rpx;background:#e8e0cd;display:flex;flex-direction:column;width:100%;border:1rpx solid #c6bba3!important}.pattern image,.spot image{width:100%;height:190rpx}.pattern text,.spot text{padding-top:12rpx}.illustration{width:100%;margin:26rpx 0}.record{background:#ece4d3;padding:20rpx;margin:20rpx 0;line-height:1.8}.record image{width:100%;max-height:500rpx;display:block}.row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.check-label{display:flex;align-items:center;line-height:1.8;font-size:26rpx;margin:28rpx 0}.check-label checkbox{flex-shrink:0}.pool{position:relative;height:470rpx;background:#d9e2da;border:3rpx solid #8a9685;border-radius:120rpx 120rpx 30rpx 30rpx;padding:28rpx}.stone-front{text-align:center;color:#7f806f;margin:0 0 36rpx;letter-spacing:12rpx}.pool-slot{display:block;background:#f3edda;width:85%;padding:18rpx;margin:16rpx auto!important;font-size:25rpx!important;border:2rpx dashed #a09573!important}.fountain-frame{height:380rpx;position:relative;overflow:hidden;background:#d8d3bd}.ruins{width:100%;height:100%;position:absolute}.reconstruction{position:absolute;inset:0;background:rgba(239,227,196,.4)}.deer{position:absolute;left:45%;top:30%;font-size:40rpx;background:#a39964;padding:14rpx;color:#fff}.dogs{position:absolute;left:15%;bottom:15%;width:70%;text-align:center;color:#4f593d;background:#cec59d;padding:12rpx}.jet{position:absolute;top:30%;height:40%;width:30%;border-top:10rpx solid #8fc6cf;border-radius:100%}.jet-left{left:8%;transform:rotate(30deg)}.jet-right{right:8%;transform:rotate(-30deg)}.reconstruction-label{position:absolute;bottom:6rpx;right:12rpx;font-size:20rpx;color:#535345}.photo-strip{display:flex;gap:14rpx;flex-wrap:wrap}.photo-strip image{width:190rpx;height:190rpx}.relay-photo{width:100%;height:340rpx}.route-card{padding:32rpx 24rpx;background:#e5e4d3;line-height:1.8}.route-destination{font-size:44rpx;margin:14rpx 0}.route-strip{display:flex;flex-wrap:wrap;gap:12rpx;margin:30rpx 0}.route-stop{font-size:24rpx;padding:10rpx 12rpx;background:#f5f0e2}.route-stop.current{background:#62756a;color:white}.page-end{text-align:center;margin:50rpx 0 0;font-size:23rpx;color:#a49b88;letter-spacing:5rpx}.overlay{position:fixed;inset:0;background:rgba(32,34,29,.45);z-index:99;display:flex;align-items:flex-end}.drawer{width:100%;background:#f4efe3;border-radius:24rpx 24rpx 0 0;padding:24rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-sizing:border-box}.drawer-scroll{height:68vh}.small{font-size:38rpx}.progress-row{border-bottom:1rpx solid #d5ccb8;padding:12rpx 0}.audio-row{margin:20rpx 0}

.ruins-line{position:absolute;inset:0;background:#e9e2cc}.column{position:absolute;bottom:60rpx;width:35rpx;height:170rpx;border:3rpx solid #827d64;background:repeating-linear-gradient(90deg,#ccc5ac 0,#ccc5ac 4rpx,#dfd7bc 5rpx,#dfd7bc 9rpx)}.c1{left:12%;height:140rpx}.c2{left:31%;height:205rpx}.c3{right:31%;height:205rpx}.c4{right:12%;height:130rpx}.arch{position:absolute;width:27%;height:100rpx;left:36.5%;bottom:185rpx;border:10rpx solid #9c957e;border-bottom:0;border-radius:90rpx 90rpx 0 0}.ruins-line text{position:absolute;bottom:12rpx;width:100%;text-align:center;font-size:22rpx;color:#82765f}
