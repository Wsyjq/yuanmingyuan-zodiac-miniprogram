.p21-page{height:100vh;display:flex;flex-direction:column;background:#f4efe3;color:#302f29;font-family:serif;box-sizing:border-box;font-size:30rpx}.p21-page button{font-family:inherit;border-radius:6rpx;box-sizing:border-box;font-size:28rpx;line-height:1.6;margin:0}.p21-page button::after{border:0}.toolbar{display:flex;align-items:center;justify-content:space-between;flex-shrink:0;padding:12rpx 24rpx;border-bottom:1rpx solid #cfc5af;background:#ede6d5}.brand{font-size:30rpx;letter-spacing:6rpx}.text-button{background:transparent;color:#746746;padding:12rpx;min-height:68rpx}.reading{flex:1;height:0;min-height:0}.paper{padding:48rpx 38rpx 70rpx}.eyebrow{font-family:sans-serif;font-size:22rpx;letter-spacing:3rpx;color:#887c65}.title{font-size:48rpx;line-height:1.4;margin:18rpx 0 38rpx;font-weight:600;letter-spacing:3rpx}.seal{display:inline-block;margin-left:22rpx;padding:2rpx 6rpx;border:2rpx solid #a45442;color:#a45442;font-size:20rpx;vertical-align:middle;transform:rotate(-5deg)}.paragraph{display:block;margin:0 0 28rpx;line-height:1.95;white-space:pre-wrap}.subheading{display:block;font-size:32rpx;font-weight:600;margin:14rpx 0 24rpx}.caption{display:block;color:#7d796c;line-height:1.7;font-size:24rpx;margin:12rpx 0}.prop{border-left:5rpx solid #89734d;padding:22rpx 24rpx;margin:24rpx 0 34rpx;background:#e8dfca}.prop-title{font-size:24rpx;color:#73623e;letter-spacing:4rpx;margin-bottom:12rpx}.prop-item text{display:block;line-height:1.8}.prop-what{font-weight:600}.activity{padding:24rpx 0;margin:16rpx 0;border-top:1rpx solid #cbbfa8}.choices{display:flex;flex-direction:column;gap:16rpx;margin:30rpx 0}.choice,.secondary{background:#f9f5ec;border:1rpx solid #b7ad96;padding:24rpx 28rpx;width:100%;margin:10rpx 0!important}
.choice{text-align:left}
