.walk { position: relative; }
.sheet, .nav-page {
  height: 100%;
  box-sizing: border-box;
  padding: 48rpx 128rpx 240rpx 48rpx;
}
.nav-page { padding-right: 48rpx; }
.walk button::after { border: none; }
.dock-skip { transform: none; }
.page-no {
  color: var(--olive);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.line {
  font-size: 32rpx;
  line-height: 1.75;
  color: var(--ink);
  margin-bottom: 28rpx;
}
.prop {
  margin: 8rpx 0 32rpx;
  color: var(--olive);
}
.choice {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 96rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  text-align: left;
  line-height: 1.45;
  color: var(--ink);
  background: rgba(255, 252, 245, 0.55);
  border: 2rpx solid rgba(70, 56, 42, 0.35);
  border-radius: 8rpx;
  font-size: 30rpx;
}
.choice.on {
  border-color: var(--cinnabar);
  color: var(--cinnabar);
}
.choice.sub { margin-left: 24rpx; width: calc(100% - 24rpx); }
.field { margin-bottom: 24rpx; }
.field-label { font-size: 28rpx; color: var(--ink60); margin-bottom: 12rpx; }
.field-input {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  font-size: 34rpx;
  color: var(--ink);
  background: rgba(255, 252, 245, 0.7);
  border: 2rpx solid rgba(70, 56, 42, 0.35);
  border-radius: 8rpx;
}
.again { margin-top: 8rpx; }
.edge {
  position: fixed;
  right: 16rpx;
  top: 160rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.edge-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  line-height: 96rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink);
  background: rgba(244, 237, 220, 0.94);
  border: 2rpx solid rgba(70, 56, 42, 0.4);
  border-radius: 48rpx;
}
.nav-page { display: flex; flex-direction: column; justify-content: center; }
.nav-kicker { color: var(--olive); letter-spacing: 6rpx; font-size: 24rpx; }
.nav-title { margin: 24rpx 0 12rpx; font-size: 48rpx; color: var(--ink); }
.nav-distance { margin-bottom: 48rpx; color: var(--ink60); font-size: 28rpx; }
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(244, 237, 220, 0.94);
  box-sizing: border-box;
}
.dock-skip, .dock-go { flex: 1; min-height: 96rpx; }
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(46, 31, 13, 0.28);
  display: flex;
  align-items: flex-end;
}
.panel {
  width: 100%;
  max-height: 78vh;
  overflow: auto;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 2rpx solid rgba(70, 56, 42, 0.3);
}
.panel-title { font-size: 36rpx; margin-bottom: 24rpx; color: var(--ink); }

.progress-block { margin-bottom: 12rpx; }

.terms { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 8rpx 0 28rpx; }
.term {
  margin: 0;
  padding: 8rpx 18rpx;
  font-size: 26rpx;
  color: var(--patina, #4A6B64);
  background: transparent;
  border-bottom: 2rpx solid var(--patina, #4A6B64);
  border-radius: 0;
  line-height: 1.4;
}
.portrait, .shot { width: 100%; margin: 12rpx 0 28rpx; border-radius: 8rpx; }
.portrait { animation: rise-in 1.6s ease forwards; }
@keyframes rise-in { from { opacity: 0; } to { opacity: 1; } }

.spots, .figures, .beasts { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.spot, .figure, .beast {
  width: calc(50% - 8rpx);
  margin: 0;
  padding: 12rpx;
  box-sizing: border-box;
  background: rgba(255, 252, 245, 0.55);
  border: 2rpx solid rgba(70, 56, 42, 0.35);
  border-radius: 8rpx;
  color: var(--ink);
  text-align: center;
  font-size: 26rpx;
  line-height: 1.4;
}
.spot image, .figure image { width: 100%; height: 180rpx; display: block; margin-bottom: 8rpx; }
.spot.on, .figure.on, .beast.on { border-color: var(--cinnabar); color: var(--cinnabar); }
.beast { display: flex; flex-direction: column; align-items: center; min-height: 120rpx; }
.beast-name { font-size: 30rpx; }
.beast-range { font-size: 22rpx; color: var(--ink60); }
.beast.finale { animation: jet 0.6s ease forwards; opacity: 0; }
.beast.finale:last-of-type { animation-name: jet-all; }
@keyframes jet { to { opacity: 1; } }
@keyframes jet-all { to { opacity: 1; border-color: var(--cinnabar); } }

.fountain { position: relative; height: 220rpx; margin: 12rpx 0 28rpx; animation: dry 2.4s ease 1.2s forwards; }
.pool {
  position: absolute; left: 10%; right: 10%; bottom: 24rpx; height: 72rpx;
  border: 2rpx solid rgba(70, 56, 42, 0.45); border-radius: 0 0 80rpx 80rpx;
}
.jet {
  position: absolute; left: 50%; bottom: 90rpx; width: 8rpx; height: 90rpx;
  margin-left: -4rpx; background: rgba(74, 107, 100, 0.7);
}
@keyframes dry { to { opacity: 0; } }

.slot { background: rgba(244, 237, 220, 0.9); }
