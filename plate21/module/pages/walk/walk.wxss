.review-resume{background:#f9f5ec;border:1rpx solid #b7ad96;border-radius:6rpx;padding:20rpx 48rpx;font-size:28rpx;color:#746746;min-height:76rpx;display:flex;align-items:center;justify-content:center;position:relative}.selected{background:#ddd6bd!important;border-color:#786c49!important;color:#383e31}.choice[disabled],.pattern[disabled]{color:#7c7769}.terms,.pieces{display:flex;flex-wrap:wrap;gap:12rpx;margin:22rpx 0}.chip{background:#eae3d2;color:#716346;font-size:24rpx!important;padding:14rpx 20rpx;border:1rpx solid #c5baa2}.footer{flex-shrink:0;padding:18rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #cfc5af;background:#f4efe3}.primary{background:#4a615a;color:#fffdf7;padding:24rpx;width:100%;font-size:30rpx!important}.primary[disabled]{background:#8f9a93;color:#fff}.skip{width:100%;font-size:24rpx!important;min-height:50rpx}.notice,.error{padding:20rpx 24rpx;background:#ebe2ca;line-height:1.6;font-size:26rpx;margin:12rpx 0}.error{color:#8b4737;background:#efe0d5}.success{display:block;color:#476f56;padding:12rpx 0}.empty{padding:80rpx 40rpx;color:#746b59}.p21-page input,.p21-page textarea{box-sizing:border-box;width:100%;background:#fffaf0;border:1rpx solid #b8ab91;padding:22rpx;font-family:inherit;font-size:30rpx;margin:18rpx 0;border-radius:4rpx}.p21-page input{height:92rpx;line-height:48rpx}
.p21-page .ph-line{font-size:30rpx;line-height:48rpx;color:#a49b88}
