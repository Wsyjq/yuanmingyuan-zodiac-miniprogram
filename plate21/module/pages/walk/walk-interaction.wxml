<view class="interaction-module">
  <view wx:if="{{screen.task}}" class="task-summary"><text class="task-title">{{screen.task.title}}</text><text class="caption">{{screen.task.instruction}}</text></view>
  <view class="interaction-heading">{{screen.interaction.title}}</view>
      <view wx:if="{{screen.prop.items.length}}" class="prop">
        <view class="prop-title">{{screen.prop.title || '实体道具'}}</view>
        <view wx:for="{{screen.prop.items}}" wx:key="what" class="prop-item">
          <text class="prop-what">取出 · {{item.what}}</text><text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index">{{step}}</text><text class="caption">{{item.returnWhen}}</text>
        </view>
      </view>
  <view class="interaction-copy"><text wx:for="{{interactionText}}" wx:for-item="paragraph" wx:key="index" class="paragraph"><text wx:for="{{paragraph}}" wx:key="index" class="{{item.key ? 'history-link' : ''}}" data-key="{{item.key}}" bindtap="onOpenCard">{{item.text}}</text></text></view>
  <block wx:if="{{screen.screenPart === 'activity'}}">
      <view wx:if="{{screen.choices.length && playId !== 'quiz-pattern'}}" class="choices"><button wx:for="{{screen.choices}}" wx:key="id" class="choice {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onChoice" disabled="{{review}}">{{item.label}}</button></view>
      <view wx:if="{{playId === 'quiz-envelope'}}" class="input-group"><label>拼出的三个字</label><input data-key="text" value="{{ui.text}}" maxlength="20" placeholder="输入地点名称" placeholder-class="ph-line" bindinput="onInput" disabled="{{review}}"/></view>
      <view wx:if="{{playId === 'listen-nfc'}}" class="activity">
        <view class="subheading">听见谐奇趣</view><text class="caption">把手机靠近音乐贴片，或点下方按钮直接听。是否读到贴片不影响考察。</text>
        <audio-clip id="soundscape" src="{{soundSrc}}" kind="clip" active="{{pageVisible && !drawer}}" label="直接听 · 声景" bind:ended="onHeard" bind:error="onSoundError"/>
        <button wx:if="{{!ui.heard && !review}}" class="secondary" bindtap="onHeard">我已听过，确认完成听音</button><text class="caption">{{nfcStatus}}</text><text wx:if="{{ui.heard}}" class="success">已听完这一段</text>
      </view>
      <view wx:if="{{playId === 'prop-flip' && !ui.flipped}}" class="activity"><text>先翻开实体黄花阵图，确认后阅读背后的故事。</text></view>
      <view wx:if="{{playId === 'photo-pavilion'}}" class="activity">
        <button disabled="{{review}}" wx:if="{{!ui.arrived}}" class="choice" bindtap="onArrived">我已到达中心亭</button>
        <block wx:if="{{ui.arrived}}">
          <view class="subheading">留一份自己的观察</view><text class="caption">可拍一张或多张照片，也可以用文字记录。</text>
          <view class="spot-grid"><button wx:for="{{screen.spots}}" wx:key="id" data-id="{{item.id}}" bindtap="onSpot" disabled="{{review}}" class="spot {{item.on ? 'selected' : ''}}"><image src="{{item.src}}" mode="aspectFit"/><text>{{item.title}}</text></button></view>
          <button class="secondary" bindtap="onAddPhoto" disabled="{{busy || review}}">拍摄或选择照片</button>
          <view class="record" wx:for="{{records}}" wx:key="id"><image wx:if="{{item.kind === 'photo'}}" src="{{item.filePath}}" mode="aspectFit" data-src="{{item.filePath}}" bindtap="onPreview"/><text wx:else>{{item.text}}</text><view wx:if="{{!review}}" class="row"><button wx:if="{{item.kind === 'photo'}}" class="text-button" data-id="{{item.id}}" bindtap="onAddPhoto">替换</button><button class="text-button" data-id="{{item.id}}" bindtap="onDeleteRecord">删除</button></view></view>
          <textarea disabled="{{review}}" data-key="note" value="{{ui.note}}" maxlength="500" placeholder="无法拍摄也没关系，写下你看到的细节…" placeholder-class="ph-block" bindinput="onInput"/><button class="text-button" disabled="{{busy || review}}" bindtap="onSaveNote">保存文字记录</button>
          <text wx:if="{{screen.spotDetail}}" class="caption">{{screen.spotDetail}}</text>
        </block>
      </view>
      <view wx:if="{{screen.figures.length}}" class="pattern-grid"><button wx:for="{{screen.figures}}" wx:key="id" data-id="{{item.id}}" bindtap="onChoice" class="pattern {{item.selected ? 'selected' : ''}}" disabled="{{review}}"><image src="{{item.src}}" mode="aspectFit"/><text>{{item.label}}</text></button></view>
      <water-clock wx:if="{{playId === 'quiz-hour'}}" state="{{waterClockState}}" active="{{pageVisible && !drawer}}" bind:change="onWaterClockChange" bind:complete="onWaterClockComplete"/>
      <view wx:if="{{playId === 'prop-dial'}}" class="activity"><checkbox-group bindchange="onConfirmDial"><label class="check-label"><checkbox value="done" checked="{{ui.confirmed}}" disabled="{{review}}" color="#716743"/>我已完成实体转盘操作，准备继续</label></checkbox-group></view>
      <fountain-puzzle wx:if="{{playId === 'place-animals'}}" placed="{{ui.placed}}" active="{{pageVisible && !drawer && !restartScreen}}" read-only="{{review}}" bind:change="onFountainPlacement"/>
      <view wx:if="{{pageId === 'DS2'}}" class="activity">
        <view class="subheading">旧画与眼前</view><view class="fountain-frame">
          <view class="ruins-line"><view class="column c1"></view><view class="column c2"></view><view class="arch"></view><view class="column c3"></view><view class="column c4"></view><text>抬头看看，眼前还留下了什么</text></view>
          <view class="reconstruction" style="opacity:{{1 - (ui.fountainProgress || 0) / 100}}"><view class="jet jet-left"></view><view class="jet jet-right"></view><view class="deer">鹿</view><view class="dogs">猎狗 · 猎狗 · 猎狗</view><text class="reconstruction-label"></text></view>
        </view><slider min="0" max="100" value="{{ui.fountainProgress || 0}}" activeColor="#627d77" bindchange="onFade"/><view class="row caption"><text>旧时构件与水流</text><text>眼前遗址</text></view>
      </view>
  </block>
      <view wx:if="{{hint && screen.play}}" class="notice">{{hint}}</view><button wx:if="{{hasHint && !review && screen.play}}" class="text-button" bindtap="onHint">给我一点提示</button>
      <view wx:if="{{ui.again}}" class="error" role="alert">{{ui.feedback || '再观察一下，或选择跳过。'}}</view>
  <button wx:if="{{canExplain && !review && screen.play}}" class="text-button" bindtap="onExplain">想先看解读</button>
  <view wx:if="{{screen.play}}" class="interaction-actions"><button class="primary" bindtap="onPrimary" disabled="{{busy}}" loading="{{busy}}">{{review ? screen.primary : completed && pageId === 'FN4' ? '查看我的作品' : pageId === 'LT8' ? '读完来信，查看作品' : screen.primary || '继续'}}</button><button wx:if="{{screen.showSkip && !review}}" class="text-button skip" bindtap="onSkip" disabled="{{busy}}">{{screen.skipLabel || '这题跳过'}}</button></view>
</view>
