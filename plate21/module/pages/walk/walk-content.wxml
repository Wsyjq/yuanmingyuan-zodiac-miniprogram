    <view class="paper">
      <view class="eyebrow">{{screen.siteTitle || '西洋楼现场考察档案'}} · {{screen.stageLabel}}</view>
      <view class="title">{{screen.title || '第二十一图'}}<text class="seal">考察</text></view>
      <view wx:if="{{review}}" class="notice">正在回看 · 保留原考察结果<button class="text-button" bindtap="onResume">回到当前进度 →</button></view>
      <view wx:if="{{screen.kind === 'nav'}}" class="route-card">
        <text class="eyebrow">前往下一站</text><view class="route-destination">{{screen.siteTitle}}</view>
        <text>{{screen.nav.instruction || '请对照实体地图与现场标识步行。'}}到达后，点击“我到达了”。</text>
        <view class="route-strip"><text wx:for="{{rows}}" wx:key="id" wx:if="{{index > 0 && index < 9}}" class="route-stop {{item.current ? 'current' : ''}}">{{item.title}}</text></view>
        <text class="caption">路线顺序示意，不用于精确定位。蓄水楼为海晏堂北面高台。</text>
      </view>
      <view wx:if="{{screen.prop.items.length && !screen.interaction}}" class="prop">
        <view class="prop-title">{{screen.prop.title || '实体道具'}}</view>
        <view wx:for="{{screen.prop.items}}" wx:key="what" class="prop-item">
          <text class="prop-what">取出 · {{item.what}}</text><text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index">{{step}}</text><text class="caption">{{item.returnWhen}}</text>
        </view>
      </view>
      <text wx:if="{{screen.sectionTitle}}" class="caption">{{screen.sectionTitle}}</text>
      <view wx:if="{{screen.interaction.position === 'before'}}"><include src="walk-interaction.wxml" /></view>
      <view class="narrative"><text wx:for="{{narrative}}" wx:for-item="paragraph" wx:key="index" class="paragraph"><text wx:for="{{paragraph}}" wx:key="index" class="{{item.key ? 'history-link' : ''}}" data-key="{{item.key}}" bindtap="onOpenCard">{{item.text}}</text></text></view>
      <image wx:if="{{screen.portrait}}" src="{{screen.portrait}}" mode="widthFix" class="illustration" data-src="{{screen.portrait}}" bindtap="onPreview"/>
      <image wx:if="{{screen.teacher}}" src="{{screen.teacher}}" mode="widthFix" class="illustration"/>
      <view class="audio-row" wx:if="{{narrClips.length}}"><audio-clip clips="{{narrClips}}" active="{{pageVisible && !clockPlaying && !drawer}}" label="听这一段" /></view>
      <view wx:if="{{screen.terms.length}}" class="terms"><button wx:for="{{screen.terms}}" wx:key="key" class="chip" data-key="{{item.key}}" bindtap="onOpenCard">史料 · {{item.label}}</button></view>
      <view wx:if="{{screen.interaction && screen.interaction.position !== 'before'}}"><include src="walk-interaction.wxml" /></view>
      <view wx:if="{{pageId === 'FN1'}}" class="activity"><view class="subheading">这一次，我留下了</view><view class="photo-strip"><image wx:for="{{records}}" wx:key="id" wx:if="{{item.kind === 'photo'}}" src="{{item.filePath}}" mode="aspectFill" data-src="{{item.filePath}}" bindtap="onPreview"/></view><text wx:if="{{!records.length}}" class="caption">还没有照片或文字记录。完成署名后，也可以在个人作品中补录。</text><text wx:for="{{records}}" wx:key="id" wx:if="{{item.kind !== 'photo'}}" class="paragraph">{{item.text}}</text></view>
      <view wx:if="{{pageId === 'FN4'}}" class="activity"><label>绘制者署名</label><text class="caption">绘制者：{{screen.signature.name}}
绘制日期：{{screen.signature.date}}
版本编号：{{screen.signature.edition}}</text><input wx:if="{{!completed}}" data-key="name" value="{{ui.name}}" maxlength="40" placeholder="写下你的名字，也可以留白" bindinput="onInput" disabled="{{completed}}"/><text class="caption">{{completed ? '考察记录已保存。' : '完成后生成个人作品。'}}次日来信将于北京时间零点后开放，可晚些回来阅读。</text></view>
      <view wx:if="{{pageId === 'LT6'}}" class="activity"><view class="subheading">探寻者的接力记录</view>
        <text wx:if="{{relayState === 'loading'}}">正在读取…</text><text wx:if="{{relayState === 'empty'}}">暂时没有可公开的接力记录。你仍可以留下自己的私人记录。</text><text wx:if="{{relayState === 'unavailable'}}">接力服务尚未接入，当前没有可展示的游客投稿。</text><text wx:if="{{relayState === 'failed'}}">暂时没有读到接力记录，请重试。</text>
        <view wx:for="{{relayItems}}" wx:key="id" class="record"><text class="caption">{{item.from}}</text><image wx:if="{{item.kind === 'photo' && item.url}}" src="{{item.url}}" mode="widthFix" data-src="{{item.url}}" bindtap="onPreview"/><text>{{item.text}}</text></view><button class="text-button" bindtap="loadRelay">重新读取</button>
      </view>
      <view wx:if="{{pageId === 'LT7'}}" class="activity"><view class="subheading">给后来者，也给自己</view>
        <view class="row"><button class="chip" data-kind="text" bindtap="onRelayKind">一句话</button><button class="chip" data-kind="photo" bindtap="onRelayKind">一张照片</button><button class="chip" data-kind="wish" bindtap="onRelayKind">一个心愿</button></view>
        <text class="caption">当前：{{ui.relayKind === 'photo' ? '照片' : ui.relayKind === 'wish' ? '心愿' : '文字'}}</text>
        <view wx:if="{{ui.relayKind === 'photo'}}"><image wx:if="{{ui.relayPath}}" src="{{ui.relayPath}}" mode="aspectFit" class="relay-photo"/><button class="secondary" bindtap="onRelayPhoto">{{ui.relayPath ? '替换照片' : '选择照片'}}</button></view>
        <textarea data-key="relayText" value="{{ui.relayText}}" maxlength="500" placeholder="写下想留住的观察或心愿…" bindinput="onInput"/>
        <button class="secondary" bindtap="onSaveRelay" disabled="{{busy}}">仅私人保存</button><text wx:if="{{ui.relaySaved}}" class="success">私人记录已保存在这份考察档案里</text>
        <checkbox-group bindchange="onRelayConsent"><label class="check-label"><checkbox value="public" checked="{{ui.consent}}" color="#716743"/>我同意将这份内容提交给官方，用于向其他探寻者公开展示。</label></checkbox-group>
        <button class="secondary" bindtap="onSubmitRelay" disabled="{{busy || !ui.consent}}">公开投稿</button><button class="text-button" bindtap="onNewRelay">另写一份</button>
        <view wx:for="{{contributions}}" wx:key="id" class="record"><text>{{item.label}}</text><text wx:if="{{item.reason}}" class="caption">{{item.reason}}</text><view class="row"><button class="text-button" data-id="{{item.id}}" bindtap="onRefreshContribution">检查状态</button><button wx:if="{{item.receiptId && item.status !== 'withdrawn'}}" class="text-button" data-id="{{item.id}}" bindtap="onWithdraw">撤回公开投稿</button></view></view>
      </view>
      <view class="page-end">· {{screen.siteTitle || '第廿一图'}} ·</view>
    </view>
