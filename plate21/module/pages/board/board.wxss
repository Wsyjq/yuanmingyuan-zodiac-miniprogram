/* 考察者留言簿：便签墙 + 留言编辑区 */
.board-page {
  height: 100%;
  overflow: hidden;
  padding: 56rpx 48rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.board-state {
  margin-top: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding: 0 80rpx;
  text-align: center;
}
.board-wax {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-family: "STKaiti", "KaiTi", serif;
  box-shadow: inset 0 0 14rpx rgba(0, 0, 0, 0.22), 0 8rpx 20rpx rgba(166, 58, 46, 0.28);
}
.board-state-text {
  font-size: 28rpx;
  line-height: 2;
  color: var(--ink);
}
.board-back {
  margin-top: 10rpx;
}

/* ---------- 头部 ---------- */
.board-head {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.board-eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--patina);
}
.board-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--ink);
}
.board-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--ink60);
}
.board-divider {
  width: 240rpx;
  margin: 24rpx 0;
}
.board-intro {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--ink);
}

/* ---------- 留言便签（自己的 + 前人） ---------- */
.board-note {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 30rpx 32rpx 26rpx;
  background: rgba(244, 237, 220, 0.72);
}
.board-mine {
  margin-top: 40rpx;
  border: 2rpx solid rgba(166, 58, 46, 0.55);
}
.board-note-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink);
  word-break: break-all;
}
.board-note-foot {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink60);
  text-align: right;
}
.board-mine .board-note-foot {
  color: var(--cinnabar);
}
.board-note-edit {
  position: absolute;
  top: -16rpx;
  right: 24rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--cinnabar);
  background: var(--paper);
  border: 2rpx solid var(--cinnabar);
  border-radius: 999rpx;
}

/* ---------- 留言编辑区 ---------- */
.board-write {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  margin-top: 40rpx;
  padding: 30rpx 32rpx;
}
.board-write-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}
.board-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink);
  background: rgba(255, 252, 244, 0.85);
  border: 2rpx dashed var(--dash);
  border-radius: 6rpx;
}
.board-placeholder {
  color: var(--ink60);
}
.board-count {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--ink60);
  text-align: right;
}
.board-submit {
  margin-top: 24rpx;
}
.board-legal {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--ink60);
  text-align: center;
}

/* ---------- 前人留言墙 ---------- */
.board-wall-title {
  margin-top: 56rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}
.board-wall {
  width: 100%;
  max-width: 620rpx;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}

/* ---------- 回访次级入口 ---------- */
.board-links {
  margin-top: 56rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.board-link {
  padding: 14rpx 34rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--patina);
  border: 2rpx solid var(--dash);
  border-radius: 999rpx;
  background: rgba(244, 237, 220, 0.55);
}
.board-link:active {
  color: var(--ink);
  border-color: var(--patina);
}

/* ---------- 昨日之路（次日回访长卷） ---------- */
.jr-section {
  width: 100%;
  max-width: 620rpx;
  margin-top: 56rpx;
}
.jr-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.jr-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--ink);
}
.jr-intro {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--ink60);
}

/* 横卷条：面板左起右行，底部虚线+铜钉连成路 */
.jr-strip {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}
.jr-track {
  position: relative;
  display: inline-flex;
  align-items: stretch;
  gap: 28rpx;
  padding: 8rpx 8rpx 46rpx;
}
.jr-track::after {
  content: '';
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 26rpx;
  border-top: 3rpx dashed var(--dash);
}
.jr-panel {
  position: relative;
  width: 300rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 18rpx 20rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: rgba(244, 237, 220, 0.5);
  border: 2rpx solid var(--dash);
  border-radius: 8rpx;
}
.jr-panel.jr-on {
  background: rgba(244, 237, 220, 0.85);
  border-color: var(--patina);
}
.jr-node {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #d8b26a, #8a6a2f 70%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25);
}
.jr-plate {
  width: 100%;
  height: 200rpx;
  overflow: hidden;
  border: 1rpx solid rgba(70, 56, 42, 0.35);
  background: var(--paper);
}
.jr-img {
  width: 100%;
  height: 100%;
  mix-blend-mode: multiply;
  filter: sepia(0.28) saturate(0.72) contrast(1.02);
}
.jr-seal {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 92rpx;
  color: var(--patina);
}
.jr-kicker {
  margin-top: 14rpx;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--ink60);
}
.jr-name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}
.jr-chips {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
}
.jr-chip {
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--ink60);
  border: 1rpx solid var(--dash);
  border-radius: 4rpx;
  background: rgba(255, 252, 244, 0.7);
}

/* 详情卡：选中点位的意象句 + 另一半 */
.jr-detail {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  margin-top: 30rpx;
  padding: 28rpx 32rpx;
}
.jr-detail-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--patina);
  text-align: center;
}
.jr-detail-motif {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
  text-align: center;
}
.jr-detail-other {
  margin-top: 18rpx;
  padding-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--ink60);
  text-align: center;
  border-top: 1rpx dashed var(--dash);
}
.jr-hint {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink60);
  text-align: center;
}
