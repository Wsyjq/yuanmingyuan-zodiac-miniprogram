<!-- 考察者留言簿：通关后的档案新增页。留言墙（前人种子池+自己的那句话）+ 留一句 + 回访次级入口 -->
<view class="page page-shell board-page paper-grain paper-real">
  <view wx:if="{{state === 'loading'}}" class="board-state note-hand">翻到新的一页……</view>

  <view wx:elif="{{state === 'notFinished'}}" class="board-state">
    <view class="board-wax">留</view>
    <view class="board-state-text kaiti">完成你的考察之后，这里会多一页。</view>
    <button class="btn-line board-back" bindtap="onBack">返回</button>
  </view>

  <block wx:else>
    <view class="board-head">
      <view class="board-eyebrow">档案 · 新增一页</view>
      <view class="board-title serif">留言簿</view>
      <view class="board-sub">给后来的人</view>
      <view class="hatch-divider board-divider"></view>
      <view class="board-intro kaiti">走完那条路的人，在这里留一句话。后来的人，会读到它。</view>
    </view>

    <!-- 昨日之路：通关次日起出现的回访长卷（当日不渲染、不留预告） -->
    <view wx:if="{{journeyReady}}" class="jr-section">
      <view class="jr-head">
        <view class="board-eyebrow">次日 · 回访</view>
        <view class="jr-title serif">昨日之路</view>
        <view class="board-sub">第廿一图 · 你的一卷</view>
        <view class="jr-intro kaiti">信里说，它在昨天你走过的那条路上。就是这一卷。</view>
      </view>
      <scroll-view class="jr-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="jr-track">
          <view
            wx:for="{{journey}}"
            wx:key="key"
            class="jr-panel {{index === journeyActiveIndex ? 'jr-on' : ''}}"
            data-index="{{index}}"
            bindtap="onPickPoint"
          >
            <view class="jr-plate">
              <image wx:if="{{item.img}}" class="jr-img" src="{{item.img}}" mode="aspectFill" />
              <view wx:else class="jr-seal serif">{{item.seal}}</view>
            </view>
            <view class="jr-kicker note-hand">{{item.kicker}}</view>
            <view class="jr-name serif">{{item.title}}</view>
            <view class="jr-chips" wx:if="{{item.chips.length}}">
              <text class="jr-chip" wx:for="{{item.chips}}" wx:for-item="chip">{{chip}}</text>
            </view>
            <view class="jr-node"></view>
          </view>
        </view>
      </scroll-view>
      <view class="jr-detail clip-card" wx:if="{{journey.length}}">
        <view class="corner tl"></view>
        <view class="corner tr"></view>
        <view class="corner bl"></view>
        <view class="corner br"></view>
        <view class="jr-detail-kicker note-hand">{{journey[journeyActiveIndex].kicker}} · {{journey[journeyActiveIndex].title}}</view>
        <view class="jr-detail-motif kaiti">{{journey[journeyActiveIndex].motif}}</view>
        <view class="jr-detail-other" wx:if="{{journey[journeyActiveIndex].otherHalf}}">{{journey[journeyActiveIndex].otherHalf}}</view>
      </view>
      <view class="jr-hint note-hand">点一处点位，读那一句</view>
    </view>

    <!-- 我的话：已投递展示卡片，可换一句 -->
    <view wx:if="{{mine && !editing}}" class="board-note clip-card board-mine tilt-l">
      <view class="corner tl"></view>
      <view class="corner tr"></view>
      <view class="corner bl"></view>
      <view class="corner br"></view>
      <view class="board-note-text kaiti">{{mine.text}}</view>
      <view class="board-note-foot">—— 你 · 今天</view>
      <view class="board-note-edit" catchtap="onEdit">换一句话</view>
    </view>

    <!-- 留言编辑区 -->
    <view wx:if="{{editing}}" class="board-write clip-card">
      <view class="corner tl"></view>
      <view class="corner tr"></view>
      <view class="corner bl"></view>
      <view class="corner br"></view>
      <view class="board-write-title serif">{{mine ? '换一句话' : '留一句话'}}</view>
      <textarea
        class="board-input kaiti"
        value="{{draftText}}"
        maxlength="50"
        placeholder="写给下一个来到这里的人"
        placeholder-class="board-placeholder"
        bindinput="onInput"
      ></textarea>
      <view class="board-count">{{draftText.length}}/50</view>
      <button class="btn-line board-submit" bindtap="onSubmit" disabled="{{submitting}}">投进档案</button>
      <view class="board-legal">留言经审核后，才会展示给后来的人。</view>
    </view>

    <!-- 前人留言墙 -->
    <view class="board-wall-title serif">先来的人</view>
    <view class="board-wall">
      <view
        wx:for="{{wall}}"
        wx:key="index"
        class="board-note clip-card {{item.tilt}}"
      >
        <view class="corner tl"></view>
        <view class="corner tr"></view>
        <view class="corner bl"></view>
        <view class="corner br"></view>
        <view class="board-note-text kaiti">{{item.text}}</view>
        <view class="board-note-foot">—— {{item.from}} · {{item.date}}</view>
      </view>
    </view>

    <!-- 回访次级入口 -->
    <view class="board-links">
      <view wx:if="{{letterReady}}" class="board-link" bindtap="onOpenLetter">再读一遍那封信</view>
      <view class="board-link" bindtap="onOpenReport">回到考察报告</view>
    </view>
  </block>
</view>
