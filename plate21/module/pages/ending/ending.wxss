/* P16 结尾 / 完结 */

.page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 0 80rpx 52rpx; /* 左侧 52rpx 让位 .binder */
}

/* v1.3 手账：归档编号签（右上角，避让胶囊） */
.page-tag {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  z-index: 3;
}
/* v1.3.1：邮戳贴纸压在编号签左下方，归档封缄感 */
.end-postmark {
  position: absolute;
  top: 28rpx;
  right: 150rpx;
  width: 170rpx;
  height: 120rpx;
  transform: rotate(-8deg);
  opacity: 0.9;
  z-index: 3;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
/* v1.3.1：干花标本贴纸压在视频框左下角 */
.end-botanical {
  position: absolute;
  bottom: -24rpx;
  left: -22rpx;
  width: 180rpx;
  height: 160rpx;
  transform: rotate(-5deg);
  opacity: 0.9;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}

/* v1.3 手账：VID-E01 主图顶边和纸胶带（视频块贴屏顶，胶带收进内侧防裁切） */
.video-block .tape {
  top: 24rpx;
  left: 50%;
  margin-left: -90rpx;
}

/* v1.3 手账：归途批注，靠右落于叙事与完结卡之间 */
.end-note {
  width: 640rpx;
  margin-top: 40rpx;
  text-align: right;
}

/* VID-E01 占位块：双框线（double-frame） */
.video-block {
  position: relative;
  width: 100%;
  height: 62vh;
  box-sizing: border-box;
  background: var(--paper2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
/* IMG-R01 大水法夕照实拍作视频区底图，sepia 统一暖调（video/image 同款） */
.video-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  filter: sepia(0.55) contrast(1.05) brightness(0.95);
  opacity: 0.92;
}
/* 视频区内容提到背景之上 */
.video-block > view, .video-block > image, .video-block > text { position: relative; z-index: 1; }
/* INT-203：播放图标可点（poster 兜底期是主要入口），落印反馈 */
.play-icon {
  width: 96rpx;
  height: 96rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.play-icon:active {
  transform: scale(0.94);
  opacity: 0.85;
}
.video-code {
  margin-top: 32rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--ink60);
}
.video-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink60);
}
.video-skipped {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--dash);
  letter-spacing: 4rpx;
}
.skip-btn {
  position: absolute;
  top: 100rpx;
  right: 40rpx;
  z-index: 2;
  padding: 8rpx 28rpx;
  border: 1rpx solid var(--ink60);
  border-radius: 4rpx;
  font-size: 24rpx;
  color: var(--ink60);
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
}
.skip-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}
.skip-btn:active {
  opacity: 0.7;
}

/* 三段结尾叙事 */
.narr {
  width: 640rpx;
  margin-top: 56rpx;
}
.narr-p {
  font-size: 28rpx;
  line-height: 2;
  color: var(--ink);
}
.narr-div {
  width: 200rpx;
  margin: 36rpx auto;
}

/* 完结卡 */
.end-card {
  width: 640rpx;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.end-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}
.end-actions {
  margin-top: 48rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.end-btn {
  width: 420rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
