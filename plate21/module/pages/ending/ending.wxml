<!-- v1.3.1 手账：左侧活页装订孔列（移到 .page 外，避免 flex 影响 fixed） -->
<view class="page paper-grain">

  <!-- v1.3 手账：归档编号签 -->
  <view class="plateno page-tag">No.016</view>
  <!-- v1.3.1 手账：邮戳贴纸压在编号签旁，归档封缄感 -->

  <!-- VID-E01 离场视频区：真视频就位用 <video>，未就位 poster 兜底显示 IMG-R01 夕照 -->
  <view class="video-block">
    <video wx:if="{{videoSrc}}" id="endVideo" class="video-bg" src="{{videoSrc}}" poster="/plate21/module/assets/img/IMG-R01.jpg" objectFit="cover" controls></video>
    <image wx:else class="video-bg" src="/plate21/module/assets/img/IMG-R01.jpg" mode="aspectFill" />
    <!-- v1.3.1 手账：干花标本贴纸压在视频框左下角，标本感 -->
    <image class="play-icon" src="/plate21/module/assets/img/icons/ic-play-ink.png" mode="aspectFit" bindtap="onPlay" />
    <text class="video-code">VID-E01</text>
    <text class="video-desc">结尾离场视频 · 30-60s</text>
    <text wx:if="{{skipped}}" class="video-skipped">已跳过</text>
    <button wx:if="{{!skipped}}" class="skip-btn" bindtap="onSkip">
      <image class="skip-icon" src="/plate21/module/assets/img/icons/ic-skip-forward-ink60.png" mode="aspectFit" />
      <text>跳过</text>
    </button>
  </view>

  <!-- 飞书 v3 rev5614：正文至结局与彩蛋止，离场页只保留完结卡与离场视频位 -->

  <!-- 完结卡 -->
  <view class="end-card">
    <view class="end-title serif">—— 第廿一图 · 完 ——</view>
    <view class="end-actions">
      <button class="btn-line end-btn" bindtap="goHandbook">回看考察手册</button>
      <button class="btn-seal end-btn" bindtap="onBack">返 回</button>
    </view>
  </view>

  <!-- INT-203 终章仪式感：进页落「考察完结」朱砂印 -->
  <stamp-toast id="stamp" />

</view>
