<nav-back wx:if="{{!touring}}" />
<page-overlays />
<bgm-ambience />
<view class="page page-shell task-shell paper-grain">
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
    <view class="task-kicker">西洋楼入口 · 本题</view>
    <view class="task-diary">
      <view class="task-lead kaiti"><gloss-text parts="{{leadParts}}" bind:glossary="onGlossary" /></view>
      <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" autoplay="{{true}}" compact="{{true}}" icon="{{true}}" kind="voice" label="听这段" />
    </view>

    <view wx:if="{{!solved}}">
      <view class="prop-title serif">我打开了地图，从上面可以看出来西洋楼的地理位置。</view>
      <map class="s1-map" longitude="{{mapLng}}" latitude="{{mapLat}}" scale="15" markers="{{markers}}" polyline="{{polyline}}" enable-rotate="{{false}}" enable-3D="{{false}}"></map>
      <view class="q-title serif">西洋楼在圆明三园中的长春园（　）部</view>
      <view class="opts">
        <view
          wx:for="{{options}}"
          wx:key="key"
          class="opt {{selected === item.key ? 'opt-sel' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelect"
          role="button"
          aria-pressed="{{selected === item.key}}"
        >
          <text class="opt-key">{{item.key}}</text>
          <text class="opt-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="result" wx:if="{{solved}}">
      <view class="result-mark">答案：东北</view>
      <view class="task-lead"><gloss-text parts="{{revealParts}}" bind:glossary="onGlossary" /></view>
      <view class="task-lead">{{followup}}</view>
    </view>
  </scroll-view>
  <view class="task-dock">
    <view wx:if="{{hintText && !solved}}" class="hint">{{hintText}}</view>
    <button wx:if="{{!solved}}" class="btn-seal" bindtap="onConfirm" disabled="{{!selected}}">提交</button>
    <button wx:else class="btn-seal" bindtap="onGoNext" disabled="{{advancing}}">{{advancing ? '正在前往……' : '前往谐奇趣'}}</button>
  </view>

  <!-- 术语史料卡（「西洋楼」SL-02、「长春园」SL-05 点入） -->
  <history-card
    wx:if="{{gloss}}"
    visible="{{!!gloss}}"
    title="{{gloss.title}}"
    source="{{gloss.source}}"
    lines="{{gloss.lines}}" layered="{{gloss.layered}}" image="{{gloss.image}}" caption="{{gloss.caption}}"
    btn-text="学到了"
    bind:next="onGlossClose"
    bind:close="onGlossClose"
  />
</view>
<coach-spot
  class="coach-host"
  style="top: {{coachWin.top}}px; left: {{coachWin.left}}px; width: {{coachWin.windowWidth}}px; height: {{coachWin.windowHeight}}px;"
  visible="{{showCoach}}"
  closing="{{coachClosing}}"
  index="{{coachIndex}}"
  total="{{coachSteps.length}}"
  step="{{coachStep}}"
  hole="{{coachHole}}"
  win="{{coachWin}}"
  bind:next="onCoachNext"
  bind:skip="onCoachSkip"
/>
