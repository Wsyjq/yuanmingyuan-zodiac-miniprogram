page{background:var(--paper)}
.page{height:100%;overflow:hidden;box-sizing:border-box;padding:calc(144rpx + env(safe-area-inset-top)) 44rpx 84rpx 60rpx;position:relative}
.title{color:var(--patina);font-size:42rpx;font-weight:700;letter-spacing:4rpx}
.tag-no-fixed{position:absolute;top: 88rpx; right: 210rpx}
.title-div{margin:20rpx 0 28rpx}
.lead{font-size:32rpx;line-height:1.8;color:var(--ink);margin-bottom:36rpx}
.prop-card{margin-top:56rpx;padding:56rpx 34rpx 26rpx}
.s1-map{display:block;width:100%;height:420rpx;margin:16rpx 0 8rpx;border:4rpx solid rgba(70,56,42,.45)}
.opts{display:flex;flex-direction:column;gap:20rpx}
.opt{display:flex;align-items:center;min-height:96rpx;padding:24rpx 28rpx;box-sizing:border-box;background:var(--paper);border:4rpx solid rgba(70,56,42,.55)}
.opt-sel{border-color:var(--cinnabar);background:rgba(166,58,46,.14);box-shadow:inset 10rpx 0 0 var(--cinnabar)}
.opt-key{font-size:32rpx;font-weight:700;color:var(--cinnabar);margin-right:20rpx}
.opt-text{font-size:32rpx;color:var(--ink);font-weight:600}
.prop-label{white-space:nowrap}
.prop-title{color:var(--ink-deep);font-size:40rpx;font-weight:700;line-height:1.5}
.step-row{display:flex;align-items:flex-start;padding:16rpx 0}
.step-no{width:46rpx;height:46rpx;line-height:46rpx;text-align:center;border:2rpx solid var(--ink-deep);border-radius:50%;font-family:"Courier New",monospace;font-size:22rpx;flex:none;margin-right:20rpx;color:var(--ink-deep)}
.step-copy{font-size:28rpx;line-height:1.65;padding-top:2rpx;color:var(--ink)}
.hint-area{margin-top:34rpx}
.hint-btn{display:inline-block;width:auto;min-height:0;line-height:1.4;margin:0 18rpx 18rpx 0;padding:14rpx 22rpx;border:2rpx dashed var(--olive);border-radius:0;background:rgba(111,114,72,.04);color:var(--olive);font-size:26rpx}
.hint-btn:after{border:0}
.hint-copy{font-size:28rpx;line-height:1.65;color:var(--olive);padding:16rpx 4rpx}
.answer-area{margin-top:34rpx}
.answer-label{font-size:26rpx;color:var(--ink60);letter-spacing:.12em;margin-bottom:16rpx}
.answer-input{display:block;width:100%;height:90rpx;box-sizing:border-box;padding:0 8rpx;border:0;border-bottom:4rpx solid var(--ink-deep);border-radius:0;background:transparent;color:var(--ink-deep);font-family:"STSong","SimSun",serif;font-size:38rpx;letter-spacing:.15em;outline:none}
.wrong-tip{font-size:26rpx;line-height:1.6;color:var(--cinnabar);margin-top:18rpx}
.confirm-btn,.next-btn{width:100%;margin-top:34rpx}
.result{margin-top:40rpx;padding:44rpx 34rpx;text-align:center;background:var(--paper2)}
.result-mark{display:inline-block;color:var(--olive);border-bottom:2rpx solid var(--olive);font-size:24rpx;letter-spacing:.18em;padding-bottom:6rpx}
.result-title{color:var(--ink-deep);font-size:40rpx;font-weight:700;line-height:1.6;margin:28rpx 0 16rpx}
.result-copy{font-size:28rpx;line-height:1.7;color:var(--ink60)}

/* V2.1 拆信读信：信纸与撕口注 */
.tear-note{color:var(--ink60)}
.letter-sheet{margin-top:12rpx;padding:60rpx 48rpx 48rpx}
.letter-line{font-size:32rpx;line-height:2.05;color:var(--ink-deep);margin-bottom:20rpx;text-align:justify}
.letter-sign{font-size:26rpx;color:var(--ink60);text-align:right;margin-top:36rpx}

/* V2.3 【记】证据句：站尾屏显 */
.result-evidence {
  margin-top: 16rpx;
  text-align: center;
}
