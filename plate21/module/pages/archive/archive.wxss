.page { height: 100%; box-sizing: border-box; padding: 140rpx 40rpx 40rpx; background: #F4EDDC; }
.title { font-size: 48rpx; font-weight: 700; }
.empty { margin-top: 48rpx; font-size: 32rpx; line-height: 1.7; }
.list { height: calc(100% - 80rpx); margin-top: 24rpx; }
.row { padding: 28rpx 0; border-bottom: 2rpx solid rgba(46,31,13,.25); }
.name { font-size: 34rpx; }
