/* P04 黄花阵选择题 */
.page {
  position: relative;
  height: 100%;
  overflow: hidden;
  padding: 140rpx 48rpx 32rpx 100rpx; /* 左 100rpx = 48 + 52 让位 .binder */
  box-sizing: border-box;
}

/* v1.3 档案编号标签：右上角，避让返回钮与胶囊 */
.page .tag-no {
  position: absolute;
  top: 88rpx; right: 210rpx;
}

/* 顶部短叙事（novel 风格直接写） */
.novel-p {
  font-size: 31rpx;
  line-height: 1.9;
  color: var(--ink);
  margin-bottom: 24rpx;
}

/* 已授权 AI 黄花阵平面图。 */
.img-ph {
  background: var(--paper2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.img-s2a {
  height: 200rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
/* 线描示意铺满档案框。 */
.s2a-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  mix-blend-mode: multiply;
  z-index: 0;
}
.img-ph-id {
  font-size: 24rpx;
  color: var(--ink60);
  letter-spacing: 4rpx;
}
.img-ph-desc {
  font-size: 22rpx;
  color: var(--ink60);
  margin-top: 10rpx;
}

/* 题卡 */
.q-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
  margin-bottom: 32rpx;
}

.opts {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  /* 底部留白，让最后一项可完整滚动 */
  padding-bottom: 24rpx;
}
.opt {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 4rpx solid rgba(70, 56, 42, 0.55);
  padding: 28rpx 88rpx 28rpx 32rpx;
  overflow: hidden;
  min-height: 96rpx;
  box-sizing: border-box;
}
.opt-sel {
  border: 4rpx solid var(--cinnabar);
  background: rgba(166, 58, 46, 0.14);
  box-shadow: inset 10rpx 0 0 var(--cinnabar);
}
.opt-key {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--patina);
  margin-right: 24rpx;
}
.opt-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}
.opt-state {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: var(--patina);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.opt-wrong .opt-state { color: var(--cinnabar); }

/* 错误卡：碎裂斜线纹 + 变灰 */
.opt-wrong {
  opacity: 0.55;
}
.opt-wrong::after {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: repeating-linear-gradient(
    -45deg,
    transparent 0rpx,
    transparent 14rpx,
    rgba(70, 56, 42, 0.2) 14rpx,
    rgba(70, 56, 42, 0.2) 16rpx
  );
  pointer-events: none;
}

/* INT-404：错误项晃动（复用 s1-decode 的 shake 范式，与全站负反馈一致） */
.shake {
  animation: shake 0.45s ease;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-6rpx); }
}

/* 铜钉：radial-gradient 圆点，答对点亮 */
.pin {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--paper) 0%, var(--brass) 55%, var(--coffee) 100%);
  opacity: 0.35;
}
.pin-lit {
  opacity: 1;
  box-shadow: 0 0 16rpx 4rpx rgba(169, 143, 95, 0.55);
  transition: box-shadow 300ms ease, opacity 300ms ease;
}

.hint {
  margin-top: 28rpx;
  font-size: 27rpx;
  color: var(--patina);
}

.confirm {
  margin-top: 40rpx;
}

.followup {
  margin-top: 56rpx;
}
.followup .btn-seal {
  margin-top: 24rpx;
}

/* v1.3.1：邮票贴纸压在黄花阵示意右上角。 */
.s2a-stamp {
  position: absolute;
  top: -28rpx;
  right: -22rpx;
  width: 130rpx;
  height: 110rpx;
  transform: rotate(6deg);
  opacity: 0.9;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}

/* V2.1 对读一：开放作答输入与跳过 */
.ans-input { display: block; width: 100%; box-sizing: border-box; height: 84rpx; padding: 0 8rpx; border: 0; border-bottom: 4rpx solid var(--ink-deep); border-radius: 0; background: transparent; color: var(--ink-deep); font-family: "STKaiti", "KaiTi", serif; font-size: 34rpx; letter-spacing: 0.12em; }
.ans-ph { color: rgba(0, 0, 0, 0.28); }
.q-actions { margin-top: 28rpx; display: flex; flex-direction: column; gap: 18rpx; align-items: center; }
.hint-btn-inline { width: auto; min-height: 0; line-height: 1.4; margin: 0; padding: 12rpx 22rpx; border: 2rpx dashed var(--olive); border-radius: 0; background: rgba(111, 114, 72, 0.04); color: var(--olive); font-size: 26rpx; }
.hint-btn-inline::after { border: 0; }
.skip-btn { width: auto; min-height: 0; line-height: 1.4; margin: 0; padding: 6rpx 10rpx; border: 0; border-bottom: 2rpx dotted currentColor; border-radius: 0; background: transparent; font-size: 26rpx; }
.skip-btn::after { border: 0; }
