<nav-back wx:if="{{!touring}}" />
<page-overlays />
<bgm-ambience />
<view class="page page-shell task-shell paper-grain">
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
    <view class="task-kicker">黄花阵 · 本题</view>
    <view class="task-diary">
      <view class="task-lead kaiti"><gloss-text parts="{{introParts}}" bind:glossary="onGlossary" /></view>
      <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" autoplay="{{true}}" compact="{{true}}" icon="{{true}}" kind="voice" label="听这段" />
    </view>

    <view class="quiz task-exam" wx:if="{{!followup}}">
      <view class="q-label">问</view>
      <view class="q-title serif">我不禁好奇，这迷宫的修建目的是</view>
      <view class="opts">
        <view
          wx:for="{{options}}"
          wx:key="key"
          class="opt {{selected === item.key ? 'opt-sel' : ''}} {{revealed && item.key !== 'C' ? 'opt-wrong' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelect"
          role="button"
          aria-pressed="{{selected === item.key}}"
        >
          <text class="opt-key">{{item.key}}</text>
          <text class="opt-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="followup" wx:if="{{followup}}">
      <view class="task-lead">原来，这个黄花阵是皇帝用来观赏宫女在迷宫路径中奔跑嬉戏的。好嘛，这下不出门就有游乐场了！可是这又和“黄花”有什么关系呢？</view>
    </view>
  </scroll-view>
  <view class="task-dock">
    <view wx:if="{{hint && !followup}}" class="hint">{{hint}}</view>
    <button wx:if="{{!followup}}" class="btn-seal" bindtap="onConfirm" disabled="{{!selected || solved}}">提交</button>
    <button wx:else class="btn-seal" bindtap="onNext" disabled="{{advancing}}">{{advancing ? '正在前往……' : '继续'}}</button>
  </view>
</view>

<history-card
  visible="{{showHistory}}"
  title="黄花阵 · 中秋灯会"
  source="圆明园西洋楼景区史料"
  lines="{{historyLines}}"
  image="{{historyImage}}"
  corner-number="{{cardNumber}}"
  show-corner="{{showHistory}}"
  btn-text="继 续"
  bind:next="onCloseHistory"
  bind:close="onCloseHistory"
/>
<!-- 术语史料卡（导语「黄花阵」点入，SL-07） -->
<history-card
  wx:if="{{gloss}}"
  visible="{{!!gloss}}"
  title="{{gloss.title}}"
  source="{{gloss.source}}"
  lines="{{gloss.lines}}" layered="{{gloss.layered}}" image="{{gloss.image}}" caption="{{gloss.caption}}"
  btn-text="学到了"
  bind:next="onGlossClose"
  bind:close="onGlossClose"
/>
<coach-spot
  class="coach-host"
  style="top: {{coachWin.top}}px; left: {{coachWin.left}}px; width: {{coachWin.windowWidth}}px; height: {{coachWin.windowHeight}}px;"
  visible="{{showCoach}}"
  closing="{{coachClosing}}"
  index="{{coachIndex}}"
  total="{{coachSteps.length}}"
  step="{{coachStep}}"
  hole="{{coachHole}}"
  win="{{coachWin}}"
  bind:next="onCoachNext"
  bind:skip="onCoachSkip"
/>
