<!-- P04 第二站 · 黄花阵选择题 -->
<nav-back />
<view class="page page-shell paper-grain paper-real">
  <!-- v1.3.1 手账：左侧活页装订孔列（全站统一） -->
  <view class="binder"></view>
  <view class="tag-no">No.004</view>
  <view class="novel">
    <view class="novel-p">穿过西洋楼的断柱残垣，你在一方矮墙围合的园圃前停住脚步。</view>
    <view class="novel-p">皇家宫苑中竟有一座迷宫——砖墙不过肩高，却纵横曲折如阵，踮起脚也望不穿它的路径。</view>
  </view>

  <view class="img-ph img-s2a double-frame">
    <view class="tape" style="top:-20rpx; left:50%; margin-left:-90rpx;"></view>
    <!-- v1.3.1 手账：邮票贴纸压在黄花阵图右上角 -->
    <image class="s2a-stamp" src="/plate21/module/assets/img/stickers/st-stamp-02.png" mode="aspectFit" />
    <image class="s2a-img" src="/plate21/module/assets/img/IMG-RUNTIME-MAZE.jpg" mode="aspectFill" />
  </view>
  <view class="note-hand olive" style="transform: rotate(-1.5deg); margin-top: 16rpx;">砖墙仅及肩，入阵便迷向，奇哉。</view>

  <view class="hatch-divider" style="width: 140rpx; margin: 44rpx auto;"></view>

  <view class="quiz">
    <view class="q-title serif">这迷宫的修建目的是</view>
    <view class="note-hand" style="transform: rotate(1deg); margin-bottom: 16rpx;">须想透「戏」字，方得正解。</view>
    <view class="opts" role="radiogroup" aria-label="黄花阵修建目的选项">
      <view
        wx:for="{{options}}"
        wx:key="key"
        class="opt {{selected === item.key ? 'opt-sel' : ''}} {{item.wrong ? 'opt-wrong' : ''}} {{shakeKey === item.key ? 'shake' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelect"
        role="radio"
        aria-checked="{{selected === item.key}}"
        aria-label="{{item.key}}，{{item.text}}{{item.wrong ? '，不对应' : (selected === item.key ? '，已选择' : '')}}"
      >
        <view class="opt-key serif">{{item.key}}</view>
        <view class="opt-text">{{item.text}}</view>
        <view wx:if="{{item.wrong || selected === item.key}}" class="opt-state">{{item.wrong ? '不对应' : (solved ? '正确' : '已选择')}}</view>
        <view class="pin {{solved && item.key === 'C' ? 'pin-lit' : ''}}"></view>
      </view>
    </view>
    <view class="hint" wx:if="{{hint}}">{{hint}}</view>
    <button wx:if="{{!solved}}" class="btn-seal confirm" bindtap="onConfirm" disabled="{{!selected}}">确 认</button>
  </view>

  <view class="followup" wx:if="{{followup}}">
    <view class="novel-p">可是这又和「黄花」有什么关系呢？</view>
    <button class="btn-seal" bindtap="onNext">继 续</button>
  </view>
</view>

<history-card
  visible="{{showHistory}}"
  title="黄花阵 · 中秋灯会"
  source="圆明园西洋楼景区史料"
  lines="{{historyLines}}"
  corner-number="{{cardNumber}}"
  show-corner="{{showHistory}}"
  btn-text="继 续"
  bind:next="onNext"
  bind:close="onCloseHistory"
/>
<stamp-toast id="stamp" />
