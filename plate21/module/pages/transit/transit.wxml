<!-- 墨晕转场：深色墨滴从中心扩散后收拢（约 900ms） -->
<view class="ink-mask" wx:if="{{!touring}}"></view>

<nav-back wx:if="{{!touring}}" />
<page-overlays />
<view class="page page-shell paper-grain paper-real" wx:if="{{leg}}">
  <!-- v1.3.1 手账：左侧活页装订孔列（叙事过渡页） -->
  <view class="binder"></view>
  <!-- 归档编号标签（右上角，避让返回按钮） -->
  <view class="tag-no page-no">No.003</view>

  <!-- 路线标题（拱券顶饰呼应大水法拱门） -->
  <view class="arch route-arch"></view>
  <view class="route serif">{{leg.from}} → {{leg.to}}</view>

  <map
    class="nav-map"
    longitude="{{center.longitude}}"
    latitude="{{center.latitude}}"
    scale="16"
    markers="{{markers}}"
    polyline="{{polyline}}"
    enable-rotate="{{false}}"
    enable-3D="{{false}}"
    bindmarkertap="onMarker"
  ></map>
  <view class="site-list">
    <view
      wx:for="{{sites}}"
      wx:key="id"
      class="site-row {{item.current ? 'cur' : ''}} {{item.opened ? '' : 'locked'}}"
      data-id="{{item.id}}"
      bindtap="onOpenVisited"
    >
      <text class="site-name">{{item.name}}</text>
      <text class="site-state">{{item.current ? '这一站' : (item.opened ? '回看' : '未到')}}</text>
    </view>
  </view>

  <!-- 考察者手记批注（图旁页边，不压正文） -->
  <view class="note-hand olive map-note" style="transform: rotate(-1.5deg);">缓步徐行，约八分可达</view>

  <!-- 该段环境叙事 -->
  <view class="narr">
    <view class="narr-text">{{leg.text}}</view>
  </view>

  <!-- v2 顺路散页：可选入口（一段可挂多张），停不停由你；走完支线一键回主线 -->
  <view
    wx:for="{{sides}}"
    wx:key="key"
    id="{{index === 0 ? 'coachSide' : ''}}"
    class="side-entry"
    data-url="{{item.url}}"
    bindtap="onOpenSide"
    role="button"
    aria-label="翻看顺路散页{{item.title}}"
  >
    <view class="side-tag">档案里还夹着一页 · 可选</view>
    <view class="side-title serif">{{item.title}}</view>
    <view class="side-hook kaiti">{{item.hook}}</view>
    <view wx:if="{{sideVisited[item.key]}}" class="side-done note-hand olive">✓ 已翻过</view>
    <view class="side-arrow">›</view>
  </view>

  <button id="coachGo" class="btn-seal next-btn" bindtap="onNext" disabled="{{advancing}}">{{advancing ? '正在前往……' : '前往' + leg.to}}</button>
</view>
<coach-spot
  class="coach-host"
  style="top: {{coachWin.top}}px; left: {{coachWin.left}}px; width: {{coachWin.windowWidth}}px; height: {{coachWin.windowHeight}}px;"
  visible="{{showCoach}}"
  closing="{{coachClosing}}"
  index="{{coachIndex}}"
  total="{{coachSteps.length}}"
  step="{{coachStep}}"
  hole="{{coachHole}}"
  win="{{coachWin}}"
  bind:next="onCoachNext"
  bind:skip="onCoachSkip"
/>
