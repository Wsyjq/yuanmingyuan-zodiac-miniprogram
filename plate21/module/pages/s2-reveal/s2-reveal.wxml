<!-- 第二站 · 黄花阵 对读二：黄花从灯上来（V2.2 讲述版，文字输入可跳） -->
<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell paper-grain paper-real">
  <view class="binder"></view>
  <view class="tag-no tag-no-fixed">No.S2-2</view>

  <view class="title serif">黄花，从灯上来</view>
  <view class="lead kaiti">画上跑阵的人手里都提着一盏灯，灯是黄的。这地方又叫黄花阵——「黄花」两个字，是不是打灯上来的？</view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" />

  <!-- 已授权 AI 参考图：宫女手持黄色彩绸莲花灯 -->
  <view class="ref-img">
    <image class="ref-pic" src="/plate21/module/assets/img/IMG-RUNTIME-LANTERN.jpg" mode="aspectFill" />
    <view class="ref-note note-hand">参考图：手持莲花灯的宫女</view>
  </view>

  <view class="answer" wx:if="{{!solved}}">
    <input
      class="ans-input"
      placeholder="你觉得「黄花」二字从何而来？"
      placeholder-class="ans-ph"
      value="{{answer}}"
      bindinput="onInput"
      bindconfirm="onSubmit"
    />
    <button class="btn-seal ans-btn" bindtap="onSubmit">提 交</button>
    <view id="coachSkip" class="coach-hit">
      <button class="skip-btn note-hand olive" bindtap="onSkip">先不猜，往下走</button>
    </view>
  </view>
  <view wx:if="{{hint}}" class="hint">{{hint}}</view>

  <view wx:if="{{solved && !showHistory}}" class="followup double-frame">
    <dialogue-block speaker="宫女" text="今年的灯，黄绸扎的莲花，一人一盏。点亮了，满阵都是黄的。管事的说，这阵就叫黄花阵。" clip-id="dlg-huanghuazhen-2" />
    <view class="kaiti">名字就是从灯上来的。画上看不出迷宫难不难走，中心亭就在那边，路得自己用脚找。</view>
    <view class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">拿俯视卡进阵：墙印上了，路是空的；走错了退回来，站到中心亭就算完。</text></view>
    <button class="btn-seal" bindtap="onNext">拿俯视卡，进阵</button>
  </view>

  <history-card
    wx:if="{{showHistory}}"
    visible="{{showHistory}}"
    title="黄花阵 · 名字由来"
    source="圆明园西洋楼景区史料"
    lines="{{historyLines}}"
    corner-number="{{cardNumber}}"
    show-corner="{{showCardNumber}}"
    btn-text="继续"
    bind:next="onNext"
    bind:close="onCloseHistory"
  />
</view>
<coach-spot
  class="coach-host"
  style="top: {{coachWin.top}}px; left: {{coachWin.left}}px; width: {{coachWin.windowWidth}}px; height: {{coachWin.windowHeight}}px;"
  visible="{{showCoach}}"
  closing="{{coachClosing}}"
  index="{{coachIndex}}"
  total="{{coachSteps.length}}"
  step="{{coachStep}}"
  hole="{{coachHole}}"
  win="{{coachWin}}"
  bind:next="onCoachNext"
  bind:skip="onCoachSkip"
/>
