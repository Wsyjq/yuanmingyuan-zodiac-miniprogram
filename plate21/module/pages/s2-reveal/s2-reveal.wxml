<!-- 第二站 · 黄花阵名字由来：翻面揭晓（飞书 rev5614） -->
<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell task-shell paper-grain">
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
  <view class="task-kicker">黄花阵 · 本题</view>
  <view class="task-lead kaiti">可是这又和“黄花”有什么关系呢？</view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" autoplay="{{true}}" kind="voice" label="听 · 本页讲述" />

  <view class="prop-prompt plate" wx:if="{{!solved}}">
    <view class="prop-label plateno">线下道具 · 实体黄花阵图</view>
    <view class="prop-title serif">翻到背面看答案</view>
    <view class="prop-steps">
      <view class="prop-step"><text class="step-no">1</text><text class="step-copy">从道具袋取出实体「黄花阵」图卡。</text></view>
      <view class="prop-step"><text class="step-no">2</text><text class="step-copy">按图卡本身的提示翻到背面。</text></view>
      <view class="prop-step"><text class="step-no">3</text><text class="step-copy">看清背面答案后，点下方按钮揭晓。</text></view>
    </view>
    <view class="prop-note handnote olive">实体道具在手上翻；本页只提示步骤，不画图卡。</view>
  </view>

  <view wx:if="{{solved && !showHistory}}" class="followup">
    <view class="task-lead">由于宫女们手持黄色彩绸扎成的莲花灯，所以这个迷宫也得名黄花阵。</view>
    <view class="task-lead">这迷宫看上去很难走？我也要试试看，也许黄花阵的中央，还有什么我值得考察的东西呢。</view>
  </view>
  </scroll-view>
  <view class="task-dock">
    <button wx:if="{{!solved}}" class="btn-seal" bindtap="onFlip">我已翻到背面</button>
    <button wx:elif="{{solved && !showHistory}}" class="btn-seal" bindtap="onNext" disabled="{{advancing}}">{{advancing ? '正在前往……' : '进阵'}}</button>
  </view>

  <history-card
    wx:if="{{showHistory}}"
    visible="{{showHistory}}"
    title="黄花阵 · 名字由来"
    source="圆明园西洋楼景区史料"
    lines="{{historyLines}}"
    btn-text="继续"
    bind:next="onCloseHistory"
    bind:close="onCloseHistory"
  />
</view>
<coach-spot
  class="coach-host"
  style="top: {{coachWin.top}}px; left: {{coachWin.left}}px; width: {{coachWin.windowWidth}}px; height: {{coachWin.windowHeight}}px;"
  visible="{{showCoach}}"
  closing="{{coachClosing}}"
  index="{{coachIndex}}"
  total="{{coachSteps.length}}"
  step="{{coachStep}}"
  hole="{{coachHole}}"
  win="{{coachWin}}"
  bind:next="onCoachNext"
  bind:skip="onCoachSkip"
/>
