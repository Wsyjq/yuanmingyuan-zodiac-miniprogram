<nav-back />
<view class="fx-page page-shell paper-grain"><view class="fx-kicker">ARCHIVE · 阅读</view><view class="fx-error">{{error}}</view><block wx:if="{{item}}"><view class="fx-title">{{item.title}}</view><view class="fx-tag">{{item.nature}}</view><button bindtap="restart">从头阅读</button><view class="fx-note">{{item.review}}</view><view class="fx-card"><view class="fx-tag">{{position + 1}} / {{total}}</view><view wx:if="{{block.title}}" class="fx-card-title">{{block.title}}</view><view wx:if="{{block.text}}" class="fx-body">{{block.text}}</view><image wx:if="{{block.type === 'image'}}" src="{{block.src}}" class="fx-photo" mode="widthFix" binderror="mediaError" /><view wx:if="{{block.caption}}" class="fx-note">{{block.caption}}</view><block wx:if="{{block.type === 'audio' && block.src}}"><view class="fx-row"><button bindtap="play">播放讲解</button><button bindtap="pause">暂停</button></view><slider value="{{sound.duration ? sound.position / sound.duration * 100 : 0}}" bindchange="seek" /><button wx:if="{{sound.error}}" bindtap="retry">重试</button></block><video id="readerVideo" wx:if="{{block.type === 'video' && block.src}}" src="{{block.src}}" initial-time="{{mediaPosition}}" controls bindplay="videoPlay" bindpause="videoPause" bindended="videoPause" bindtimeupdate="videoTime" binderror="mediaError" /><view class="fx-row"><button disabled="{{position === 0}}" bindtap="move" data-delta="-1">上一页</button><button wx:if="{{position + 1 < total}}" bindtap="move" data-delta="1">下一页</button><button wx:else bindtap="finish">标为已读</button></view></view><view class="fx-card" wx:if="{{item.dispute}}"><view class="fx-card-title">阅读说明与争议</view><view class="fx-note">{{item.dispute}}</view></view><view class="fx-card"><view class="fx-card-title">出处</view><view wx:for="{{item.sources}}" wx:key="index"><view class="fx-note">{{item.title}} · {{item.file}}</view><view class="fx-url">{{item.url}}</view><button wx:if="{{item.url}}" data-url="{{item.url}}" bindtap="copy">复制原文链接</button></view></view></block></view>

<page-overlays />
