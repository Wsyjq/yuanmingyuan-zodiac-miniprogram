@import "../../styles/report-artwork.wxss";

/* P14 反转揭示 */

.stage {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: 52rpx; /* 让位 .binder */
  justify-content: center;
  transition: background-color 0.8s ease;
  box-sizing: border-box;
}
.stage.night {
  background: var(--night);
}

.finale-novel-host {
  display: block;
  align-self: stretch;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* v1.3 手账：右上档案编号标签（避让胶囊） */
.fin-no {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  z-index: 9;
}
/* v1.3 手账：幕5 手写批注 */
.fin-note {
  margin-top: 28rpx;
}

.act1 {
  width: 100%;
  height: 100vh;
}

/* ---------- 幕2 打字机 ---------- */
.term {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 40rpx;
}
.tline {
  font-family: "Courier New", monospace;
  font-size: 28rpx;
  line-height: 2;
  letter-spacing: 2rpx;
  color: var(--ink);
}
.cursor {
  margin-left: 4rpx;
  animation: blink 0.8s step-end infinite;
}
@keyframes blink {
  50% { opacity: 0; }
}

/* ---------- 铜版画中央画布（幕3 / 幕5 共用） ---------- */
.canvas {
  position: relative;
  width: 100%;
  max-width: 700rpx;
  aspect-ratio: 14 / 19;
  height: auto;
  background: var(--paper);
  border: 1rpx solid rgba(70, 56, 42, 0.35);
  overflow: hidden;
}
/* 已授权 AI 第二十一图作为画布底图（五层逐层显现 / 幕5 全显）。 */
.canvas-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  mix-blend-mode: multiply;
}
.layer {
  position: absolute;
  opacity: 0;
}
.layer.on {
  opacity: 1;
}
/* 五片纸幕分别打开，动画只在合成层执行。 */
.reveal-curtain {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 20;
  width: 20.2%;
  background: var(--paper);
  transform: scaleX(1);
  transform-origin: right center;
  transition: transform 0.55s ease;
}
.reveal-curtain.is-open { transform: scaleX(0); }
.curtain-1 { left: 0; }.curtain-2 { left: 20%; }.curtain-3 { left: 40%; }.curtain-4 { left: 60%; }.curtain-5 { left: 80%; }

/* 占位块：--paper2 底 + 双框线（double-frame） + 居中两行小字 */
.ph {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: var(--paper2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}
.ph-code {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink60);
}
.ph-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink60);
  text-align: center;
}
.tag {
  position: absolute;
  top: 6rpx;
  left: 12rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--ink60);
}
/* L1 标签移到题跋横条上方，不压铭文 */
.layer-l1 .tag {
  top: -26rpx;
  left: 0;
}
/* L2 标签移到边框线外下缘，不压边框 */
.layer-l2 .tag {
  top: auto;
  bottom: -28rpx;
  left: 0;
}

/* L4 背景 */
.layer-l4 {
  top: 200rpx;
  left: 80rpx;
  right: 80rpx;
  height: 640rpx;
  z-index: 2;
}
/* L3 主体 */
.layer-l3 {
  top: 320rpx;
  left: 130rpx;
  width: 440rpx;
  height: 460rpx;
  z-index: 3;
}
/* L2 边框（万字纹虚线矩形框） */
.layer-l2 {
  top: 170rpx;
  left: 44rpx;
  right: 44rpx;
  bottom: 64rpx;
  z-index: 4;
}
.l2-frame {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 4rpx dashed var(--brass);
}
.l2-inner {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1rpx dashed var(--brass);
}
/* L1 题跋（顶部铭文横条） */
.layer-l1 {
  top: 28rpx;
  left: 40rpx;
  right: 40rpx;
  height: 116rpx;
  z-index: 5;
}
.l1-bar {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: var(--paper);
  border: 1rpx solid rgba(70, 56, 42, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
}
.l1-text {
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--ink);
}
/* L5 落款（右下角） */
.layer-l5 {
  right: 120rpx;
  bottom: 84rpx;
  width: 320rpx;
  z-index: 6;
}
.l5-box {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.l5-tag {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--ink60);
}
.l5-line {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.l5-name {
  margin-top: 4rpx;
  min-height: 36rpx;
  font-size: 28rpx;
  color: var(--cinnabar);
}

/* ---------- 幕3 点题短文案 ---------- */
.caption {
  margin-top: 44rpx;
  min-height: 56rpx;
  font-size: 30rpx;
  text-align: center;
  color: var(--ink);
}

/* ---------- 幕5 署名 ---------- */
.act5 {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sign-panel {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  margin-top: 48rpx;
}
.sign-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.sign-label {
  width: 180rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--ink60);
}
.sign-input {
  flex: 1;
  height: 64rpx;
  font-size: 30rpx;
  color: var(--cinnabar);
  border-bottom: 1rpx solid var(--ink);
}
.sign-ph {
  color: var(--dash);
  font-size: 26rpx;
}
.sign-name {
  flex: 1;
  font-size: 32rpx;
  color: var(--cinnabar);
  border-bottom: 1rpx solid var(--ink);
}
.sign-value {
  font-size: 28rpx;
  color: var(--ink);
}
.sign-value.dim {
  color: var(--dash);
  font-size: 24rpx;
}
.sign-btn {
  margin-top: 40rpx;
}

/* v1.3.1：幕3 画框贴纸（吊牌 + 干花），仅 act3 显示时可见，不扰演出 */
.act3 .perfo-frame { position: relative; }
.act3, .act5 { width: 100%; max-width: var(--content-max); box-sizing: border-box; }
.act3 .perfo-frame, .act5 .perfo-frame { width: 100%; box-sizing: border-box; }
.fin-tag {
  position: absolute;
  top: -36rpx;
  right: -22rpx;
  width: 150rpx;
  height: 120rpx;
  transform: rotate(7deg);
  opacity: 0.9;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
.fin-botanical {
  position: absolute;
  bottom: -26rpx;
  left: -22rpx;
  width: 170rpx;
  height: 150rpx;
  transform: rotate(-5deg);
  opacity: 0.9;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}

@media (prefers-reduced-motion: reduce) {
  .reveal-curtain { transition: none; }
  .cursor { animation: none; }
}

/* V2.3 回显块：两处游客输入只在结局屏显 */
.echo-panel {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  margin: 24rpx auto 0;
  padding: 24rpx 28rpx;
  border: 2rpx dashed var(--dash);
  border-radius: 8rpx;
  background: rgba(244, 237, 220, 0.6);
  text-align: center;
}
.echo-title {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--patina);
}
.echo-line {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}
