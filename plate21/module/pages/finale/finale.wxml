<!-- v1.3.1 手账：左侧活页装订孔列（移到 .stage 外，避免 flex 影响 fixed；pointer-events:none 不扰演出点击） -->
<view class="binder"></view>
<view class="stage page-shell paper-grain paper-real {{night ? 'night' : ''}}" bindtap="onTapScreen">

  <!-- v1.3 手账：档案编号标签（黑屏/打字机幕不显示，避让演出） -->
  <view wx:if="{{act === 3 || act === 5}}" class="tag-no fin-no">No.014</view>

  <!-- 幕1 黑屏：整页转 --night，无内容 -->
  <view wx:if="{{act === 1}}" class="act1"></view>

  <!-- 幕2 生成中：等宽感打字机逐行 -->
  <view wx:if="{{act === 2}}" class="act2">
    <view class="term">
      <view wx:for="{{typeLines}}" wx:key="index" wx:if="{{index < typedCount}}" class="tline">
        <text>{{item}}</text><text wx:if="{{index === typedCount - 1}}" class="cursor">▌</text>
      </view>
    </view>
  </view>

  <!-- 幕3 五层拼合 -->
  <view wx:if="{{act === 3}}" class="act3">
    <view class="perfo-frame">
      <!-- v1.3.1 手账：吊牌贴纸压在画框右上角（幕3 才显，不扰演出） -->
      <image class="fin-tag" src="/plate21/module/assets/img/stickers/st-hang-tag-02.png" mode="aspectFit" />
      <!-- v1.3.1 手账：干花标本贴纸压在画框左下角 -->
      <image class="fin-botanical" src="/plate21/module/assets/img/stickers/st-botanical-01.png" mode="aspectFit" />
      <view class="canvas report-artwork">
      <view class="corner tl"></view>
      <view class="corner tr"></view>
      <view class="corner bl"></view>
      <view class="corner br"></view>
      <image class="canvas-bg" src="/plate21/module/assets/img/IMG-RUNTIME-PLATE.jpg" mode="aspectFill" />
      <!-- L2 边框（万字纹虚线矩形框） -->
      <view class="layer layer-l2">
        <view class="l2-frame">
          <view class="l2-inner"></view>
        </view>
      </view>
      <!-- L1 题跋（V2.1 副行） -->
      <view class="layer layer-l1">
        <view class="l1-bar">
          <text class="l1-text kaiti">今日对读。非馆藏原件。</text>
        </view>
      </view>
      <!-- L5 落款 -->
      <view class="layer layer-l5">
        <view class="l5-box">
          <text class="l5-line kaiti">此处待绘</text>
        </view>
      </view>
      <view class="reveal-curtain curtain-1 {{layerCount >= 1 ? 'is-open' : ''}}"></view>
      <view class="reveal-curtain curtain-2 {{layerCount >= 2 ? 'is-open' : ''}}"></view>
      <view class="reveal-curtain curtain-3 {{layerCount >= 3 ? 'is-open' : ''}}"></view>
      <view class="reveal-curtain curtain-4 {{layerCount >= 4 ? 'is-open' : ''}}"></view>
      <view class="reveal-curtain curtain-5 {{layerCount >= 5 ? 'is-open' : ''}}"></view>
      </view>
    </view>
    <view class="caption kaiti">{{caption}}</view>
  </view>

  <!-- 幕4 长文叙事（novel 风格，不可跳过） -->
  <novel-view
    id="novelView"
    wx:if="{{act === 4}}"
    class="finale-novel-host"
    title="尾声 · 第二十一图"
    paragraphs="{{novel}}"
    finish-text="署名"
    bind:finish="onNovelFinish"
  />
    <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 结局讲述" />

  <!-- 幕5 署名 -->
  <view wx:if="{{act === 5}}" class="act5">
    <view class="perfo-frame">
      <view class="canvas report-artwork">
      <view class="corner tl"></view>
      <view class="corner tr"></view>
      <view class="corner bl"></view>
      <view class="corner br"></view>
      <image class="canvas-bg" src="/plate21/module/assets/img/IMG-RUNTIME-PLATE.jpg" mode="aspectFill" />
      <view class="layer layer-l2 on">
        <view class="l2-frame">
          <view class="l2-inner"></view>
        </view>
      </view>
      <view class="layer layer-l1 on">
        <view class="l1-bar">
          <text class="l1-text kaiti">今日对读。非馆藏原件。</text>
        </view>
      </view>
      <view class="layer layer-l5 on">
        <view class="l5-box">
          <text class="l5-line kaiti">今日对读</text>
          <text class="l5-name kaiti">{{name}}</text>
        </view>
      </view>
      </view>
    </view>

    <!-- v1.3 手账：考察者手记批注 -->
    <view class="note-hand fin-note" style="transform: rotate(-1.5deg);">中央空着的那一块，是你站着的位置。</view>

    <view class="sign-panel">
      <view class="sign-row">
        <text class="sign-label">绘制者</text>
        <input
          wx:if="{{!signed}}"
          class="sign-input kaiti"
          placeholder="写下你的名字"
          placeholder-class="sign-ph"
          value="{{name}}"
          maxlength="12"
          bindinput="onNameInput"
        />
        <text wx:else class="sign-name kaiti">{{name}}</text>
      </view>
      <view class="sign-row">
        <text class="sign-label">绘制时间</text>
        <text class="sign-value">{{today}}</text>
      </view>
      <button wx:if="{{!signed}}" class="btn-seal sign-btn" bindtap="onSign" disabled="{{signing}}">{{signing ? '落款中……' : '署 名'}}</button>
      <button wx:else class="btn-seal sign-btn" bindtap="goReport" disabled="{{reporting}}">{{reporting ? '正在归档……' : '查看考察报告'}}</button>
    </view>
  </view>

</view>
