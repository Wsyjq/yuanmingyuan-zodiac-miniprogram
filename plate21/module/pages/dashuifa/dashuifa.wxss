/* v2 大水法留白站：静默页刻意接近空白 */
.page-no {
  position: absolute;
  top: 88rpx; right: 210rpx;
  z-index: 2;
}
.dsf-page {
  justify-content: flex-start;
  padding-top: 200rpx;
}
.dsf-stage {
  width: 100%;
  max-width: var(--content-max);
  box-sizing: border-box;
  padding: 0 12rpx;
}
.dsf-pageturn {
  font-size: 22rpx;
  margin-bottom: 18rpx;
}
.dsf-quote {
  font-size: 30rpx;
  line-height: 1.9;
  letter-spacing: 2rpx;
  color: var(--ink-deep);
  margin-bottom: 18rpx;
}
.dsf-plate {
  position: relative;
  margin: 24rpx 0 8rpx;
  padding: 14rpx;
  background: var(--paper2);
}
.dsf-plate-img {
  display: block;
  width: 100%;
}
.dsf-plate-note {
  margin-top: 12rpx;
  font-size: 24rpx;
}
.dsf-zones, .dsf-pieces { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 16rpx 0; }
.dsf-zone, .dsf-piece, .dsf-choice {
  padding: 22rpx 28rpx;
  border: 1rpx solid var(--dash);
  background: var(--paper2);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.dsf-piece.on, .dsf-choice.on {
  border: 3rpx solid var(--patina);
  background: rgba(74, 107, 100, 0.12);
  box-shadow: inset 8rpx 0 0 rgba(74, 107, 100, 0.22);
}
.dsf-key {
  font-weight: 700;
  color: var(--patina);
  margin-right: 24rpx;
}
.dsf-dim {
  opacity: 0.55;
}
/* 答错提示：铜绿手写 */
.hint {
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--patina);
}
.q-title {
  font-size: 34rpx;
  letter-spacing: 4rpx;
  margin: 24rpx 0 20rpx;
}
.dsf-rule {
  margin-top: 30rpx;
  border-top: 1rpx solid rgba(70, 56, 42, 0.3);
  padding-top: 24rpx;
}
.dsf-rule-line {
  font-size: 28rpx;
  line-height: 1.95;
  color: var(--ink60);
}
.dsf-rule-line + .dsf-rule-line {
  margin-top: 6rpx;
}
.dsf-start {
  margin-top: 44rpx;
}
.dsf-skip {
  margin-top: 22rpx;
  font-size: 22rpx;
}

/* 静默幕：居中倒计时 + 细进度条 */
.dsf-silence {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f4efe3;
  z-index: 5;
}
.dsf-remain {
  font-family: "Courier New", monospace;
  font-size: 56rpx;
  letter-spacing: 6rpx;
  color: rgba(70, 56, 42, 0.55);
}
.dsf-bar {
  width: 300rpx;
  height: 4rpx;
  margin-top: 30rpx;
  background: rgba(70, 56, 42, 0.12);
  border-radius: 2rpx;
  overflow: hidden;
}
.dsf-bar-fill {
  height: 100%;
  background: rgba(70, 56, 42, 0.4);
}
.dsf-early {
  margin-top: 90rpx;
  font-size: 24rpx;
  color: rgba(70, 56, 42, 0.45);
  background: transparent;
  border: none;
  line-height: 2;
}
.dsf-early::after {
  border: none;
}

/* 三选一 */
.dsf-choices {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.dsf-choice {
  width: 100%;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  box-sizing: border-box;
}
.dsf-skipq {
  margin-top: 30rpx;
  font-size: 22rpx;
  background: transparent;
  border: none;
  padding: 0;
}
.dsf-skipq::after {
  border: none;
}
