/* v2 大水法留白站：静默页刻意接近空白 */
.page-no {
  position: absolute;
  top: 88rpx; right: 210rpx;
  z-index: 2;
}
.dsf-page {
  justify-content: flex-start;
  padding-top: 200rpx;
}
.dsf-stage {
  width: 100%;
  max-width: var(--content-max);
  box-sizing: border-box;
  padding: 0 12rpx;
}
.dsf-pageturn {
  font-size: 22rpx;
  margin-bottom: 18rpx;
}
.dsf-quote {
  font-size: 30rpx;
  line-height: 1.9;
  letter-spacing: 2rpx;
  color: var(--ink-deep);
  margin-bottom: 18rpx;
}
.dsf-plate { width: 100%; margin: 16rpx 0; }
.dsf-zones, .dsf-pieces { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 12rpx 0; }
.dsf-zone, .dsf-piece, .dsf-choice {
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--dash);
  background: var(--paper2);
  font-size: 26rpx;
}
.dsf-piece.on, .dsf-choice.on { border: 3rpx solid var(--patina); }
.dsf-rule {
  margin-top: 30rpx;
  border-top: 1rpx solid rgba(70, 56, 42, 0.3);
  padding-top: 24rpx;
}
.dsf-rule-line {
  font-size: 26rpx;
  line-height: 1.95;
  color: var(--ink60);
}
.dsf-rule-line + .dsf-rule-line {
  margin-top: 6rpx;
}
.dsf-start {
  margin-top: 44rpx;
}
.dsf-skip {
  margin-top: 22rpx;
  font-size: 22rpx;
}

/* 静默幕：居中倒计时 + 细进度条 */
.dsf-silence {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f4efe3;
  z-index: 5;
}
.dsf-remain {
  font-family: "Courier New", monospace;
  font-size: 56rpx;
  letter-spacing: 6rpx;
  color: rgba(70, 56, 42, 0.55);
}
.dsf-bar {
  width: 300rpx;
  height: 4rpx;
  margin-top: 30rpx;
  background: rgba(70, 56, 42, 0.12);
  border-radius: 2rpx;
  overflow: hidden;
}
.dsf-bar-fill {
  height: 100%;
  background: rgba(70, 56, 42, 0.4);
}
.dsf-early {
  margin-top: 90rpx;
  font-size: 24rpx;
  color: rgba(70, 56, 42, 0.45);
  background: transparent;
  border: none;
  line-height: 2;
}
.dsf-early::after {
  border: none;
}

/* 三选一 */
.dsf-choices {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.dsf-choice {
  width: 100%;
}
.dsf-skipq {
  margin-top: 30rpx;
  font-size: 22rpx;
  background: transparent;
  border: none;
  padding: 0;
}
.dsf-skipq::after {
  border: none;
}
