<nav-back />
<page-overlays />
<view class="page page-shell paper-grain paper-real dsf-page">
  <view class="tag-no page-no">No.DS</view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" dock="{{true}}" />
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">

  <block wx:if="{{stage === 'hunt'}}">
    <view class="dsf-quote kaiti"><gloss-text parts="{{introParts}}" bind:glossary="onGlossary" /></view>
    <view class="dsf-quote kaiti">我翻了翻档案，正好找到了一幅《大水法南面》的铜版图。图中的石构轮廓和眼前能够对得上。但真正吸引我注意的，反而是前面的喷水池。不过水池中间怎么还有一只鹿？周围那些动物又是在做什么？</view>
    <view class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">根据铜版图，把三件放回原本的位置</text></view>
    <view class="dsf-plate double-frame">
      <view class="tape" style="top:-20rpx; left:50%; margin-left:-90rpx;"></view>
      <image class="dsf-plate-img" src="/plate21/module/assets/img/plate-dashuifa.jpg" mode="widthFix" />
    </view>
    <view class="note-hand olive dsf-plate-note tilt-r">档案里的《大水法南面》——画上的热闹，地上都没有了。</view>
    <view class="dsf-zones">
      <view wx:for="{{zones}}" wx:key="key" class="dsf-zone" data-zone="{{item.key}}" bindtap="onDrop">{{item.label}}</view>
    </view>
    <view class="dsf-pieces">
      <view wx:for="{{pieces}}" wx:key="key" class="dsf-piece {{holding === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onHold">{{item.label}}{{placed[item.key] ? ' · 已放' : ''}}</view>
    </view>
    <view class="hint note-hand" wx:if="{{huntHint}}">{{huntHint}}</view>
    <button class="btn-seal" bindtap="onHuntConfirm">放 好 了</button>
  </block>

  <block wx:elif="{{stage === 'after'}}">
    <view class="dsf-quote kaiti">最后一只猎狗归位之后，水流一下子从屏幕里的各个方向喷了出来。原来这些动物并不是随便摆在喷泉里的装饰。鹿站在中间，猎狗围在周围，水流一喷起来，整个场景一下子就像“动”了起来。所以，海晏堂是用水来表示时间，大水法则是用水来表现一场正在发生的追逐。难怪日记里会写“以水成戏”。</view>
    <view class="dsf-quote kaiti">我本来准备把档案翻向下一页，却发现复原画面的后方似乎还有一座建筑。刚开始我还以为那只是大水法的一部分，可再看看铜版图，又抬头看了看现场的方向，好像并不是这样。大水法后面，原本还有一座更高的建筑。那会是什么地方？</view>
    <button class="btn-seal" bindtap="onAfterNext">往北看</button>
  </block>

  <block wx:else>
    <view class="q-title serif">大水法北侧、位于高台上的建筑是什么？</view>
    <view
      wx:for="{{yuanOpts}}"
      wx:key="key"
      class="dsf-choice {{yuanSelected === item.key ? 'on' : ''}} {{yuanSolved && item.key !== 'B' ? 'dsf-dim' : ''}}"
      data-key="{{item.key}}"
      bindtap="onYuanSelect"
      role="button"
      aria-pressed="{{yuanSelected === item.key}}"
    >
      <text class="dsf-key">{{item.key}}</text>
      <text class="dsf-text">{{item.text}}</text>
    </view>
    <view class="hint note-hand" wx:if="{{yuanHint}}">{{yuanHint}}</view>
    <button wx:if="{{!followup}}" class="btn-seal" bindtap="onYuanConfirm" disabled="{{!yuanSelected || yuanSolved}}">{{yuanRevealed ? '记 下 了' : '就 是 这 座'}}</button>
    <view wx:if="{{followup}}">
      <view class="dsf-quote kaiti"><gloss-text parts="{{axisParts}}" bind:glossary="onGlossary" /></view>
      <view class="paper-quote">「上观其形。」</view>
      <view class="dsf-quote kaiti"><gloss-text parts="{{hugoParts}}" bind:glossary="onGlossary" /></view>
      <button class="btn-seal" bindtap="onNext">前往雨果雕像</button>
    </view>
  </block>
  </scroll-view>

  <!-- 术语史料卡（「大水法」SL-14 /「观水法」SL-15 /「雨果」SL-17 点入） -->
  <history-card
    wx:if="{{gloss}}"
    visible="{{!!gloss}}"
    title="{{gloss.title}}"
    source="{{gloss.source}}"
    lines="{{gloss.lines}}"
    btn-text="返 回"
    bind:next="onGlossClose"
    bind:close="onGlossClose"
  />
</view>
