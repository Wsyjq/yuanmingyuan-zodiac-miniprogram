/* 第二站 · 谜题3 现场四图考察 */
.page {
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
  padding: 0 30rpx 90rpx 60rpx;
}

.tag-no-fixed { position: absolute; top: 88rpx; right: 210rpx; }
.page-tag-sticker {
  position: absolute;
  top: 84rpx;
  right: 22rpx;
  z-index: 9;
  width: 140rpx;
  height: 140rpx;
  opacity: 0.72;
  transform: rotate(7deg);
  pointer-events: none;
  filter: drop-shadow(0 2rpx 4rpx rgba(70, 56, 42, 0.18));
}

.title {
  padding-top: 130rpx;
  color: var(--ink-deep);
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.title-div { width: 42%; margin: 18rpx 0 0; }
.lead { margin-top: 18rpx; font-size: 31rpx; line-height: 1.85; color: var(--ink); }

.capture-grid {
  margin-top: 42rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.capture-card {
  width: 48%;
  margin-bottom: 28rpx;
  padding: 18rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.capture-card.captured { width: 100%; }
.skip-line {
  display: block;
  margin: 18rpx auto 0;
  background: transparent;
  color: #46382A;
  font-size: 30rpx;
  border-bottom: 2rpx solid #46382A;
}
.capture-card.captured { border-top: 5rpx solid var(--patina); }
.slot-head { position: relative; min-height: 66rpx; padding-left: 50rpx; }
.slot-no {
  position: absolute;
  left: 0;
  top: 0;
  color: var(--coffee);
  font-family: "Courier New", monospace;
  font-size: 20rpx;
}
.slot-title { color: var(--ink-deep); font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.slot-state { margin-top: 3rpx; color: var(--ink60); font-size: 18rpx; letter-spacing: 2rpx; }
.captured .slot-state { color: var(--patina); }

.photo-stage {
  position: relative;
  height: 208rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(46, 31, 13, 0.38);
  background: var(--paper3);
}
.photo-result,
.photo-guide { display: block; width: 100%; height: 100%; }
.photo-result { filter: sepia(0.2) saturate(0.82) contrast(1.02); }
.photo-guide { filter: sepia(0.65) saturate(0.45) contrast(0.9); opacity: 0.5; }
.guide-mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--paper);
  background: rgba(46, 31, 13, 0.28);
}
.guide-mark { width: 52rpx; height: 52rpx; line-height: 48rpx; border: 2rpx solid currentColor; border-radius: 50%; text-align: center; font-size: 38rpx; }
.guide-copy { margin-top: 10rpx; font-size: 19rpx; letter-spacing: 2rpx; }
.photo-busy {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--paper);
  background: rgba(35, 40, 46, 0.72);
  font-size: 22rpx;
}

.slot-desc { min-height: 94rpx; margin-top: 12rpx; color: var(--ink60); font-size: 23rpx; line-height: 1.55; }
.slot-actions { display: flex; margin-top: 12rpx; gap: 10rpx; }
.capture-btn {
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0 6rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.42);
  border-radius: 2rpx;
  background: transparent;
  color: var(--ink60);
  font-size: 20rpx;
  line-height: 62rpx;
}
.capture-btn::after { border: 0; }
.capture-btn.primary { border-color: var(--patina); color: var(--patina); }
.capture-btn:active { transform: scale(0.96); opacity: 0.8; }

.capture-message { margin-top: 8rpx; }
.capture-error { color: var(--cinnabar); font-size: 24rpx; line-height: 1.7; }
.capture-warning { color: var(--coffee); font-size: 23rpx; line-height: 1.7; }
.settings-btn {
  width: auto;
  min-height: 0;
  margin: 16rpx 0 0;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--cinnabar);
  border-radius: 2rpx;
  background: transparent;
  color: var(--cinnabar);
  font-size: 22rpx;
  line-height: 1.5;
}
.settings-btn::after { border: 0; }

.progress-slip { margin-top: 12rpx; }
.progress-meta { display: flex; justify-content: space-between; align-items: center; }
.progress-label { color: var(--ink-deep); font-size: 26rpx; letter-spacing: 3rpx; }
.progress-count { color: var(--coffee); font-family: "Courier New", monospace; font-size: 25rpx; }
.progress-track { height: 5rpx; margin-top: 18rpx; background: rgba(70, 56, 42, 0.14); overflow: hidden; }
.progress-fill { height: 100%; background: var(--patina); transition: width 0.25s ease; }
.progress-note { margin-top: 18rpx; font-size: 24rpx; }
.complete-btn { width: 100%; margin-top: 22rpx; }
.btn-disabled { opacity: 0.42; }

.record-mask {
  position: fixed;
  inset: 0;
  z-index: 145;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  background: rgba(46, 31, 13, 0.48);
}
.record-card {
  width: 100%;
  max-height: 92vh;
  box-sizing: border-box;
  padding: 38rpx 30rpx 30rpx;
  overflow-y: auto;
  animation: record-in 0.35s ease both;
}
.record-kicker { color: var(--ink60); font-family: "Courier New", monospace; font-size: 18rpx; letter-spacing: 2rpx; }
.record-title { margin-top: 12rpx; color: var(--ink-deep); font-size: 34rpx; font-weight: 700; line-height: 1.45; }
.record-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 22rpx; }
.record-photo { width: 48.5%; margin-bottom: 18rpx; border: 1rpx solid rgba(46, 31, 13, 0.34); background: var(--paper); }
.record-photo-image { display: block; width: 100%; height: 190rpx; filter: sepia(0.22) saturate(0.8); }
.record-caption { padding: 8rpx 10rpx; color: var(--ink); font-size: 20rpx; line-height: 1.45; }
.record-caption-no { margin-right: 9rpx; color: var(--coffee); font-family: "Courier New", monospace; }
.record-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 2rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(70, 56, 42, 0.25); }
.record-date { color: var(--ink60); font-size: 21rpx; letter-spacing: 2rpx; }
.record-number { width: 54rpx; height: 54rpx; line-height: 54rpx; border-radius: 50%; background: var(--cinnabar); color: var(--paper); text-align: center; font-size: 30rpx; font-weight: 700; transform: rotate(-5deg); }
.record-confirm { width: 100%; margin-top: 22rpx; }

@keyframes record-in {
  from { opacity: 0; transform: translateY(24rpx) rotate(-0.5deg); }
  to { opacity: 1; transform: translateY(0) rotate(0); }
}
