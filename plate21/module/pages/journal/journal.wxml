<nav-back /><view class="fx-page page-shell paper-grain"><page-overlays inline="{{true}}" /><view class="fx-kicker">PRIVATE ARCHIVE · 私人记录</view><view class="fx-title">留下一点，属于今天</view><view class="fx-note">照片和文字都可选。不必答对全部题目，也能留下纪念。</view><view class="fx-tag">{{message}}</view><view class="fx-row"><button bindtap="create" disabled="{{busy}}">新建记录</button><button bindtap="report">回看原报告</button><button wx:if="{{cloud}}" bindtap="sync" disabled="{{busy}}">同步 / 重试</button></view><view wx:if="{{conflict}}" class="fx-card"><view class="fx-card-title">请选择要继续的存档</view><view class="fx-note">{{remoteSummary}}。采用云端前会在本机备份当前档案；采用本机将替换云端内容。</view><button data-choice="cloud" bindtap="resolve" disabled="{{busy}}">采用云端存档</button><button data-choice="local" bindtap="resolve" disabled="{{busy}}">采用本机存档</button></view>
<view wx:if="{{entry}}" class="fx-card"><view class="fx-card-title">{{entry.status === 'sealed' ? '纪念记录（仍可编辑）' : '记录草稿'}}</view><textarea value="{{entry.text}}" maxlength="1000" data-field="text" bindinput="input" placeholder="写下你愿意记录的内容……" disabled="{{busy}}" /><view class="fx-note">{{entry.text.length}} / 1000 字</view><input value="{{entry.name}}" maxlength="40" data-field="name" bindinput="input" placeholder="落款（可不填）" disabled="{{busy}}" /><view wx:for="{{entry.photos}}" wx:key="index"><image class="fx-photo" src="{{item}}" mode="aspectFit" /><button bindtap="removePhoto" data-index="{{index}}" disabled="{{busy}}">移除此照片</button></view><button wx:if="{{entry.photos.length < 4}}" bindtap="photo" disabled="{{busy}}">添加照片（可选，最多 4 张）</button><view class="fx-row"><button bindtap="save" data-status="draft" disabled="{{busy}}">保存草稿</button><button class="fx-primary" bindtap="save" data-status="sealed" disabled="{{busy}}">落款封存</button></view><button bindtap="export" disabled="{{busy}}">导出纪念图</button><button wx:for="{{exports}}" wx:key="index" bindtap="album" data-path="{{item}}">保存第 {{index + 1}} 张到相册</button><button bindtap="close" disabled="{{busy}}">收起编辑</button></view>
<view wx:if="{{!entries.length}}" class="fx-card fx-note">还没有私人记录。可以只写一句话，或保存一页空白纪念。</view><view wx:for="{{entries}}" wx:key="id" class="fx-card"><view class="fx-tag">{{item.status === 'sealed' ? '已封存' : '草稿'}}</view><view class="fx-body">{{item.text || '未填写文字'}}</view><view class="fx-note">{{item.name || '未署名'}} · {{item.photos.length}} 张照片</view><view class="fx-row"><button bindtap="edit" data-id="{{item.id}}" disabled="{{busy}}">编辑 / 导出</button><button bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">删除</button></view></view><view class="fx-line"></view><button bindtap="finish" disabled="{{busy}}">结束今日体验，查看次日入口</button><view class="fx-note">结束后仍可返回原题目补做，不会自动解锁答题成就。</view></view><canvas canvas-id="journalCanvas" class="fx-export" style="width:750px;height:1200px;" />

