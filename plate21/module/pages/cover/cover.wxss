/* P00 封面 */
.page.page-shell {
  position: relative;
  height: auto;
  min-height: 100%;
  max-height: none;
  overflow: visible;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: 120rpx;
  padding-left: 52rpx; /* 给左侧活页装订孔列让位 */
}

/* v1.3.1：真实吊牌 + 叠字编号 */
.page-tag {
  position: absolute;
  top: calc(var(--sbh, 20px) + 106px);
  right: 48rpx;
  width: 130rpx;
  z-index: 60;
}
.page-tag-img {
  width: 130rpx;
  height: 238rpx;
  display: block;
}
.page-tag-no {
  position: absolute;
  left: 0;
  right: 0;
  top: 108rpx;
  text-align: center;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--coffee);
}

/* ---------- 已授权 AI 档案主图 ---------- */
.img-ph {
  background: var(--paper2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.img-ph-code {
  font-size: 24rpx;
  color: var(--ink60);
  letter-spacing: 4rpx;
}
.img-ph-desc {
  font-size: 22rpx;
  color: var(--ink60);
  margin-top: 8rpx;
}

/* ---------- 上 1/3：主视觉 + 排线 ---------- */
.hero {
  position: relative;
  height: 30%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}
/* v1.3 手账：邮票齿孔框包裹主视觉（边距与排线对齐） */
.hero-perfo {
  flex: 1;
  margin: 0 40rpx;
  position: relative;
}
.hero-img {
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}
.hero-photo {
  width: 100%;
  height: 100%;
  display: block;
}
/* v1.3 手账：考察者手记批注，收进主视觉图框内侧下缘，不压框线 */
.hero-note {
  position: absolute;
  left: 72rpx;
  bottom: 64rpx;
  z-index: 8;
}
/* v1.3 手账：朱砂日期章，盖在主视觉右下角 */
.cover-stamp {
  position: absolute;
  right: 56rpx;
  bottom: 40rpx;
  z-index: 8;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}
/* v1.3.1：邮戳贴纸，压在主视觉右上角、微微出框 */
.sticker-postmark {
  position: absolute;
  top: -34rpx;
  right: -26rpx;
  width: 250rpx;
  height: 164rpx;
  opacity: 0.92;
  z-index: 9;
}
/* 排线从左到右显现一次（设计文档 §1.5 排线逐笔显现 1200ms） */
.hero-hatch {
  margin: 8rpx 40rpx 0;
  transform-origin: left center;
  animation: hatch-in 1.2s ease both;
}
@keyframes hatch-in {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

/* ---------- 中部：拱券顶饰 + 书名 + 印章 ---------- */
.middle {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}
.middle .arch {
  margin-bottom: 32rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--ink-deep);
}
/* 书名下旧金 1rpx 分隔线（两端渐隐） */
.title-line {
  margin-top: 20rpx;
  width: 320rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(169, 143, 95, 0) 0%, rgba(169, 143, 95, 0.7) 50%, rgba(169, 143, 95, 0) 100%);
}
/* 朱砂方印「第二十一图」：白文（纸色字朱砂底）、楷体、旋转 -3° */
.seal {
  margin-top: 20rpx;
  width: 168rpx;
  height: 168rpx;
  background: var(--cinnabar);
  border-radius: 8rpx;
  box-shadow: inset 0 0 0 4rpx rgba(247, 244, 236, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-3deg);
}
.seal-text {
  font-size: 44rpx;
  line-height: 1.2;
  color: var(--paper);
}

/* ---------- 下部按钮区：考察凭证票根卡 ---------- */
.torn-divider {
  margin: 8rpx 24rpx 0 0; /* page 已有左 padding，右侧对齐内容区 */
}
.entry {
  margin: 0 40rpx 32rpx;
  position: relative;
}
/* v1.3.1：干花标本贴纸，从票根卡左侧探出 */
.sticker-botanical {
  position: absolute;
  left: -46rpx;
  bottom: -30rpx;
  width: 140rpx;
  height: 218rpx;
  z-index: 5;
}
.entry-card {
  padding: 32rpx 40rpx 28rpx;
}
.entry-meta {
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--coffee);
  margin-bottom: 28rpx;
}
.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.restart {
  margin-top: 24rpx;
}
.coach-hit {
  display: inline-flex;
  align-self: center;
}
/* 宿主铺满本次量到的可视区域，组件内 absolute 与按钮同一套 px */
.coach-host {
  position: fixed !important;
  z-index: 140;
  pointer-events: none;
  overflow: hidden;
}

/* ---------- 底部小字入口 ---------- */
.foot-links {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 64rpx;
}
.link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--ink60);
  letter-spacing: 4rpx;
  padding: 12rpx 24rpx;
}

.link-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.link-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--dash);
}

/* ---------- 重新考察确认 ---------- */
.restart-mask {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(46, 31, 13, 0.58);
}
.restart-card {
  width: 610rpx;
  padding: 42rpx 40rpx 36rpx;
  box-sizing: border-box;
}
.restart-kicker {
  font-family: "Courier New", monospace;
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: var(--coffee);
}
.restart-title {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-deep);
}
.restart-copy {
  margin-top: 28rpx;
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--ink);
}
.restart-actions {
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.restart-keep,
.restart-confirm {
  width: 100%;
  box-sizing: border-box;
}
.restart-confirm {
  color: var(--cinnabar);
  border-color: var(--cinnabar);
}
