<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell paper-grain paper-real">
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
  <view class="binder"></view>
  <image class="comic-botanical" src="/plate21/module/assets/img/stickers/st-botanical-01.png" mode="aspectFit" />
  <view class="page-head">
    <view class="tag-no">No.S3</view>
  </view>

  <view class="novel">
    <view class="novel-p"><gloss-text parts="{{introParts}}" bind:glossary="onGlossary" /></view>
  </view>
  <view class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">观看小程序不同时辰喷水示意，回答14时对应由哪个兽首喷水，并推测正午时候由哪个兽首喷水</text></view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" dock="{{true}}" />

  <view class="comic-plate double-frame" role="img" aria-label="十二兽首按时辰喷水的四格漫画">
    <view class="tape" style="top:-20rpx; left:50%; margin-left:-90rpx;"></view>
    <image class="comic-image img-aged" src="/assets/fig/IMG-RUNTIME-COMIC.jpg" mode="widthFix" />
  </view>
  <view class="comic-captions">
    <view class="comic-caption" wx:for="{{cells}}" wx:key="id" wx:for-index="index">
      <view class="panel-no serif">第 {{index + 1}} 格 · {{item.time}}</view>
      <view class="cell-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="q" wx:if="{{!followup}}">
    <view class="q-title serif">14 时对应由哪个兽首喷水？</view>
    <input class="answer-input" value="{{q1}}" bindinput="onInputQ1" placeholder="写一个生肖" maxlength="4" disabled="{{solved}}" />
    <view class="q-title serif">正午时候由哪个兽首喷水？</view>
    <input class="answer-input" value="{{q2}}" bindinput="onInputQ2" placeholder="写一个生肖" maxlength="4" disabled="{{solved}}" />
    <view class="hint" wx:if="{{hint}}">{{hint}}</view>
    <button class="btn-seal" bindtap="onConfirm" disabled="{{!q1 || !q2 || solved}}">就 是 这 样</button>
  </view>

  <view class="followup" wx:if="{{followup}}">
    <view class="novel-p">答案确认后，画面里的十二生肖一个接一个亮起，到了正午，十二道水流同时喷出。</view>
    <view class="novel-p">昔日竟然如此壮观，可如今却只剩下断壁残垣。这些兽首流离失所，有七尊归来了，但还有五尊不知所踪。</view>
    <button class="btn-seal" bindtap="onNext" disabled="{{advancing}}">前往转盘花纹匹配</button>
  </view>
</scroll-view>
</view>

<history-card
  visible="{{showHistory}}"
  title="海晏堂 · 水力钟"
  source="《西洋楼铜版图·海晏堂西面》"
  lines="{{historyLines}}"
  corner-number="{{cardNumber}}"
  show-corner="{{showHistory}}"
  btn-text="继 续"
  bind:next="onHistoryNext"
  bind:close="onCloseHistory"
/>
<!-- 术语史料卡（导语「海晏堂」SL-12 点入） -->
<history-card
  wx:if="{{gloss}}"
  visible="{{!!gloss}}"
  title="{{gloss.title}}"
  source="{{gloss.source}}"
  lines="{{gloss.lines}}" layered="{{gloss.layered}}" image="{{gloss.image}}" caption="{{gloss.caption}}"
  btn-text="学到了"
  bind:next="onGlossClose"
  bind:close="onGlossClose"
/>
<stamp-toast id="stamp" />
