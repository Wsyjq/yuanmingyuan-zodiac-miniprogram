/* P07 时辰漫画推理 */
.page {
  position: relative;
  height: 100%;
  overflow: hidden;
  padding: 140rpx 48rpx 40rpx 100rpx; /* 左 100rpx = 48 + 52 让位 .binder */
  box-sizing: border-box;
}

/* 页眉：档案编号标签（右端，避让返回按钮与胶囊） */
.page-head {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

/* 手写批注：漫画旁 / 小问旁 */
.note-comic {
  margin-top: 20rpx;
  text-align: right;
}
.note-q {
  margin-top: 24rpx;
}

.novel-p {
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
  margin-bottom: 24rpx;
}

/* 已授权 AI 四格漫画 + 非颜色文字索引。 */
.comic-plate {
  position: relative;
  margin-top: 32rpx;
  padding: 14rpx;
  overflow: hidden;
  background: var(--paper2);
}
.comic-image {
  display: block;
  width: 100%;
  height: auto;
  max-height: 360rpx;
  object-fit: contain;
  filter: sepia(.18) saturate(.82) contrast(1.03);
  mix-blend-mode: multiply;
}
.comic-captions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}
.comic-caption {
  position: relative;
  background: var(--paper2);
  min-width: 0;
  min-height: 112rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  border-left: 4rpx solid var(--coffee);
}
.cell-clue {
  border: 2rpx solid var(--brass);
  border-left-width: 6rpx;
  box-shadow: 0 0 12rpx rgba(169, 143, 95, 0.4);
}
.panel-no { color: var(--coffee); font-size: 20rpx; letter-spacing: 2rpx; }
.cell-desc {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--ink);
}

.q {
  margin-top: 48rpx;
}
.q-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
}
.q-sub {
  font-size: 22rpx;
  color: var(--ink60);
  margin-top: 12rpx;
}

/* 小问一：6 候选兽首 */
.heads {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.head {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--paper2);
  border: 1rpx solid var(--dash);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-family: STSong, serif;
  color: var(--ink);
  transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  min-height: 88rpx;
}
.head-sel {
  border: 2rpx solid var(--brass);
}
/* INT-404：答对即时正反馈——铜绿描金 + 柔光（300ms 高亮过渡） */
.head-correct {
  border: 2rpx solid var(--patina);
  background: rgba(74, 107, 100, 0.16);
  box-shadow: 0 0 16rpx rgba(74, 107, 100, 0.45);
}

/* 小问二：十二时辰网格 */
.hours {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.hour {
  width: 150rpx;
  padding: 20rpx 0;
  text-align: center;
  background: var(--paper2);
  border: 1rpx solid var(--dash);
  font-size: 28rpx;
  color: var(--ink);
  min-height: 88rpx;
  box-sizing: border-box;
}
.hour-sel {
  border: 2rpx solid var(--brass);
}

/* 负反馈：轻晃 */
.shake {
  animation: shake 400ms ease;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-5rpx); }
}

.hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--patina);
  line-height: 1.8;
}

.followup {
  margin-top: 48rpx;
}

/* v1.3.1：干花标本贴纸压在页右上角（绝对定位页边） */
.comic-botanical {
  position: absolute;
  top: 20rpx;
  right: 8rpx;
  width: 170rpx;
  height: 150rpx;
  transform: rotate(7deg);
  opacity: 0.88;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}

/* V2.1 可跳通道 */
.skip-btn { display: block; width: auto; min-height: 0; line-height: 1.6; margin: 20rpx auto 0; padding: 6rpx 10rpx; border: 0; border-bottom: 2rpx dotted currentColor; border-radius: 0; background: transparent; font-size: 26rpx; }
.skip-btn::after { border: 0; }
