/* P07 时辰漫画推理 */
.page {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 48rpx 120rpx 100rpx; /* 左 100rpx = 48 + 52 让位 .binder */
  box-sizing: border-box;
}

/* 页眉：档案编号标签（右端，避让返回按钮与胶囊） */
.page-head {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

/* 手写批注：漫画旁 / 小问旁 */
.note-comic {
  margin-top: 20rpx;
  text-align: right;
}
.note-q {
  margin-top: 24rpx;
}

.novel-p {
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
  margin-bottom: 24rpx;
}

/* 四格漫画（竖排占位） */
.comic {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.cell {
  position: relative;
  background: var(--paper2);
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}
/* IMG-S3A 四格漫画局部作每格半透明装饰底（按格序 background-position 偏移取对应格） */
.cell-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--paper2);
  opacity: 0.5;
  z-index: 0;
  pointer-events: none;
}
.cell > view:not(.cell-bg) { position: relative; z-index: 1; }
.cell-clue {
  border: 2rpx solid var(--brass);
  box-shadow: 0 0 12rpx rgba(169, 143, 95, 0.4);
}
.cell-tag {
  font-size: 22rpx;
  color: var(--ink60);
  letter-spacing: 4rpx;
}
.cell-desc {
  font-size: 26rpx;
  color: var(--ink);
  margin-top: 10rpx;
}

.q {
  margin-top: 48rpx;
}
.q-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
}
.q-sub {
  font-size: 22rpx;
  color: var(--ink60);
  margin-top: 12rpx;
}

/* 小问一：6 候选兽首 */
.heads {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.head {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--paper2);
  border: 1rpx solid var(--dash);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-family: STSong, serif;
  color: var(--ink);
  transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
}
.head-sel {
  border: 2rpx solid var(--brass);
}
/* INT-404：答对即时正反馈——铜绿描金 + 柔光（300ms 高亮过渡） */
.head-correct {
  border: 2rpx solid var(--patina);
  background: rgba(74, 107, 100, 0.16);
  box-shadow: 0 0 16rpx rgba(74, 107, 100, 0.45);
}

/* 小问二：十二时辰网格 */
.hours {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.hour {
  width: 150rpx;
  padding: 20rpx 0;
  text-align: center;
  background: var(--paper2);
  border: 1rpx solid var(--dash);
  font-size: 28rpx;
  color: var(--ink);
}
.hour-sel {
  border: 2rpx solid var(--brass);
}

/* 负反馈：轻晃 */
.shake {
  animation: shake 400ms ease;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-5rpx); }
}

.hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--patina);
  line-height: 1.8;
}

.followup {
  margin-top: 48rpx;
}

/* v1.3.1：干花标本贴纸压在页右上角（绝对定位页边） */
.comic-botanical {
  position: absolute;
  top: 20rpx;
  right: -28rpx;
  width: 170rpx;
  height: 150rpx;
  transform: rotate(7deg);
  opacity: 0.88;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
