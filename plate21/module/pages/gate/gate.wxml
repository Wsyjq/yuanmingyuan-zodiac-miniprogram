<!-- 门票门页：未解锁=门票卡（买票进场）；已解锁=自动放行 cover -->
<view class="page page-shell gate-page paper-grain paper-real">
  <view wx:if="{{state === 'checking'}}" class="gate-state note-hand">检票中……</view>

  <block wx:else>
    <!-- 门票主体 -->
    <view class="gate-ticket clip-card {{state === 'paid' ? '' : 'tilt-l'}}">
      <view class="corner tl"></view>
      <view class="corner tr"></view>
      <view class="corner bl"></view>
      <view class="corner br"></view>

      <view class="gate-head">
        <view class="gate-eyebrow">西洋楼铜版图 · 实景解谜</view>
        <view class="gate-title serif">第二十一图 · 完整考察</view>
      </view>

      <view class="gate-includes">
        <view class="gate-line kaiti">沿四站走一遍：入口破译 · 黄花阵 · 海晏堂 · 大水法 · 雨果</view>
        <view class="gate-line kaiti">集齐八张日期卡，绘制并保存属于你的「第二十一图」</view>
        <view class="gate-line kaiti">次日之信 · 考察者留言簿 · 六处顺路支线</view>
      </view>

      <!-- 撕票线 -->
      <view class="gate-perforation">
        <view class="gate-notch notch-l"></view>
        <view class="gate-dash"></view>
        <view class="gate-notch notch-r"></view>
      </view>

      <!-- 票根：价格 + 购买 -->
      <view class="gate-stub">
        <view class="gate-price-block">
          <view class="gate-price-label">门票</view>
          <view class="gate-price serif">{{priceText}}</view>
          <view class="gate-price-note">一次解锁 · 此账号长期有效</view>
        </view>

        <view wx:if="{{state === 'locked'}}" class="gate-buy {{purchasing ? 'busy' : ''}}" bindtap="onUnlock" role="button" aria-label="解锁完整考察">
          {{purchasing ? '正在解锁……' : '解锁完整考察'}}
        </view>
        <view wx:elif="{{state === 'paid'}}" class="gate-paid">
          <view class="gate-paid-stamp">已检票</view>
          <view class="gate-paid-text kaiti">正在进入考察……</view>
        </view>
        <view wx:else class="gate-unavailable">
          <view class="gate-unavailable-text kaiti">完整版暂未开放购买</view>
          <view class="gate-unavailable-sub">可先返回，体验园内其他内容</view>
        </view>
      </view>
    </view>

    <view class="gate-foot note-hand">持票进场。走不完的那天，档案会等你回来。</view>
    <view class="gate-back" bindtap="onBackHome">返回</view>
  </block>
</view>
