page {
  background: #F4EDDC;
}

.gate {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 48rpx 80rpx;
  background: #F4EDDC;
  color: #2E1F0D;
}

.ticket {
  position: relative;
  box-sizing: border-box;
  padding: 56rpx 40rpx 44rpx;
  background: #FBF6EA;
  border: 4rpx solid #2E1F0D;
  box-shadow: 8rpx 10rpx 0 rgba(70, 56, 42, 0.08);
}

.kicker {
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #4A6B64;
}

.title {
  margin-top: 12rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #2E1F0D;
}

.dash {
  position: relative;
  margin: 40rpx -40rpx 32rpx;
  border-top: 4rpx dashed #C0B49A;
}

.notch {
  position: absolute;
  top: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #F4EDDC;
}

.notch.l { left: -16rpx; }
.notch.r { right: -16rpx; }

.label {
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #8A7A60;
}

.price {
  margin-top: 8rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #A63A2E;
}

.note {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A7A60;
}

.pay {
  position: relative;
  margin-top: 40rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pay-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.pay-label {
  position: relative;
  z-index: 1;
  color: #6E241C;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
}

.pay.busy {
  opacity: 0.7;
}

.back {
  margin-top: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #2E1F0D;
}
