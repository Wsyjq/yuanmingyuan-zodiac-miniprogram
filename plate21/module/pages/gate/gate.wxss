/* 门票门页：票根风（虚线撕票线 + 两侧票孔 + 朱砂检票章） */
.gate-page {
  min-height: 100vh;
  padding: 88rpx 48rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gate-state {
  margin-top: 220rpx;
}

.gate-ticket {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 44rpx 40rpx 0;
}

/* ---------- 票头 ---------- */
.gate-head {
  text-align: center;
}
.gate-eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--patina);
}
.gate-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.gate-includes {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.gate-line {
  position: relative;
  padding-left: 26rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}
.gate-line::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 18rpx;
  width: 10rpx;
  height: 10rpx;
  background: var(--cinnabar);
  transform: rotate(45deg);
  opacity: 0.75;
}

/* ---------- 撕票线 ---------- */
.gate-perforation {
  position: relative;
  display: flex;
  align-items: center;
  margin: 40rpx -40rpx 0;
}
.gate-notch {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--paper);
  box-shadow: inset 0 2rpx 6rpx rgba(70, 56, 42, 0.18);
  z-index: 2;
}
.notch-l { left: -14rpx; }
.notch-r { right: -14rpx; }
.gate-dash {
  flex: 1;
  border-top: 3rpx dashed var(--dash);
}

/* ---------- 票根 ---------- */
.gate-stub {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 0 40rpx;
}
.gate-price-block {
  flex-shrink: 0;
  min-width: 200rpx;
}
.gate-price-label {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink60);
}
.gate-price {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--cinnabar);
  line-height: 1.1;
}
.gate-price-note {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--ink60);
}

.gate-buy {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  border: 2rpx solid var(--cinnabar);
  border-radius: 8rpx;
  background: rgba(166, 58, 46, 0.08);
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: var(--cinnabar);
}
.gate-buy:active,
.gate-buy.busy {
  transform: scale(0.97);
  background: rgba(166, 58, 46, 0.16);
}

.gate-paid {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.gate-paid-stamp {
  width: 108rpx;
  height: 108rpx;
  border: 3rpx solid var(--cinnabar);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  font-family: "STKaiti", "KaiTi", serif;
  color: var(--cinnabar);
  transform: rotate(-8deg);
  opacity: 0.9;
}
.gate-paid-text {
  font-size: 26rpx;
  color: var(--ink);
}

.gate-unavailable {
  flex: 1;
  text-align: center;
}
.gate-unavailable-text {
  font-size: 28rpx;
  color: var(--ink);
}
.gate-unavailable-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink60);
}

/* ---------- 页脚 ---------- */
.gate-foot {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--ink60);
}
.gate-back {
  margin-top: 26rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--patina);
  padding: 8rpx 28rpx;
  border: 2rpx solid var(--dash);
  border-radius: 999rpx;
}
.gate-back:active {
  color: var(--ink);
}
