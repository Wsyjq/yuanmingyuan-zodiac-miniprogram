page {
  background: #F4EDDC;
}

.gate {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx 80rpx;
  background: #F4EDDC;
  color: #2E1F0D;
}

.card {
  box-sizing: border-box;
  padding: 48rpx 36rpx 40rpx;
  background: #FBF6EA;
  border: 2rpx solid rgba(46, 31, 13, 0.28);
}

.kicker {
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #4A6B64;
}

.title {
  margin-top: 16rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #2E1F0D;
}

.line {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #2E1F0D;
}

.dash {
  margin: 36rpx 0 28rpx;
  border-top: 3rpx dashed #C0B49A;
}

.label {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #8A7A60;
}

.price {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #A63A2E;
}

.note {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #8A7A60;
}

.pay {
  margin-top: 36rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #6E241C;
  color: #F7F4EC;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.pay.busy {
  opacity: 0.7;
}

.foot {
  margin-top: 36rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8A7A60;
}

.back {
  margin-top: 28rpx;
  text-align: center;
  font-size: 30rpx;
  color: #2E1F0D;
}
