page { background: #F4EDDC; }

.gate-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gate-tag {
  align-self: flex-end;
  margin-bottom: 40rpx;
}

.gate-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 72rpx 40rpx 64rpx;
  text-align: center;
  background: #FBF6EA;
}

.gate-title {
  font-size: 40rpx;
  letter-spacing: 8rpx;
  color: var(--ink, #46382A);
  margin-bottom: 20rpx;
}

.gate-note {
  font-size: 26rpx;
  color: rgba(70, 56, 42, 0.72);
  margin-bottom: 28rpx;
}

.gate-dots .dot {
  display: inline-block;
  margin: 0 6rpx;
  font-size: 40rpx;
  line-height: 1;
  color: var(--cinnabar, #A63A2E);
  animation: gatePulse 1.1s ease-in-out infinite;
}

.gate-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.gate-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes gatePulse {
  0%, 100% { opacity: 0.2; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-6rpx); }
}
