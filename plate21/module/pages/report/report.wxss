page{background:#f1e9d8;color:#443727}.report-page{padding:38rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));box-sizing:border-box;max-width:900rpx;margin:0 auto}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#8a7351}.report-title{font-family:serif;font-size:48rpx;letter-spacing:3rpx;margin-top:22rpx}.report-subtitle{font-size:28rpx;line-height:1.8;color:#796347;margin-top:14rpx}.identity{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12rpx;font-size:27rpx;margin:24rpx 0 32rpx;border-top:1rpx solid #c9b99c;padding-top:22rpx;word-break:break-all}.artwork-preview{display:block;width:100%;margin:16rpx 0 24rpx;box-shadow:0 6rpx 18rpx #6b502321;background:#e6dac2}.artwork-section{margin-bottom:32rpx}.section{margin-top:36rpx;padding:30rpx 26rpx;background:#f8f2e7;border:1rpx solid #d3c3a7}.section-title{font-family:serif;font-size:34rpx;margin-bottom:22rpx}.count{font:24rpx sans-serif;color:#887351;margin-left:12rpx}.small-note{font-size:25rpx;line-height:1.7;color:#837051;word-break:break-word}.button-row{display:flex;flex-wrap:wrap;gap:18rpx;margin-top:22rpx}.report-button{font-size:28rpx;line-height:1.6;padding:18rpx 24rpx;min-height:86rpx;border:1rpx solid #aa9270;border-radius:4rpx;background:#eee1c9;color:#5b4128;white-space:normal;margin:0;display:flex;align-items:center;justify-content:center}.report-button::after{border:0}.report-button.primary{background:#823d30;color:#fff0d4;border-color:#823d30}.report-button[disabled]{opacity:.48}.button-row .report-button{flex:1;min-width:190rpx}.notice{padding:22rpx;font-size:28rpx;line-height:1.7;background:#e8dcc3;margin:20rpx 0;word-break:break-word}.error{color:#8c4030}.empty-art{height:220rpx;display:flex;align-items:center;justify-content:center;background:#e6dac2;color:#8a7554;font-size:28rpx;padding:30rpx;text-align:center}.stations{display:grid;grid-template-columns:1fr 1fr;gap:18rpx 28rpx}.station{font-size:27rpx;display:flex;flex-direction:column;gap:7rpx}.station-status{font-size:23rpx;color:#8d7b61}.station-status.done{color:#4a7063}.station-status.skipped{color:#997e51}.photos{display:grid;grid-template-columns:1fr 1fr;gap:28rpx 20rpx}.field-photo{display:block;width:100%;height:216rpx;background:#e6dccb}.missing-photo{display:flex;align-items:center;justify-content:center;font-size:25rpx;color:#877151}.photo-label{font-size:25rpx;color:#806645;line-height:1.6;margin:10rpx 0;word-break:break-all}.record-actions{display:flex;gap:12rpx;margin-top:12rpx}.record-actions button{font-size:25rpx;line-height:1.5;padding:14rpx 18rpx;min-height:70rpx;flex:1;margin:0;background:#ede3d2;color:#6d5237;border-radius:3rpx}.record-actions button::after{border:0}.text-record+.text-record{border-top:1rpx solid #d3c3a7;padding-top:24rpx;margin-top:24rpx}.record-body{display:block;font-size:29rpx;line-height:1.9;white-space:pre-wrap;word-break:break-word}.site-picker{font-size:27rpx;padding:20rpx 18rpx;border:1rpx solid #c9b99c;line-height:1.6;display:flex;align-items:center;justify-content:space-between;gap:10rpx}.note-input{box-sizing:border-box;width:100%;min-height:220rpx;margin-top:20rpx;border:1rpx solid #c9b99c;padding:20rpx;background:#fffaf0;color:#483823;font-size:29rpx;line-height:1.8}.counter{text-align:right;margin-top:8rpx}.editor .small-note:last-child{margin-top:20rpx}.editor>.report-button{margin-top:16rpx;width:100%}.letter-card{background:#e5dcc7}.letter-message{font-size:28rpx;line-height:1.8;margin-bottom:22rpx}.letter-card .report-button{width:100%}.return-button{width:100%;margin-top:36rpx}.export-canvas{position:fixed;left:-3000px;top:0;opacity:0;pointer-events:none}
