<view class="report-page">
  <view wx:if="{{loading}}" class="notice">正在翻开你的考察档案……</view>
  <view wx:elif="{{loadError}}" class="notice error">
    <view>{{loadError}}</view><button class="report-button" bindtap="onRetryLoad">重新读取</button>
  </view>
  <block wx:elif="{{model}}">
    <view class="eyebrow">FIELD ARCHIVE · 个人考察档案</view>
    <view class="report-title">我的第二十一图</view>
    <view class="report-subtitle">{{model.completed ? '考察已经完成，这份作品仍可以补充。' : '这是一份考察草稿，完成后会保留署名与日期。'}}</view>
    <view class="identity"><text>{{model.name}}</text><text>{{model.dateLabel}}</text></view>

    <view class="artwork-section">
      <view wx:if="{{generating}}" class="notice">正在把你的照片和观察编入作品……</view>
      <image wx:for="{{previewImages}}" wx:key="filePath" class="artwork-preview" src="{{item.filePath}}" mode="widthFix" data-index="{{index}}" bindtap="onPreviewArtwork" aria-label="预览个人作品第{{item.number}}页" />
      <view wx:if="{{!previewImages.length && !generating}}" class="empty-art">作品还未生成。你的记录已经保存在下方。</view>
      <view class="small-note">底图为遗址示意线稿；照片只来自你留下的现场记录。{{sheetCount > 1 ? '记录较多，作品会分成 ' + sheetCount + ' 页，完整保留每条记录。' : ''}}</view>
      <view wx:if="{{exportWarning}}" class="notice">{{exportWarning}}</view>
      <view class="button-row">
        <button class="report-button primary" bindtap="onSave" disabled="{{generating || saving || busy}}">{{saving ? '保存中…' : (savedCount && savedCount === previewImages.length ? '已保存到相册' : '保存到相册')}}</button>
        <button class="report-button" bindtap="onRegenerate" disabled="{{generating || saving || busy}}">重新生成</button>
      </view>
      <view wx:if="{{saving || savedCount}}" class="small-note">已保存 {{savedCount}} / {{sheetCount}} 页</view>
      <view wx:if="{{saveError}}" class="notice error">{{saveError}}</view>
      <button wx:if="{{canOpenAlbumSettings}}" class="report-button" bindtap="onOpenAlbumSettings">打开相册权限设置</button>
    </view>

    <view class="section">
      <view class="section-title">八站记录</view>
      <view class="stations">
        <view wx:for="{{model.stations}}" wx:key="id" class="station"><text>{{item.label}}</text><text class="station-status {{item.status}}">{{item.stateLabel}}</text></view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">我的现场照片 <text class="count">{{model.photos.length}}</text></view>
      <view wx:if="{{!model.photos.length}}" class="small-note">还没有现场照片。可以补上一张，也可以保留文字作品。</view>
      <view class="photos">
        <view wx:for="{{model.photos}}" wx:key="id" class="photo-card">
          <image wx:if="{{item.filePath}}" class="field-photo" src="{{item.filePath}}" mode="aspectFill" data-id="{{item.id}}" bindtap="onPreviewPhoto" aria-label="预览{{item.title}}照片" />
          <view wx:else class="field-photo missing-photo">照片待补充</view>
          <view class="photo-label">{{item.title}}</view>
          <view class="record-actions"><button data-id="{{item.id}}" bindtap="onReplacePhoto" disabled="{{busy || generating || saving}}">替换</button><button data-id="{{item.id}}" bindtap="onDeleteRecord" disabled="{{busy || generating || saving}}">删除</button></view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">观察笔记 <text class="count">{{model.texts.length}}</text></view>
      <view wx:if="{{!model.texts.length}}" class="small-note">你记住了什么，或还有什么想再看一眼？</view>
      <view wx:for="{{model.texts}}" wx:key="id" class="text-record">
        <view class="photo-label">{{item.title}}</view><text class="record-body" selectable>{{item.text}}</text>
        <view class="record-actions"><button data-id="{{item.id}}" bindtap="onEditText" disabled="{{busy || generating || saving}}">修改</button><button data-id="{{item.id}}" bindtap="onDeleteRecord" disabled="{{busy || generating || saving}}">删除</button></view>
      </view>
    </view>

    <view class="section editor" id="recordEditor">
      <view class="section-title">{{editingTextId ? '修改这条观察' : '补充一条记录'}}</view>
      <picker mode="selector" range="{{siteOptions}}" range-key="label" value="{{siteIndex}}" bindchange="onSiteChange"><view class="site-picker">关联地点：{{siteOptions[siteIndex].label}} <text>⌄</text></view></picker>
      <textarea class="note-input" value="{{draftText}}" bindinput="onTextInput" maxlength="500" auto-height placeholder="写下自己的观察；也可以只补充照片。" aria-label="个人观察笔记" />
      <view class="small-note counter">{{draftText.length}} / 500</view>
      <view class="button-row"><button class="report-button primary" bindtap="onSaveText" disabled="{{busy || generating || saving}}">{{busy ? '保存中…' : '保存文字'}}</button><button class="report-button" bindtap="onAddPhoto" disabled="{{busy || generating || saving}}">补充照片</button></view>
      <button wx:if="{{editingTextId}}" class="report-button" bindtap="onCancelEdit" disabled="{{busy}}">取消修改</button>
      <view wx:if="{{recordError}}" class="notice error">{{recordError}}</view>
      <view class="small-note">这些是你的私人记录。补充、替换或删除不会改变原完成日期，也不会把跳过的站点改成已完成。</view>
    </view>

    <view wx:if="{{model.completed}}" class="section letter-card">
      <view class="section-title">{{letterAvailable ? '来信已可启封' : '一封稍后来到的信'}}</view>
      <view class="letter-message">{{letterChecking ? '正在确认来信状态……' : letterMessage}}</view>
      <button class="report-button" bindtap="onOpenLetter" disabled="{{letterOpening || letterChecking}}">{{letterOpening ? '正在启封…' : (letterAvailable ? '阅读来信' : '检查来信')}}</button>
    </view>
    <button class="report-button return-button" bindtap="onReturn" disabled="{{busy || saving}}">返回考察</button>
  </block>
  <canvas type="2d" id="reportCanvas" class="export-canvas" style="width:700px;height:2000px;" />
</view>
