<nav-back />
<!-- v1.3.1 手账：左侧活页装订孔列（移到 .page 外，避免 flex 影响 fixed） -->
<view class="binder"></view>
<view class="page page-shell paper-grain">
<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">

  <!-- v1.3.1 手账：票根贴纸压在标题右上角，像手册的装订凭证 -->
  <image class="hb-ticket" src="/plate21/module/assets/img/stickers/st-ticket-02.png" mode="aspectFit" />

  <view class="hb-title serif">考察手册</view>
  <view class="hb-sub">西洋楼铜版图 · 第二十一图</view>
  <view class="tag-no hb-tag">No.017</view>

  <!-- 第壹折：五份考察记录位 -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">第壹折 · 四份考察记录</view>
  <!-- v1.3.1 手账：邮票贴纸压在「第壹折」标题旁，归档感 -->
  <image class="hb-stamp" src="/plate21/module/assets/img/stickers/st-stamp-01.png" mode="aspectFit" />
  <view class="slots">
    <view wx:for="{{slots}}" wx:key="key" class="slot-item">
      <view class="slot card-ticket">
        <view class="slot-index">REC.{{item.no}}</view>
        <view class="slot-name serif">{{item.name}}</view>
        <view wx:if="{{item.done}}" class="seal kaiti">已录</view>
        <view wx:else class="seal-empty kaiti">待录</view>
      </view>
      <view class="ticket-edge"></view>
    </view>
  </view>
  <view class="note-hand olive hb-note">已录 {{doneCount}} 则，共四则。</view>

  <!-- 第贰折：玩家实际拍摄的四图考察卡 -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">第贰折 · 亭下考察卡</view>
  <view class="photo-record double-frame">
    <view class="photo-record-head">
      <view>
        <view class="photo-record-kicker">FIELD RECORD · S2-3</view>
        <view class="photo-record-title serif">亭子线稿对眼前这座亭</view>
      </view>
      <view class="photo-record-count">已记 {{photoCount}} / 4 处</view>
    </view>
    <view class="hatch-divider"></view>
    <view class="photo-record-grid">
      <view wx:for="{{fieldPhotos}}" wx:key="key" class="photo-record-item" data-key="{{item.key}}" bindtap="onPreviewPhoto" role="button" aria-label="预览{{item.title}}现场照片">
        <image wx:if="{{item.photoPath}}" class="photo-record-image" src="{{item.photoPath}}" mode="aspectFill" lazy-load="{{true}}" />
        <view wx:else class="photo-record-missing">待补录</view>
        <view class="photo-record-caption"><text>{{item.no}}</text>{{item.title}}</view>
      </view>
    </view>
    <view class="photo-record-note">点击已记录照片可全屏查看。这里不会用参考图替代现场记录。</view>
    <button wx:if="{{photoCount < 4}}" class="btn-line photo-repair" bindtap="onRepairPhotos">前往现场照片页补录</button>
  </view>

  <!-- 第叁折：已收集史料卡 -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">第叁折 · 已收集史料</view>
  <!-- v1.3.1 手账：回形针贴纸压在「第贰折」标题旁，夹史料感 -->
  <image class="hb-paperclip" src="/plate21/module/assets/img/stickers/st-paperclip-01.png" mode="aspectFit" />
  <view class="hlist">
    <view wx:for="{{history}}" wx:key="id" class="hitem">
      <view
        class="hcard card-ticket {{item.available ? '' : 'locked'}}"
        data-index="{{index}}"
        bindtap="onReadHistory"
      >
        <view class="hcard-no">{{item.no}}</view>
        <view class="hcard-main">
          <view class="hcard-title">{{item.title}}</view>
          <view class="hcard-src">〔{{item.source}}〕</view>
        </view>
        <view wx:if="{{item.available}}" class="hcard-badge kaiti">已录</view>
        <view wx:else class="hcard-badge lock kaiti">未录</view>
      </view>
      <view class="ticket-edge"></view>
    </view>
  </view>

  <!-- 第肆折：考察报告缩略位 -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">第肆折 · 考察报告</view>
  <view wx:if="{{finaleDone}}" class="report-thumb">
    <view class="tape" style="top:-20rpx; left:50%; margin-left:-90rpx;"></view>
    <view class="mini-wrap">
      <view class="canvas report-artwork">
        <image class="canvas-bg" src="/plate21/module/assets/img/IMG-RUNTIME-PLATE.jpg" mode="aspectFill" />
        <view class="layer layer-l2"><view class="l2-frame"><view class="l2-inner"></view></view></view>
        <view class="layer layer-l1"><view class="l1-bar"><text class="l1-text kaiti">前二十幅记录建成，此幅记录后来</text></view></view>
        <view class="layer layer-l5">
          <view class="l5-box">
            <text class="l5-line kaiti">1747 —— 本次考察</text>
            <text class="l5-name kaiti">{{name}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="thumb-caption">西洋楼铜版图 · 第二十一图{{name ? ' · ' + name : ''}}{{sessionDateLabel ? ' · ' + sessionDateLabel : ''}}</view>
  </view>
  <view wx:else class="report-empty">
    <text class="report-empty-text">考察报告 · 尚未生成</text>
  </view>

  <!-- 第伍折：成就印记（成就系统解锁记录，详见 store/achievements 规则表） -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">第伍折 · 成就印记</view>
  <view class="ach-list">
    <view wx:for="{{achievementList}}" wx:key="id" class="ach-item {{item.unlocked ? '' : 'locked'}}">
      <view class="ach-seal {{item.unlocked ? 'got' : ''}} kaiti">{{item.unlocked ? '得' : '—'}}</view>
      <view class="ach-main">
        <view class="ach-title serif">{{item.title}}</view>
        <view class="ach-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
  <view class="note-hand olive hb-note">已得 {{achievementCount}} 印，共 {{achievementList.length}} 印。</view>

  <!-- V2.2 独立音频开关：背景音乐 / 人声讲述，各自独立、默认全开（产品定位拍板项） -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">音频 · 独立开关</view>
  <view class="audio-set">
    <view class="audio-set-row">
      <view class="audio-set-main">
        <view class="audio-set-title serif">背景音乐</view>
        <view class="audio-set-sub">各站的氛围曲，循环低音量；人声讲话时自动让路。</view>
      </view>
      <switch checked="{{audioBgm}}" bindchange="onToggleBgm" aria-label="背景音乐开关" color="#4a6b64" />
    </view>
    <view class="audio-set-row">
      <view class="audio-set-main">
        <view class="audio-set-title serif">人声讲述</view>
        <view class="audio-set-sub">台词、旁白与语音导览的播放键；关掉后只读文稿，一处不留按钮。</view>
      </view>
      <switch checked="{{audioVoice}}" bindchange="onToggleVoice" aria-label="人声讲述开关" color="#4a6b64" />
    </view>
  </view>
  <view class="note-hand olive hb-note">两个开关互不影响；大水法那一段什么都不会响——那是设计。</view>

  <!-- v2 顺路散页：可选站点，随时可进；不显示 X/N 完成度（反结算红线） -->
  <view class="hatch-divider sec-div"></view>
  <view class="sec-head serif">路上的页 · 可选</view>
  <view class="side-grid">
    <view
      wx:for="{{sideSites}}"
      wx:key="key"
      class="side-chip {{item.visited ? 'got' : ''}}"
      data-key="{{item.key}}"
      bindtap="onOpenSide"
      role="button"
      aria-label="翻看顺路散页{{item.title}}"
    >
      <text class="side-chip-mark">{{item.visited ? '✓' : '·'}}</text>
      <text class="side-chip-name">{{item.title}}</text>
    </view>
  </view>
  <view class="note-hand olive hb-note">档案里夹着的页，不出日期卡、不做裁判；翻不翻，由你决定。</view>

  <!-- v2 回响：次日之信入口（finale 后出现；当日封蜡，次日出信） -->
  <view class="hatch-divider sec-div"></view>
  <view class="hb-letter {{letterReady ? '' : 'sealed'}}" bindtap="onOpenLetter" role="button" aria-label="次日之信入口">
    <view class="hb-letter-wax kaiti">封</view>
    <view class="hb-letter-main">
      <view class="hb-letter-title serif">{{letterReady ? '有一封信在等你' : '明日启封'}}</view>
      <view class="hb-letter-sub kaiti">{{letterReady ? '来自那个还在整理档案的人' : '明天，这里会有一封写给你的信'}}</view>
    </view>
    <view wx:if="{{letterReady}}" class="hb-letter-arrow">›</view>
  </view>

</scroll-view>
</view>

<history-card
  visible="{{showHistory}}"
  title="{{card.title}}"
  source="{{card.source}}"
  lines="{{card.lines}}"
  bind:collect="onCollectHistory"
  bind:close="onCloseHistory"
/>
