@import "../../styles/report-artwork.wxss";

/* P17 考察手册 */

.page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 100rpx 52rpx; /* 左侧 52rpx 让位 .binder */
  box-sizing: border-box;
}

.hb-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--ink-deep);
}
.hb-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ink60);
}
/* 编号标签：页眉区右端（避让返回按钮与胶囊） */
.hb-tag {
  position: absolute;
  top: 214rpx;
  right: 44rpx;
}
/* 手写批注：第壹折记录位下方页边 */
.hb-note {
  width: 100%;
  max-width: 660rpx;
  margin-top: -8rpx;
  text-align: right;
  transform: rotate(-1deg);
}

.sec-div {
  width: 100%;
  max-width: 660rpx;
  margin: 56rpx 0 32rpx;
}
.sec-head {
  width: 100%;
  max-width: 660rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink-deep);
  margin-bottom: 32rpx;
}

/* v1.3.1：三处贴纸（票根/邮票/回形针），压在标题与折区附近，归档手账感 */
.hb-ticket {
  position: absolute;
  top: 180rpx;
  right: 30rpx;
  width: 180rpx;
  height: 100rpx;
  transform: rotate(5deg);
  opacity: 0.9;
  z-index: 5;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
.hb-stamp {
  position: absolute;
  top: 360rpx;
  left: 60rpx;
  width: 130rpx;
  height: 110rpx;
  transform: rotate(-7deg);
  opacity: 0.9;
  z-index: 5;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
.hb-paperclip {
  position: absolute;
  top: 760rpx;
  right: 56rpx;
  width: 90rpx;
  height: 110rpx;
  transform: rotate(8deg);
  opacity: 0.92;
  z-index: 5;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}

/* ---------- 第壹折：五份考察记录位 ---------- */
.slots {
  width: 100%;
  max-width: 660rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.slot-item {
  width: 200rpx;
  margin-bottom: 28rpx;
}
.slot {
  width: 200rpx;
  height: 220rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-top: 3rpx solid rgba(111, 114, 72, 0.64);
}
.slot-index {
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  color: rgba(122, 92, 62, 0.52);
  font-family: "Courier New", monospace;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}
.slot-name {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--ink);
}
/* 已完成：朱砂印 */
.seal {
  margin-top: 20rpx;
  padding: 6rpx 16rpx;
  border: 3rpx solid var(--cinnabar);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--cinnabar);
  letter-spacing: 4rpx;
  transform: rotate(-6deg);
}
/* 未完成：虚线印位 */
.seal-empty {
  margin-top: 20rpx;
  padding: 6rpx 16rpx;
  border: 2rpx dashed var(--dash);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--dash);
  letter-spacing: 4rpx;
}

/* ---------- 第贰折：玩家四图考察卡 ---------- */
.photo-record { width: 100%; max-width: 660rpx; padding: 28rpx; box-sizing: border-box; }
.photo-record-head { display: flex; align-items: flex-end; justify-content: space-between; }
.photo-record-kicker { font-family: "Courier New", monospace; font-size: 17rpx; letter-spacing: 3rpx; color: var(--coffee); }
.photo-record-title { margin-top: 10rpx; font-size: 30rpx; color: var(--ink-deep); }
.photo-record-count { font-family: "Courier New", monospace; font-size: 23rpx; color: var(--patina); }
.photo-record-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 22rpx; }
.photo-record-item { overflow: hidden; background: var(--paper2); border: 1rpx solid rgba(70, 56, 42, 0.34); }
.photo-record-image, .photo-record-missing { width: 100%; height: 176rpx; }
.photo-record-missing { display: flex; align-items: center; justify-content: center; border-bottom: 1rpx dashed var(--dash); color: var(--dash); font-size: 23rpx; }
.photo-record-caption { padding: 11rpx; font-size: 20rpx; color: var(--ink); }
.photo-record-caption text { margin-right: 8rpx; font-family: "Courier New", monospace; color: var(--coffee); }
.photo-record-note { margin-top: 18rpx; font-size: 21rpx; line-height: 1.7; color: var(--ink60); }
.photo-repair { width: 100%; margin-top: 20rpx; box-sizing: border-box; }

/* ---------- 第叁折：史料卡列表 ---------- */
.hlist {
  width: 100%;
  max-width: 660rpx;
}
.hitem {
  margin-bottom: 24rpx;
}
.hcard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  position: relative;
  border-left: 5rpx solid var(--patina);
}
.hcard-no {
  width: 48rpx;
  flex-shrink: 0;
  color: var(--coffee);
  font-family: "Courier New", monospace;
  font-size: 20rpx;
}
.hcard-main {
  flex: 1;
}
.hcard.locked {
  opacity: 0.55;
}
.hcard-title {
  font-size: 28rpx;
  color: var(--patina);
  letter-spacing: 2rpx;
}
.hcard-src {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink60);
}
.hcard-badge {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 4rpx 14rpx;
  border: 3rpx solid var(--patina);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--patina);
  letter-spacing: 4rpx;
  transform: rotate(-4deg);
}
.hcard-badge.lock {
  border: 2rpx dashed var(--dash);
  color: var(--dash);
  transform: none;
}

/* ---------- 第肆折：考察报告缩略位 ---------- */
.report-thumb {
  position: relative;
  width: 100%;
  max-width: 660rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mini-wrap {
  width: 300rpx;
  height: 407rpx;
  overflow: hidden;
  border: 2rpx solid var(--brass);
}
/* 缩略：整体缩放 finale 同构图画布 */
.mini-wrap .canvas {
  transform: scale(0.4286);
  transform-origin: left top;
}
.thumb-caption {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--ink60);
  letter-spacing: 2rpx;
}
.report-empty {
  width: 300rpx;
  height: 407rpx;
  box-sizing: border-box;
  border: 2rpx dashed var(--dash);
  display: flex;
  align-items: center;
  justify-content: center;
}
.report-empty-text {
  font-size: 24rpx;
  color: var(--dash);
  letter-spacing: 2rpx;
}

/* ---------- 缩略画布（与 finale/report 同构图，宽度 700rpx 基准） ---------- */
.canvas {
  position: relative;
  width: 700rpx;
  height: 950rpx;
  background: var(--paper);
  border: 1rpx solid rgba(70, 56, 42, 0.35);
  overflow: hidden;
}
/* 已授权 AI 第二十一图缩略底图。 */
.canvas-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  mix-blend-mode: multiply;
}
.layer {
  position: absolute;
}
.ph {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: var(--paper2);
}
.layer-l4 {
  top: 200rpx;
  left: 80rpx;
  right: 80rpx;
  height: 640rpx;
  z-index: 2;
}
.layer-l3 {
  top: 320rpx;
  left: 130rpx;
  width: 440rpx;
  height: 460rpx;
  z-index: 3;
}
.layer-l2 {
  top: 170rpx;
  left: 44rpx;
  right: 44rpx;
  bottom: 64rpx;
  z-index: 4;
}
.l2-frame {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 4rpx dashed var(--brass);
}
.layer-l1 {
  top: 28rpx;
  left: 40rpx;
  right: 40rpx;
  height: 116rpx;
  z-index: 5;
}
.l1-bar {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: var(--paper);
  border: 1rpx solid rgba(70, 56, 42, 0.4);
}
.layer-l5 {
  right: 56rpx;
  bottom: 84rpx;
  width: 320rpx;
  z-index: 6;
}
.l5-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.l5-line {
  font-size: 26rpx;
  color: var(--ink);
}
.l5-name {
  margin-top: 4rpx;
  min-height: 36rpx;
  font-size: 28rpx;
  color: var(--cinnabar);
}
