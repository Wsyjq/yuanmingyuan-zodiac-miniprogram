/* v2 回响（次日之信）：竖排信纸 */
.letter-page {
  height: 100%;
  overflow: hidden;
  padding: 56rpx 0 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.letter-state {
  margin-top: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  padding: 0 80rpx;
  text-align: center;
}
.letter-wax {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-family: "STKaiti", "KaiTi", serif;
  box-shadow: inset 0 0 14rpx rgba(0, 0, 0, 0.22), 0 8rpx 20rpx rgba(166, 58, 46, 0.28);
}
.letter-state-title {
  font-size: 38rpx;
  letter-spacing: 8rpx;
  color: var(--ink-deep);
}
.letter-state-text {
  font-size: 28rpx;
  line-height: 2;
  color: var(--ink);
}
.letter-back {
  margin-top: 10rpx;
}

/* 竖排正文：容器高度固定，列自右向左生长，横向滚动 */
.letter-scroll {
  width: 100%;
  height: 80vh;
}
.letter-body {
  writing-mode: vertical-rl;
  height: 100%;
  padding: 24rpx 48rpx;
  box-sizing: border-box;
}
.letter-photo {
  writing-mode: horizontal-tb;
  width: 420rpx;
  margin-left: 28rpx;
}
.letter-para {
  max-height: 100%;
  margin-left: 34rpx;
  font-size: 30rpx;
  line-height: 1.95;
  letter-spacing: 4rpx;
  color: var(--ink);
}
.letter-quote {
  color: var(--coffee);
}
.letter-aside {
  font-size: 26rpx;
  color: var(--ink60);
}
.letter-sign {
  color: var(--cinnabar);
}

/* 信末脚注入口（信正文之外）：去读大家的留言 */
.letter-footnote {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 32rpx;
  border: 2rpx solid var(--dash);
  border-radius: 999rpx;
}
.letter-footnote:active {
  border-color: var(--patina);
}
.letter-footnote-text {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--patina);
}
.letter-footnote-arrow {
  font-size: 28rpx;
  color: var(--patina);
}
.letter-input {
  width: 280rpx;
  min-height: 72rpx;
  margin: 12rpx 0;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--dash);
  background: rgba(255, 252, 245, 0.7);
  font-size: 28rpx;
}
