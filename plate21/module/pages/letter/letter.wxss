/* v2 回响（次日之信）：竖排信纸 */
.letter-page {
  min-height: 100vh;
  padding: 56rpx 0 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.letter-state {
  margin-top: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding: 0 80rpx;
  text-align: center;
}
.letter-wax {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-family: "STKaiti", "KaiTi", serif;
  box-shadow: inset 0 0 14rpx rgba(0, 0, 0, 0.22), 0 8rpx 20rpx rgba(166, 58, 46, 0.28);
}
.letter-state-title {
  font-size: 38rpx;
  letter-spacing: 8rpx;
  color: var(--ink-deep);
}
.letter-state-text {
  font-size: 28rpx;
  line-height: 2;
  color: var(--ink);
}
.letter-back {
  margin-top: 10rpx;
}

/* 竖排正文：容器高度固定，列自右向左生长，横向滚动 */
.letter-scroll {
  width: 100%;
  height: 80vh;
}
.letter-body {
  writing-mode: vertical-rl;
  height: 100%;
  padding: 24rpx 48rpx;
  box-sizing: border-box;
}
.letter-para {
  max-height: 100%;
  margin-left: 34rpx;
  font-size: 30rpx;
  line-height: 1.95;
  letter-spacing: 4rpx;
  color: var(--ink);
}
.letter-quote {
  color: var(--coffee);
}
.letter-aside {
  font-size: 26rpx;
  color: var(--ink60);
}
.letter-sign {
  color: var(--cinnabar);
}
