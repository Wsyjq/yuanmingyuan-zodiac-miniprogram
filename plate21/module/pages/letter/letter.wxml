<bgm-ambience />
<!-- v2 回响：竖排信纸，读完没有按钮（红线：反结算、无分享导出） -->
<view class="binder"></view>
<view class="page page-shell letter-page paper-grain">
  <view wx:if="{{state === 'loading'}}" class="letter-state note-hand">整理信笺……</view>

  <view wx:elif="{{state === 'notFinished'}}" class="letter-state">
    <view class="letter-wax">封</view>
    <view class="letter-state-text kaiti">完成你的考察之后，这里会有一封给你的信。</view>
    <button class="btn-line letter-back" bindtap="onBack">返回</button>
  </view>

  <view wx:elif="{{state === 'sealed'}}" class="letter-state">
    <view class="letter-wax">封</view>
    <view class="letter-state-title serif">明日启封</view>
    <view class="letter-state-text kaiti">考察结束了。明天，这里会有一封写给你的信。</view>
  </view>

  <scroll-view wx:else scroll-x class="letter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="letter-body">
      <view class="letter-title serif">彩蛋 · 离园之后</view>
      <block wx:for="{{paragraphs}}" wx:key="index">
        <image wx:if="{{item.image}}" class="letter-photo" src="{{item.image}}" mode="widthFix" />
        <view wx:else class="letter-para kaiti {{item.cls ? 'letter-' + item.cls : ''}}">{{item.text}}</view>
      </block>
      <!-- 飞书 v3 rev5614 彩蛋：点击按钮揭晓档案主人 -->
      <button wx:if="{{!revealed}}" class="btn-seal letter-reveal" bindtap="onReveal">揭 晓</button>
    </view>
  </scroll-view>
  <!-- 信末脚注（不在信正文内，V2.1 信稿一字不动）：读完信去读大家的留言 -->
  <view wx:if="{{state === 'open'}}" class="letter-footnote" bindtap="onOpenBoard" role="button" aria-label="去读大家的留言">
    <text class="letter-footnote-text">档案的最后一页，是大家的话</text>
    <text class="letter-footnote-arrow">›</text>
  </view>
</view>
