/* 第二站 · 谜题4 墙体花纹观察（采风修订版，复古手账风） */
.page { padding: 0 36rpx 48rpx; height: 100%; overflow: hidden; }

/* 编号签 */
.tag-no-fixed { position: absolute; top: 88rpx; right: 210rpx; }

/* 经历感贴纸：吊牌（右上）+ 邮票（左上页边）+ 票根（右下页边）*/
.sticker-hangtag {
  position: absolute; top: 84rpx; right: 28rpx;
  width: 130rpx; height: 78rpx; opacity: .88; z-index: 9;
  transform: rotate(-5deg); pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
.sticker-stamp {
  position: absolute; top: 18rpx; left: 176rpx;
  width: 96rpx; height: 110rpx; opacity: .85; z-index: 9;
  transform: rotate(-8deg); pointer-events: none;
  filter: drop-shadow(0 2rpx 4rpx rgba(70, 56, 42, 0.2));
}

/* 标题区 */
.title { padding-top: 130rpx; font-size: 42rpx; font-weight: 700; color: var(--patina); letter-spacing: 4rpx; }
.title-div { width: 40%; margin: 18rpx auto 0; }
.lead { margin-top: 18rpx; font-size: 31rpx; line-height: 1.85; color: var(--ink); }

/* 主图区 */
.grid { position: relative; z-index: 2; margin-top: 40rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.cell {
  position: relative;
  min-width: 0; padding: 14rpx; box-sizing: border-box;
  background: var(--paper2); border-radius: 10rpx;
  transition: all .2s;
}
.cell { border: 4rpx solid rgba(70, 56, 42, 0.45); }
.cell.on { border-color: #A63A2E; background: rgba(166, 58, 46, 0.12); }
.cell-img { width: 100%; height: 180rpx; overflow: hidden; border-radius: 6rpx; background: var(--paper3); }
.pattern-photo { display: block; width: 100%; height: 100%; filter: sepia(.18) saturate(.8) contrast(1.02); }
.cell-name { margin-top: 10rpx; font-size: 30rpx; font-weight: 600; color: var(--ink); text-align: center; letter-spacing: 2rpx; }
.cell-desc { margin-top: 4rpx; font-size: 24rpx; color: var(--ink60); text-align: center; }
.cell-pin {
  position: absolute; top: 10rpx; right: 10rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: var(--cinnabar); color: var(--paper); border-radius: 50%;
  font-size: 24rpx; font-weight: 700;
}

/* 注释区（考察者手记，留白）*/
.annot { transform: rotate(-1deg); margin: 24rpx 0 8rpx; font-size: 28rpx; }

.hint { margin-top: 16rpx; font-size: 26rpx; color: var(--cinnabar); text-align: center; }

/* 日期区：朱砂日期章 + 手写"考察记录"（真实记录证据感）*/
.date-row {
  display: flex; align-items: center; gap: 20rpx;
  margin: 36rpx 0 28rpx; padding: 20rpx 0;
  border-top: 1rpx dashed var(--dash);
}
.stamp-date.mini { width: 100rpx; height: 100rpx; font-size: 18rpx; }
.date-note { font-size: 26rpx; color: var(--ink60); transform: rotate(-1deg); }

/* 解谜后独白 */
.reveal { margin-top: 28rpx; font-size: 32rpx; line-height: 1.85; color: var(--ink); text-align: center; letter-spacing: 2rpx; }
.route-card { margin-top: 30rpx; padding: 34rpx 30rpx; }
.route-title { margin-top: 18rpx; font-size: 34rpx; color: var(--ink-deep); }
.route-copy, .route-check { margin: 24rpx 0; font-size: 30rpx; line-height: 1.85; color: var(--ink); }
.route-check { padding: 18rpx 20rpx; border-left: 5rpx solid var(--patina); background: rgba(72, 112, 103, 0.08); }

.btn-disabled { opacity: .45; }

/* V2.1 对读四：收尾叙事与跳过按钮 */
.reveal-block { margin-top: 36rpx; }
.novel-p { font-size: 30rpx; line-height: 1.9; color: var(--ink); margin-bottom: 22rpx; text-align: justify; }
.skip-btn { display: block; width: auto; min-height: 0; line-height: 1.6; margin: 16rpx auto 0; padding: 6rpx 10rpx; border: 0; border-bottom: 2rpx dotted currentColor; border-radius: 0; background: transparent; font-size: 26rpx; }
.skip-btn::after { border: 0; }

/* V2.3 【记】证据句 */
.result-evidence {
  margin: 20rpx 0;
  text-align: center;
}
