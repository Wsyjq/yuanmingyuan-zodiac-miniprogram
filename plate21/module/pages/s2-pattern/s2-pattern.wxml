<!-- 第二站 · 黄花阵 对读四：纹样举纸对照（V2.2 讲述版，举纸不贴墙 + 可跳） -->
<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell task-shell paper-grain" style="--sbh: {{statusBarHeight}}px">
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
  <view class="task-kicker">黄花阵 · 本题</view>
  <view class="task-lead kaiti">{{lead}}</view>
  <view class="task-lead">{{actStrip}}</view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" autoplay="{{true}}" kind="voice" label="听 · 本页讲述" />

  <!-- ============ 主图区（4 花纹格子）============ -->
  <view class="grid" wx:if="{{!solved && !skipped}}">
    <view
      wx:for="{{patterns}}"
      wx:key="key"
      class="cell {{picked === item.key ? 'on' : ''}}"
      bindtap="onPick"
      data-key="{{item.key}}"
      role="button"
      aria-pressed="{{picked === item.key}}"
      aria-label="{{item.name}}，{{item.desc}}{{picked === item.key ? '，已选择' : ''}}"
    >
      <view class="cell-name serif">{{item.name}}</view>
      <view class="cell-desc">{{item.desc}}</view>
      <view wx:if="{{picked === item.key}}" class="cell-pin">✓</view>
    </view>
  </view>
<view wx:if="{{showFinale}}" class="reveal-block">
    <view class="task-lead">{{finaleReveal}}</view>
    <view class="task-lead"><gloss-text parts="{{wallParts}}" bind:glossary="onGlossary" /></view>
    <view class="task-lead">{{finaleClosing}}</view>
  </view>
  </scroll-view>
  <view class="task-dock">
    <view wx:if="{{nudge && !solved && !skipped}}" class="hint">{{nudge}}</view>
    <button wx:if="{{!solved && !skipped}}" class="btn-seal" bindtap="onConfirm" disabled="{{!picked}}">提交</button>
    <button wx:elif="{{showFinale}}" class="btn-seal" bindtap="onGoS3" disabled="{{advancing}}">{{advancing ? '正在保存……' : '前往方外观'}}</button>
  </view>

  <history-card
    wx:if="{{showHistory}}"
    visible="{{showHistory}}"
    title="黄花阵 · 万字纹"
    source="圆明园西洋楼景区史料"
    lines="{{historyLines}}"
    corner-number="{{cardNumber}}"
    show-corner="{{showCardNumber}}"
    btn-text="继 续"
    bind:next="onCloseHistory"
    bind:close="onCloseHistory"
  />
  <!-- 术语史料卡（收尾「原墙」点入，SL-08） -->
  <history-card
    wx:if="{{gloss}}"
    visible="{{!!gloss}}"
    title="{{gloss.title}}"
    source="{{gloss.source}}"
    lines="{{gloss.lines}}" layered="{{gloss.layered}}" image="{{gloss.image}}" caption="{{gloss.caption}}"
    btn-text="学到了"
    bind:next="onGlossClose"
    bind:close="onGlossClose"
  />
</view>
