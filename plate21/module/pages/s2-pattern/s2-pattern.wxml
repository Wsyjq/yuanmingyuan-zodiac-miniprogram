<!-- 第二站 · 黄花阵 对读四：纹样举纸对照（V2.2 讲述版，举纸不贴墙 + 可跳） -->
<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell paper-grain paper-real">
  <view class="binder"></view>

  <!-- ============ 编号区 ============ -->
  

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
  <!-- ============ 标题区 ============ -->
  <view class="title serif">黄花阵花纹观察</view>
  <view class="hatch-divider title-div"></view>
  <view class="lead kaiti">{{lead}}</view>
  <view class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">{{actStrip}}</text></view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" dock="{{true}}" />

  <!-- ============ 主图区（4 花纹格子）============ -->
  <view class="grid" wx:if="{{!solved && !skipped}}">
    <view
      wx:for="{{patterns}}"
      wx:key="key"
      class="cell {{picked === item.key ? 'on' : ''}}"
      bindtap="onPick"
      data-key="{{item.key}}"
      role="button"
      aria-pressed="{{picked === item.key}}"
      aria-label="{{item.name}}，{{item.desc}}{{picked === item.key ? '，已选择' : ''}}"
    >
      <view class="cell-name serif">{{item.name}}</view>
      <view class="cell-desc">{{item.desc}}</view>
      <view wx:if="{{picked === item.key}}" class="cell-pin">✓</view>
    </view>
  </view>

  <!-- ============ 注释区（考察者手记）============ -->


  <view wx:if="{{nudge}}" class="hint kaiti">{{nudge}}</view>

  <!-- ============ 日期区（朱砂日期章 = 真实记录证据）============ -->
  <view class="date-row">
    <view class="stamp-date mini">
      <view>西洋楼</view>
      <view>{{today}}</view>
    </view>
    <view class="note-hand date-note">考察记录 · 第二站</view>
  </view>

  <!-- ============ 操作区：举纸对照后「我认出了」；可跳 ============ -->
  <block wx:if="{{!solved && !skipped}}">
    <button
      class="btn-seal {{!picked ? 'btn-disabled' : ''}}"
      bindtap="onConfirm"
      disabled="{{!picked}}"
    >提交</button>

  </block>

  <!-- ============ 收尾：飞书 v3 原文（不可跳）============ -->
  <view wx:if="{{showFinale}}" class="reveal-block">
    <view class="novel-p">{{finaleReveal}}</view>
    <view class="novel-p"><gloss-text parts="{{wallParts}}" bind:glossary="onGlossary" /></view>
    <view class="novel-p">{{finaleClosing}}</view>
    <button class="btn-seal" bindtap="onGoS3" disabled="{{advancing}}">{{advancing ? '正在保存……' : '前往方外观'}}</button>
  </view>
  </scroll-view>

  <history-card
    wx:if="{{showHistory}}"
    visible="{{showHistory}}"
    title="黄花阵 · 万字纹"
    source="圆明园西洋楼景区史料"
    lines="{{historyLines}}"
    corner-number="{{cardNumber}}"
    show-corner="{{showCardNumber}}"
    btn-text="继 续"
    bind:next="onCloseHistory"
    bind:close="onCloseHistory"
  />
  <!-- 术语史料卡（收尾「原墙」点入，SL-08） -->
  <history-card
    wx:if="{{gloss}}"
    visible="{{!!gloss}}"
    title="{{gloss.title}}"
    source="{{gloss.source}}"
    lines="{{gloss.lines}}" layered="{{gloss.layered}}" image="{{gloss.image}}" caption="{{gloss.caption}}"
    btn-text="学到了"
    bind:next="onGlossClose"
    bind:close="onGlossClose"
  />
</view>
