<!-- 第二站 · 黄花阵 对读四：纹样举纸对照（V2.2 讲述版，举纸不贴墙 + 可跳） -->
<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell paper-grain paper-real">
  <view class="binder"></view>

  <!-- ============ 编号区 ============ -->
  <view class="tag-no tag-no-fixed">No.S2-4</view>
  <image class="sticker-hangtag" src="/plate21/module/assets/img/stickers/st-hang-tag-01.png" mode="aspectFit" />
  <image class="sticker-stamp" src="/plate21/module/assets/img/stickers/st-stamp-02.png" mode="aspectFit" />

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
  <!-- ============ 标题区 ============ -->
  <view class="title serif">纹样举纸对照</view>
  <view class="hatch-divider title-div"></view>
  <view class="lead kaiti">出亭子顺墙走。这一路的墙上都是同一种花纹，手里那页正好印着四种纹样图样。第四件事，举纸对照。</view>
  <view class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">举起纹样页，对照墙上的纹：哪种对得上，就是这一路看到的纹。</text></view>
  <dialogue-block speaker="造办处匠人" text="四种花样，举到墙跟前比，别贴着。哪个的走向和墙上的对得上，就是它。" clip-id="dlg-huanghuazhen-5" />
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" dock="{{true}}" />

  <!-- ============ 主图区（4 花纹格子）============ -->
  <view class="grid" wx:if="{{!solved && !skipped}}">
    <view
      wx:for="{{patterns}}"
      wx:key="key"
      class="cell double-frame {{picked === item.key ? 'on' : ''}}"
      bindtap="onPick"
      data-key="{{item.key}}"
      role="button"
      aria-pressed="{{picked === item.key}}"
      aria-label="{{item.name}}，{{item.desc}}{{picked === item.key ? '，已选择' : ''}}"
    >
      <view class="cell-img">
        <image class="pattern-photo" src="{{item.src}}" mode="aspectFill" />
      </view>
      <view class="cell-name serif">{{item.name}}</view>
      <view class="cell-desc">{{item.desc}}</view>
      <view wx:if="{{picked === item.key}}" class="cell-pin">✓</view>
    </view>
  </view>

  <!-- ============ 注释区（考察者手记）============ -->
  <view class="note-hand olive annot">墙上的花纹，回转连绵，像是走不到头。</view>

  <view wx:if="{{nudge}}" class="hint kaiti">{{nudge}}</view>

  <!-- ============ 日期区（朱砂日期章 = 真实记录证据）============ -->
  <view class="date-row">
    <view class="stamp-date mini">
      <view>西洋楼</view>
      <view>{{today}}</view>
    </view>
    <view class="note-hand date-note">考察记录 · 第二站</view>
  </view>

  <!-- ============ 操作区：举纸对照后「我认出了」；可跳 ============ -->
  <block wx:if="{{!solved && !skipped}}">
    <button
      class="btn-seal {{!picked ? 'btn-disabled' : ''}}"
      bindtap="onConfirm"
      disabled="{{!picked}}"
    >我 认 出 了</button>

  </block>

  <!-- ============ 收尾：翻照片背面（V2.2：看砖＋砌墙师傅，不可跳）============ -->
  <view wx:if="{{showFinale}}" class="reveal-block">
    <view class="novel-p" wx:for="{{finaleLead}}" wx:key="index">{{item}}</view>
    <view class="paper-quote kaiti">{{finaleQuote}}</view>
    <view class="novel-p">{{finaleBridge}}</view>
    <view class="act-strip"><text class="act-strip-tag">做</text><text class="act-strip-text">离墙近一点，看砖。砖是新的，砖缝是新的，两百年前的墙不会这么齐。</text></view>
    <view class="novel-p">这一页的人声也换了个人，年纪近得多。</view>
    <dialogue-block speaker="砌墙师傅" text="我八七年进的场。那会儿这儿就是一片土坡子。图？图就你们夹子里那张，我们对着它放的线。砖是新的，砖缝也新，你别嫌。不照图砌回来，你今天都进不来。八九年，又收了一回尾。画这阵的，就占两号，四号、五号，我们砌回来的，也就这两号。再往下，没派给我们。" clip-id="dlg-huanghuazhen-6" />
    <view class="novel-p" wx:for="{{finaleTail}}" wx:key="index">{{item}}</view>
    <view class="result-evidence note-hand olive">【记】空栏 · 黄花阵：对得上，但不是要找的那一页。砌墙的人是在干活；要不是这道墙，今天谁也走不进这座迷宫。</view>
    <view class="novel-p">走出迷宫，档案里有一行后来补上的记录：眼前能走进去的墙，并不是乾隆年间留下的原墙。</view>
    <view class="novel-p">我按照地图继续走，下一站是方外观。</view>
    <button class="btn-seal" bindtap="onGoS3" disabled="{{advancing}}">{{advancing ? '正在保存……' : '前往方外观'}}</button>
  </view>
  </scroll-view>

  <history-card
    wx:if="{{showHistory}}"
    visible="{{showHistory}}"
    title="黄花阵 · 万字回纹"
    source="圆明园西洋楼景区史料"
    lines="{{historyLines}}"
    corner-number="{{cardNumber}}"
    show-corner="{{showCardNumber}}"
    btn-text="继 续"
    bind:next="onCloseHistory"
    bind:close="onCloseHistory"
  />
</view>
