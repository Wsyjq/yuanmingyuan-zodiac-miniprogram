<!-- 第二站 · 黄花阵 对读四：纹样页贴墙（V2.1，贴墙自校验 + 可跳） -->
<nav-back />
<page-overlays />
<view class="page page-shell paper-grain paper-real">
  <view class="binder"></view>

  <!-- ============ 编号区 ============ -->
  <view class="tag-no tag-no-fixed">No.S2-4</view>
  <image class="sticker-hangtag" src="/plate21/module/assets/img/stickers/st-hang-tag-01.png" mode="aspectFit" />
  <image class="sticker-stamp" src="/plate21/module/assets/img/stickers/st-stamp-02.png" mode="aspectFit" />

  <!-- ============ 标题区 ============ -->
  <view class="title serif">纹样页贴墙</view>
  <view class="hatch-divider title-div"></view>
  <view class="lead kaiti">出亭子的时候，手还搭在墙上。档案里另有一页，印着四种花纹图样——把纸贴到墙上一处一处比，这一路摸过来的，正是其中的一种。</view>

  <!-- ============ 主图区（4 花纹格子）============ -->
  <view class="grid" wx:if="{{!solved && !skipped}}">
    <view
      wx:for="{{patterns}}"
      wx:key="key"
      class="cell double-frame {{picked === item.key ? 'on' : ''}}"
      bindtap="onPick"
      data-key="{{item.key}}"
      role="button"
      aria-pressed="{{picked === item.key}}"
      aria-label="{{item.name}}，{{item.desc}}{{picked === item.key ? '，已选择' : ''}}"
    >
      <view class="cell-img">
        <image class="pattern-photo" src="{{item.src}}" mode="aspectFill" />
      </view>
      <view class="cell-name serif">{{item.name}}</view>
      <view class="cell-desc">{{item.desc}}</view>
      <view wx:if="{{picked === item.key}}" class="cell-pin">✓</view>
    </view>
  </view>

  <!-- ============ 注释区（考察者手记）============ -->
  <view class="note-hand olive annot">墙上的花纹，回转连绵，像是走不到头。</view>

  <view wx:if="{{nudge}}" class="hint kaiti">{{nudge}}</view>

  <!-- ============ 日期区（朱砂日期章 = 真实记录证据）============ -->
  <view class="date-row">
    <view class="stamp-date mini">
      <view>西洋楼</view>
      <view>{{today}}</view>
    </view>
    <view class="note-hand date-note">考察记录 · 第二站</view>
  </view>

  <!-- ============ 操作区：贴墙比对后「我认出了」；可跳 ============ -->
  <block wx:if="{{!solved && !skipped}}">
    <button
      class="btn-seal {{!picked ? 'btn-disabled' : ''}}"
      bindtap="onConfirm"
      disabled="{{!picked}}"
    >我 认 出 了</button>
    <button class="skip-btn note-hand olive" bindtap="onSkip">先不认，往下走</button>
  </block>

  <!-- ============ 收尾：翻照片背面（V2.1，不可跳的两下之一）============ -->
  <view wx:if="{{showFinale}}" class="reveal-block">
    <view class="novel-p" wx:for="{{finaleParagraphs}}" wx:key="index">{{item}}</view>
    <button class="btn-seal" bindtap="onGoS3" disabled="{{advancing}}">{{advancing ? '正在保存……' : '出迷宫，往东'}}</button>
  </view>

  <history-card
    wx:if="{{showHistory}}"
    visible="{{showHistory}}"
    title="黄花阵 · 万字回纹"
    source="圆明园西洋楼景区史料"
    lines="{{historyLines}}"
    corner-number="{{cardNumber}}"
    show-corner="{{showCardNumber}}"
    btn-text="继 续"
    bind:next="onCloseHistory"
    bind:close="onCloseHistory"
  />
</view>
