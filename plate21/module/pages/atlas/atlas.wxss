.page { height: 100%; box-sizing: border-box; padding: 130rpx 28rpx 24rpx; background: #F4EDDC; display: flex; flex-direction: column; }
.title { font-size: 44rpx; font-weight: 700; }
.map-wrap { width: 100%; margin-top: 16rpx; padding: 4rpx; box-sizing: border-box; border: 4rpx solid rgba(46,31,13,.4); }
.map { width: 100%; height: 460rpx; }
.list { flex: 1; margin-top: 12rpx; }
.row { display: flex; justify-content: space-between; padding: 18rpx 4rpx; border-bottom: 2rpx solid rgba(46,31,13,.18); font-size: 32rpx; }
.locked { opacity: .45; }
