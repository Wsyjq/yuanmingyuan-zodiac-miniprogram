/* P13 时间轴排序 */
.page {
  position: relative;
  min-height: 100vh;
  overflow: visible;
  box-sizing: border-box;
}
/* 完成态轻震由 CSS keyframes 驱动；减弱动画时关闭。 */

/* v1.3 手账元素：编号标签（右上，避让胶囊） */
.page-tag {
  position: absolute;
  top: 198rpx;
  right: 64rpx;
  z-index: 10;
}
/* v1.3 手账元素：手写批注 */
.navi-note {
  margin: 8rpx 64rpx 40rpx;
  text-align: right;
}
.tl-note {
  position: absolute;
  top: 292rpx;
  right: 60rpx;
  z-index: 1;
  pointer-events: none;
}

/* ---- 站名叙事 ---- */
.navi-title {
  margin-top: 200rpx;
  padding: 0 64rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.navi-line {
  margin: 24rpx 64rpx 0;
}
.navi-body {
  padding: 48rpx 64rpx 0;
  height: calc(100vh - 480rpx);
  min-height: 420rpx;
  box-sizing: border-box;
}
.navi-figure { margin-bottom: 34rpx; padding: 12rpx; overflow: hidden; background: var(--paper2); }
.navi-image { display: block; width: 100%; height: 310rpx; filter: sepia(.16) saturate(.82) contrast(1.03); }
.navi-caption { margin-top: 10rpx; color: var(--ink60); font-size: 20rpx; letter-spacing: 2rpx; text-align: right; }
.para {
  margin-bottom: 40rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
}
.quote-card {
  margin-bottom: 40rpx;
}
.quote-line {
  width: 60%;
  margin: 0 auto;
}
.quote-text {
  padding: 32rpx 24rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 1.8;
  color: var(--ink);
}
.navi-footer {
  display: flex;
  justify-content: center;
}

/* ---- 谜题区 ---- */
.title {
  margin-top: 190rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.subtitle {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink60);
}

/* 横向时间轴 */
.tl {
  margin-top: 20rpx;
  width: 100%;
  height: 260rpx;
  white-space: nowrap;
}
.tl-inner {
  position: relative;
  width: 850rpx;
  height: 260rpx;
}
/* 金线由 CSS 合成动画完成，不通过 JS 逐帧传值。 */
.gold-line {
  position: absolute;
  left: 20rpx;
  top: 148rpx;
  height: 6rpx;
  width: 810rpx;
  background: var(--brass);
  box-shadow: 0 0 10rpx 2rpx rgba(169, 143, 95, 0.6);
  transform: scaleX(0);
  transform-origin: left center;
}
.timeline-complete .gold-line { animation: timeline-gold 0.9s ease-out forwards; }
@keyframes timeline-gold { to { transform: scaleX(1); } }
.tl-slots {
  display: flex;
  padding-top: 40rpx;
}
.tl-cell {
  width: 170rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tl-label {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink);
  margin-bottom: 10rpx;
}
.tl-clock {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}
.tl-label.sub {
  font-size: 22rpx;
  color: var(--brass);
}
.tl-slot {
  width: 150rpx;
  height: 130rpx;
  border: 2rpx dashed var(--dash);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  box-sizing: border-box;
}
.tl-slot.filled {
  border: 1rpx solid var(--patina);
  background: var(--paper2);
}
.tl-slot.flash {
  animation: slot-flash 0.4s ease;
}
/* INT-402：磁吸预提示——拖到槽位上方时铜绿实线高亮 */
.tl-slot.near {
  border-color: var(--patina);
  border-style: solid;
  box-shadow: 0 0 0 2rpx var(--patina);
}
@keyframes slot-flash {
  0%, 100% { background: transparent; }
  50% { background: rgba(169, 143, 95, 0.25); }
}
.tl-filled {
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--ink);
  text-align: center;
}

/* 正常文档流事件卡托盘；transform 拖影不挤走原占位。 */
.tray-label { margin: 34rpx 0 18rpx; color: var(--ink60); font-size: 22rpx; letter-spacing: 2rpx; }
.card-tray { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.card {
  position: relative;
  z-index: 5;
  background: var(--paper2);
  border: 1rpx solid rgba(70, 56, 42, 0.3);
  border-left: 6rpx solid var(--brass);
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: 132rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 10rpx rgba(70, 56, 42, 0.18);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}
.card.dragging {
  z-index: 50;
  box-shadow: 0 10rpx 24rpx rgba(70, 56, 42, 0.27);
  transition: none;
}
.card.selected {
  border-color: var(--patina);
  box-shadow: 0 0 0 4rpx rgba(72, 112, 103, 0.18), 0 8rpx 18rpx rgba(46, 31, 13, 0.16);
}
.point-tip {
  position: relative;
  z-index: 8;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  background: rgba(244, 237, 220, 0.96);
  border-left: 5rpx solid var(--patina);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.6;
  pointer-events: none;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.card-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink60);
}

/* 独白 + 生成考察报告 */
.mono {
  position: relative;
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 42rpx;
  padding: 0 24rpx calc(40rpx + env(safe-area-inset-bottom));
}
.mono-text {
  margin-bottom: 28rpx;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink);
}

/* v1.3.1：邮戳贴纸压在编号签下方页边（绝对定位，不扰时间轴拖拽） */
.tl-postmark {
  position: absolute;
  top: 120rpx;
  right: 24rpx;
  width: 170rpx;
  height: 120rpx;
  transform: rotate(-8deg);
  opacity: 0.88;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}

.timeline-complete { animation: timeline-shake 0.55s ease; }
@keyframes timeline-shake {
  0%, 100% { transform: translate3d(0, 0, 0); }
  20% { transform: translate3d(-5rpx, 1rpx, 0); }
  40% { transform: translate3d(5rpx, -1rpx, 0); }
  60% { transform: translate3d(-3rpx, 0, 0); }
  80% { transform: translate3d(3rpx, 0, 0); }
}
@media (prefers-reduced-motion: reduce) {
  .timeline-complete { animation: none; }
  .timeline-complete .gold-line { animation: none; transform: scaleX(1); }
  .card { transition: none; }
}
