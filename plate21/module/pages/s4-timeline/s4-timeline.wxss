/* P13 时间轴排序 */
.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  padding-left: 52rpx; /* 让位 .binder */
  box-sizing: border-box;
}
/* 屏幕轻震：位移由 Anime.js 驱动（inline transform） */

/* v1.3 手账元素：编号标签（右上，避让胶囊） */
.page-tag {
  position: absolute;
  top: 198rpx;
  right: 64rpx;
  z-index: 10;
}
/* v1.3 手账元素：手写批注 */
.navi-note {
  margin: 8rpx 64rpx 40rpx;
  text-align: right;
}
.tl-note {
  position: absolute;
  top: 292rpx;
  right: 60rpx;
  z-index: 1;
  pointer-events: none;
}

/* ---- 站名叙事 ---- */
.navi-title {
  margin-top: 200rpx;
  padding: 0 64rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.navi-line {
  margin: 24rpx 64rpx 0;
}
.navi-body {
  padding: 48rpx 64rpx 0;
  height: calc(100vh - 480rpx);
  box-sizing: border-box;
}
.para {
  margin-bottom: 40rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
}
.quote-card {
  margin-bottom: 40rpx;
}
.quote-line {
  width: 60%;
  margin: 0 auto;
}
.quote-text {
  padding: 32rpx 24rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 1.8;
  color: var(--ink);
}
.navi-footer {
  display: flex;
  justify-content: center;
}

/* ---- 谜题区 ---- */
.title {
  margin-top: 190rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.subtitle {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink60);
}

/* 横向时间轴 */
.tl {
  margin-top: 20rpx;
  width: 750rpx;
  height: 260rpx;
  white-space: nowrap;
}
.tl-inner {
  position: relative;
  width: 1700rpx;
  height: 260rpx;
}
/* 金线：全部归位后由 Anime.js 驱动宽度 0 → 1660rpx（inline style） */
.gold-line {
  position: absolute;
  left: 20rpx;
  top: 148rpx;
  height: 6rpx;
  width: 0;
  background: var(--brass);
  box-shadow: 0 0 10rpx 2rpx rgba(169, 143, 95, 0.6);
}
/* 1860 组标 */
.y1860-label {
  position: absolute;
  left: 690rpx; /* 第 5~7 槽（1860 子槽）上方：4*170=680 起 */
  top: 0;
  width: 490rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--brass);
  letter-spacing: 4rpx;
  border-bottom: 1rpx solid var(--brass);
  padding-bottom: 4rpx;
}
.tl-slots {
  display: flex;
  padding-top: 40rpx;
}
.tl-cell {
  width: 170rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tl-label {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink);
  margin-bottom: 10rpx;
}
.tl-clock {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}
.tl-label.sub {
  font-size: 22rpx;
  color: var(--brass);
}
.tl-slot {
  width: 150rpx;
  height: 130rpx;
  border: 2rpx dashed var(--dash);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  box-sizing: border-box;
}
.tl-slot.filled {
  border: 1rpx solid var(--patina);
  background: var(--paper2);
}
.tl-slot.flash {
  animation: slot-flash 0.4s ease;
}
/* INT-402：磁吸预提示——拖到槽位上方时铜绿实线高亮 */
.tl-slot.near {
  border-color: var(--patina);
  border-style: solid;
  box-shadow: 0 0 0 2rpx var(--patina);
}
@keyframes slot-flash {
  0%, 100% { background: transparent; }
  50% { background: rgba(169, 143, 95, 0.25); }
}
.tl-filled {
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--ink);
  text-align: center;
}

/* 事件卡 */
.card {
  position: absolute;
  z-index: 5;
  background: var(--paper2);
  border: 1rpx solid rgba(70, 56, 42, 0.3);
  border-left: 6rpx solid var(--brass);
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 10rpx rgba(70, 56, 42, 0.18);
}
.card.dragging {
  z-index: 50;
  box-shadow: 0 10rpx 24rpx rgba(70, 56, 42, 0.27);
}
.card.selected {
  border-color: var(--patina);
  box-shadow: 0 0 0 4rpx rgba(72, 112, 103, 0.18), 0 8rpx 18rpx rgba(46, 31, 13, 0.16);
}
.point-tip {
  position: fixed;
  left: 70rpx;
  right: 24rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 18;
  padding: 18rpx 24rpx;
  background: rgba(244, 237, 220, 0.96);
  border-left: 5rpx solid var(--patina);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 1.6;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.card-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink60);
}

/* 独白 + 生成考察报告 */
.mono {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 60rpx;
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 64rpx;
}
.mono-text {
  margin-bottom: 28rpx;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink);
}

/* v1.3.1：邮戳贴纸压在编号签下方页边（绝对定位，不扰时间轴拖拽） */
.tl-postmark {
  position: absolute;
  top: 120rpx;
  right: 24rpx;
  width: 170rpx;
  height: 120rpx;
  transform: rotate(-8deg);
  opacity: 0.88;
  z-index: 9;
  pointer-events: none;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
