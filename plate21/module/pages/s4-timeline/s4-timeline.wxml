<nav-back />
<page-overlays />
<bgm-ambience />

<!-- 雨果雕像（飞书 v3 rev5614 §雨果雕像：纯叙事） -->
<view class="page page-shell paper-grain">
  <view class="binder"></view>
  <view class="tag-no page-tag">No.S4</view>
  <view class="navi-title serif">雨果雕像</view>
  <view class="hatch-divider navi-line"></view>
  <scroll-view class="navi-body" scroll-y>
    <view class="navi-figure double-frame">
      <image class="navi-image" src="/plate21/module/assets/img/IMG-RUNTIME-HUGO.jpg" mode="aspectFill" />
      <view class="navi-caption">雨果雕像 · 项目 AI 叙事图</view>
    </view>
    <view class="para"><gloss-text parts="{{hugoParts}}" bind:glossary="onGlossary" /></view>
    <view class="para" wx:for="{{paragraphs}}" wx:key="index">{{item}}</view>
    <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" label="听 · 本页讲述" dock="{{true}}" />
  </scroll-view>
  <view class="navi-footer">
    <button class="btn-seal" bindtap="onNext" disabled="{{advancing}}">{{advancing ? '正在保存……' : '继 续'}}</button>
  </view>
</view>

<!-- 术语史料卡（「雨果」SL-17 点入） -->
<history-card
  wx:if="{{gloss}}"
  visible="{{!!gloss}}"
  title="{{gloss.title}}"
  source="{{gloss.source}}"
  lines="{{gloss.lines}}"
  btn-text="学到了"
  bind:next="onGlossClose"
  bind:close="onGlossClose"
/>
