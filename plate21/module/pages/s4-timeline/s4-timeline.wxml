<nav-back />
<page-overlays />
<bgm-ambience />

<!-- 雨果雕像（飞书 v3 rev5614 §雨果雕像：纯叙事） -->
<view class="page page-shell task-shell paper-grain" style="--sbh: {{statusBarHeight}}px">
  <scroll-view class="page-doc" scroll-y>
    <view class="task-kicker">雨果雕像</view>
    <image class="navi-image" src="/plate21/module/assets/img/IMG-RUNTIME-HUGO.jpg" mode="widthFix" />
    <view class="task-lead"><gloss-text parts="{{hugoParts}}" bind:glossary="onGlossary" /></view>
    <view class="task-lead" wx:for="{{paragraphs}}" wx:key="index">{{item}}</view>
    <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" autoplay="{{true}}" kind="voice" label="听 · 本页讲述" />
  </scroll-view>
  <view class="task-dock">
    <button class="btn-seal" bindtap="onNext" disabled="{{advancing}}">{{advancing ? '正在保存……' : '继续'}}</button>
  </view>
</view>

<!-- 术语史料卡（「雨果」SL-17 点入） -->
<history-card
  wx:if="{{gloss}}"
  visible="{{!!gloss}}"
  title="{{gloss.title}}"
  source="{{gloss.source}}"
  lines="{{gloss.lines}}" layered="{{gloss.layered}}" image="{{gloss.image}}" caption="{{gloss.caption}}"
  btn-text="学到了"
  bind:next="onGlossClose"
  bind:close="onGlossClose"
/>
