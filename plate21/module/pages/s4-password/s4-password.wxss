/* 第四站 · 末题 密码输入（融入旧纸档案手账风） */
.page { padding: 0 36rpx 48rpx; height: 100%; overflow: hidden; }

.tag-no-fixed { position: absolute; top: 88rpx; right: 210rpx; }
/* 邮戳贴纸：右上角，微倾斜 */
.postmark-sticker {
  position: absolute; top: 80rpx; right: 28rpx;
  width: 140rpx; height: 140rpx; opacity: .85; z-index: 9;
  transform: rotate(8deg); pointer-events: none;
  filter: drop-shadow(0 2rpx 4rpx rgba(70, 56, 42, 0.18));
}
/* 机密吊牌：装订孔列里，不压标题 */
.secret-tag {
  position: absolute;
  top: 220rpx;
  left: 2rpx;
  width: 72rpx;
  height: 44rpx;
  opacity: .82;
  z-index: 8;
  transform: rotate(-12deg);
  pointer-events: none;
}

.title { padding-top: 130rpx; padding-right: 8rpx; font-size: 42rpx; font-weight: 700; color: var(--patina); letter-spacing: 4rpx; }
.title-div { width: 40%; margin: 18rpx auto 0; }
.lead { margin-top: 18rpx; font-size: 31rpx; line-height: 1.85; color: var(--ink); }

/* 密码输入：双线框包裹，四角铜钉质感 */
.pwd-box { margin-top: 56rpx; display: flex; justify-content: center; }
.pwd-frame { padding: 24rpx 32rpx; background: var(--paper2); border-radius: 8rpx; }
.pwd-input {
  width: 380rpx; height: 110rpx; text-align: center;
  font-size: 64rpx; letter-spacing: 48rpx; font-weight: 700; color: var(--ink);
  font-family: "STSong", "SimSun", serif;
}
.pwd-ph { color: var(--brass); letter-spacing: 48rpx; }

.tip { margin-top: 24rpx; text-align: center; font-size: 26rpx; }
.tip.wrong { color: var(--cinnabar); }
.tip.hint { color: var(--ink60); line-height: 1.7; padding: 0 24rpx; }
.tip-link { color: var(--brass); border-bottom: 2rpx solid var(--brass); padding-bottom: 2rpx; }
.tip-div { width: 30%; margin: 20rpx auto; }

.unlock-btn { margin-top: 48rpx; }

/* 已收集的卡片数字（朱砂圆印） */
.collected { margin-top: 36rpx; text-align: center; }
.collected-label { display: inline-block; margin-bottom: 14rpx; transform: rotate(-1deg); }
.collected-nums { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; }
.num-chip {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  font-size: 30rpx; font-weight: 700; color: var(--paper); background: var(--cinnabar);
  border-radius: 50%; box-shadow: 0 2rpx 6rpx rgba(166, 58, 46, .3);
  font-family: "STSong", "SimSun", serif;
}
.collected-tip { display: inline-block; margin-top: 14rpx; transform: rotate(0.5deg); }
.collected-source { margin-top: 12rpx; color: var(--ink60); font-size: 20rpx; line-height: 1.6; }

/* V2.1 缺卡通道：跳过连数直接摊开档案 */
.skip-btn { display: block; width: auto; min-height: 0; line-height: 1.6; margin: 16rpx auto 0; padding: 6rpx 10rpx; border: 0; border-bottom: 2rpx dotted currentColor; border-radius: 0; background: transparent; font-size: 26rpx; }
.skip-btn::after { border: 0; }

/* V2.3 【记】证据句 */
.result-evidence {
  margin: 16rpx 0;
  text-align: center;
}
