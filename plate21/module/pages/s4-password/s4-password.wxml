<!-- 第四站 · 末题 密码输入（采风修订版主线收口） -->
<nav-back />
<page-overlays />
<bgm-ambience />
<view class="page page-shell task-shell paper-grain">
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-doc">
  <view class="task-kicker">雨果 · 本题</view>
  <view class="task-lead kaiti">把之前拿到的卡片重新按路线顺序排开。每张卡片的角落都有一个数字，单独看没有意义，可从第一站开始依次连起来以后，刚好组成了今天的日期。</view>
  <audio-clip wx:if="{{narrSrc}}" src="{{narrSrc}}" autoplay="{{true}}" kind="voice" label="听 · 本页讲述" />

  <block wx:if="{{!correct}}">
  <!-- 已收集的卡片数字（主线：连起来 = 本次考察锁定日期）-->
  <view class="collected" wx:if="{{collectedNums.length}}">
    <view class="collected-label handnote olive">你从各处卡片角落记下的数字</view>
    <view class="collected-nums">
      <view wx:for="{{collectedNums}}" wx:key="index" class="num-chip {{item ? '' : 'empty'}}">{{item || '·'}}</view>
    </view>
    <view class="collected-tip handnote">把它们连起来看看……</view>
    <view class="collected-source">编号按史料卡取得顺序归档；日期依据见封面考察凭证。</view>
  </view>

  <view class="pwd-box">
    <input
      class="pwd-input"
      type="number"
      maxlength="8"
      placeholder="· · · · · · · ·"
      placeholder-class="pwd-ph"
      value="{{pwd}}"
      bindinput="onInput"
    />
  </view>

  <view wx:if="{{wrongTip}}" class="tip wrong kaiti">{{wrongTip}}</view>
  <view class="rule tip-div" wx:if="{{showHint || wrongTip}}"></view>

  <view wx:if="{{showHint}}" class="tip hint kaiti">{{hint}}</view>
  <view wx:else class="tip"><text class="tip-link" bindtap="onShowHint">需要提示？</text></view>

  </block>

  <view wx:else class="unlock-result">
    <view class="task-kicker">对上了</view>
    <view class="task-lead kaiti">画面中央那块一直空着的位置，开始一点点亮起来。</view>
    <view wx:if="{{progressError}}" class="tip wrong kaiti">{{progressError}}</view>
  </view>
  </scroll-view>
  <view class="task-dock">
    <view wx:if="{{wrongTip}}" class="hint">{{wrongTip}}</view>
    <view wx:if="{{showHint && !correct}}" class="hint">{{hint}}</view>
    <button wx:if="{{!correct}}" class="btn-seal" bindtap="onSubmit">连起来</button>
    <button wx:else class="btn-seal" bindtap="onGoFinale" disabled="{{advancing}}">{{advancing ? '正在保存档案……' : '打开档案'}}</button>
    <button wx:if="{{!correct}}" class="skip-btn" bindtap="onSkipPassword">不连了，直接摊开档案</button>
  </view>
</view>
