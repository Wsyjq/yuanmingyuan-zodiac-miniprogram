<nav-back />
<page-overlays node-id="s4-password" />
<challenge-gate node-id="s4-password">
<!-- 第四站 · 末题 密码输入（采风修订版主线收口） -->


<view class="page page-shell paper-grain paper-real">
  <view class="binder"></view>
  <view class="tag-no tag-no-fixed">No.S4-2</view>
  <!-- 手账贴纸：邮戳 + 机密吊牌 -->
  <image class="postmark-sticker" src="/plate21/module/assets/img/stickers/st-postmark-02.png" mode="aspectFit" />
  <image class="secret-tag" src="/plate21/module/assets/img/stickers/st-hang-tag-02.png" mode="aspectFit" />

  <view class="title serif">请输入密码</view>
  <view class="hatch-divider title-div"></view>
  <view class="lead kaiti">谜题都破译了，现在也接近西洋楼的终点了，可是第二十一幅版画呢？也许，最后还有一道锁。</view>

  <block wx:if="{{!correct}}">
  <!-- 已收集的卡片数字（主线：连起来 = 本次考察锁定日期）-->
  <view class="collected" wx:if="{{collectedNums.length}}">
    <view class="collected-label note-hand olive">你从各处卡片角落记下的数字</view>
    <view class="collected-nums">
      <view wx:for="{{collectedNums}}" wx:key="index" class="num-chip {{item ? '' : 'empty'}}">{{item || '·'}}</view>
    </view>
    <view class="collected-tip note-hand">把它们连起来看看……</view>
    <view class="collected-source">编号按史料卡取得顺序归档；日期依据见封面考察凭证。</view>
  </view>

  <view class="pwd-box">
    <view class="pwd-frame double-frame">
      <input
        class="pwd-input"
        type="number"
        maxlength="8"
        placeholder="· · · · · · · ·"
        placeholder-class="pwd-ph"
        value="{{pwd}}"
        bindinput="onInput"
      />
    </view>
  </view>

  <view wx:if="{{wrongTip}}" class="tip wrong kaiti">{{wrongTip}}</view>
  <view class="hatch-divider tip-div" wx:if="{{showHint || wrongTip}}"></view>

  <view wx:if="{{showHint}}" class="tip hint kaiti">{{hint}}</view>
  <view wx:else class="tip link" bindtap="onShowHint">需要提示？</view>

  <button class="btn-seal unlock-btn" bindtap="onSubmit">解 锁</button>
  </block>

  <view wx:else class="unlock-result double-frame">
    <view class="tag-no">LOCK OPEN</view>
    <view class="title serif">日期密码成立</view>
    <view class="lead kaiti">八张史料卡共同指向本次考察建档日：{{archiveDate}}。最后一道锁已经打开。</view>
    <view wx:if="{{progressError}}" class="tip wrong kaiti">{{progressError}}</view>
    <button class="btn-seal unlock-btn" bindtap="onGoFinale" disabled="{{advancing}}">{{advancing ? '正在保存档案……' : '开启第二十一图'}}</button>
  </view>
</view>

</challenge-gate>
