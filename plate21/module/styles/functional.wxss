
.fx-page{min-height:100vh;box-sizing:border-box;background:#f4eddc;color:#342f29;padding:160rpx 40rpx 100rpx;}
.fx-kicker{font-size:20rpx;letter-spacing:4rpx;color:#876d48;margin-bottom:24rpx;}
.fx-title{font-family:serif;font-size:48rpx;line-height:1.3;margin-bottom:28rpx;font-weight:500;}
.fx-note{font-size:25rpx;line-height:1.8;color:#736a5a;white-space:pre-wrap;}
.fx-card{padding:30rpx;margin-top:24rpx;border:1rpx solid #cbbb98;border-radius:8rpx;background:#faf6eb;}
.fx-card-title{font-size:31rpx;font-family:serif;margin-bottom:16rpx;}
.fx-row{display:flex;gap:14rpx;align-items:center;flex-wrap:wrap;margin:22rpx 0;}
.fx-row button{flex:1;min-width:150rpx;}
.fx-page button{font-size:26rpx;line-height:1.5;padding:22rpx 20rpx;background:#ede3cd;border:1rpx solid #cbbb98;color:#42392c;margin:12rpx 0;border-radius:6rpx;}
.fx-page .fx-primary{background:#5b4935;color:#fff9ec;}
.fx-page .fx-selected{border:2rpx solid #8e4734;background:#ecdfc4;}
.fx-body{font-size:29rpx;line-height:1.9;white-space:pre-wrap;margin:26rpx 0;}
.fx-page input,.fx-page textarea{box-sizing:border-box;width:100%;padding:22rpx;background:#fffaf0;border:1rpx solid #cbbb98;border-radius:6rpx;font-size:28rpx;margin:18rpx 0;}
.fx-page input{height:90rpx;}.fx-page textarea{height:330rpx;line-height:1.8;}
.fx-photo{width:100%;height:400rpx;margin:20rpx 0;}.fx-page video{width:100%;}
.fx-error{color:#934b39;font-size:25rpx;line-height:1.7;margin:20rpx 0;}
.fx-tag{font-size:22rpx;color:#8e4734;margin:12rpx 0;}.fx-line{height:1rpx;background:#cbbb98;margin:32rpx 0;}
.fx-url{font-size:22rpx;word-break:break-all;color:#6e614b;}.fx-export{position:fixed;left:-2200px;top:0;width:750px;height:1200px;}
