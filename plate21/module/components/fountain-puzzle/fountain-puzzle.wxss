.fountain-game{margin:24rpx -16rpx;color:#344d44}.fountain-scene{position:relative;width:100%;padding-top:56.28%;overflow:hidden;border-radius:10rpx;background:#c7d4cd}.scene-bg,.scene-fallback{position:absolute;inset:0;width:100%;height:100%}.scene-fallback{display:flex;align-items:center;justify-content:center;color:#657c70}.fallback-ring{position:absolute;left:18%;top:56%;width:64%;height:28%;border:2rpx solid #6b8b7d;border-radius:50%}.drop-zone{position:absolute;padding:0;margin:0;min-height:0;line-height:1;border:2rpx dashed #f8efd1;background:#e4dfbb45;display:flex;align-items:center;justify-content:center;color:#fffbe9;font-family:serif;font-size:20rpx;text-shadow:0 1rpx 4rpx #172b20;z-index:2}.drop-zone::after,.piece-label::after,.fountain-button::after{border:0}.dogs-zone{left:22%;top:65%;width:56%;height:23%;border-radius:50%}.dogs-zone-label{margin-top:12%}.deer-zone{left:44%;top:54%;width:15%;height:21%;border-radius:50%}.target-active{border-style:solid;background:#f6eac077;box-shadow:0 0 16rpx #f3eab9}.placed-deer{position:absolute;left:44%;top:46%;width:15%;height:28%;z-index:3}.placed-dogs{position:absolute;left:23%;top:48%;width:54%;height:38%;z-index:4}.piece-tray{display:flex;gap:20rpx;margin-top:18rpx}.piece{flex:1;border:1rpx solid #b6c2af;background:#f5f0e4;border-radius:10rpx;overflow:hidden}.piece-selected{border-color:#426859;box-shadow:0 0 0 2rpx #658170}.piece-image{display:block;width:100%;height:130rpx}.piece-label{background:transparent;color:#435e50;font-family:serif;font-size:25rpx;line-height:1.5;padding:14rpx 4rpx}.piece-done{opacity:.5}.instruction,.fountain-notice{display:block;font-size:25rpx;line-height:1.7;margin-top:16rpx}.fountain-button{font:26rpx serif;color:#466559;background:#e5e8da;padding:20rpx;margin-top:18rpx;border-radius:6rpx}.drag-ghost{position:fixed;width:96px;height:96px;z-index:90;pointer-events:none;filter:drop-shadow(0 3px 5px #243a31aa)}.ghost-image{width:100%;height:100%}.water-layer{position:absolute;inset:0;z-index:5;pointer-events:none;opacity:.4}.is-flowing .water-layer{opacity:1}.water-arc{position:absolute;border-top:3rpx solid #f2fbff;border-radius:50%;filter:drop-shadow(0 0 2rpx #9ce6ff);animation:fountain-stream 1.3s ease-in-out infinite;animation-play-state:paused}.is-flowing .water-arc,.is-flowing .water-droplet,.is-flowing .water-mist{animation-play-state:running}.water-droplet{position:absolute;right:8%;top:15%;width:3rpx;height:11rpx;border-radius:50%;background:#fff;animation:fountain-drop .9s linear infinite;animation-play-state:paused}.water-mist{position:absolute;left:26%;top:69%;width:48%;height:15%;border-radius:50%;background:radial-gradient(ellipse,#effcff80,transparent 70%);animation:fountain-stream 2s ease-in-out infinite;animation-play-state:paused}@keyframes fountain-stream{0%,100%{opacity:.55}50%{opacity:1}}@keyframes fountain-drop{0%{opacity:0;transform:translateY(-6rpx)}30%{opacity:1}100%{opacity:0;transform:translateY(20rpx)}}
