<!-- Missing/unapproved clips render nothing. Enabling narration never starts it. -->
<block wx:if="{{hasAudio && active}}">
  <view wx:if="{{!enabled}}" class="ac-wrap {{dock ? 'ac-dock-bar' : ''}}">
    <button class="ac-btn" bindtap="onMute">{{kind === 'bgm' ? '开启音乐' : '开启讲述'}}</button>
  </view>
  <view wx:elif="{{icon}}" class="ac-iconbtn {{playing ? 'on' : ''}}" bindtap="onToggle" role="button" aria-label="{{loading ? '取消加载' : (failed ? '重试播放' : (playing ? '暂停' : label))}}">
    <text wx:if="{{loading}}">…</text>
    <text wx:elif="{{failed}}">↻</text>
    <image wx:elif="{{!playing}}" class="ac-iconbtn-img" src="/plate21/module/assets/img/icons/ic-play-ink.png" mode="aspectFit" />
    <view wx:else class="ac-iconbtn-pause"><view class="ac-iconbtn-bar"></view><view class="ac-iconbtn-bar"></view></view>
  </view>
  <view wx:elif="{{dock && !dockOpen}}" class="ac-dock-dot {{playing ? 'on' : ''}}" bindtap="onDockOpen" role="button" aria-label="展开播放条">
    <image class="ac-iconbtn-img" src="/plate21/module/assets/img/icons/ic-play-ink.png" mode="aspectFit" />
  </view>
  <view wx:else id="coachListen" class="ac-wrap {{compact ? 'ac-compact' : ''}} {{dock ? 'ac-dock-bar' : ''}}">
    <button class="ac-btn" bindtap="onToggle">{{loading ? '取消加载' : (failed ? '重试播放' : (playing ? '暂停' : label))}}</button>
    <view class="ac-track"><view class="ac-track-fill" style="width: {{progress}}%;"></view></view>
    <text wx:if="{{segmentCount > 1}}" class="ac-segment">{{segmentIndex + 1}}/{{segmentCount}}</text>
    <button class="ac-btn ac-action" bindtap="onReplay">重播</button>
    <button wx:if="{{kind !== 'clip'}}" class="ac-btn ac-action" bindtap="onMute">静音</button>
    <view wx:if="{{dock}}" class="ac-dock-fold" bindtap="onDockFold" role="button" aria-label="收起播放条">⌄</view>
  </view>
</block>
