<view class="novel-view">
  <view class="archive-tab">
    <view class="clip-mark"></view>
    <text>旧纸档案 · 考察手账</text>
  </view>

  <view
    class="book-stage"
    bindtap="onPaperTap"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
  >
    <view class="paper-stack stack-back"></view>
    <view class="paper-stack stack-mid"></view>

    <view
      class="paper-leaf current-leaf {{pageIndex === 0 ? 'first-leaf' : 'continued-leaf'}} {{turning ? 'under-turn' : ''}} {{dragging ? 'dragging' : ''}}"
      style="{{dragStyle}}"
    >
      <view class="leaf-grain"></view>
      <view class="leaf-topline">
        <text class="archive-code">A-021-{{pageLabel}}</text>
        <text class="folio">{{pageLabel}} / {{countLabel}}</text>
      </view>

      <view wx:if="{{pageIndex === 0}}" class="title-block">
        <view class="title-kicker">考察档案 · 被认真保存的记录</view>
        <view class="title serif">{{title}}</view>
        <view class="title-rule"><text></text></view>
      </view>
      <view wx:else class="continued-title">
        <text class="continued-no">{{pageLabel}}</text>
        <text class="continued-copy">档案续页</text>
        <view class="continued-line"></view>
      </view>

      <view wx:if="{{pageIndex === 0}}" class="archive-stamp">
        <text>ARCHIVE</text>
        <text class="stamp-number">21</text>
      </view>

      <scroll-view class="page-body" scroll-y enhanced show-scrollbar="{{false}}">
        <block wx:for="{{currentPage}}" wx:key="index" wx:for-item="block">
          <view wx:if="{{block.image}}" class="photo-sheet">
            <view class="photo-tape"></view>
            <archive-illustration wx:if="{{block.illustrationType}}" class="page-photo" type="{{block.illustrationType}}" label="{{block.caption}}" compact="{{true}}" style="display:block;" />
            <image wx:elif="{{block.src}}" class="page-photo" src="{{block.src}}" mode="aspectFill" />
            <view wx:else class="photo-code">{{block.image}}</view>
            <view class="photo-caption">{{block.caption}}</view>
          </view>

          <view wx:elif="{{block.quote}}" class="quote-sheet">
            <view class="quote-mark">“</view>
            <view class="quote-copy kaiti">
              <text class="reveal-copy {{showAll ? 'show-all' : ''}}" style="animation-duration: {{revealDuration}}ms; animation-delay: {{index * blockDelay}}ms;">{{block.text}}</text>
            </view>
            <view class="quote-mark quote-end">”</view>
          </view>

          <view wx:else class="narrative-copy {{index === leadIndex ? 'lead-copy' : ''}}">
            <text class="reveal-copy {{showAll ? 'show-all' : ''}}" style="animation-duration: {{revealDuration}}ms; animation-delay: {{index * blockDelay}}ms;">{{block.text}}</text>
          </view>
        </block>
      </scroll-view>

      <image class="leaf-botanical" src="/plate21/module/assets/img/stickers/st-botanical-02.png" mode="aspectFit" />
      <view class="leaf-footnote">
        <view class="footnote-line"></view>
        <text wx:if="{{gestureArmed}}" class="gesture-ready">{{gestureDirection === 'next' ? '松手，翻到下一页' : '松手，翻回上一页'}}</text>
        <text wx:elif="{{typing}}" class="typing-note">文字正在落到纸上</text>
        <text wx:else>{{pageIndex === pageCount - 1 ? '本卷记录至此' : '轻触纸面或向左滑动翻页'}}</text>
      </view>
      <view class="page-curl {{dragging ? 'peeling drag-' + gestureDirection : ''}}" style="{{curlStyle}}"></view>
    </view>

    <view
      id="turningLeaf"
      wx:if="{{turning}}"
      class="paper-leaf turning-leaf turn-{{turnDirection}} {{turnPageLabel === '01' ? 'first-leaf' : 'continued-leaf'}}"
      style="--turn-duration: {{turnDuration}}ms"
      bindanimationend="onTurnAnimationEnd"
    >
      <view class="leaf-grain"></view>
      <view class="leaf-topline">
        <text class="archive-code">A-021-{{turnPageLabel}}</text>
        <text class="folio">{{turnPageLabel}} / {{countLabel}}</text>
      </view>
      <view wx:if="{{turnPageLabel === '01'}}" class="title-block">
        <view class="title-kicker">考察档案 · 被认真保存的记录</view>
        <view class="title serif">{{title}}</view>
        <view class="title-rule"><text></text></view>
      </view>
      <view wx:else class="continued-title">
        <text class="continued-no">{{turnPageLabel}}</text>
        <text class="continued-copy">档案续页</text>
        <view class="continued-line"></view>
      </view>
      <view wx:if="{{turnPageLabel === '01'}}" class="archive-stamp">
        <text>ARCHIVE</text>
        <text class="stamp-number">21</text>
      </view>
      <view class="page-body turn-body">
        <block wx:for="{{turnPage}}" wx:key="index" wx:for-item="block">
          <view wx:if="{{block.image}}" class="photo-sheet">
            <view class="photo-tape"></view>
            <archive-illustration wx:if="{{block.illustrationType}}" class="page-photo" type="{{block.illustrationType}}" label="{{block.caption}}" compact="{{true}}" style="display:block;" />
            <image wx:elif="{{block.src}}" class="page-photo" src="{{block.src}}" mode="aspectFill" />
            <view wx:else class="photo-code">{{block.image}}</view>
            <view class="photo-caption">{{block.caption}}</view>
          </view>
          <view wx:elif="{{block.quote}}" class="quote-sheet">
            <view class="quote-mark">“</view>
            <view class="quote-copy kaiti">{{block.text}}</view>
            <view class="quote-mark quote-end">”</view>
          </view>
          <view wx:else class="narrative-copy {{index === turnLeadIndex ? 'lead-copy' : ''}}">{{block.text}}</view>
        </block>
      </view>
      <view class="turn-shine"></view>
    </view>
  </view>

  <view class="reader-footer">
    <button class="page-control prev-control {{pageIndex === 0 || turning ? 'disabled' : ''}}" disabled="{{pageIndex === 0 || turning}}" catchtap="onPrev">
      <text class="control-arrow">←</text><text>上一页</text>
    </button>
    <view class="reader-progress">
      <view class="progress-track"><view class="progress-ink" style="width: {{(pageIndex + 1) / pageCount * 100}}%"></view></view>
      <text>{{pageLabel}} / {{countLabel}}</text>
    </view>
    <button class="page-control next-control {{turning ? 'disabled' : ''}}" disabled="{{turning}}" catchtap="onNext">
      <text>{{pageIndex === pageCount - 1 ? finishText : '下一页'}}</text><text class="control-arrow">→</text>
    </button>
  </view>
</view>
