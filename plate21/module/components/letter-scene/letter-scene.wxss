:host{display:block;height:100%;min-height:0}.scene{height:100%;display:flex;flex-direction:column;position:relative;background:#342e26;color:#f4efe3;overflow:hidden}.stage{position:relative;flex:1;min-height:140rpx;overflow:hidden}.portrait{width:100%;height:100%;position:absolute;inset:0}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,18,14,.4),transparent 40%,rgba(20,18,14,.55))}.chapter{position:absolute;top:28rpx;left:32rpx;font-size:25rpx;letter-spacing:4rpx}.scene-note{position:absolute;bottom:24rpx;left:32rpx;font-size:23rpx;letter-spacing:3rpx}.dialogue{flex-shrink:0;background:#f4efe3;color:#302f29;border-top:3rpx solid #b6a079;padding:24rpx 32rpx calc(16rpx + env(safe-area-inset-bottom))}.speaker{font-family:serif;font-size:35rpx;border-bottom:1rpx solid #c7bba4;padding-bottom:16rpx;margin-bottom:20rpx}.counter{float:right;font-size:22rpx;color:#82785f;padding-top:12rpx}.dialogue-scroll{height:340rpx;max-height:38vh}.words{font-size:31rpx;line-height:1.9;white-space:pre-wrap}.cursor{color:#85704f}.advance{width:100%;text-align:right;background:transparent;font-size:26rpx;line-height:2;color:#675b44;padding:10rpx 0;margin:0}.advance::after,.history-button::after,.close::after{border:0}.history-button{background:transparent;color:#65766a;font-size:24rpx;line-height:2;margin:0;padding:4rpx}.history{position:absolute;inset:0;background:#f4efe3;color:#302f29;padding:32rpx;z-index:2}.history-scroll{height:75%}.past{display:block;font-size:30rpx;line-height:1.9;margin-bottom:28rpx}.close{float:right;font-size:24rpx;color:#49665c;background:transparent}.fallback{padding:140rpx 40rpx;font-size:36rpx;line-height:2}.fallback-line{display:block;font-size:28rpx}

.advance{position:relative;padding-right:64rpx}
.scene-arrow{position:absolute;right:22rpx;top:50%;transform:translateY(-50%);font-style:normal}
