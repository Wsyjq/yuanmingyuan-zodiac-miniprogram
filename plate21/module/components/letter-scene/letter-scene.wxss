:host{display:block;height:100%;min-height:0}.scene{height:100%;display:flex;flex-direction:column;position:relative;background:transparent;color:#43362d;overflow:hidden}.stage{position:relative;flex:1;min-height:140rpx;overflow:hidden}.portrait{display:none}.shade{display:none}.chapter{display:none}.scene-note{display:none}.letter-hills{position:absolute;left:0;right:0;bottom:0;width:100%;z-index:1;pointer-events:none}.dialogue{flex-shrink:0;background:#efe3cc;color:#43362d;border-top:2rpx solid #c7b99b;padding:24rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));font-family:"Noto Serif SC","Songti SC","STSong",serif}.speaker{font-family:"Noto Serif SC","Songti SC","STSong",serif;font-size:38rpx;font-weight:600;line-height:55rpx;border-bottom:0;padding-bottom:0;margin-bottom:8rpx}.counter{float:right;font-size:27rpx;font-weight:500;color:#82785f;padding-top:8rpx}.dialogue-scroll{height:120rpx;max-height:22vh}.words{font-size:31rpx;font-weight:400;line-height:53rpx;letter-spacing:1rpx;white-space:pre-wrap}.cursor{color:#85704f}.advance{width:100%;text-align:right;background:transparent;font-size:25rpx;font-weight:500;line-height:36rpx;color:#43362d;padding:10rpx 0;margin:0}.advance::after,.history-button::after,.close::after{border:0}.history-button{background:transparent;color:#65766a;font-size:24rpx;line-height:2;margin:0;padding:4rpx}.history{position:absolute;inset:0;background:#f4efe3;color:#302f29;padding:32rpx;z-index:2}.history-scroll{height:75%}.past{display:block;font-size:30rpx;line-height:1.9;margin-bottom:28rpx}.close{float:right;font-size:24rpx;color:#49665c;background:transparent}.fallback{padding:140rpx 40rpx;font-size:36rpx;line-height:2}.fallback-line{display:block;font-size:28rpx}
