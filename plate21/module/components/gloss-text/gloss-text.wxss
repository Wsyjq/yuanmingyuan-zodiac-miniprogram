/* 正文行内术语超链接：铜绿 + 虚线下划线，与 history-card 卡内 .hc-link 同一视觉 */
.gloss-text {
  display: block;
  color: var(--ink-deep);
  font-size: 32rpx;
  line-height: 1.85;
}
.gt-link {
  color: var(--patina);
  font-weight: 700;
  border-bottom: 4rpx solid var(--patina);
  padding-bottom: 2rpx;
}
.gt-link:active {
  opacity: 0.65;
}
