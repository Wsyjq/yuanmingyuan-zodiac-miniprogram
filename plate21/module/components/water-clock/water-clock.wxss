:host{display:block;min-width:0}.water-clock{margin:28rpx 0;padding:24rpx;background:#e4d3b1;border:1rpx solid #99805b;box-shadow:0 5rpx 14rpx rgba(79,57,30,.12);color:#3e3225}.clock-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:18rpx}.clock-title{font-family:serif;font-size:34rpx;letter-spacing:3rpx}.clock-time{font-size:32rpx;color:#813b2b;font-variant-numeric:tabular-nums}.clock-stage{position:relative;width:100%;height:420rpx;background:#d5bc91;overflow:hidden}.clock-canvas,.clock-still{width:100%;height:420rpx;display:block}.clock-canvas{position:relative}.canvas-hidden{opacity:0}.clock-still{position:absolute;inset:0}.still-label{position:absolute;bottom:12rpx;left:12rpx;right:12rpx;padding:12rpx;background:rgba(230,209,172,.94);font-size:25rpx}.clock-scene-label{font-size:26rpx;margin-top:18rpx;color:#70543a}.clock-caption{font-size:29rpx;line-height:1.7;margin:12rpx 0;min-height:2.8em}.beast-row{display:flex;flex-wrap:wrap;gap:8rpx;margin:18rpx 0}.beast-dot{width:38rpx;height:42rpx;line-height:42rpx;text-align:center;border:1rpx solid #b5a183;color:#887862;font-size:25rpx}.beast-dot.lit{color:#734b21;border-color:#997345;background:#edcc8e}.beast-dot.spraying{border-bottom:5rpx solid #779b98}.clock-controls{display:flex;gap:12rpx;flex-wrap:wrap;align-items:center;justify-content:space-between;margin:16rpx 0}
.clock-controls .clock-button{flex:1 1 0;min-width:30%}.clock-button{font-size:27rpx;line-height:1.45;padding:19rpx 22rpx;min-height:88rpx;border:1rpx solid #a48a65;border-radius:5rpx;background:#efe1c6;color:#493727;margin:0;display:flex;align-items:center;justify-content:center;white-space:normal}.clock-button::after,.hours-toggle::after{border:0}.clock-button.primary{background:#843c2d;color:#fff0d3;border-color:#843c2d}.clock-button.is-disabled{opacity:.5}.clock-progress{display:flex;align-items:center;gap:8rpx;font-size:23rpx;color:#6c5740}.clock-progress-slider{flex:1;min-width:0;margin:18rpx 8rpx}.clock-progress-time{white-space:nowrap}.clock-question,.clock-result{margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #ad9574;font-size:28rpx;line-height:1.65}.question-title{font-size:31rpx;font-weight:600;margin-bottom:12rpx}.question-help{font-size:27rpx;margin-bottom:18rpx;color:#6a5540}.answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.answer,.confirm{width:100%;margin-top:14rpx}.answer.selected{border:2rpx solid #843c2d;background:#dfc49a}.clock-feedback{font-size:27rpx;color:#89392b;margin-top:16rpx}.hours-toggle{background:transparent;color:#694d30;text-align:left;padding:20rpx 0;font-size:28rpx;line-height:1.5;margin-top:18rpx;border-top:1rpx solid #ad9574;border-radius:0}.hours-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20rpx;font-size:26rpx}.hour-range{display:block;font-size:23rpx;color:#796249;margin-top:5rpx}.clock-notice{font-size:24rpx;color:#7d4c35;line-height:1.6;margin-top:18rpx}.clock-source{font-size:22rpx;color:#776348;line-height:1.6;margin-top:20rpx}
