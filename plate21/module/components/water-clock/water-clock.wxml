<view class="water-clock">
  <view class="clock-heading"><text class="clock-title">海晏堂 · 水醒</text><text class="clock-time">{{clock}}</text></view>
  <view class="clock-stage">
    <canvas type="2d" id="waterClockCanvas" class="clock-canvas {{staticMode ? 'canvas-hidden' : ''}}" aria-label="海晏堂十二生肖喷水示意" />
    <image wx:if="{{staticMode || loading}}" class="clock-still" src="{{shotSrc}}" mode="aspectFill" />
    <view wx:if="{{staticMode}}" class="still-label">{{label}}</view>
  </view>
  <view class="clock-scene-label" wx:if="{{!staticMode}}">{{label}}</view>
  <view class="clock-caption" aria-live="polite">{{caption}}</view>
  <view class="beast-row" aria-label="当前亮起的兽首">
    <text wx:for="{{beasts}}" wx:key="name" class="beast-dot {{item.lit ? 'lit' : ''}} {{item.spraying ? 'spraying' : ''}}">{{item.name}}</text>
  </view>
  <view class="clock-controls">
    <button wx:if="{{stage === 'observe' || stage === 'reveal' || completed}}" class="clock-button primary {{loading && !staticMode ? 'is-disabled' : ''}}" bindtap="onPlay" disabled="{{loading && !staticMode}}">{{staticMode ? (completed ? '回看图景' : '看下一幅') : (playing ? '暂停' : (time === 0 ? '开始观察' : '继续观看'))}}</button>
    <button wx:if="{{!staticMode}}" class="clock-button" bindtap="onStatic">静态讲解</button>
    <button wx:if="{{!staticMode}}" class="clock-button" bindtap="onSound">水声：{{sound ? '开' : '关'}}</button>
  </view>
  <view wx:if="{{!staticMode || completed}}" class="clock-progress">
    <slider class="clock-progress-slider" min="0" max="{{seekMax}}" step="0.1" value="{{time}}" disabled="{{stage === 'reveal'}}" activeColor="#843c2d" backgroundColor="#c9b99b" block-size="18" bindchange="onSeek" aria-label="动画进度" />
    <text class="clock-progress-time">{{elapsed}} / 40 秒</text>
  </view>
  <view wx:if="{{stage === 'hour14'}}" class="clock-question">
    <view class="question-title">第一问：14 时，应该由谁喷水？</view>
    <view class="question-help">一个时辰是两小时。可以展开下方的时辰表寻找线索。</view>
    <view class="answer-grid">
      <button wx:for="{{hourOptions}}" wx:key="id" class="clock-button" data-id="{{item.id}}" bindtap="onAnswer14">{{item.label}}</button>
    </view>
    <view wx:if="{{wrong14}}" class="clock-feedback">14 时落在 13—15 时，看看对应哪个生肖，再试一次。</view>
  </view>
  <view wx:if="{{stage === 'prediction'}}" class="clock-question">
    <view class="question-title">第二问：预测正午，会出现怎样的喷水景象？</view>
    <view class="question-help">14 时属于未时，由羊首报时。先记录你的预测，再观看揭晓。</view>
    <button wx:for="{{predictions}}" wx:key="id" class="clock-button answer {{prediction === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onPredict" aria-pressed="{{prediction === item.id}}">{{item.label}}</button>
    <button class="clock-button primary confirm {{!prediction ? 'is-disabled' : ''}}" bindtap="onConfirm" disabled="{{!prediction}}">确认预测 · 揭晓正午</button>
  </view>
  <view wx:if="{{completed}}" class="clock-result">
    <view class="question-title">水力钟的秘密，已揭晓</view>
    <view>{{prediction === 'all' ? '你的正午预测正确！正午十二兽首一起喷水报时，平时则轮流报时。' : '这次没猜中：正午时十二兽首会一起喷水报时，而平时每个时辰只有一只生肖喷水。看下面的演示。'}}</view>
    <view class="clock-controls"><button class="clock-button" bindtap="onReplay">回看完整动画</button><button class="clock-button" bindtap="onReplayNoon">重看正午</button></view>
  </view>
  <button class="hours-toggle" bindtap="onToggleHours">十二时辰对照表 {{showHours ? '－' : '＋'}}</button>
  <view wx:if="{{showHours}}" class="hours-grid">
    <view wx:for="{{hours}}" wx:key="name"><text>{{item.name}}</text><text class="hour-range">{{item.range}}</text></view>
  </view>
  <view wx:if="{{notice}}" class="clock-notice">{{notice}}</view>

</view>
