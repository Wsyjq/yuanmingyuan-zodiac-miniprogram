.stamp-toast {
  position: fixed;
  left: 0;
  right: 0;
  top: 42%;
  z-index: 200;
  display: flex;
  justify-content: center;
  pointer-events: none;
  animation: stamp-drop 0.45s cubic-bezier(0.2, 0.9, 0.24, 1.18) both;
}

.stamp-toast.fading {
  opacity: 0;
  transition: opacity 0.3s ease;
}
@keyframes stamp-drop {
  0% { opacity: 0; transform: translateY(-48rpx) scale(1.3); }
  78% { opacity: 1; transform: translateY(3rpx) scale(0.97); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 白文方印：朱砂边框 + 朱砂文字 */
.seal {
  padding: 16rpx 28rpx;
  border: 5rpx solid var(--cinnabar);
  border-radius: 8rpx;
  color: var(--cinnabar);
  background: rgba(229, 213, 184, 0.92);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  transform: rotate(var(--rot));
}

@media (prefers-reduced-motion: reduce) {
  .stamp-toast { animation: none; }
}
