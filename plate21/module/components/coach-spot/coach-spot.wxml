<view wx:if="{{visible && panes}}" class="cs-root {{closing ? 'overlay-out' : ''}}">
  <view class="cs-pane" style="top: {{panes.top.top}}px; left: {{panes.top.left}}px; width: {{panes.top.width}}px; height: {{panes.top.height}}px;" catchtap="noop"></view>
  <view class="cs-pane" style="top: {{panes.left.top}}px; left: {{panes.left.left}}px; width: {{panes.left.width}}px; height: {{panes.left.height}}px;" catchtap="noop"></view>
  <view class="cs-pane" style="top: {{panes.right.top}}px; left: {{panes.right.left}}px; width: {{panes.right.width}}px; height: {{panes.right.height}}px;" catchtap="noop"></view>
  <view class="cs-pane" style="top: {{panes.bottom.top}}px; left: {{panes.bottom.left}}px; width: {{panes.bottom.width}}px; height: {{panes.bottom.height}}px;" catchtap="noop"></view>

  <view
    wx:if="{{ring}}"
    class="cs-ring"
    style="top: {{ring.top}}px; left: {{ring.left}}px; width: {{ring.width}}px; height: {{ring.height}}px;"
  ></view>

  <view
    wx:if="{{step && bubble}}"
    class="cs-bubble card-archive {{bubble.above ? 'cs-bubble-above' : ''}}"
    style="{{bubble.style}}"
    catchtap="noop"
  >
    <view class="cs-dots">
      <view wx:for="{{dots}}" wx:key="i" class="cs-dot {{item.on ? 'on' : ''}}"></view>
    </view>
    <view class="cs-tag kaiti">{{step.tag}}</view>
    <view class="cs-tap">{{step.tap}}</view>
    <view class="cs-body">{{step.body}}</view>
    <view wx:if="{{step.names}}" class="cs-names">
      <view wx:for="{{step.names}}" wx:for-item="nm" wx:key="tap" class="cs-name">
        <text class="cs-name-tag kaiti">{{nm.tag}}</text>
        <text class="cs-name-tap">{{nm.tap}}</text>
      </view>
    </view>
    <view class="cs-actions">
      <button wx:if="{{!isLast}}" class="cs-skip" bindtap="onSkip">跳过</button>
      <button class="btn-seal cs-next" bindtap="onNext">{{primaryText}}</button>
    </view>
  </view>
</view>
