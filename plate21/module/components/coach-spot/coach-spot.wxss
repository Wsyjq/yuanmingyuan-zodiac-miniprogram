.cs-root {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 140;
  pointer-events: none;
}

.cs-pane {
  position: absolute;
  background: rgba(46, 31, 13, 0.58);
  pointer-events: auto;
}

.cs-ring {
  position: absolute;
  box-sizing: border-box;
  border: 4rpx solid var(--cinnabar);
  box-shadow: 0 0 0 6rpx rgba(166, 58, 46, 0.18);
  pointer-events: none;
}

.cs-bubble {
  position: absolute;
  z-index: 141;
  box-sizing: border-box;
  padding: 28rpx 28rpx 24rpx;
  pointer-events: auto;
  overflow-y: auto;
  background:
    linear-gradient(165deg, #F6F0E0 0%, var(--paper2) 100%);
  box-shadow: 0 20rpx 56rpx rgba(46, 31, 13, 0.28);
}

.cs-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.cs-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid var(--cinnabar);
  box-sizing: border-box;
}

.cs-dot.on {
  background: var(--cinnabar);
}

.cs-tag {
  color: var(--cinnabar);
  font-size: 40rpx;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

.cs-tap {
  margin-top: 4rpx;
  color: var(--ink60);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.cs-body {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.45;
}

.cs-names {
  margin-top: 12rpx;
  margin-bottom: 4rpx;
  border-top: 2rpx dashed rgba(70, 56, 42, 0.2);
  padding-top: 8rpx;
}

.cs-name {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 2rpx 0;
}

.cs-name-tag {
  flex: 0 0 136rpx;
  color: var(--cinnabar);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.cs-name-tap {
  flex: 1;
  color: var(--ink60);
  font-size: 20rpx;
}

.cs-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cs-skip {
  flex: 0 0 auto;
  padding: 12rpx 16rpx;
  color: var(--ink60);
  font-size: 26rpx;
  letter-spacing: 6rpx;
}

.cs-next {
  flex: 1;
  min-height: 80rpx;
  font-size: 30rpx;
  letter-spacing: 12rpx;
}
