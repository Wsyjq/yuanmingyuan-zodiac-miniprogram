.cs-root {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 140;
  pointer-events: none;
}

.cs-pane {
  position: absolute;
  background: rgba(46, 31, 13, 0.58);
  pointer-events: auto;
}

.cs-ring {
  position: absolute;
  box-sizing: border-box;
  border: 2px solid var(--cinnabar);
  box-shadow: 0 0 0 3px rgba(166, 58, 46, 0.18);
  pointer-events: none;
}

.cs-bubble {
  position: absolute;
  z-index: 141;
  box-sizing: border-box;
  padding: 14px 14px 12px;
  pointer-events: auto;
  overflow-y: auto;
  background:
    linear-gradient(165deg, #FBF9F3 0%, var(--paper2) 100%);
  box-shadow: 0 10px 28px rgba(46, 31, 13, 0.28);
}

.cs-dots {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
}

.cs-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1px solid var(--cinnabar);
  box-sizing: border-box;
}

.cs-dot.on {
  background: var(--cinnabar);
}

.cs-tag {
  color: var(--cinnabar);
  font-size: 20px;
  letter-spacing: 3px;
  line-height: 1.2;
}

.cs-tap {
  margin-top: 2px;
  color: var(--ink60);
  font-size: 12px;
  letter-spacing: 1px;
}

.cs-body {
  margin-top: 4px;
  color: var(--ink);
  font-size: 13px;
  line-height: 1.45;
}

.cs-names {
  margin-top: 6px;
  margin-bottom: 2px;
  border-top: 1px dashed rgba(70, 56, 42, 0.2);
  padding-top: 4px;
}

.cs-name {
  display: flex;
  align-items: baseline;
  gap: 6px;
  padding: 1px 0;
}

.cs-name-tag {
  flex: 0 0 68px;
  color: var(--cinnabar);
  font-size: 12px;
  letter-spacing: 1px;
}

.cs-name-tap {
  flex: 1;
  color: var(--ink60);
  font-size: 10px;
}

.cs-actions {
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.cs-skip {
  flex: 0 0 auto;
  padding: 6px 8px;
  color: var(--ink60);
  font-size: 13px;
  letter-spacing: 3px;
}

.cs-next {
  flex: 1;
  min-height: 40px;
  font-size: 15px;
  letter-spacing: 6px;
}
