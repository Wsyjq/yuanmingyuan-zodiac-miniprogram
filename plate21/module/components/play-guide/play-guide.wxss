/* 一页标签板：吊牌网格，不是长文出门条。 */

.pg-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(46, 31, 13, 0.52);
}

.pg-sheet {
  width: 100%;
  max-width: 680rpx;
  box-sizing: border-box;
  padding: 32rpx 36rpx 36rpx;
  background:
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 47rpx,
      rgba(122, 92, 62, 0.04) 48rpx,
      transparent 49rpx
    ),
    linear-gradient(165deg, #EBDDBF 0%, var(--paper2) 100%);
  box-shadow: 0 -16rpx 40rpx rgba(46, 31, 13, 0.22);
  animation: pg-up 0.35s ease;
}

.pg-sheet.pg-sheet-out {
  animation: pg-down 0.25s ease forwards;
}

.pg-kicker {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx;
  border-left: 4rpx solid var(--patina);
  color: var(--coffee);
  font-family: "Courier New", monospace;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.pg-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--ink-deep);
}

.pg-lead {
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink60);
}

.pg-scroll {
  max-height: 48vh;
  height: 48vh;
}

.pg-group {
  margin-bottom: 12rpx;
}

.pg-group-title {
  margin-bottom: 8rpx;
  color: var(--olive);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.pg-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pg-chip {
  position: relative;
  width: 48%;
  box-sizing: border-box;
  padding: 14rpx 8rpx 8rpx;
  background: var(--paper);
  border: 1rpx solid rgba(166, 58, 46, 0.55);
  box-shadow: 2rpx 3rpx 0 rgba(70, 56, 42, 0.08);
}

.pg-chip-hole {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: var(--paper2);
  box-shadow: inset 0 0 0 1rpx rgba(70, 56, 42, 0.35);
}

.pg-chip-tag {
  margin-top: 4rpx;
  text-align: center;
  color: var(--cinnabar);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.pg-chip-tap {
  margin-top: 2rpx;
  text-align: center;
  color: var(--ink60);
  font-size: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.pg-actions {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pg-skip {
  align-self: center;
  padding: 8rpx 24rpx;
  color: var(--ink60);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.pg-next {
  width: 100%;
  box-sizing: border-box;
}

@keyframes pg-up {
  from {
    transform: translateY(48rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes pg-down {
  to {
    transform: translateY(36rpx);
    opacity: 0;
  }
}
