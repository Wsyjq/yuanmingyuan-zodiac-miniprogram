<view wx:if="{{visible}}" class="history-card-mask {{closing ? 'overlay-out' : ''}}" bindtap="onClose">
  <view class="history-card card-archive {{closing ? 'card-out' : ''}}" catchtap="noop">
    <!-- 巴洛克卷草角饰（极简弧角 + 菱形点） -->
    <view class="corner tl"></view>
    <view class="corner tr"></view>
    <view class="corner bl"></view>
    <view class="corner br"></view>
    <view class="hc-close" bindtap="onClose">×</view>

    <!-- 采风修订版：卡片右下角数字（主线：数字连成日期密码） -->
    <view wx:if="{{showCorner}}" class="hc-corner-num">{{cornerNumber}}</view>

    <view class="hc-head">
      <view class="hc-kicker">ARCHIVE NOTE · 史料收录</view>
      <view class="hatch-divider hc-head-line"></view>
      <view class="hc-title serif">{{title}}</view>
    </view>

    <scroll-view class="hc-body" scroll-y>
      <view wx:for="{{lines}}" wx:key="index" class="hc-line">
        <block wx:if="{{item.parts}}"><text
          wx:for="{{item.parts}}"
          wx:for-item="seg"
          wx:key="index"
          class="hc-seg {{seg.g ? 'hc-link' : ''}}"
          data-g="{{seg.g || ''}}"
          bindtap="onSeg"
        >{{seg.t}}</text></block>
        <block wx:else>{{item}}</block>
      </view>
    </scroll-view>

    <view class="hc-foot">
      <view wx:if="{{source}}" class="hc-source">〔来源〕{{source}}</view>
      <button class="btn-seal hc-collect" bindtap="onBtn" disabled="{{closing}}">{{btnText || '收入考察手册'}}</button>
    </view>
  </view>
</view>
