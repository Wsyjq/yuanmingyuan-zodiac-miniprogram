.history-card-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 150;
  background: rgba(70, 56, 42, 0.35);
  display: flex;
  align-items: flex-end;
}

.history-card {
  width: 100%;
  max-height: 75vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  padding: 0 48rpx 48rpx;
  border-top: 3rpx solid rgba(46, 31, 13, 0.72);
  background:
    repeating-linear-gradient(0deg, transparent 0, transparent 47rpx, rgba(122, 92, 62, 0.025) 48rpx, transparent 49rpx),
    linear-gradient(155deg, #EBDDBF, var(--paper2));
  box-shadow: 0 -12rpx 34rpx rgba(46, 31, 13, 0.16);
  animation: card-up 0.35s ease;
}
/* INT-301：离场向下滑出，与进场 card-up 对称 */
.history-card.card-out {
  animation: card-down 0.25s ease forwards;
}

.hc-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 48rpx;
  line-height: 1;
  color: var(--ink60);
  padding: 8rpx 16rpx;
  /* INT-302：落印 :active 统一（与 .btn-seal 一致） */
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.hc-close:active {
  transform: scale(0.94);
  opacity: 0.85;
}

/* 采风修订版：卡片右下角数字（朱砂圆印样式，主线数字→日期密码） */
.hc-corner-num {
  position: absolute;
  bottom: 24rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #E5D5B8;
  background: #A63A2E;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(166, 58, 46, 0.35);
  z-index: 5;
}

.hc-head {
  padding-top: 32rpx;
}

.hc-kicker {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 5rpx 13rpx;
  border-left: 4rpx solid var(--patina);
  color: var(--ink60);
  font-family: "Courier New", monospace;
  font-size: 18rpx;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.hc-head-line {
  width: 100%;
  height: 8rpx;
  margin-bottom: 20rpx;
  opacity: 0.65;
}

.hc-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink-deep);
}

.hc-body {
  flex: 1;
  overflow: hidden;
  margin-top: 24rpx;
  max-height: 50vh;
}

.hc-line {
  font-size: 29rpx;
  line-height: 1.8;
  color: var(--ink);
  margin-bottom: 16rpx;
}

/* 卡内术语超链接：铜绿 + 虚线下划线，点开对应术语史料卡（bind:glossary） */
.hc-link {
  color: var(--patina);
  font-weight: 700;
  border-bottom: 2rpx dashed var(--patina);
  padding-bottom: 2rpx;
}
.hc-link:active {
  opacity: 0.65;
}

.hc-foot {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(70, 56, 42, 0.24);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hc-source {
  font-size: 22rpx;
  color: var(--ink60);
  flex: 1;
  padding-right: 24rpx;
}

.hc-collect {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

@keyframes card-up {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}

/* INT-301：离场向下滑出（card-up 的逆） */
@keyframes card-down {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(100%);
  }
}
