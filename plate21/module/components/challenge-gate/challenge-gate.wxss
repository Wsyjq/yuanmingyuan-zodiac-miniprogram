.cg-shell{box-sizing:border-box;min-height:100vh;padding:170rpx 48rpx 260rpx;background:#f5eedf;color:#403529;}.cg-kicker{font-size:21rpx;letter-spacing:4rpx;color:#90744f;margin-bottom:34rpx;}.cg-title{font-family:serif;font-size:48rpx;margin-bottom:50rpx;}.cg-action{font-family:serif;font-size:37rpx;line-height:1.8;padding-bottom:30rpx;border-bottom:1rpx solid #b7a281;}.cg-note{font-size:26rpx;line-height:1.9;color:#7c6e59;margin:22rpx 0;}.cg-copy{font-size:29rpx;line-height:1.9;margin:24rpx 0;}.cg-shell button{background:#e8dcc2;border:1rpx solid #b7a281;padding:22rpx;font-size:28rpx;margin:24rpx 0;line-height:1.5;}.cg-row{display:flex;gap:20rpx;}.cg-row button{flex:1;}.cg-collapse{position:fixed;left:30rpx;bottom:36rpx;z-index:94;font-size:24rpx;background:#ece1c9;padding:15rpx 24rpx;line-height:1.5;border:1rpx solid #b7a281;}