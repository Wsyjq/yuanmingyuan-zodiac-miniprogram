/* optional: task-shell 已预留顶部空间；当前主线页未引用本组件，保留备用 */
.task-banner {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 90;
  min-height: 92rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx 10rpx;
  background: linear-gradient(155deg, #F6F0E0, var(--paper2));
  border: 2rpx solid rgba(46, 31, 13, 0.68);
  border-left: 7rpx solid var(--brass);
  border-radius: 3rpx 7rpx 4rpx 5rpx;
  box-shadow: 7rpx 8rpx 0 rgba(70, 56, 42, 0.07), 0 5rpx 18rpx rgba(70, 56, 42, 0.18);
  transform: translateY(-240rpx);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
}

.task-banner::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 10rpx;
  bottom: 10rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.18);
  pointer-events: none;
}

.task-banner.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.task-kicker {
  position: absolute;
  left: 22rpx;
  top: -20rpx;
  padding: 5rpx 16rpx;
  border: 1rpx solid var(--brass);
  background: var(--paper);
  color: var(--coffee);
  font-size: 17rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  transform: rotate(-1deg);
}

.icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  color: var(--brass);
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-deep);
  font-family: "STSong", "SimSun", serif;
  letter-spacing: 1rpx;
}
