<view class="page index-page" wx:if="{{route}}">
  <progress-header
    eyebrow="YUANMINGYUAN STUDY TOUR"
    title="{{route.title}}"
    subtitle="{{route.subtitle}}"
    tag="{{route.estimatedDuration}}"
    meta-left="线路进度 {{progressText}}"
    meta-right="{{progressPercent}}%"
    progress-percent="{{progressPercent}}"
    dark="{{true}}"
  />

  <view class="theme-card card">
    <view class="theme-text">{{route.themeText}}</view>
  </view>

  <view class="status-card card">
    <view class="status-row">
      <view>
        <view class="status-label">当前用户</view>
        <view class="status-value">{{user.nickname}}</view>
      </view>
      <view class="status-pill">Mock 登录态</view>
    </view>
    <mark-strip chips="{{markChips}}" label="已获印记" />
  </view>

  <view wx:if="{{hasSession}}" class="resume-card card">
    <view class="resume-title">发现未完成的游玩进度</view>
    <view class="resume-text">可继续上次进度，也可重新开始。重新开始会将旧进度标记为已放弃。</view>
    <view class="action-grid">
      <button class="btn-primary" bindtap="continueTour">继续上次进度</button>
      <button class="btn-secondary" bindtap="restartTour">重新开始</button>
    </view>
  </view>

  <view wx:else class="start-card card">
    <view class="resume-title">准备开始寻迹</view>
    <view class="resume-text">从大水法出发，沿八个站点完成实景解谜，最终在正觉寺完成十二格终局拼图。</view>
    <button class="btn-primary" bindtap="startTour">开始游玩</button>
  </view>

  <view class="quick-actions">
    <button class="btn-secondary" bindtap="openMap">地图辅助</button>
    <button class="btn-secondary" bindtap="openRecords">游玩记录</button>
    <button wx:if="{{enableDevPlayground}}" class="btn-secondary" bindtap="openDevPlayground">玩法调试</button>
  </view>

  <stage-list stages="{{stageCards}}" bind:stagetap="tapStage" />

  <button class="dev-clear" bindtap="clearLocalData">开发调试：清空本地 Mock 进度</button>
</view>
