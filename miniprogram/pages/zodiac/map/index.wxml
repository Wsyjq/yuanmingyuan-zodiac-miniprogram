<view class="page map-page">
  <view class="map-card card">
    <view class="map-title">地图辅助游览</view>
    <view class="map-desc">一期定位仅用于辅助游览，不作为强制打卡门槛。</view>
    <button class="btn-primary" bindtap="locateUser">显示当前位置</button>
    <view class="location-text">{{userLocationText}}</view>
  </view>

  <map class="map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" markers="{{markers}}" polyline="{{polyline}}" show-location="{{hasUserLocation}}" bindmarkertap="onMarkerTap"></map>

  <view wx:if="{{selectedStage}}" class="stage-preview card">
    <view class="stage-title">{{selectedStage.order}}. {{selectedStage.place}}</view>
    <view class="stage-task">{{selectedStage.task}}</view>
    <button class="btn-primary" bindtap="goStage">进入该站</button>
  </view>
</view>
