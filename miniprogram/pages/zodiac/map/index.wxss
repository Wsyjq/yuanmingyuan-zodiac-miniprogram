.map-card,
.stage-preview {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.map-title,
.stage-title {
  font-size: 34rpx;
  font-weight: 900;
}

.map-desc,
.stage-task,
.location-text {
  margin: 12rpx 0 18rpx;
  color: rgba(44, 61, 69, 0.66);
  font-size: 25rpx;
  line-height: 1.7;
}

.map {
  width: 100%;
  height: 760rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.stage-preview {
  margin-top: 22rpx;
}
