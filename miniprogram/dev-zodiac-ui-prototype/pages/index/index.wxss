page {
  min-height: 100%;
  background: #d8d0c0;
}

button {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border-radius: 0;
  font-family: "DIN Alternate", "PingFang SC", sans-serif;
  font-weight: 500;
  line-height: 1.2;
}

button::after {
  display: none;
}

.prototype-page {
  --ink: #1e2521;
  --ink-soft: #4c554e;
  --paper: #eee5d3;
  --paper-deep: #d8cbb5;
  --verdigris: #426a63;
  --verdigris-light: #82a096;
  --cinnabar: #964536;
  --brass: #b08a4d;
  --night: #121815;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --type-display: 48rpx;
  --type-body: 28rpx;
  --type-ui: 25rpx;
  --type-quote: 30rpx;
  --motion-enter: 520ms;
  --motion-result: 1200ms;
  --motion-settle: 760ms;
  --motion-focus-delay: 1620ms;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: 24rpx;
  padding-right: calc(24rpx + env(safe-area-inset-right));
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
  padding-left: calc(24rpx + env(safe-area-inset-left));
  color: var(--ink);
  background:
    linear-gradient(90deg, rgba(30, 37, 33, 0.035) 1rpx, transparent 1rpx) 0 0 / 32rpx 32rpx,
    linear-gradient(rgba(30, 37, 33, 0.03) 1rpx, transparent 1rpx) 0 0 / 32rpx 32rpx,
    #d8d0c0;
}

.prototype-shell {
  width: 100%;
  max-width: 1180rpx;
  margin: 0 auto;
}

.workbench {
  padding: var(--space-4);
  color: #ecE6d9;
  background:
    radial-gradient(circle at 88% -20%, rgba(176, 138, 77, 0.2), transparent 38%),
    #171c19;
  border-top: 6rpx solid var(--brass);
  box-shadow: 0 16rpx 38rpx rgba(31, 37, 33, 0.18);
}

.workbench-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.dev-kicker,
.scene-eyebrow,
.chapter-label,
.beat-label,
.reading-label,
.control-label,
.metadata-key,
.fallback-coordinate,
.night-caption {
  font-family: "DIN Alternate", "PingFang SC", sans-serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.dev-kicker {
  color: rgba(236, 230, 217, 0.72);
}

.dev-title {
  margin-top: 8rpx;
  font-family: STSong, "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.isolation-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  min-height: 48rpx;
  padding: 0 16rpx;
  color: #cbd8ce;
  background: rgba(90, 124, 111, 0.16);
  border: 1rpx solid rgba(130, 160, 150, 0.38);
  font-size: 22rpx;
}

.isolation-dot {
  width: 10rpx;
  height: 10rpx;
  background: #86b39e;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(134, 179, 158, 0.1);
}

.dev-note {
  margin-top: 18rpx;
  padding-top: 16rpx;
  color: rgba(236, 230, 217, 0.66);
  border-top: 1rpx solid rgba(236, 230, 217, 0.12);
  font-size: 26rpx;
  line-height: 1.6;
}

.token-strip {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.token-item {
  display: inline-flex;
  width: 190rpx;
  min-height: 66rpx;
  margin-right: 10rpx;
  padding: 8rpx 10rpx;
  align-items: center;
  gap: 12rpx;
  color: rgba(236, 230, 217, 0.78);
  vertical-align: top;
  border: 1rpx solid rgba(236, 230, 217, 0.14);
}

.token-swatch {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border: 1rpx solid rgba(236, 230, 217, 0.32);
}

.token-paper { background: #eee5d3; }
.token-ink { background: #1e2521; }
.token-verdigris { background: #426a63; }
.token-cinnabar { background: #964536; }
.token-brass { background: #b08a4d; }
.token-night { background: #121815; }

.token-copy,
.token-label,
.token-value {
  display: block;
  min-width: 0;
}

.token-label {
  font-size: 21rpx;
  line-height: 1.3;
}

.token-value {
  margin-top: 3rpx;
  color: rgba(236, 230, 217, 0.72);
  font-family: "DIN Alternate", monospace;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.query-warning {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  color: #f3d8ad;
  background: rgba(150, 69, 54, 0.2);
  border-left: 4rpx solid #d28b61;
  font-size: 26rpx;
  line-height: 1.5;
}

.control-section,
.preview-controls {
  margin-top: var(--space-3);
}

.control-label {
  margin-bottom: 12rpx;
  color: rgba(236, 230, 217, 0.72);
}

.screen-selector {
  width: 100%;
  white-space: nowrap;
}

.screen-option {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 220rpx;
  min-height: 48px;
  margin-right: 12rpx;
  padding: 14rpx 18rpx;
  color: rgba(236, 230, 217, 0.62);
  text-align: left;
  vertical-align: top;
  background: transparent;
  border: 1rpx solid rgba(236, 230, 217, 0.16);
}

.screen-option.is-active {
  color: #171c19;
  background: #d8cbb5;
  border-color: #d8cbb5;
  box-shadow: inset 0 -5rpx 0 var(--cinnabar);
}

.screen-option-id {
  font-family: "DIN Alternate", monospace;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.screen-option-name {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.preview-controls {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.segmented-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border: 1rpx solid rgba(236, 230, 217, 0.16);
}

.mode-option {
  min-height: 44px;
  padding: 0 14rpx;
  color: rgba(236, 230, 217, 0.62);
  background: transparent;
  border-right: 1rpx solid rgba(236, 230, 217, 0.16);
  font-size: var(--type-ui);
}

.mode-option:last-child {
  border-right: 0;
}

.mode-option.is-active {
  color: #f1eadb;
  background: rgba(66, 106, 99, 0.42);
  box-shadow: inset 0 -4rpx 0 #82a096;
}

.control-hover {
  opacity: 0.76;
}

.screen-option:focus,
.mode-option:focus {
  border-color: #d8cbb5;
  box-shadow: inset 0 0 0 2rpx #d8cbb5;
}

.screen-option.is-active:focus {
  box-shadow: inset 0 -5rpx 0 var(--cinnabar), inset 0 0 0 3rpx var(--ink);
}

.product-button:focus,
.reset-preview:focus {
  border-color: var(--ink);
  box-shadow: inset 0 0 0 3rpx var(--ink);
}

.preview-column {
  margin-top: 22rpx;
}

.device-ruler {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rpx;
  background: rgba(30, 37, 33, 0.16);
  border: 1rpx solid rgba(30, 37, 33, 0.16);
}

.device-reading {
  display: flex;
  min-width: 0;
  min-height: 70rpx;
  padding: 12rpx 16rpx;
  flex-direction: column;
  justify-content: center;
  background: #e9e1d2;
}

.reading-label {
  color: rgba(30, 37, 33, 0.72);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.reading-value {
  margin-top: 5rpx;
  overflow: hidden;
  font-family: "DIN Alternate", monospace;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screen-frame {
  position: relative;
  min-height: 980rpx;
  margin-top: var(--space-2);
  overflow: hidden;
  background: var(--paper);
  border: 1rpx solid rgba(30, 37, 33, 0.24);
  box-shadow: 0 24rpx 56rpx rgba(30, 37, 33, 0.18);
}

.screen-frame::before {
  position: absolute;
  z-index: 0;
  inset: 0;
  pointer-events: none;
  content: "";
  opacity: 0.2;
  background-image:
    repeating-linear-gradient(8deg, rgba(65, 53, 37, 0.08) 0, rgba(65, 53, 37, 0.08) 1rpx, transparent 1rpx, transparent 8rpx);
}

.frame-index {
  position: absolute;
  z-index: 3;
  top: 26rpx;
  right: 24rpx;
  color: rgba(30, 37, 33, 0.22);
  font-family: "DIN Alternate", monospace;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.frame-head,
.frame-footer,
.scene,
.state-banner,
.unreachable-panel {
  position: relative;
  z-index: 1;
}

.frame-head {
  display: flex;
  min-height: 110rpx;
  padding: 26rpx 28rpx 20rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 120rpx;
  border-bottom: 1rpx solid rgba(30, 37, 33, 0.18);
}

.product-chrome {
  position: relative;
  z-index: 2;
  display: flex;
  min-height: 96rpx;
  padding: var(--space-2) var(--space-3);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  color: var(--ink);
  background: rgba(244, 236, 220, 0.72);
  border-bottom: 1rpx solid rgba(30, 37, 33, 0.16);
}

.route-progress {
  min-width: 0;
  flex: 1;
}

.route-progress-copy,
.route-progress-label,
.route-progress-source {
  display: block;
  min-width: 0;
}

.route-progress-label {
  font-size: 24rpx;
  font-weight: 700;
}

.route-progress-source {
  margin-top: 4rpx;
  overflow: hidden;
  color: rgba(30, 37, 33, 0.72);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-progress-track {
  display: grid;
  max-width: 330rpx;
  margin-top: var(--space-1);
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6rpx;
}

.route-tick {
  height: 5rpx;
  background: rgba(30, 37, 33, 0.18);
}

.route-tick.is-reached {
  background: var(--cinnabar);
}

.product-utilities {
  display: flex;
  flex: none;
  gap: var(--space-1);
}

.product-button {
  min-height: 44px;
  padding: 0 var(--space-2);
  color: var(--ink);
  background: transparent;
  border: 1rpx solid rgba(30, 37, 33, 0.42);
  font-size: var(--type-ui);
}

.utility-button {
  min-width: 92rpx;
}

.chapter-label {
  color: var(--cinnabar);
  letter-spacing: 2rpx;
}

.beat-label {
  margin-top: 8rpx;
  color: rgba(30, 37, 33, 0.7);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.asset-stamp {
  flex: none;
  padding: 8rpx 13rpx 7rpx;
  color: var(--cinnabar);
  border: 2rpx solid currentColor;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  transform: rotate(-3deg);
}

.state-banner {
  display: flex;
  padding: 15rpx 28rpx;
  align-items: baseline;
  gap: 14rpx;
  color: #e9e1d2;
  background: var(--verdigris);
  font-size: 24rpx;
  line-height: 1.5;
}

.state-banner-title {
  flex: none;
  font-weight: 700;
}

.scene {
  box-sizing: border-box;
  min-height: 620rpx;
}

.scene-eyebrow {
  color: var(--cinnabar);
  font-size: 21rpx;
}

.scene-title {
  margin-top: 15rpx;
  font-family: STSong, "Songti SC", serif;
  font-size: var(--type-display);
  font-weight: 700;
  line-height: 1.28;
  letter-spacing: 2rpx;
}

.scene-summary {
  margin-top: 22rpx;
  color: var(--ink-soft);
  font-family: "Songti SC", STSong, serif;
  font-size: var(--type-body);
  line-height: 1.8;
}

.scene-asset {
  display: block;
}

.asset-provenance,
.asset-provenance-code,
.asset-provenance-copy {
  display: block;
}

.asset-provenance {
  z-index: 4;
  font-family: "DIN Alternate", "PingFang SC", sans-serif;
}

.asset-provenance-code {
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.asset-provenance-copy {
  margin-top: 5rpx;
  font-size: 21rpx;
  line-height: 1.45;
}

.asset-error {
  color: #f3dfbc;
  background: #6f382f;
}

.prologue-scene {
  position: relative;
  display: flex;
  min-height: 790rpx;
  padding: 46rpx 34rpx 38rpx;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  background: #c9bba2;
}

.prologue-artwork {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  animation: material-reveal var(--motion-result) var(--ease-out) both;
}

.prologue-wash {
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(238, 229, 211, 0.02) 20%, rgba(19, 24, 21, 0.16) 59%, rgba(19, 24, 21, 0.58) 100%),
    linear-gradient(90deg, rgba(238, 229, 211, 0.25), transparent 36%);
}

.prologue-folio {
  position: absolute;
  z-index: 2;
  top: 40rpx;
  right: 26rpx;
  display: flex;
  width: 150rpx;
  align-items: flex-end;
  flex-direction: column;
  color: rgba(238, 229, 211, 0.86);
  text-shadow: 0 3rpx 12rpx rgba(18, 24, 21, 0.4);
}

.folio-number {
  font-family: "DIN Alternate", monospace;
  font-size: 126rpx;
  font-weight: 700;
  line-height: 0.82;
  letter-spacing: -8rpx;
}

.folio-label {
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid rgba(238, 229, 211, 0.62);
  font-family: "DIN Alternate", monospace;
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.prologue-provenance {
  position: absolute;
  top: 44rpx;
  left: 34rpx;
  max-width: 330rpx;
  color: rgba(30, 37, 33, 0.78);
}

.title-plate {
  position: relative;
  z-index: 3;
  width: calc(100% - 34rpx);
  max-width: 630rpx;
  margin-right: auto;
  padding: 34rpx 38rpx 31rpx 32rpx;
  background: rgba(244, 236, 220, 0.93);
  clip-path: polygon(0 0, 92% 0, 100% 12%, 97% 90%, 88% 100%, 7% 97%, 0 84%);
  animation: plate-enter var(--motion-settle) var(--ease-out) both;
}

.title-plate::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  content: "";
  background: var(--cinnabar);
}

.route-thread {
  position: relative;
  display: grid;
  margin-top: 27rpx;
  padding-top: 18rpx;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  color: rgba(30, 37, 33, 0.72);
}

.route-thread::before {
  position: absolute;
  top: 24rpx;
  right: 9%;
  left: 9%;
  height: 2rpx;
  content: "";
  background: rgba(30, 37, 33, 0.28);
}

.route-stop {
  position: relative;
  z-index: 1;
  min-width: 0;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.3;
}

.route-node {
  width: 13rpx;
  height: 13rpx;
  margin: 0 auto 10rpx;
  background: var(--paper);
  border: 2rpx solid var(--cinnabar);
  border-radius: 50%;
}

.route-stop:first-child .route-node {
  background: var(--cinnabar);
  box-shadow: 0 0 0 6rpx rgba(150, 69, 54, 0.13);
}

.path-scene {
  position: relative;
  min-height: 760rpx;
  padding: 34rpx 0 40rpx;
  overflow: hidden;
  color: #efe4cb;
  background: #121815;
}

.night-caption {
  margin: 0 34rpx;
  color: rgba(239, 228, 203, 0.72);
}

.path-artwork-shell {
  position: relative;
  height: 470rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: #17201c;
  clip-path: polygon(0 7%, 8% 0, 95% 3%, 100% 18%, 96% 88%, 87% 100%, 4% 95%);
}

.path-artwork {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  animation: material-reveal var(--motion-result) var(--ease-out) both;
}

.path-vignette {
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(18, 24, 21, 0.02) 45%, rgba(18, 24, 21, 0.72) 100%);
}

.path-origin-seal,
.path-focus-seal {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  border-radius: 50%;
  text-align: center;
}

.path-origin-seal {
  bottom: 24rpx;
  left: 24rpx;
  width: 88rpx;
  height: 88rpx;
  color: #f0e5ce;
  background: rgba(150, 69, 54, 0.88);
  border: 1rpx solid rgba(240, 229, 206, 0.44);
  font-size: 18rpx;
}

.path-origin-seal text:first-child {
  font-family: STSong, serif;
  font-size: 28rpx;
  line-height: 1;
}

.path-focus-seal {
  top: 26rpx;
  right: 21rpx;
  width: 126rpx;
  height: 126rpx;
  color: #151b18;
  background: rgba(211, 184, 117, 0.92);
  border: 8rpx solid rgba(18, 24, 21, 0.42);
  box-shadow: 0 0 0 2rpx rgba(211, 184, 117, 0.72), 0 0 38rpx rgba(211, 184, 117, 0.34);
  font-size: 18rpx;
  animation: focus-settle var(--motion-result) var(--ease-out) both;
  animation-delay: var(--motion-focus-delay);
}

.focus-hanzi {
  font-family: STSong, serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.path-provenance {
  position: absolute;
  right: 24rpx;
  bottom: 25rpx;
  left: 132rpx;
  color: rgba(240, 229, 206, 0.76);
}

.result-copy {
  margin: 30rpx 34rpx 0;
  padding-left: 24rpx;
  border-left: 3rpx solid var(--brass);
}

.path-scene .scene-eyebrow { color: var(--brass); }
.path-scene .scene-title { color: #f1e5cb; }
.path-scene .scene-summary { color: rgba(241, 229, 203, 0.72); }

.reconstruction-scene {
  min-height: 800rpx;
  padding: 34rpx 30rpx 40rpx;
  overflow: hidden;
  background: #e6ded0;
}

.comparison-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.comparison-header .scene-title {
  max-width: 520rpx;
  font-size: 40rpx;
}

.comparison-mode {
  flex: none;
  padding-bottom: 7rpx;
  color: rgba(30, 37, 33, 0.7);
  border-bottom: 2rpx solid var(--cinnabar);
  font-family: "DIN Alternate", monospace;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.comparison-stage {
  position: relative;
  height: 520rpx;
  margin-top: 34rpx;
  overflow: hidden;
  background: #69736c;
  clip-path: polygon(0 4%, 5% 0, 100% 0, 100% 94%, 94% 100%, 0 97%);
}

.comparison-image {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.comparison-image-ruin {
  clip-path: polygon(0 0, 66% 0, 48% 100%, 0 100%);
}

.comparison-image-reconstruction {
  clip-path: polygon(66% 0, 100% 0, 100% 100%, 48% 100%);
  animation: reconstruction-reveal var(--motion-settle) var(--ease-out) both;
}

.comparison-shade {
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(18, 24, 21, 0.48), transparent 42%),
    linear-gradient(0deg, rgba(18, 24, 21, 0.48), transparent 38%);
}

.comparison-tag,
.comparison-tag-kicker,
.comparison-tag-title,
.comparison-tag-note {
  display: block;
}

.comparison-tag {
  position: absolute;
  z-index: 3;
  width: 292rpx;
  padding: 16rpx 20rpx;
  font-size: 20rpx;
  line-height: 1.35;
}

.comparison-tag-ruin {
  top: 26rpx;
  left: 20rpx;
  color: #f1eadb;
  background: rgba(18, 24, 21, 0.82);
  clip-path: polygon(0 0, 96% 0, 100% 18%, 94% 100%, 0 92%);
}

.comparison-tag-reconstruction {
  right: 20rpx;
  bottom: 42rpx;
  color: #1e2521;
  background: rgba(238, 229, 211, 0.9);
  clip-path: polygon(7% 0, 100% 5%, 100% 100%, 0 92%, 0 15%);
}

.comparison-tag-kicker {
  font-family: "DIN Alternate", monospace;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  opacity: 0.76;
}

.comparison-tag-title {
  margin-top: 7rpx;
  font-family: STSong, "Songti SC", serif;
  font-size: 25rpx;
  font-weight: 700;
}

.comparison-tag-note {
  margin-top: 4rpx;
  opacity: 0.82;
}

.comparison-divider {
  position: absolute;
  z-index: 4;
  top: -12%;
  bottom: -12%;
  left: 57%;
  width: 3rpx;
  background: rgba(242, 234, 219, 0.9);
  box-shadow: 0 0 0 1rpx rgba(30, 37, 33, 0.3);
  transform: rotate(10deg);
}

.divider-label {
  position: absolute;
  top: 49%;
  left: 50%;
  width: 54rpx;
  height: 54rpx;
  color: #f2eadb;
  background: #26302b;
  border: 2rpx solid #f2eadb;
  border-radius: 50%;
  font-family: STSong, serif;
  font-size: 24rpx;
  line-height: 50rpx;
  text-align: center;
  transform: translate(-50%, -50%) rotate(-10deg);
}

.comparison-provenance {
  position: absolute;
  z-index: 3;
  bottom: 16rpx;
  left: 20rpx;
  max-width: 310rpx;
  color: rgba(241, 234, 219, 0.84);
  font-size: 18rpx;
  line-height: 1.35;
}

.comparison-summary {
  padding-left: 20rpx;
  border-left: 3rpx solid var(--verdigris);
}

.screen-final-board {
  color: #eee5d3;
  background: var(--night);
  border-color: rgba(216, 203, 181, 0.24);
}

.screen-final-board::before {
  opacity: 0.14;
  background-image:
    radial-gradient(circle at 50% 18%, rgba(176, 138, 77, 0.34), transparent 30%),
    repeating-linear-gradient(10deg, rgba(238, 229, 211, 0.1) 0, rgba(238, 229, 211, 0.1) 1rpx, transparent 1rpx, transparent 9rpx);
}

.screen-final-board .frame-head {
  border-color: rgba(238, 229, 211, 0.17);
}

.screen-final-board .frame-index {
  color: rgba(238, 229, 211, 0.12);
}

.screen-final-board .beat-label {
  color: rgba(238, 229, 211, 0.78);
}

.screen-final-board .chapter-label,
.screen-final-board .asset-stamp {
  color: #c89a5a;
}

.final-scene {
  min-height: 920rpx;
  padding: 38rpx 30rpx 44rpx;
  overflow: hidden;
}

.final-heading {
  position: relative;
  z-index: 3;
  padding-right: 30rpx;
}

.final-heading .scene-eyebrow {
  color: #c89a5a;
}

.final-heading .scene-title {
  max-width: 560rpx;
  color: #f0e5ce;
  font-size: 42rpx;
}

.status-fixture {
  display: flex;
  margin-top: 18rpx;
  align-items: center;
  gap: 10rpx;
  color: rgba(240, 229, 206, 0.78);
  font-size: 22rpx;
}

.status-fixture::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border: 2rpx dashed #c89a5a;
  border-radius: 50%;
}

.zodiac-orbit {
  position: relative;
  width: 100%;
  height: 700rpx;
  margin: 30rpx auto 0;
}

.radial-board-artwork {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 50%;
  width: 640rpx;
  height: 640rpx;
  opacity: 0.94;
  transform: translateX(-50%);
  animation: material-reveal var(--motion-result) var(--ease-out) both;
}

.radial-status {
  position: absolute;
  z-index: 3;
  display: flex;
  width: 104rpx;
  align-items: center;
  flex-direction: column;
  color: #d7be7f;
  text-align: center;
  transform: translate(-50%, -50%);
  animation: radial-status-enter var(--motion-enter) var(--ease-out) both;
}

.radial-status:nth-child(2n) { animation-delay: 80ms; }
.radial-status:nth-child(3n) { animation-delay: 160ms; }
.radial-status:nth-child(4n) { animation-delay: 240ms; }

.radial-status-01 { top: 22rpx; left: 50%; }
.radial-status-02 { top: 68rpx; left: 70.5%; }
.radial-status-03 { top: 172rpx; left: 86.5%; }
.radial-status-04 { top: 304rpx; left: 92%; }
.radial-status-05 { top: 438rpx; left: 86.5%; }
.radial-status-06 { top: 550rpx; left: 70.5%; }
.radial-status-07 { top: 604rpx; left: 50%; }
.radial-status-08 { top: 550rpx; left: 29.5%; }
.radial-status-09 { top: 438rpx; left: 13.5%; }
.radial-status-10 { top: 304rpx; left: 8%; }
.radial-status-11 { top: 172rpx; left: 13.5%; }
.radial-status-12 { top: 68rpx; left: 29.5%; }

.slot-mark {
  width: 25rpx;
  height: 25rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.slot-copy {
  display: flex;
  margin-top: 5rpx;
  align-items: baseline;
  justify-content: center;
  gap: 5rpx;
  white-space: nowrap;
}

.slot-index {
  font-family: "DIN Alternate", monospace;
  font-size: 18rpx;
  opacity: 0.72;
}

.slot-label {
  font-size: 19rpx;
  line-height: 1.2;
}

.status-layout-a .slot-mark {
  background: #bfa36b;
  box-shadow: 0 0 0 5rpx rgba(191, 163, 107, 0.12);
}

.status-layout-b {
  color: #91b1a7;
}

.status-layout-b .slot-mark {
  background: rgba(66, 106, 99, 0.78);
  border-color: #a9c4bb;
}

.status-pending {
  color: rgba(240, 229, 206, 0.68);
}

.status-pending .slot-mark {
  background: transparent;
  border-style: dashed;
}

.orbit-center {
  position: absolute;
  z-index: 3;
  top: 320rpx;
  left: 50%;
  display: flex;
  width: 172rpx;
  height: 172rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #d9c486;
  background: rgba(18, 24, 21, 0.78);
  border: 1rpx solid rgba(217, 196, 134, 0.5);
  border-radius: 50%;
  text-align: center;
  transform: translate(-50%, -50%);
}

.orbit-count,
.orbit-center-label,
.orbit-center-note {
  display: block;
}

.orbit-count {
  font-family: "DIN Alternate", monospace;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 0.9;
}

.orbit-center-label {
  margin-top: 8rpx;
  font-family: STSong, serif;
  font-size: 22rpx;
}

.orbit-center-note {
  margin-top: 5rpx;
  color: rgba(240, 229, 206, 0.58);
  font-size: 16rpx;
}

.orbit-provenance {
  position: absolute;
  right: 10rpx;
  bottom: 0;
  left: 10rpx;
  color: rgba(240, 229, 206, 0.62);
  text-align: center;
}

.final-summary {
  margin-top: 20rpx;
  color: rgba(240, 229, 206, 0.76);
}

.unreachable-panel {
  display: flex;
  min-height: 700rpx;
  padding: 56rpx 44rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  background:
    linear-gradient(90deg, rgba(30, 37, 33, 0.04) 1rpx, transparent 1rpx) 0 0 / 42rpx 42rpx,
    linear-gradient(rgba(30, 37, 33, 0.04) 1rpx, transparent 1rpx) 0 0 / 42rpx 42rpx,
    #e7dfd0;
}

.product-action-row {
  position: relative;
  z-index: 2;
  display: grid;
  padding: var(--space-3) 28rpx;
  grid-template-columns: 1fr;
  gap: var(--space-2);
  border-top: 1rpx solid rgba(30, 37, 33, 0.16);
}

.product-action-copy,
.product-action-kicker,
.product-action-note {
  display: block;
  min-width: 0;
}

.product-action-kicker {
  color: var(--cinnabar);
  font-family: "DIN Alternate", monospace;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.product-action-note {
  margin-top: 6rpx;
  color: rgba(30, 37, 33, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}

.product-primary {
  width: 100%;
  color: #f4ecdc;
  background: var(--cinnabar);
  border-color: var(--cinnabar);
  font-weight: 700;
}

.product-primary:focus {
  border-color: #f4ecdc;
  box-shadow: inset 0 0 0 3rpx #f4ecdc;
}

.preview-notice {
  position: relative;
  z-index: 2;
  margin: 0 28rpx var(--space-2);
  padding: var(--space-2);
  color: var(--ink);
  background: rgba(66, 106, 99, 0.12);
  border-left: 4rpx solid var(--verdigris);
  font-size: 24rpx;
  line-height: 1.5;
}

.screen-final-board .product-chrome,
.screen-final-board .product-action-row {
  color: #eee5d3;
  background: rgba(238, 229, 211, 0.045);
  border-color: rgba(238, 229, 211, 0.16);
}

.screen-final-board .route-progress-source,
.screen-final-board .product-action-note {
  color: rgba(238, 229, 211, 0.74);
}

.screen-final-board .route-tick {
  background: rgba(238, 229, 211, 0.18);
}

.screen-final-board .route-tick.is-reached {
  background: var(--brass);
}

.screen-final-board .product-button {
  color: #eee5d3;
  border-color: rgba(238, 229, 211, 0.46);
}

.screen-final-board .product-button:focus {
  border-color: #eee5d3;
  box-shadow: inset 0 0 0 3rpx #eee5d3;
}

.screen-final-board .product-primary {
  color: var(--night);
  background: var(--brass);
  border-color: var(--brass);
}

.screen-final-board .product-primary:focus {
  border-color: var(--night);
  box-shadow: inset 0 0 0 3rpx var(--night);
}

.screen-final-board .preview-notice {
  color: #eee5d3;
  background: rgba(66, 106, 99, 0.18);
}

.fallback-coordinate {
  color: rgba(30, 37, 33, 0.68);
}

.fallback-mark {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin-top: 34rpx;
}

.fallback-ring {
  position: absolute;
  inset: 12rpx;
  border: 2rpx solid var(--verdigris);
  border-radius: 50%;
}

.fallback-ring::before,
.fallback-ring::after,
.fallback-cross::before,
.fallback-cross::after {
  position: absolute;
  content: "";
  background: var(--verdigris);
}

.fallback-ring::before { top: -14rpx; bottom: -14rpx; left: 50%; width: 1rpx; }
.fallback-ring::after { top: 50%; right: -14rpx; left: -14rpx; height: 1rpx; }
.fallback-cross::before { top: 84rpx; left: 48rpx; width: 80rpx; height: 2rpx; transform: rotate(45deg); }
.fallback-cross::after { top: 84rpx; left: 48rpx; width: 80rpx; height: 2rpx; transform: rotate(-45deg); }

.fallback-title {
  margin-top: 28rpx;
  font-family: STSong, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.fallback-copy {
  max-width: 560rpx;
  margin-top: 18rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.75;
}

.fallback-label {
  margin-top: 28rpx;
  padding: 9rpx 14rpx;
  color: var(--cinnabar);
  border: 2rpx solid currentColor;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  transform: rotate(-2deg);
}

.frame-footer {
  padding: 6rpx 28rpx 28rpx;
}

.metadata-row {
  display: grid;
  padding: 17rpx 0;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 18rpx;
  border-top: 1rpx solid rgba(30, 37, 33, 0.16);
}

.screen-final-board .metadata-row {
  border-color: rgba(238, 229, 211, 0.15);
}

.metadata-key {
  color: rgba(30, 37, 33, 0.7);
  font-size: 20rpx;
}

.screen-final-board .metadata-key {
  color: rgba(238, 229, 211, 0.7);
}

.metadata-value {
  min-width: 0;
  color: rgba(30, 37, 33, 0.76);
  font-size: 26rpx;
  line-height: 1.6;
}

.screen-final-board .metadata-value {
  color: rgba(238, 229, 211, 0.76);
}

.result-state {
  color: var(--verdigris);
  font-family: "DIN Alternate", monospace;
  font-weight: 700;
}

.screen-final-board .result-state {
  color: #88a99f;
}

.next-screen-row {
  display: flex;
  min-height: 78rpx;
  margin-top: 8rpx;
  padding: 0 18rpx;
  align-items: center;
  gap: 15rpx;
  color: rgba(30, 37, 33, 0.72);
  background: rgba(30, 37, 33, 0.055);
  font-size: 23rpx;
}

.screen-final-board .next-screen-row {
  color: rgba(238, 229, 211, 0.7);
  background: rgba(238, 229, 211, 0.06);
}

.next-screen-id {
  color: var(--ink);
  font-family: "DIN Alternate", monospace;
  font-size: 22rpx;
  font-weight: 700;
}

.screen-final-board .next-screen-id {
  color: #eee5d3;
}

.readonly-label {
  margin-left: auto;
  color: var(--cinnabar);
  font-weight: 700;
}

.screen-final-board .readonly-label {
  color: #c89a5a;
}

.reset-preview {
  width: 100%;
  min-height: 46px;
  margin-top: 16rpx;
  color: var(--ink);
  background: transparent;
  border: 1rpx solid rgba(30, 37, 33, 0.4);
  font-size: 23rpx;
  letter-spacing: 2rpx;
}

.prototype-footnote {
  padding: 18rpx 8rpx 0;
  color: rgba(30, 37, 33, 0.7);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.network-weak .screen-frame::before,
.network-weak .prologue-wash,
.network-weak .path-vignette,
.network-weak .comparison-shade {
  display: none;
}

.network-weak .scene-asset {
  opacity: 0.46 !important;
  animation: none !important;
  transition: none !important;
}

.motion-reduced .prologue-artwork,
.motion-reduced .title-plate,
.motion-reduced .path-artwork,
.motion-reduced .path-focus-seal,
.motion-reduced .comparison-image-reconstruction,
.motion-reduced .radial-board-artwork,
.motion-reduced .radial-status {
  animation: none !important;
  transition: none !important;
}

@keyframes material-reveal {
  from { opacity: 0.24; }
  to { opacity: 1; }
}

@keyframes plate-enter {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes focus-settle {
  from { opacity: 0.66; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes reconstruction-reveal {
  from { opacity: 0.18; transform: translateX(16rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes radial-status-enter {
  from { opacity: 0; transform: translate(-50%, -34%); }
  to { opacity: 1; transform: translate(-50%, -50%); }
}

@media (min-width: 430px) {
  .preview-controls {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .device-ruler {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .product-action-row {
    grid-template-columns: minmax(0, 1fr) minmax(240rpx, 0.72fr);
    align-items: center;
  }
}

@media (orientation: landscape) and (min-width: 1024px) {
  .prototype-shell {
    display: grid;
    grid-template-columns: minmax(360px, 0.82fr) minmax(480px, 1.18fr);
    gap: 22rpx;
    align-items: start;
  }

  .workbench {
    position: sticky;
    top: 20rpx;
  }

  .preview-column {
    margin-top: 0;
  }

  .preview-controls {
    grid-template-columns: 1fr;
  }
}
