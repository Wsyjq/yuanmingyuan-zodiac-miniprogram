<view class="prototype-page tone-{{screen.tone}} motion-{{motionMode}} network-{{networkMode}} reachability-{{reachabilityMode}}">
  <view class="prototype-shell">
    <view class="workbench" aria-label="UI 原型控制台">
      <view class="workbench-heading">
        <view>
          <view class="dev-kicker">DEVELOPMENT / I1</view>
          <view class="dev-title">五章 UI 原型工作台</view>
        </view>
        <view class="isolation-badge">
          <view class="isolation-dot"></view>
          独立分包
        </view>
      </view>
      <view class="dev-note">只读 mock · 不接 Service · 不写 storage · 不执行主线后继</view>

      <scroll-view class="token-strip" scroll-x="true" enable-flex="true" show-scrollbar="false" aria-label="I1 视觉颜色 token">
        <view wx:for="{{visualTokens}}" wx:key="id" class="token-item">
          <view class="token-swatch token-{{item.id}}"></view>
          <view class="token-copy">
            <text class="token-label">{{item.label}}</text>
            <text class="token-value">{{item.value}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{queryWarning}}" class="query-warning" aria-role="alert" aria-live="assertive">{{queryWarning}}</view>

      <view class="control-section">
        <view class="control-label">关键屏幕</view>
        <scroll-view class="screen-selector" scroll-x="true" enable-flex="true" show-scrollbar="false">
          <button
            wx:for="{{screenOptions}}"
            wx:key="id"
            class="screen-option {{activeScreenId === item.id ? 'is-active' : ''}}"
            data-screen-id="{{item.id}}"
            aria-label="打开 {{item.id}} {{item.label}}"
            aria-pressed="{{activeScreenId === item.id}}"
            bindtap="onSelectScreen"
            hover-class="control-hover"
          >
            <text class="screen-option-id">{{item.id}}</text>
            <text class="screen-option-name">{{item.label}} · {{item.caption}}</text>
          </button>
        </scroll-view>
      </view>

      <view class="preview-controls">
        <view class="control-group">
          <view class="control-label">动态</view>
          <view class="segmented-control">
            <button
              wx:for="{{motionOptions}}"
              wx:key="value"
              class="mode-option motion-option {{motionMode === item.value ? 'is-active' : ''}}"
              data-preview-axis="motion"
              data-value="{{item.value}}"
              aria-pressed="{{motionMode === item.value}}"
              bindtap="onSelectMotion"
              hover-class="control-hover"
            >{{item.label}}</button>
          </view>
        </view>

        <view class="control-group">
          <view class="control-label">网络</view>
          <view class="segmented-control">
            <button
              wx:for="{{networkOptions}}"
              wx:key="value"
              class="mode-option network-option {{networkMode === item.value ? 'is-active' : ''}}"
              data-preview-axis="network"
              data-value="{{item.value}}"
              aria-pressed="{{networkMode === item.value}}"
              bindtap="onSelectNetwork"
              hover-class="control-hover"
            >{{item.label}}</button>
          </view>
        </view>

        <view class="control-group">
          <view class="control-label">现场</view>
          <view class="segmented-control">
            <button
              wx:for="{{reachabilityOptions}}"
              wx:key="value"
              class="mode-option reachability-option {{reachabilityMode === item.value ? 'is-active' : ''}}"
              data-preview-axis="reachability"
              data-value="{{item.value}}"
              aria-pressed="{{reachabilityMode === item.value}}"
              bindtap="onSelectReachability"
              hover-class="control-hover"
            >{{item.label}}</button>
          </view>
        </view>
      </view>
    </view>

    <view class="preview-column">
      <view class="device-ruler">
        <view class="device-reading">
          <text class="reading-label">VIEWPORT</text>
          <text class="reading-value">{{viewport.width}} × {{viewport.height}}</text>
        </view>
        <view class="device-reading">
          <text class="reading-label">ORIENTATION</text>
          <text class="reading-value">{{viewport.orientationLabel}}</text>
        </view>
        <view class="device-reading">
          <text class="reading-label">PIXEL RATIO</text>
          <text class="reading-value">{{viewport.pixelRatio}}</text>
        </view>
        <view class="device-reading">
          <text class="reading-label">SAFE AREA</text>
          <text class="reading-value">←{{viewport.safeLeft}} ↑{{viewport.safeTop}} →{{viewport.safeRight}} ↓{{viewport.safeBottom}}</text>
        </view>
      </view>

      <view class="screen-frame screen-{{screen.kind}}" aria-label="{{screen.id}} {{screen.title}}" aria-live="polite">
        <view class="frame-index">{{screen.sequence}}</view>
        <view class="frame-head">
          <view>
            <view class="chapter-label">{{screen.chapter}}</view>
            <view class="beat-label">{{screen.id}} / {{screen.beatId}}</view>
          </view>
          <view class="asset-stamp">{{screen.assetLabel}}</view>
        </view>

        <view class="product-chrome" aria-label="产品导航样式预览">
          <view class="route-progress">
            <view class="route-progress-copy">
              <text class="route-progress-label">{{screen.progressLabel}}</text>
              <text class="route-progress-source">{{screen.sourceLabel}}</text>
            </view>
            <view class="route-progress-track" aria-label="五地点进度">
              <view class="route-tick {{screen.locationIndex >= 1 ? 'is-reached' : ''}}"></view>
              <view class="route-tick {{screen.locationIndex >= 2 ? 'is-reached' : ''}}"></view>
              <view class="route-tick {{screen.locationIndex >= 3 ? 'is-reached' : ''}}"></view>
              <view class="route-tick {{screen.locationIndex >= 4 ? 'is-reached' : ''}}"></view>
              <view class="route-tick {{screen.locationIndex >= 5 ? 'is-reached' : ''}}"></view>
            </view>
          </view>
          <view class="product-utilities">
            <button class="product-button utility-button" data-utility="toolkit" bindtap="onPreviewUtility">工具包</button>
            <button class="product-button utility-button" data-utility="map" bindtap="onPreviewUtility">路线</button>
          </view>
        </view>

        <view wx:if="{{networkMode === 'weak'}}" class="state-banner network-banner">
          <text class="state-banner-title">弱网替代 · 原型素材</text>
          <text>关闭装饰与素材动效，降低概念图层级，保留来源标签与文字摘要。</text>
        </view>

        <view wx:if="{{assetFailureMessage && reachabilityMode === 'reachable'}}" class="state-banner asset-error" aria-role="alert" aria-live="assertive">
          <text class="state-banner-title">概念素材未载入</text>
          <text>{{assetFailureMessage}}</text>
        </view>

        <view wx:if="{{reachabilityMode === 'unreachable'}}" class="unreachable-panel">
          <view class="fallback-coordinate">ALT / FIELD VIEW</view>
          <view class="fallback-mark">
            <view class="fallback-ring"></view>
            <view class="fallback-cross"></view>
          </view>
          <view class="fallback-title">点位暂不可达</view>
          <view class="fallback-copy">切换为同一观察目标的审核资料，不记为解题失败，也不自动推进流程。</view>
          <view class="fallback-label">替代现场资料 · 原型素材</view>
        </view>

        <block wx:elif="{{prototypeReady}}">
          <view wx:if="{{screen.kind === 'prologue'}}" class="scene prologue-scene">
            <image
              class="scene-asset prologue-artwork"
              src="{{screen.assets[0].src}}"
              mode="aspectFill"
              aria-label="{{screen.assets[0].alt}}"
              data-asset-id="{{screen.assets[0].id}}"
              data-asset-generation="{{assetGeneration}}"
              bindload="onAssetLoad"
              binderror="onAssetError"
            />
            <view class="prologue-wash"></view>
            <view class="prologue-folio layout-probe" aria-hidden="true">
              <text class="folio-number">05</text>
              <text class="folio-label">SITES</text>
            </view>
            <view class="asset-provenance prologue-provenance layout-probe">
              <text class="asset-provenance-code">CONCEPT STUDY / 01</text>
              <text class="asset-provenance-copy">{{screen.assets[0].provenance}}</text>
            </view>
            <view class="title-plate layout-probe">
              <view class="scene-eyebrow">{{screen.eyebrow}}</view>
              <view class="scene-title">{{screen.title}}</view>
              <view class="scene-summary">{{screen.summary}}</view>
              <view class="route-thread" aria-label="五地点路线顺序：黄花阵、海晏堂、大水法、远瀛观、雨果雕像">
                <view class="route-stop"><view class="route-node"></view><text>黄花阵</text></view>
                <view class="route-stop"><view class="route-node"></view><text>海晏堂</text></view>
                <view class="route-stop"><view class="route-node"></view><text>大水法</text></view>
                <view class="route-stop"><view class="route-node"></view><text>远瀛观</text></view>
                <view class="route-stop"><view class="route-node"></view><text>雨果雕像</text></view>
              </view>
            </view>
          </view>

          <view wx:elif="{{screen.kind === 'path-result'}}" class="scene path-scene">
            <view class="night-caption">PATH CONNECTED / 原型终态</view>
            <view class="path-artwork-shell">
              <image
                class="scene-asset path-artwork"
                src="{{screen.assets[0].src}}"
                mode="aspectFill"
                aria-label="{{screen.assets[0].alt}}"
                data-asset-id="{{screen.assets[0].id}}"
                data-asset-generation="{{assetGeneration}}"
                bindload="onAssetLoad"
                binderror="onAssetError"
              />
              <view class="path-vignette"></view>
              <view class="path-origin-seal layout-probe"><text>入</text><text>构图起点</text></view>
              <view class="path-focus-seal layout-probe"><text class="focus-hanzi">心</text><text>结果聚焦</text></view>
              <view class="asset-provenance path-provenance layout-probe">
                <text class="asset-provenance-code">PATH STUDY / 01</text>
                <text class="asset-provenance-copy">{{screen.assets[0].provenance}}</text>
              </view>
            </view>
            <view class="result-copy">
              <view class="scene-eyebrow">{{screen.eyebrow}}</view>
              <view class="scene-title">{{screen.title}}</view>
              <view class="scene-summary">{{screen.summary}}</view>
            </view>
          </view>

          <view wx:elif="{{screen.kind === 'reconstruction-result'}}" class="scene reconstruction-scene">
            <view class="comparison-header">
              <view>
                <view class="scene-eyebrow">{{screen.eyebrow}}</view>
                <view class="scene-title">{{screen.title}}</view>
              </view>
              <view class="comparison-mode">SIDE BY SIDE</view>
            </view>
            <view class="comparison-stage">
              <image
                class="scene-asset comparison-image comparison-image-ruin"
                src="{{screen.comparePanels[0].asset.src}}"
                mode="aspectFill"
                aria-label="{{screen.comparePanels[0].asset.alt}}"
                data-asset-id="{{screen.comparePanels[0].asset.id}}"
                data-asset-generation="{{assetGeneration}}"
                bindload="onAssetLoad"
                binderror="onAssetError"
              />
              <image
                class="scene-asset comparison-image comparison-image-reconstruction"
                src="{{screen.comparePanels[1].asset.src}}"
                mode="aspectFill"
                aria-label="{{screen.comparePanels[1].asset.alt}}"
                data-asset-id="{{screen.comparePanels[1].asset.id}}"
                data-asset-generation="{{assetGeneration}}"
                bindload="onAssetLoad"
                binderror="onAssetError"
              />
              <view class="comparison-shade"></view>
              <view class="comparison-tag comparison-tag-ruin layout-probe">
                <text class="comparison-tag-kicker">FACT LAYER / 占位</text>
                <text class="comparison-tag-title">{{screen.comparePanels[0].label}}</text>
                <text class="comparison-tag-note">{{screen.comparePanels[0].note}}</text>
              </view>
              <view class="comparison-tag comparison-tag-reconstruction layout-probe">
                <text class="comparison-tag-kicker">INTERPRETATION / 占位</text>
                <text class="comparison-tag-title">{{screen.comparePanels[1].label}}</text>
                <text class="comparison-tag-note">{{screen.comparePanels[1].note}}</text>
              </view>
              <view class="comparison-divider"><view class="divider-label">界</view></view>
              <view class="comparison-provenance layout-probe">双图均为内部概念绘制 · 不是现场与史实复原</view>
            </view>
            <view class="scene-summary comparison-summary">{{screen.summary}}</view>
          </view>

          <view wx:else class="scene final-scene">
            <view class="final-heading">
              <view class="scene-eyebrow">{{screen.eyebrow}}</view>
              <view class="scene-title">{{screen.title}}</view>
              <view class="status-fixture">状态集未审核 · 仅测试版式</view>
            </view>
            <view class="zodiac-orbit">
              <image
                class="scene-asset radial-board-artwork"
                src="{{screen.assets[0].src}}"
                mode="aspectFit"
                aria-label="{{screen.assets[0].alt}}"
                data-asset-id="{{screen.assets[0].id}}"
                data-asset-generation="{{assetGeneration}}"
                bindload="onAssetLoad"
                binderror="onAssetError"
              />
              <view
                wx:for="{{screen.boardSlots}}"
                wx:key="index"
                class="radial-status radial-status-{{item.index}} status-{{item.status}} layout-probe"
              >
                <view class="slot-mark"></view>
                <view class="slot-copy"><text class="slot-index">{{item.index}}</text><text class="slot-label">{{item.label}}</text></view>
              </view>
              <view class="orbit-center layout-probe">
                <text class="orbit-count">12</text>
                <text class="orbit-center-label">状态刻位</text>
                <text class="orbit-center-note">非获批事实集</text>
              </view>
              <view class="asset-provenance orbit-provenance layout-probe">
                <text class="asset-provenance-code">DIAL STUDY / 01</text>
                <text class="asset-provenance-copy">{{screen.assets[0].provenance}}</text>
              </view>
            </view>
            <view class="scene-summary final-summary">{{screen.summary}}</view>
          </view>
        </block>

        <view class="product-action-row">
          <view class="product-action-copy">
            <text class="product-action-kicker">PRIMARY ACTION / 原型预览</text>
            <text class="product-action-note">当前按钮只验证层级和触控，不推进 beat。</text>
          </view>
          <button class="product-button product-primary" bindtap="onProductAction">{{screen.primaryActionLabel}}</button>
        </view>
        <view wx:if="{{previewNotice}}" class="preview-notice" aria-role="status" aria-live="polite">{{previewNotice}}</view>

        <view class="frame-footer">
          <view class="metadata-row">
            <text class="metadata-key">KNOWLEDGE</text>
            <text class="metadata-value">{{screen.knowledgeGoal}}</text>
          </view>
          <view wx:if="{{screen.resultState}}" class="metadata-row">
            <text class="metadata-key">RESULT</text>
            <text class="metadata-value result-state">{{screen.resultState}}</text>
          </view>
          <view class="metadata-row">
            <text class="metadata-key">MATERIAL</text>
            <text class="metadata-value">{{screen.materialNote}}</text>
          </view>
          <view class="next-screen-row">
            <text>下一屏登记</text>
            <text class="next-screen-id">{{screen.nextScreen}}</text>
            <text class="readonly-label">只读 · 不执行</text>
          </view>
        </view>
      </view>

      <button class="reset-preview" bindtap="onResetPreview" hover-class="control-hover">复位原型状态</button>
      <view class="prototype-footnote">开发入口不会保存选择。刷新、离开或复位均不会创建、推进或结束任何 legacy session。</view>
    </view>
  </view>
</view>
