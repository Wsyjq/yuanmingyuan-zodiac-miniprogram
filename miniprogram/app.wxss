page {
  min-height: 100%;
  background: #f7f0e5;
  color: #2c3d45;
  font-family: "Noto Serif SC", "Songti SC", "Microsoft YaHei", serif;
}

page,
view,
scroll-view,
swiper,
swiper-item,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

text,
button,
input {
  min-width: 0;
}

button,
input {
  font-family: inherit;
  font-size: inherit;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  overflow: hidden;
  text-align: center;
  white-space: normal;
}

button::after {
  border: 0;
}

.page {
  width: 100%;
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  background: linear-gradient(180deg, #f8f2e8 0%, #efe2d2 100%);
  overflow-x: hidden;
}

.card {
  max-width: 100%;
  border: 1rpx solid rgba(44, 61, 69, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 18rpx 54rpx rgba(44, 61, 69, 0.12);
}

.btn-primary,
.btn-secondary,
.btn-danger {
  min-height: 88rpx;
  border-radius: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-primary {
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
}

.btn-secondary {
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(101, 135, 128, 0.28);
}

.btn-danger {
  color: #fff8ed;
  background: linear-gradient(135deg, #b36a5f, #a68d73);
}

.muted {
  color: rgba(44, 61, 69, 0.62);
}

.section-title {
  margin: 28rpx 0 14rpx;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
