view,
text,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.maze-path-game {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.maze-status,
.timeline-status {
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.timeline-status {
  color: #2c3d45;
  background: linear-gradient(135deg, rgba(216, 170, 82, 0.18), rgba(101, 135, 128, 0.1));
  font-weight: 900;
}

.maze-route-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: rgba(44, 61, 69, 0.52);
  font-size: 18rpx;
}

.maze-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.maze-module {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 31.6%;
  min-width: 0;
  height: 190rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 6rpx;
  border-radius: 22rpx;
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.68);
}

.maze-module:nth-child(n + 4) {
  margin-bottom: 0;
}

.maze-module.connected {
  border: 2rpx solid rgba(101, 135, 128, 0.46);
  background: rgba(101, 135, 128, 0.14);
}

.maze-road {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 8rpx;
  transition: transform 0.2s ease;
}

.road-arm {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(179, 106, 95, 0.72);
}

.road-horizontal {
  left: 0;
  right: 0;
  top: 32rpx;
  height: 12rpx;
}

.road-east {
  left: 32rpx;
  right: 0;
  top: 32rpx;
  height: 12rpx;
}

.road-south {
  left: 32rpx;
  top: 32rpx;
  bottom: 0;
  width: 12rpx;
}

.road-node {
  position: absolute;
  left: 28rpx;
  top: 28rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #b36a5f;
}

.maze-module.connected .road-arm,
.maze-module.connected .road-node {
  background: #d8aa52;
  box-shadow: 0 0 16rpx rgba(216, 170, 82, 0.62);
}

.module-label {
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.2;
}

.module-state {
  margin-top: 8rpx;
  color: rgba(44, 61, 69, 0.58);
  font-size: 18rpx;
  font-weight: 800;
}

.maze-hint {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.72);
  line-height: 1.6;
}

.timeline-heading {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.54);
}

.timeline-kicker {
  color: #b36a5f;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.timeline-copy {
  margin-top: 6rpx;
  color: rgba(44, 61, 69, 0.66);
  font-size: 21rpx;
  line-height: 1.5;
}

.timeline-slots {
  position: relative;
  padding-left: 30rpx;
}

.timeline-slots::before {
  position: absolute;
  left: 14rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #d8aa52, #658780);
  content: '';
}

.timeline-slot {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 82rpx;
  margin-bottom: 10rpx;
  padding: 12rpx 14rpx;
  border: 1rpx dashed rgba(44, 61, 69, 0.24);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.5);
}

.timeline-slot:last-child {
  margin-bottom: 0;
}

.timeline-slot.filled {
  border-style: solid;
  border-color: rgba(101, 135, 128, 0.42);
  background: rgba(101, 135, 128, 0.11);
}

.timeline-order {
  position: absolute;
  left: -30rpx;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  transform: translateY(-50%);
  border-radius: 50%;
  color: #fff8ed;
  background: #658780;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 28rpx;
  text-align: center;
}

.timeline-slot-copy {
  min-width: 0;
}

.timeline-year {
  color: #b36a5f;
  font-size: 20rpx;
  font-weight: 900;
}

.timeline-label {
  margin-top: 4rpx;
  color: #2c3d45;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.timeline-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 18rpx;
}

.timeline-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 48.5%;
  min-width: 0;
  min-height: 104rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  color: #2c3d45;
  background: rgba(255, 248, 237, 0.82);
  line-height: 1.25;
  text-align: left;
}

.timeline-card:last-child {
  margin-bottom: 0;
}

.timeline-card.used {
  opacity: 0.34;
}

.card-year {
  color: #b36a5f;
  font-size: 21rpx;
  font-weight: 900;
}

.card-label {
  margin-top: 5rpx;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.35;
}

.timeline-actions {
  display: flex;
  width: 100%;
  margin-top: 18rpx;
}

.timeline-actions button {
  flex: 1 1 0;
  width: 100%;
  min-width: 0;
  margin: 0;
}

.timeline-actions button + button {
  margin-left: 12rpx;
}

.btn-primary,
.btn-secondary {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  margin-top: 18rpx;
  border-radius: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.timeline-actions .btn-primary,
.timeline-actions .btn-secondary {
  margin-top: 0;
}

.btn-primary {
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
}

.btn-secondary {
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(101, 135, 128, 0.28);
}
