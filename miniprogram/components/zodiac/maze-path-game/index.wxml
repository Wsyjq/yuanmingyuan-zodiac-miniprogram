<view class="maze-path-game">
  <block wx:if="{{game.phase === 'maze'}}">
    <view class="maze-status">入口已贯通 {{game.connectedCount}}/{{game.target.length}} 段 · 尝试 {{game.attempts}}</view>
    <view class="maze-route-labels">
      <view>西侧入口</view>
      <view>沿亮起道路前进</view>
      <view>中心亭</view>
    </view>
    <view class="maze-grid">
      <view wx:for="{{game.modules}}" wx:key="index" class="maze-module {{item.connected ? 'connected' : ''}}" style="order: {{item.gridOrder}};" data-index="{{index}}" bindtap="onRotate">
        <view class="maze-road {{item.shape}}" style="transform: rotate({{item.rotation}}deg);">
          <view wx:if="{{item.shape === 'straight'}}" class="road-arm road-horizontal"></view>
          <block wx:else>
            <view class="road-arm road-east"></view>
            <view class="road-arm road-south"></view>
          </block>
          <view class="road-node"></view>
        </view>
        <view class="module-label">{{item.label}}</view>
        <view class="module-state">{{item.connected ? '水路已亮' : item.rotationText}}</view>
      </view>
    </view>
    <view class="maze-hint">{{game.message}}</view>
    <button class="btn-primary" bindtap="onCheck">检查路径</button>
  </block>

  <block wx:else>
    <view class="timeline-status">中心亭已到达 · 已排序 {{game.timelinePicked.length}}/{{game.timelineAnswer.length}}</view>
    <view class="timeline-heading">
      <view class="timeline-kicker">第二步 · 回归时间线</view>
      <view class="timeline-copy">从最早回归到仍在追索，依次放入五条记录。</view>
    </view>
    <view class="timeline-slots">
      <view wx:for="{{game.timelineSlots}}" wx:key="index" class="timeline-slot {{item.eventId ? 'filled' : ''}}" data-index="{{index}}" bindtap="onRemoveTimeline">
        <view class="timeline-order">{{index + 1}}</view>
        <view class="timeline-slot-copy">
          <view class="timeline-year">{{item.year || '年份待定'}}</view>
          <view class="timeline-label">{{item.label}}</view>
        </view>
      </view>
    </view>
    <view class="timeline-cards">
      <button wx:for="{{game.timelineEvents}}" wx:key="id" class="timeline-card {{item.used ? 'used' : ''}}" data-index="{{index}}" disabled="{{item.used}}" bindtap="onPickTimeline">
        <view class="card-year">{{item.year}}</view>
        <view class="card-label">{{item.label}}</view>
      </button>
    </view>
    <view class="maze-hint">{{game.message}}</view>
    <view class="timeline-actions">
      <button class="btn-secondary" bindtap="onClearTimeline">清空时间线</button>
      <button class="btn-primary" bindtap="onCheckTimeline">确认顺序</button>
    </view>
  </block>
</view>
