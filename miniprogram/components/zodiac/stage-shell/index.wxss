.stage-shell {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.mark-card,
.scene-card {
  width: 100%;
  max-width: 100%;
  padding: 28rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(44, 61, 69, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 18rpx 54rpx rgba(44, 61, 69, 0.12);
}

.scene-place {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #fff8ed;
  background: #658780;
  font-size: 22rpx;
}

.scene-intro {
  margin-top: 18rpx;
  color: rgba(44, 61, 69, 0.72);
  font-size: 27rpx;
  line-height: 1.8;
  word-break: break-all;
}

.task-box {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #a68d73;
  border-radius: 0 20rpx 20rpx 0;
  background: rgba(101, 135, 128, 0.1);
  color: #2c3d45;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-all;
}
