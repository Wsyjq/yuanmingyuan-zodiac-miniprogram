view,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.password-clue-game {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.password-status,
.password-message {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  color: rgba(44, 61, 69, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.password-status {
  background: rgba(101, 135, 128, 0.1);
}

.password-message {
  margin-top: 16rpx;
  background: rgba(216, 170, 82, 0.13);
}

.evidence-tabs {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.evidence-tab {
  width: 31.6%;
  min-width: 0;
  min-height: 112rpx;
  padding: 12rpx 8rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(44, 61, 69, 0.12);
  background: rgba(255, 255, 255, 0.58);
}

.evidence-tab.active {
  border-color: rgba(179, 106, 95, 0.54);
  box-shadow: 0 8rpx 18rpx rgba(179, 106, 95, 0.12);
}

.evidence-tab.solved {
  background: rgba(101, 135, 128, 0.15);
}

.tab-index {
  color: #b36a5f;
  font-size: 18rpx;
  font-weight: 900;
}

.tab-title {
  margin-top: 4rpx;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.25;
}

.tab-state {
  margin-top: 6rpx;
  color: rgba(44, 61, 69, 0.5);
  font-size: 17rpx;
}

.evidence-workspace {
  min-height: 410rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(166, 141, 115, 0.1)),
    #f7f0e5;
  border: 1rpx solid rgba(44, 61, 69, 0.12);
}

.evidence-title {
  color: #2c3d45;
  font-size: 28rpx;
  font-weight: 900;
}

.evidence-instruction {
  margin-top: 8rpx;
  color: rgba(44, 61, 69, 0.66);
  font-size: 22rpx;
  line-height: 1.5;
}

.evidence-board {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 18rpx;
}

.evidence-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 23.3%;
  height: 74rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(44, 61, 69, 0.13);
  background: rgba(255, 255, 255, 0.66);
  color: #2c3d45;
}

.evidence-mark:nth-child(n + 5) {
  margin-bottom: 0;
}

.evidence-mark.selected {
  border-color: #b36a5f;
  background: rgba(179, 106, 95, 0.16);
  box-shadow: 0 8rpx 16rpx rgba(179, 106, 95, 0.16);
}

.mark-glyph {
  font-size: 25rpx;
  font-weight: 900;
}

.evidence-mark.vine {
  border-radius: 50% 18rpx 50% 18rpx;
}

.evidence-mark.branch {
  border-radius: 8rpx 30rpx 8rpx 30rpx;
  transform: rotate(-5deg);
}

.evidence-mark.leaf {
  border-radius: 60% 10% 60% 10%;
}

.evidence-mark.swirl {
  border-style: dashed;
  border-radius: 50%;
}

.evidence-board.holes .evidence-mark.hole {
  border-radius: 50%;
  background: radial-gradient(circle, #2c3d45 0 24%, #a68d73 26% 48%, rgba(255, 255, 255, 0.68) 50%);
}

.evidence-board.holes .evidence-mark.hole.selected {
  box-shadow: 0 0 0 5rpx rgba(216, 170, 82, 0.24), 0 0 22rpx rgba(216, 170, 82, 0.48);
}

.evidence-board.holes .evidence-mark.crack {
  border-style: dashed;
  color: rgba(44, 61, 69, 0.48);
  background: linear-gradient(135deg, transparent 44%, rgba(44, 61, 69, 0.24) 46% 50%, transparent 52%);
}

.overlay-puzzle {
  margin-top: 16rpx;
  text-align: center;
}

.overlay-howto {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  color: rgba(44, 61, 69, 0.62);
  font-size: 17rpx;
}

.layer-key {
  display: flex;
  align-items: center;
}

.key-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 6rpx;
  border-radius: 50%;
}

.key-dot.fixed {
  background: #d8aa52;
  box-shadow: 0 0 8rpx rgba(216, 170, 82, 0.6);
}

.key-dot.movable {
  background: #b36a5f;
  box-shadow: 0 0 8rpx rgba(179, 106, 95, 0.5);
}

.overlay-stage {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 22rpx;
  background: #d8c5aa;
  border: 2rpx solid rgba(44, 61, 69, 0.2);
}

.base-label,
.paper-label {
  position: absolute;
  z-index: 2;
  padding: 5rpx 8rpx;
  border-radius: 999rpx;
  font-size: 14rpx;
  font-weight: 900;
  line-height: 1;
}

.base-label {
  left: 9rpx;
  top: 9rpx;
  color: #2c3d45;
  background: rgba(216, 170, 82, 0.78);
}

.paper-label {
  left: 50%;
  top: 8rpx;
  color: #fff8ed;
  background: rgba(179, 106, 95, 0.86);
  transform: translateX(-50%);
}

.stone-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
}

.stone-cell {
  width: 33.333%;
  height: 33.333%;
  border: 1rpx solid rgba(44, 61, 69, 0.18);
}

.tracing-sheet {
  position: absolute;
  left: 40rpx;
  top: 40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: rgba(255, 248, 237, 0.42);
  border: 2rpx dashed rgba(179, 106, 95, 0.62);
  transform-origin: center;
  transition: transform 220ms ease;
}

.trace-line {
  position: absolute;
  height: 8rpx;
  border-radius: 999rpx;
  background: #b36a5f;
}

.trace-a {
  left: 30rpx;
  top: 46rpx;
  width: 136rpx;
  transform: rotate(28deg);
}

.trace-b {
  left: 22rpx;
  top: 102rpx;
  width: 102rpx;
  transform: rotate(-34deg);
}

.trace-c {
  right: 22rpx;
  bottom: 36rpx;
  width: 118rpx;
  transform: rotate(52deg);
}

.base-anchor,
.trace-anchor {
  position: absolute;
  z-index: 3;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.base-anchor {
  background: #d8aa52;
  box-shadow: 0 0 12rpx rgba(216, 170, 82, 0.8);
}

.base-anchor-a {
  left: 208rpx;
  top: 58rpx;
}

.base-anchor-b {
  left: 183rpx;
  top: 208rpx;
}

.base-anchor-c {
  left: 58rpx;
  top: 133rpx;
}

.trace-anchor {
  background: #b36a5f;
  box-shadow: 0 0 10rpx rgba(179, 106, 95, 0.74);
}

.trace-anchor-a {
  left: 18rpx;
  top: 18rpx;
}

.trace-anchor-b {
  left: 168rpx;
  top: 43rpx;
}

.trace-anchor-c {
  left: 93rpx;
  top: 168rpx;
}

.overlay-digit {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ed;
  background: rgba(44, 61, 69, 0.64);
  font-size: 92rpx;
  font-weight: 900;
}

.alignment-meter {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

.alignment-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(44, 61, 69, 0.16);
}

.alignment-dot + .alignment-dot {
  margin-left: 7rpx;
}

.alignment-dot.active {
  background: #d8aa52;
  box-shadow: 0 0 10rpx rgba(216, 170, 82, 0.66);
}

.alignment-text {
  margin-left: 12rpx;
  color: rgba(44, 61, 69, 0.68);
  font-size: 18rpx;
  font-weight: 800;
}

.rotate-button {
  width: 280rpx;
  min-height: 62rpx;
  margin: 12rpx auto 0;
  border-radius: 18rpx;
  color: #fff8ed;
  background: #658780;
  font-size: 21rpx;
  line-height: 62rpx;
  font-weight: 800;
}

.rotation-readout {
  margin-top: 8rpx;
  color: rgba(44, 61, 69, 0.52);
  font-size: 18rpx;
}

.evidence-result {
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(44, 61, 69, 0.07);
  color: rgba(44, 61, 69, 0.58);
  font-size: 20rpx;
  line-height: 1.45;
}

.evidence-result.solved {
  color: #2c3d45;
  background: rgba(101, 135, 128, 0.16);
  font-weight: 800;
}

.password-dial {
  display: flex;
  justify-content: center;
  margin: 18rpx 0;
}

.password-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(44, 61, 69, 0.22);
  color: rgba(44, 61, 69, 0.38);
  background: rgba(255, 255, 255, 0.62);
  font-size: 38rpx;
  font-weight: 900;
}

.password-slot + .password-slot {
  margin-left: 14rpx;
}

.password-slot.decoded {
  border-style: solid;
  border-color: rgba(179, 106, 95, 0.46);
  color: #fff8ed;
  background: #b36a5f;
}

.btn-primary {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  border-radius: 28rpx;
  line-height: 88rpx;
  color: rgba(255, 248, 237, 0.72);
  background: rgba(44, 61, 69, 0.48);
  font-weight: 700;
}

.btn-primary.ready {
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
}
