<view class="password-clue-game">
  <view class="password-status">证据解码 {{game.foundCount}}/3 · 开盒尝试 {{game.attempts}}</view>

  <view class="evidence-tabs">
    <view
      wx:for="{{game.clues}}"
      wx:key="id"
      class="evidence-tab {{game.activeClue === item.id ? 'active' : ''}} {{item.found ? 'solved' : ''}}"
      data-clue="{{item.id}}"
      bindtap="onSelectEvidence"
    >
      <view class="tab-index">0{{index + 1}}</view>
      <view class="tab-title">{{item.title}}</view>
      <view class="tab-state">{{item.found ? '已解码' : '待调查'}}</view>
    </view>
  </view>

  <view class="evidence-workspace">
    <block wx:for="{{game.clues}}" wx:key="id">
      <view wx:if="{{game.activeClue === item.id}}" class="evidence-panel">
        <view class="evidence-title">{{item.title}}</view>
        <view class="evidence-instruction">{{item.instruction}}</view>

        <view wx:if="{{item.type === 'select'}}" class="evidence-board {{item.id}}">
          <view
            wx:for="{{item.options}}"
            wx:for-item="option"
            wx:key="index"
            class="evidence-mark {{option.kind}} {{option.selected ? 'selected' : ''}}"
            data-clue="{{item.id}}"
            data-index="{{index}}"
            bindtap="onToggleEvidence"
          >
            <view class="mark-glyph">{{option.label}}</view>
          </view>
        </view>

        <view wx:elif="{{item.type === 'rotate'}}" class="overlay-puzzle">
          <view class="overlay-howto">
            <view class="layer-key"><view class="key-dot fixed"></view>石刻底图固定不动</view>
            <view class="layer-key"><view class="key-dot movable"></view>硫酸纸可顺时针旋转</view>
          </view>
          <view class="overlay-stage" bindtap="onRotateOverlay">
            <view class="base-label">石刻底图 · 固定</view>
            <view class="stone-grid">
              <view wx:for="{{gridCells}}" wx:key="*this" class="stone-cell"></view>
            </view>
            <view class="base-anchor base-anchor-a"></view>
            <view class="base-anchor base-anchor-b"></view>
            <view class="base-anchor base-anchor-c"></view>
            <view class="tracing-sheet" style="transform: rotate({{item.rotation}}deg);">
              <view class="paper-label">硫酸纸</view>
              <view class="trace-line trace-a"></view>
              <view class="trace-line trace-b"></view>
              <view class="trace-line trace-c"></view>
              <view class="trace-anchor trace-anchor-a"></view>
              <view class="trace-anchor trace-anchor-b"></view>
              <view class="trace-anchor trace-anchor-c"></view>
            </view>
            <view wx:if="{{item.found}}" class="overlay-digit">8</view>
          </view>
          <view class="alignment-meter">
            <view wx:for="{{anchorDots}}" wx:for-item="dot" wx:key="*this" class="alignment-dot {{item.alignmentCount >= dot ? 'active' : ''}}"></view>
            <view class="alignment-text">定位点重合 {{item.alignmentCount}}/3</view>
          </view>
          <view class="rotate-button" bindtap="onRotateOverlay">顺时针旋转 90°</view>
          <view class="rotation-readout">也可以直接点击透明纸 · 当前角度 {{item.rotation}}°</view>
        </view>

        <view class="evidence-result {{item.found ? 'solved' : ''}}">
          <block wx:if="{{item.found}}">{{item.clue}} 解得数字 {{item.digit}}</block>
          <block wx:else>完成观察后，这里会记录解码结果。</block>
        </view>
      </view>
    </block>
  </view>

  <view class="password-message">{{game.message}}</view>
  <view class="password-dial">
    <view wx:for="{{game.clues}}" wx:key="id" class="password-slot {{item.found ? 'decoded' : ''}}">{{item.found ? item.digit : '?'}}</view>
  </view>
  <view class="btn-primary {{game.foundCount === 3 ? 'ready' : ''}}" bindtap="onCheck">开启线索盒</view>
</view>
