<view class="clock-match-game">
  <view class="clock-wheel">十二时辰轮盘 · 已匹配 {{game.lockedCount}}/{{game.heads.length}}</view>
  <view class="clock-message">{{game.message}}</view>
  <view class="pair-columns">
    <view class="pair-col">
      <view class="col-title">兽首</view>
      <view wx:for="{{game.heads}}" wx:key="index" class="choice {{game.selectedHeadIndex === index ? 'selected' : ''}} {{item.locked ? 'locked' : ''}}" data-index="{{index}}" bindtap="onSelectHead">
        <view class="choice-main">{{item.label}}首</view>
        <view class="choice-sub">{{item.locked ? '已锁定' : item.clue}}</view>
      </view>
    </view>
    <view class="pair-col">
      <view class="col-title">时辰</view>
      <view wx:for="{{game.branches}}" wx:key="index" class="choice {{item.locked ? 'locked' : ''}}" data-index="{{index}}" bindtap="onSelectBranch">
        <view class="choice-main">{{item.label}}时</view>
        <view class="choice-sub">{{item.locked ? '已匹配' : item.time}}</view>
      </view>
    </view>
  </view>
</view>
