view,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.clock-match-game {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.clock-wheel {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.72);
  line-height: 1.6;
}

.clock-message {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(216, 170, 82, 0.13);
  color: rgba(44, 61, 69, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.pair-columns {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-top: 18rpx;
}

.pair-col {
  flex: 0 0 48.5%;
  width: 48.5%;
  min-width: 0;
  padding: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.42);
}

.col-title {
  margin-bottom: 10rpx;
  color: rgba(44, 61, 69, 0.6);
  font-size: 22rpx;
}

.choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  margin-top: 10rpx;
  min-height: 76rpx;
  padding: 10rpx 6rpx;
  border-radius: 18rpx;
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.74);
  line-height: 1.2;
}

.choice-main {
  font-size: 29rpx;
  font-weight: 900;
}

.choice-sub {
  margin-top: 6rpx;
  color: rgba(44, 61, 69, 0.54);
  font-size: 18rpx;
  font-weight: 700;
}

.choice.selected {
  border: 3rpx solid #b36a5f;
  background: rgba(179, 106, 95, 0.12);
}

.choice.locked {
  opacity: 0.45;
}
