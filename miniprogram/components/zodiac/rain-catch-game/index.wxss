view,
text,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.rain-catch-game {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
  gap: 18rpx;
  overflow: hidden;
}

.rain-panel {
  padding: 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(101, 135, 128, 0.14), rgba(255, 248, 237, 0.72));
}

.rain-status,
.rain-hint {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.72);
  line-height: 1.6;
}

.rain-panel .rain-status {
  padding: 0;
  background: transparent;
  font-weight: 800;
  color: #2c3d45;
}

.rain-meter {
  height: 14rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(44, 61, 69, 0.12);
}

.rain-meter-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #d8aa52, #b36a5f);
  transition: width 220ms ease;
}

.rain-readout {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 14rpx;
  color: rgba(44, 61, 69, 0.68);
  font-size: 22rpx;
  line-height: 1.4;
}

.rain-track {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 420rpx;
  padding: 72rpx 12rpx 96rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 6%, rgba(216, 170, 82, 0.24), transparent 24%),
    linear-gradient(180deg, rgba(101, 135, 128, 0.2), rgba(44, 61, 69, 0.08));
  border: 1rpx solid rgba(101, 135, 128, 0.24);
}

.rain-track.dragging {
  border-color: rgba(179, 106, 95, 0.42);
  box-shadow: 0 18rpx 36rpx rgba(44, 61, 69, 0.12) inset;
}

.rain-skyline {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 22rpx;
  z-index: 2;
  color: rgba(44, 61, 69, 0.76);
  font-size: 24rpx;
  font-weight: 800;
}

.cloud {
  position: absolute;
  top: 74rpx;
  width: 92rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: 22rpx -14rpx 0 rgba(255, 255, 255, 0.32), 46rpx 2rpx 0 rgba(255, 255, 255, 0.4);
}

.cloud-left {
  left: 28rpx;
}

.cloud-center {
  left: 44%;
  transform: scale(0.78);
  opacity: 0.7;
}

.cloud-right {
  right: 56rpx;
  transform: scale(0.62);
  opacity: 0.52;
}

.track-lane {
  position: relative;
  flex: 1 1 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-width: 0;
  color: rgba(44, 61, 69, 0.42);
  font-size: 22rpx;
  font-weight: 800;
}

.track-lane.active {
  color: #b36a5f;
}

.lane-guide {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  transform: translateX(-50%);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(101, 135, 128, 0.28));
}

.falling-drop {
  position: absolute;
  z-index: 3;
  width: 54rpx;
  min-width: 0;
  height: 66rpx;
  margin-left: -27rpx;
  border-radius: 50% 50% 54% 54%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ed;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(44, 61, 69, 0.2);
  transition: top 40ms linear, left 180ms ease, opacity 160ms ease;
}

.falling-drop.good {
  background: linear-gradient(180deg, #f2d991, #d8aa52);
}

.falling-drop.bad {
  background: linear-gradient(180deg, #7d8080, #2c3d45);
}

.tray {
  position: absolute;
  bottom: 32rpx;
  z-index: 4;
  width: 132rpx;
  min-width: 0;
  margin-left: -66rpx;
  text-align: center;
  color: #2c3d45;
  font-size: 22rpx;
  font-weight: 900;
  transition: left 160ms ease;
}

.tray-bowl {
  width: 132rpx;
  height: 42rpx;
  border-radius: 8rpx 8rpx 54rpx 54rpx;
  background: linear-gradient(180deg, #fff8ed, #d8aa52);
  border: 3rpx solid rgba(179, 106, 95, 0.45);
  box-shadow: 0 10rpx 20rpx rgba(44, 61, 69, 0.16);
}

.tray-label {
  margin-top: 8rpx;
}

.rain-hint {
  margin-top: 0;
}

.rain-result {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(216, 170, 82, 0.13);
  color: rgba(44, 61, 69, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.btn-primary {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  margin-top: 0;
  border-radius: 28rpx;
  line-height: 88rpx;
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
  font-weight: 700;
}

.btn-primary.pause {
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(101, 135, 128, 0.32);
}
