view,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.sandtable-order-game {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.order-line {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.72);
  line-height: 1.6;
}

.order-line.current,
.order-message {
  margin-top: 16rpx;
}

.order-message {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(216, 170, 82, 0.13);
  color: rgba(44, 61, 69, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.order-slots {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.order-slot {
  display: flex;
  align-items: center;
  width: 31.6%;
  min-height: 70rpx;
  margin-bottom: 12rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.54);
  border: 1rpx dashed rgba(44, 61, 69, 0.22);
}

.order-slot:nth-child(n + 10) {
  margin-bottom: 0;
}

.order-slot.filled {
  border-style: solid;
  border-color: rgba(179, 106, 95, 0.4);
  background: rgba(179, 106, 95, 0.1);
}

.slot-index {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(44, 61, 69, 0.12);
  color: rgba(44, 61, 69, 0.62);
  font-size: 18rpx;
  line-height: 34rpx;
  text-align: center;
}

.slot-value {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.piece-row,
.button-row {
  display: flex;
  width: 100%;
  margin-top: 18rpx;
}

.piece-row {
  flex-wrap: wrap;
  justify-content: space-between;
}

.piece,
.button-row button {
  width: 100%;
  min-width: 0;
}

.piece {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 31.6%;
  height: 86rpx;
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  color: #2c3d45;
  background: rgba(255, 248, 237, 0.82);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.piece:nth-child(n + 10) {
  margin-bottom: 0;
}

.button-row button + button {
  margin-left: 12rpx;
}

.piece.used {
  opacity: 0.38;
}

.btn-primary,
.btn-secondary {
  display: block;
  flex: 1 1 0;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  border-radius: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.btn-primary {
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
}

.btn-secondary {
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(101, 135, 128, 0.28);
}
