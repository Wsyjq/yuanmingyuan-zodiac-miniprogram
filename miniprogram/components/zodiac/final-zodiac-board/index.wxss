view,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.final-zodiac-board {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
  gap: 18rpx;
  overflow: hidden;
}

.final-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 82% 24%, rgba(216, 170, 82, 0.3), transparent 32%),
    linear-gradient(135deg, rgba(44, 61, 69, 0.92), rgba(101, 135, 128, 0.82));
  color: #fff8ed;
}

.final-hero > view {
  min-width: 0;
}

.final-hero.confirmed {
  background:
    radial-gradient(circle at 82% 24%, rgba(255, 248, 237, 0.24), transparent 32%),
    linear-gradient(135deg, #b36a5f, #658780);
}

.final-kicker {
  color: rgba(255, 248, 237, 0.66);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.final-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.final-text {
  margin-top: 10rpx;
  color: rgba(255, 248, 237, 0.82);
  line-height: 1.6;
}

.horse-button {
  flex: 0 0 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  min-width: 0;
  min-height: 76rpx;
  border-radius: 999rpx;
  color: #2c3d45;
  background: #fff8ed;
  font-weight: 900;
  line-height: 76rpx;
}

.final-progress {
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.78);
  font-weight: 800;
}

.final-meter {
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(44, 61, 69, 0.12);
}

.final-meter-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #d8aa52, #b36a5f);
  transition: width 220ms ease;
}

.section-title {
  color: #2c3d45;
  font-size: 26rpx;
  font-weight: 900;
}

.mark-tray {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.mark-token {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 23.4%;
  min-width: 0;
  height: 112rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 6rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(101, 135, 128, 0.18);
  color: #2c3d45;
  line-height: 1.2;
}

.mark-token:nth-child(n + 5) {
  margin-bottom: 0;
}

.mark-token.tracking {
  background: rgba(216, 170, 82, 0.18);
}

.mark-token.selected {
  border-color: #b36a5f;
  box-shadow: 0 10rpx 24rpx rgba(179, 106, 95, 0.2);
}

.mark-token.placed {
  opacity: 0.45;
}

.mark-zodiac {
  font-size: 34rpx;
  font-weight: 900;
}

.mark-label {
  margin-top: 8rpx;
  color: rgba(44, 61, 69, 0.62);
  font-size: 20rpx;
  font-weight: 800;
}

.selected-tip {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(216, 170, 82, 0.14);
  color: rgba(44, 61, 69, 0.72);
  line-height: 1.5;
}

.final-message {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(216, 170, 82, 0.14);
  color: rgba(44, 61, 69, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.final-rule {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(101, 135, 128, 0.1);
  color: rgba(44, 61, 69, 0.66);
  font-size: 22rpx;
  line-height: 1.5;
}

.missing-tip {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(179, 106, 95, 0.12);
  color: #b36a5f;
  font-weight: 800;
  line-height: 1.5;
}

.zodiac-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.zodiac-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 31.6%;
  min-width: 0;
  height: 146rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 6rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 2rpx solid rgba(101, 135, 128, 0.16);
  color: #2c3d45;
  line-height: 1.2;
}

.zodiac-slot:nth-child(n + 10) {
  margin-bottom: 0;
}

.zodiac-slot.target {
  border-color: #d8aa52;
  background: rgba(216, 170, 82, 0.16);
}

.zodiac-slot.filled {
  border-color: rgba(179, 106, 95, 0.4);
  background: linear-gradient(180deg, rgba(255, 248, 237, 0.96), rgba(216, 170, 82, 0.18));
}

.zodiac-slot.tracking.filled {
  border-color: rgba(101, 135, 128, 0.5);
  background: linear-gradient(180deg, rgba(255, 248, 237, 0.96), rgba(101, 135, 128, 0.18));
}

.zodiac-slot.missing {
  background: rgba(44, 61, 69, 0.08);
  color: rgba(44, 61, 69, 0.54);
}

.slot-zodiac {
  font-size: 30rpx;
  font-weight: 900;
}

.slot-time {
  margin-top: 4rpx;
  color: rgba(44, 61, 69, 0.5);
  font-size: 17rpx;
  font-weight: 800;
}

.slot-mark {
  margin-top: 8rpx;
  color: #b36a5f;
  font-size: 20rpx;
  font-weight: 900;
}

.slot-mark.empty {
  color: rgba(44, 61, 69, 0.46);
}

.btn-primary,
.btn-secondary {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  border-radius: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.btn-primary {
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
}

.btn-primary.ready {
  background: linear-gradient(135deg, #b36a5f, #d8aa52);
}

.btn-secondary {
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(101, 135, 128, 0.28);
}
