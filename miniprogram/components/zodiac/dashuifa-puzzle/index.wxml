<view class="dashuifa-puzzle">
  <view class="puzzle-guide">
    <view class="guide-title">华容道复原 · 已归位 {{game.correctCount}}/8 · {{game.moveCount}} 步</view>
    <view class="guide-text">点击空位上下左右相邻的残片，让它沿空位滑动。只能移动一格，残片不能直接交换。</view>
    <view class="blueprint-rows">
      <view wx:for="{{game.blueprintRows}}" wx:key="label" class="blueprint-row">
        <view class="blueprint-label">{{item.label}}</view>
        <view class="blueprint-clue">{{item.clue}}</view>
      </view>
    </view>
    <view class="guide-message">{{game.message}}</view>
  </view>
  <view class="puzzle-grid">
    <view
      wx:for="{{game.tiles}}"
      wx:key="slotIndex"
      class="puzzle-tile {{item.blank ? 'blank' : ''}} {{item.movable ? 'movable' : ''}}"
      data-index="{{index}}"
      bindtap="onTileTap"
    >
      <block wx:if="{{item.blank}}">
        <view class="blank-mark">空位</view>
        <view class="blank-tip">相邻残片滑入此处</view>
      </block>
      <block wx:else>
        <view class="tile-motif">{{item.motif}}</view>
        <view class="tile-title">{{item.title}}</view>
        <view class="tile-detail">{{item.detail}}</view>
      </block>
    </view>
  </view>
  <view class="button-row">
    <button class="btn-secondary" bindtap="onReset">重排</button>
    <button class="btn-primary" bindtap="onCheck">确认复原</button>
  </view>
</view>
