.progress-header {
  width: 100%;
  max-width: 100%;
  padding: 30rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(44, 61, 69, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 18rpx 54rpx rgba(44, 61, 69, 0.12);
}

.progress-header.dark {
  color: #fff8ed;
  background: radial-gradient(circle at 18% 16%, rgba(166, 141, 115, 0.5), transparent 30%), linear-gradient(145deg, #2c3d45, #658780);
}

.progress-header.compact {
  padding: 26rpx;
}

.header-row,
.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 18rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.72;
}

.title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.25;
  word-break: break-all;
}

.dark .title {
  font-size: 52rpx;
  letter-spacing: 4rpx;
}

.compact .title {
  font-size: 38rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: rgba(44, 61, 69, 0.66);
  font-size: 25rpx;
  line-height: 1.65;
  word-break: break-all;
}

.dark .subtitle {
  color: rgba(255, 248, 237, 0.9);
}

.tag {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #fff8ed;
  background: #b36a5f;
  font-size: 22rpx;
  white-space: nowrap;
}

.dark .tag {
  background: rgba(255, 248, 237, 0.16);
  border: 1rpx solid rgba(255, 248, 237, 0.28);
}

.progress-meta {
  margin-top: 22rpx;
  color: rgba(44, 61, 69, 0.68);
  font-size: 24rpx;
}

.dark .progress-meta {
  color: rgba(255, 248, 237, 0.78);
}

.progress-track {
  height: 14rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(44, 61, 69, 0.12);
}

.dark .progress-track {
  background: rgba(255, 248, 237, 0.18);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #658780, #a68d73, #b36a5f);
}

.dark .progress-fill {
  background: linear-gradient(90deg, #f7f0e5, #a68d73, #b36a5f);
}
