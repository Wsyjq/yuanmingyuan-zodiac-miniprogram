<view class="progress-header {{dark ? 'dark' : ''}} {{compact ? 'compact' : ''}}">
  <view class="header-row">
    <view class="header-main">
      <view wx:if="{{eyebrow}}" class="eyebrow">{{eyebrow}}</view>
      <view class="title">{{title}}</view>
      <view wx:if="{{subtitle}}" class="subtitle">{{subtitle}}</view>
    </view>
    <view wx:if="{{tag}}" class="tag">{{tag}}</view>
  </view>
  <view wx:if="{{metaLeft || metaRight}}" class="progress-meta">
    <text>{{metaLeft}}</text>
    <text>{{metaRight}}</text>
  </view>
  <view class="progress-track">
    <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
  </view>
</view>
