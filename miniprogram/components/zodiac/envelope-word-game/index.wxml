<view class="envelope-word-game">
  <view class="envelope-hint">{{game.hint}}</view>
  <view class="slots">
    <view wx:for="{{game.slots}}" wx:key="index" class="slot {{item.pieceId ? 'filled' : ''}}" data-index="{{index}}" bindtap="onRemovePiece">
      <view class="slot-label">{{item.label}}</view>
      <view class="character-frame">
        <view class="character-half upper-half {{item.pieceId ? 'placed' : ''}}">
          <text wx:if="{{item.pieceId}}" class="character-glyph upper-glyph">{{item.upperChar}}</text>
          <text wx:else class="upper-placeholder">?</text>
        </view>
        <view class="join-line"></view>
        <view class="character-half lower-half">
          <text class="character-glyph lower-glyph">{{item.lowerChar}}</text>
        </view>
      </view>
      <view class="slot-tip" wx:if="{{item.pieceId}}">字块 {{item.pieceCode}} · 点按撤回</view>
      <view class="slot-tip" wx:else>选择上半字块</view>
    </view>
  </view>
  <view class="envelope-message">{{game.message}} · 尝试 {{game.attempts}}</view>
  <view class="piece-row">
    <button wx:for="{{game.pieces}}" wx:key="id" class="piece {{item.used ? 'used' : ''}}" data-index="{{index}}" disabled="{{item.used}}" bindtap="onPickPiece">
      <view class="piece-code">{{item.code}}</view>
      <view class="piece-preview"><text class="piece-glyph">{{item.char}}</text></view>
      <view class="piece-name">{{item.used ? '已使用' : '上半字块'}}</view>
    </button>
  </view>
  <view class="button-row">
    <button class="btn-secondary" bindtap="onClear">清空</button>
    <button class="btn-primary" bindtap="onCheck">确认</button>
  </view>
</view>
