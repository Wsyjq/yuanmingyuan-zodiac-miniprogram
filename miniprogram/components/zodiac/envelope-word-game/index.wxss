view,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: center;
  overflow: hidden;
}

button::after {
  border: 0;
}

.envelope-word-game {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.envelope-hint,
.envelope-message {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  color: rgba(44, 61, 69, 0.7);
  font-size: 22rpx;
  line-height: 1.5;
}

.envelope-hint {
  margin-bottom: 16rpx;
  background: rgba(101, 135, 128, 0.1);
}

.envelope-message {
  margin-top: 16rpx;
  background: rgba(216, 170, 82, 0.13);
}

.slots {
  display: flex;
  justify-content: space-between;
}

.slot {
  flex-direction: column;
  width: 31.6%;
  min-height: 210rpx;
  padding: 12rpx 8rpx;
  border: 2rpx dashed rgba(44, 61, 69, 0.28);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.52);
}

.slot.filled {
  border-style: solid;
  border-color: rgba(179, 106, 95, 0.42);
  background: rgba(179, 106, 95, 0.1);
}

.slot-label {
  color: rgba(44, 61, 69, 0.52);
  font-size: 17rpx;
  font-weight: 800;
}

.character-frame {
  position: relative;
  width: 84rpx;
  height: 96rpx;
  margin-top: 8rpx;
  border: 1rpx solid rgba(44, 61, 69, 0.16);
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(255, 248, 237, 0.88);
}

.character-half {
  position: relative;
  width: 100%;
  height: 48rpx;
  overflow: hidden;
}

.upper-half {
  color: rgba(44, 61, 69, 0.32);
  background: rgba(101, 135, 128, 0.06);
}

.upper-half.placed {
  color: #2c3d45;
  background: rgba(216, 170, 82, 0.1);
}

.lower-half {
  color: #2c3d45;
}

.character-glyph {
  position: absolute;
  left: 0;
  right: 0;
  height: 96rpx;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 96rpx;
  text-align: center;
}

.upper-glyph {
  top: 0;
}

.lower-glyph {
  top: -48rpx;
}

.upper-placeholder {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.join-line {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 47rpx;
  z-index: 2;
  border-top: 2rpx dashed rgba(179, 106, 95, 0.48);
}

.slot-tip {
  margin-top: 8rpx;
  color: rgba(44, 61, 69, 0.5);
  font-size: 18rpx;
  font-weight: 700;
}

.piece-row,
.button-row {
  display: flex;
  width: 100%;
  margin-top: 18rpx;
}

.piece-row {
  flex-wrap: wrap;
  justify-content: space-between;
}

.button-row button {
  width: 100%;
  min-width: 0;
}

.piece {
  position: relative;
  flex: 0 0 31.6%;
  width: 31.6%;
  min-width: 0;
  height: 112rpx;
  margin-bottom: 12rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  color: #2c3d45;
  background: rgba(255, 248, 237, 0.82);
  font-weight: 900;
  line-height: 1.2;
}

.piece:nth-child(n + 4) {
  margin-bottom: 0;
}

.piece-code {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #fff8ed;
  background: #b36a5f;
  font-size: 16rpx;
  line-height: 28rpx;
}

.piece-preview {
  position: relative;
  width: 58rpx;
  height: 38rpx;
  margin: 4rpx auto 0;
  overflow: hidden;
  border-bottom: 2rpx dashed rgba(179, 106, 95, 0.44);
}

.piece-glyph {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 76rpx;
  font-size: 54rpx;
  line-height: 76rpx;
  text-align: center;
}

.piece-name {
  margin-top: 8rpx;
  color: rgba(44, 61, 69, 0.54);
  font-size: 16rpx;
  font-weight: 800;
}

.button-row button + button {
  margin-left: 12rpx;
}

.piece.used {
  opacity: 0.38;
}

.btn-primary,
.btn-secondary {
  display: block;
  flex: 1 1 0;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  border-radius: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.btn-primary {
  color: #fff8ed;
  background: linear-gradient(135deg, #658780, #2c3d45);
}

.btn-secondary {
  color: #2c3d45;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(101, 135, 128, 0.28);
}
