/* ============================================================
 * 全局设计 token —— 「旧纸档案手账」（设计文档 §1，v1.3）
 * 参考：复古手账风的「旧纸档案」路线——温暖、沉稳、有故事感、有秩序。
 * 不做重做旧、不压暗：轻微泛黄的旧纸 + 低饱和棕/灰米/暗橄榄绿，
 * 用票据、邮票齿孔、编号标签、日期章、手写批注营造「被认真保存过」的时间感。
 * 仅此处定义颜色/字体变量；页面与组件统一引用，不要散落写死色值。
 * ============================================================ */
page {
  /* 色彩系统 · 手帐风：轻微泛黄的旧纸 + 暖褐墨，不用档案纸白和蓝黑墨 */
  --paper: #F4EDDC;      /* 旧纸黄：全局页面底色 */
  --paper2: #EBE1CB;     /* 浅棕一档：卡片底、抽屉底 */
  --paper3: #DED1B4;     /* 灰米深档：浮层、覆盖层 */
  --ink: #46382A;        /* 暖褐墨：正文主文本、排线 */
  --ink-deep: #2E1F0D;   /* 重墨：大标题、重要框线 */
  --ink60: #70624E;      /* 褐墨淡：次要文本、来源标注 */
  --patina: #4A6B64;     /* 铜绿：史料卡标题、已解锁、可交互提示 */
  --olive: #6F7248;      /* 暗橄榄绿：编号标签、注释、和纸胶带 */
  --coffee: #7A5C3E;     /* 咖色：票据正文、次级强调 */
  --brass: #A98F5F;      /* 旧金（亚光）：描金线、铜钉、进度标记 */
  --cinnabar: #A63A2E;   /* 朱砂：印章、日期章、确认按钮（全 App 唯一红，≤2%） */
  --dash: #C0B49A;       /* 虚线灰：拖放目标位、纹样缺失位轮廓 */
  --night: #23282E;      /* 夜景墨蓝：拍照页底、图片预览遮罩 */
  --binder-width: 32rpx;
  --binder-reserve: 20rpx;
  --page-gutter: 32rpx;
  --content-max: 666rpx;
  --safe-bottom: env(safe-area-inset-bottom);

  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.9;
  height: 100%;
}

.page-shell {
  position: relative;
  width: 100%;
  max-width: 100vw;
  min-width: 0;
  height: 100%;
  max-height: 100%;
  overflow: hidden;
  box-sizing: border-box;
}
.page-shell.page-shell {
  height: 100%;
  max-height: 100%;
  overflow: hidden;
  padding-right: var(--page-gutter);
  padding-bottom: calc(48rpx + var(--safe-bottom));
  padding-left: calc(var(--page-gutter) + var(--binder-reserve));
}
.content-bound {
  width: 100%;
  max-width: var(--content-max);
  box-sizing: border-box;
}
.page-doc {
  height: calc(100% - 48rpx);
  width: auto;
  margin: 24rpx 24rpx 24rpx 0;
  padding: 36rpx 32rpx 160rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(70, 56, 42, 0.34);
  border-radius: 2rpx 18rpx 14rpx 2rpx;
  background:
    repeating-linear-gradient(0deg, rgba(122, 92, 62, 0.025) 0, rgba(122, 92, 62, 0.025) 1rpx, transparent 1rpx, transparent 13rpx),
    linear-gradient(155deg, #F6F0E0 0%, var(--paper) 58%, #E8E0CE 100%);
  box-shadow: 8rpx 10rpx 0 var(--paper2), 0 10rpx 28rpx rgba(70, 56, 42, 0.18);
}

/* 任务页：一层纸，不要内卡+装订孔。操作栏钉在底部。 */
.task-shell {
  --binder-reserve: 0px;
  display: flex;
  flex-direction: column;
  padding-top: calc(var(--sbh, 20px) + 44px) !important;
  padding-left: 32rpx !important;
  padding-right: 32rpx !important;
  padding-bottom: 0 !important;
}
.task-shell .binder {
  display: none;
}
.task-shell .page-doc {
  flex: 1;
  height: auto;
  min-height: 0;
  width: auto;
  margin: 0;
  padding: 8rpx 8rpx 16rpx;
  border: none;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
}
.task-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.task-head .task-kicker {
  margin-bottom: 0;
  flex: 1;
}
.task-head .ac-wrap,
.task-head .ac-iconbtn {
  flex-shrink: 0;
  margin: 0;
}
.task-kicker {
  margin-bottom: 0;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--olive);
  font-weight: 700;
}
.task-diary {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 12rpx 0 28rpx;
  padding: 4rpx 0 4rpx 20rpx;
  border-left: 4rpx solid var(--cinnabar);
}
.task-diary .task-lead {
  flex: 1;
}
.task-diary .ac-iconbtn {
  margin-top: 6rpx;
}
.task-lead {
  margin-bottom: 0;
  font-size: 36rpx;
  line-height: 1.75;
  color: var(--ink-deep);
}
.task-exam {
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(46, 31, 13, 0.18);
}
.q-label {
  margin: 16rpx 0 8rpx;
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--cinnabar);
  font-weight: 700;
}

/* 任务页：上面剧情大、下面选项小。 */
.task-shell .task-lead,
.task-shell .lead,
.task-shell .novel-p,
.task-shell .para,
.task-shell .wp-line,
.task-shell .wp-intro,
.task-shell .dsf-quote,
.task-shell .narr-text,
.task-shell .prop-title,
.task-shell .flip-face,
.task-shell .act-strip-text {
  font-size: 36rpx !important;
  line-height: 1.7 !important;
  color: var(--ink-deep) !important;
}
.task-shell .q-title,
.task-shell .title,
.task-shell .navi-title,
.task-shell .route {
  font-size: 34rpx !important;
  line-height: 1.45 !important;
  font-weight: 700 !important;
  color: var(--ink-deep) !important;
  letter-spacing: 1rpx !important;
}
.task-shell .opt,
.task-shell .wp-opt {
  align-items: flex-start;
  min-height: 88rpx;
  padding: 18rpx 8rpx 18rpx 0 !important;
  background: transparent !important;
  border: none !important;
  border-bottom: 1rpx solid rgba(46, 31, 13, 0.16) !important;
  box-shadow: none !important;
}
.task-shell .opt-sel,
.task-shell .wp-opt-on {
  background: rgba(166, 58, 46, 0.08) !important;
  border-bottom-color: var(--cinnabar) !important;
}
.task-shell .opt-text,
.task-shell .wp-opt-text,
.task-shell .cell-name {
  font-size: 28rpx !important;
  line-height: 1.5 !important;
  color: var(--ink-deep) !important;
  font-weight: 400 !important;
}
.task-shell .opt-key,
.task-shell .wp-opt-key {
  width: 48rpx;
  margin-right: 12rpx;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  color: var(--cinnabar) !important;
}
.task-shell .hint,
.task-shell .hint-copy,
.task-shell .wrong-tip,
.task-shell .cell-desc,
.task-shell .step-copy,
.task-shell .note-hand,
.task-shell .care-note,
.task-shell .act-strip,
.task-shell .site-name,
.task-shell .site-state,
.task-shell .wp-step-text,
.task-shell .panel-no {
  font-size: 28rpx !important;
  line-height: 1.55 !important;
  color: var(--ink-deep) !important;
}
.task-shell .answer-input,
.task-shell .pwd-input {
  font-size: 32rpx !important;
  color: var(--ink-deep) !important;
}
.task-dock {
  flex-shrink: 0;
  padding: 16rpx 8rpx calc(24rpx + var(--safe-bottom));
  background: linear-gradient(180deg, rgba(244, 237, 220, 0) 0%, var(--paper) 18%);
  border-top: none;
}
.task-dock .btn-seal {
  width: 100%;
  min-height: 96rpx;
  font-size: 32rpx;
  letter-spacing: 16rpx;
  color: #F7F4EC;
  background: var(--cinnabar);
  border: none;
  border-radius: 2rpx;
  box-shadow: 0 8rpx 0 #7A241C;
}
.task-dock .btn-seal[disabled] {
  color: #F7F4EC;
  background: rgba(166, 58, 46, 0.45);
  border-color: rgba(166, 58, 46, 0.45);
  opacity: 1;
}
.task-dock .skip-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 8rpx 0;
  min-height: 56rpx;
  background: transparent;
  border: none;
  color: var(--ink-deep);
  font-size: 28rpx;
}
.task-dock .hint {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: var(--ink-deep);
}

/* ---------- 字体工具类（设计文档 §1.3） ---------- */
/* 大标题 / 站名：宋体 */
.serif {
  font-family: "STSong", "SimSun", serif;
}
/* 铭文 / 题跋 / 引文：楷体 */
.kaiti {
  font-family: "STKaiti", "KaiTi", serif;
}
/* 手写批注：LXGW WenKai v1.522 OFL 项目子集，商用许可见 assets/licenses/。 */
.hand {
  font-family: "Plate21WenKai", "STXingkai", "HanziPen SC", "STKaiti", "KaiTi", cursive;
}

/* ---------- 按钮（设计文档 §1.4） ---------- */
button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
}
button::after { border: none; }
/* 主按钮：朱砂描边方印，手帐印章，不用档案签底图 */
.btn-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 56rpx;
  border: 3rpx solid var(--cinnabar);
  color: var(--cinnabar);
  background: transparent;
  font-family: "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  border-radius: 6rpx;
  min-height: 88rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-seal:active {
  transform: scale(0.94);
  opacity: 0.85;
}
button.btn-seal[disabled] {
  background: transparent;
  color: rgba(166, 58, 46, 0.45);
  opacity: 0.6;
}

/* 次按钮：褐墨细线描边 */
.btn-line {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 44rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.5);
  color: var(--ink);
  background: transparent;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  border-radius: 4rpx;
  min-height: 88rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-line:active {
  transform: scale(0.96);
  opacity: 0.8;
}
button.btn-line[disabled] {
  background: transparent;
  color: rgba(70, 56, 42, 0.45);
  opacity: 0.6;
}

/* 跳过：橄榄和纸胶带，不是白纸封签 */
button.skip-btn {
  color: var(--olive);
  background: rgba(111, 114, 72, 0.22);
  background-image: none;
  border: 0;
  text-decoration: none;
  min-height: 64rpx;
  padding: 8rpx 28rpx;
  border-radius: 4rpx;
  transform: rotate(-1.5deg);
}

/* ---------- 弹层离场动画（INT-301，v1.4.0-b3） ---------- */
/* wx:if 弹层关闭时先加此类播放离场动画，再延迟卸载，避免瞬间消失。
 * 遮罩用淡出，卡片/抽屉各自定义方向（见各组件 wxss）。closing 期间忽略二次操作。 */
.coach-hit {
  display: inline-block;
}
.coach-host {
  position: fixed !important;
  z-index: 140;
  pointer-events: none;
  overflow: hidden;
}

.overlay-out {
  animation: overlay-out 0.25s ease forwards;
}
@keyframes overlay-out {
  to {
    opacity: 0;
    transform: scale(0.96);
  }
}

/* ---------- 纸面质感（设计文档 §1.5，v1.3 新增） ---------- */
/* 旧纸底纹：暖色渐变 + 细纤维排线 + 污渍斑 + 边缘晕影（v1.3.1 加强）。
 * 克制不脏：斑与晕影透明度 ≤0.10。正式纸纹理照片见素材清单 TEX-01。 */
.paper-grain {
  background:
    radial-gradient(ellipse 400rpx 300rpx at 18% 12%, rgba(122, 92, 62, 0.07) 0%, transparent 70%),
    radial-gradient(ellipse 500rpx 380rpx at 88% 68%, rgba(122, 92, 62, 0.06) 0%, transparent 70%),
    radial-gradient(ellipse 360rpx 460rpx at 60% 96%, rgba(111, 114, 72, 0.05) 0%, transparent 70%),
    repeating-linear-gradient(
      0deg,
      rgba(122, 92, 62, 0.03) 0rpx,
      rgba(122, 92, 62, 0.03) 2rpx,
      transparent 2rpx,
      transparent 14rpx
    ),
    radial-gradient(ellipse at center, transparent 52%, rgba(122, 92, 62, 0.10) 100%),
    linear-gradient(160deg, #F6F0E0 0%, var(--paper) 55%, #EFE5CE 100%);
}

/* ---------- 手账元素（设计文档 §1.6，v1.3 新增） ---------- */
/* 编号标签：手帐「No.」小签，橄榄绿细框 */
.tag-no {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 18rpx;
  border: 1rpx solid var(--olive);
  color: var(--olive);
  font-family: "STSong", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  border-radius: 3rpx;
  background: rgba(111, 114, 72, 0.06);
}

/* 日期章：朱砂双圈圆章，微微倾斜，营造「盖章归档」感。
 * 用法：绝对定位在卡片边角，内部两行小字（年号 / 公元）。 */
.stamp-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border: 3rpx solid rgba(166, 58, 46, 0.75);
  border-radius: 50%;
  color: rgba(166, 58, 46, 0.85);
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  transform: rotate(-8deg);
  position: relative;
  background: rgba(166, 58, 46, 0.04);
}
.stamp-date::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 1rpx solid rgba(166, 58, 46, 0.5);
  border-radius: 50%;
  pointer-events: none;
}

/* 和纸胶带：半透明橄榄条，微旋转贴在照片或卡片顶边。容器需 position:relative。 */
.tape {
  position: absolute;
  width: 180rpx;
  height: 44rpx;
  background: rgba(111, 114, 72, 0.32);
  border: 0;
  transform: rotate(-3deg);
  box-shadow: 0 2rpx 6rpx rgba(70, 56, 42, 0.12);
  z-index: 12;
  pointer-events: none;
}
.tape.brass {
  background: rgba(169, 143, 95, 0.38);
}

/* 票据锯齿边：卡片下缘的撕票锯齿（径向渐变圆齿）。
 * 用法：放在卡片底部的 16rpx 高条，颜色跟随卡片底色。 */
.ticket-edge {
  height: 16rpx;
  background-image: radial-gradient(circle at 12rpx 0rpx, transparent 10rpx, var(--paper2) 11rpx);
  background-size: 28rpx 16rpx;
  background-repeat: repeat-x;
}

/* 邮票齿孔框：主图外圈的齿孔白边，让照片/铜版画「像一枚邮票」。
 * 用法：包裹主图，内边距即齿孔带宽。 */
.perfo-frame {
  padding: 20rpx;
  background:
    radial-gradient(circle at 10rpx 10rpx, var(--paper) 8rpx, transparent 9rpx),
    #FBF7EC;
  background-size: 28rpx 28rpx;
  background-position: 0 0;
  border: 2rpx solid rgba(70, 56, 42, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(70, 56, 42, 0.18);
}

/* 手写批注行：页边/图旁的手写小字，橄榄绿或褐墨淡 */
.note-hand {
  font-family: "Plate21WenKai", "STXingkai", "HanziPen SC", "STKaiti", "KaiTi", cursive;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.7;
}
.skip-line {
  display: block;
  margin: 20rpx auto 0;
  background: transparent;
  color: var(--ink);
  font-size: 30rpx;
  border-bottom: 3rpx solid var(--ink-deep);
}
.note-hand.olive {
  color: var(--olive);
}

/* ---------- 实物拼贴语言（设计文档 §1.6 增补，v1.3.1） ---------- */
/* 活页装订孔列：页面左缘的打孔 + 竖向缝线，手账活页纸的标志性特征。
 * 用法：页面根容器内第一个节点，<view class="binder"/>。 */
/* 活页装订脊：窄浅装订脊 + 三组金属环（上/中/下各 3 个，共 9 环）
 * 层次：①浅色装订脊底（比纸略深，灰米色）②金属环高光 ③金属环本体 ④孔洞凹陷
 * 9 个环用 background-position 精确定位，不靠 repeat（避免均匀密布）
 * background-size: 100% 100% 让百分比定位基于整条侧边高度
 */
.binder {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--binder-width);
  pointer-events: none;
  z-index: 4;
  background-color: transparent;
  background-image:
    radial-gradient(circle at 16rpx 14%, #46382A 0, #46382A 2rpx, transparent 3rpx, transparent 6rpx, rgba(138, 129, 117, 0.72) 7rpx, transparent 9rpx),
    radial-gradient(circle at 16rpx 18%, #46382A 0, #46382A 2rpx, transparent 3rpx, transparent 6rpx, rgba(138, 129, 117, 0.72) 7rpx, transparent 9rpx),
    radial-gradient(circle at 16rpx 49%, #46382A 0, #46382A 2rpx, transparent 3rpx, transparent 6rpx, rgba(138, 129, 117, 0.72) 7rpx, transparent 9rpx),
    radial-gradient(circle at 16rpx 53%, #46382A 0, #46382A 2rpx, transparent 3rpx, transparent 6rpx, rgba(138, 129, 117, 0.72) 7rpx, transparent 9rpx),
    radial-gradient(circle at 16rpx 82%, #46382A 0, #46382A 2rpx, transparent 3rpx, transparent 6rpx, rgba(138, 129, 117, 0.72) 7rpx, transparent 9rpx),
    radial-gradient(circle at 16rpx 86%, #46382A 0, #46382A 2rpx, transparent 3rpx, transparent 6rpx, rgba(138, 129, 117, 0.72) 7rpx, transparent 9rpx),
    linear-gradient(90deg, rgba(222, 209, 180, 0.2), rgba(235, 225, 203, 0.08));
  background-size: 100% 100%;
  background-repeat: no-repeat;
  /* 右侧与纸面的分隔（装订脊厚度，浅阴影）*/
  border-right: 1rpx solid rgba(138, 122, 96, 0.2);
  box-shadow: 1rpx 0 3rpx rgba(70, 56, 42, 0.04);
}

/* 实物卡片：像一张贴上手账的米白卡纸——投影 + 微旋转 + 圆角。
 * 搭配 .tilt-l / .tilt-r 制造随手贴上的感觉。 */
.clip-card {
  background: #FBF6EA;
  border-radius: 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(70, 56, 42, 0.18), 0 1rpx 4rpx rgba(70, 56, 42, 0.10);
  border: 1rpx solid rgba(70, 56, 42, 0.14);
}
.tilt-l { transform: rotate(-1.2deg); }
.tilt-r { transform: rotate(1deg); }

/* 撕纸边分隔条：上下两区之间的撕纸锯齿（上浅下深两色交叠）。
 * 用法：独立一行 <view class="torn-divider"/>。 */
.torn-divider {
  height: 20rpx;
  background:
    linear-gradient(45deg, var(--paper2) 0, var(--paper2) 10rpx, transparent 10rpx),
    linear-gradient(-45deg, var(--paper2) 0, var(--paper2) 10rpx, transparent 10rpx);
  background-size: 24rpx 20rpx;
  background-repeat: repeat-x;
  background-position: 0 100%;
}

/* 吊牌式编号：在 .tag-no 基础上加绳孔，更像档案吊牌。
 * 用法：<view class="tag-no tag-hang">No.021</view> */
.tag-hang {
  position: relative;
  padding-left: 34rpx;
  transform: rotate(-2deg);
  box-shadow: 0 3rpx 8rpx rgba(70, 56, 42, 0.14);
  background: #F7F0DF;
}
.tag-hang::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 2rpx solid var(--olive);
  box-sizing: border-box;
}

/* 照片贴纸：主图白边 + 投影 + 微旋转，像一张洗出来贴上的照片。
 * 用法：包在主图占位块外，配 .tilt-l/.tilt-r。 */
.photo-sticker {
  background: #FDFBF4;
  padding: 16rpx 16rpx 56rpx 16rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.12);
  box-shadow: 0 8rpx 22rpx rgba(70, 56, 42, 0.20);
  position: relative;
}
/* 照片下方白边里的手写说明位（配合 .note-hand 绝对定位使用） */

/* 缝线框：卡片内缘的虚线缝边（stitched border），手账常用。
 * 容器需 position:relative。 */
.stitched {
  position: relative;
}
.stitched::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 10rpx;
  bottom: 10rpx;
  border: 2rpx dashed rgba(138, 122, 96, 0.45);
  border-radius: 6rpx;
  pointer-events: none;
}

/* 缝线条：手帐等价物（左青绿边 + 横线稿纸，无英文 FIELD NOTE） */
.stitch-strip {
  position: relative;
  box-sizing: border-box;
  padding: 24rpx 24rpx 20rpx;
  border-top: 1rpx solid rgba(70, 56, 42, 0.28);
  border-right: 1rpx solid rgba(70, 56, 42, 0.16);
  border-bottom: 1rpx solid rgba(70, 56, 42, 0.28);
  border-left: 6rpx solid var(--patina);
  background:
    repeating-linear-gradient(0deg, transparent 0, transparent 47rpx, rgba(122, 92, 62, 0.05) 48rpx, transparent 49rpx),
    rgba(248, 241, 223, 0.72);
  box-shadow: 4rpx 5rpx 0 rgba(70, 56, 42, 0.06);
}

/* 实体道具提示卡（只提示步骤，不画假道具） */
.prop-prompt {
  position: relative;
  box-sizing: border-box;
  margin-top: 40rpx;
  padding: 48rpx 32rpx 32rpx;
}
.prop-prompt .prop-label {
  display: inline-flex;
  margin-bottom: 16rpx;
}
.prop-prompt .prop-title {
  color: var(--ink-deep);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}
.prop-prompt .prop-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.prop-prompt .prop-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.prop-prompt .step-no {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--patina);
  color: #FBF6EA;
  font-size: 22rpx;
}
.prop-prompt .step-copy {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink);
  padding-top: 2rpx;
}
.prop-prompt .prop-note {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: rgba(70, 56, 42, 0.62);
}

.record-action {
  box-shadow: inset 0 0 0 1rpx rgba(166, 58, 46, 0.1);
}

/* 排线分隔细条：cover/handbook/report/waypoint 标题下（非禁用类） */
.archive-rule {
  position: relative;
  height: 10rpx;
  margin: 14rpx 0 8rpx;
  border-top: 1rpx solid rgba(46, 31, 13, 0.42);
  background: repeating-linear-gradient(90deg, rgba(46, 31, 13, 0.24) 0, rgba(46, 31, 13, 0.24) 2rpx, transparent 2rpx, transparent 9rpx);
  background-size: 100% 5rpx;
  background-position: left bottom;
  background-repeat: no-repeat;
}

/* ---------- 装饰（设计文档 §1.4/§1.5） ---------- */
/* 排线分隔带：纯 CSS 模拟铜版画排线，褐墨 45% 透明度的细排线 */
.hatch-divider {
  height: 12rpx;
  background: repeating-linear-gradient(
    90deg,
    rgba(70, 56, 42, 0.45) 0rpx,
    rgba(70, 56, 42, 0.45) 2rpx,
    transparent 2rpx,
    transparent 8rpx
  );
}

/* 铜版画双框线：外 2rpx + 内 1rpx 褐墨细线，间距 6~8rpx。
 * 重要卡片 / 占位块统一用这一语言。容器需 position:relative。 */
.double-frame {
  position: relative;
  border: 3rpx solid rgba(70, 56, 42, 0.55);
}
.double-frame::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 2rpx solid rgba(70, 56, 42, 0.4);
  pointer-events: none;
}

/* 档案著录卡：浅棕底 + 铜版画双框 + 顶部铜绿标题条 */
.card-archive {
  position: relative;
  background: var(--paper2);
  border: 2rpx solid rgba(70, 56, 42, 0.5);
  border-radius: 4rpx;
  overflow: hidden;
}
.card-archive::before {
  content: "";
  display: block;
  height: 8rpx;
  background: var(--patina);
}
/* 双框内圈（给顶部铜绿条让位） */
.card-archive::after {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 16rpx;
  bottom: 6rpx;
  border: 1rpx solid rgba(70, 56, 42, 0.35);
  pointer-events: none;
}

/* 票据卡：浅棕底 + 底部撕票锯齿，用于「线索票根 / 记录凭证」 */
.card-ticket {
  position: relative;
  background: var(--paper2);
  border: 1rpx solid rgba(70, 56, 42, 0.35);
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

/* 巴洛克卷草角饰（极简：弧角 + 菱形点），四个一组放在相对定位容器内 */
.corner {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  z-index: 6;
  pointer-events: none;
}
.corner::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 2rpx solid var(--brass);
}
.corner::after {
  content: "";
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: var(--brass);
  transform: rotate(45deg);
}
.corner.tl { left: 14rpx; top: 14rpx; }
.corner.tr { right: 14rpx; top: 14rpx; }
.corner.bl { left: 14rpx; bottom: 14rpx; }
.corner.br { right: 14rpx; bottom: 14rpx; }
.corner.tl::before { border-right: none; border-bottom: none; border-top-left-radius: 22rpx; }
.corner.tr::before { border-left: none; border-bottom: none; border-top-right-radius: 22rpx; }
.corner.bl::before { border-right: none; border-top: none; border-bottom-left-radius: 22rpx; }
.corner.br::before { border-left: none; border-top: none; border-bottom-right-radius: 22rpx; }
.corner.tl::after { right: -4rpx; bottom: -4rpx; }
.corner.tr::after { left: -4rpx; bottom: -4rpx; }
.corner.bl::after { right: -4rpx; top: -4rpx; }
.corner.br::after { left: -4rpx; top: -4rpx; }

/* 拱券细线（呼应大水法拱门），半圆拱顶饰 */
.arch {
  width: 160rpx;
  height: 72rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(70, 56, 42, 0.45);
  border-bottom: none;
  border-radius: 160rpx 160rpx 0 0;
}

/* ---------- 贴纸通用定位（v1.3.1 实物拼贴推广，17 页共用） ----------
 * 用法：<image class="sticker tr tilt-r" src=".../st-stamp-01.png" mode="aspectFit"/>
 *   .sticker        必填基类：绝对定位、指针穿透、投影、微透明
 *   .tl/.tr/.bl/.br 四角方位：贴在「最近 position:relative 容器」的某一角，略微出框
 *   .edge-l/.edge-r 页边纵向贴：贴在页面左/右边缘中部
 *   倾斜复用已有 .tilt-l / .tilt-r（亦可内联 style="transform:rotate(Ndeg)"）
 * 容器需 position:relative（.page 已是；卡片类已自带）。谜题操作页贴在 .page 根上即「退到页边」。
 */
.sticker {
  position: absolute;
  z-index: 9;
  pointer-events: none;
  opacity: 0.92;
  filter: drop-shadow(0 3rpx 6rpx rgba(70, 56, 42, 0.22));
}
/* 默认尺寸：邮票/邮戳/回形针类小贴纸 ≈160rpx 宽，按 aspectFit 不定高即可 */
.sticker { width: 160rpx; height: 120rpx; }
/* 大号贴纸（吊牌/票根/干花），用法加 .lg */
.sticker.lg { width: 220rpx; height: 200rpx; }

/* 四角方位：相对最近的 relative 容器，略微出框制造「随手贴」感 */
.sticker.tl { top: -28rpx; left: -22rpx; }
.sticker.tr { top: -28rpx; right: -22rpx; }
.sticker.bl { bottom: -24rpx; left: -22rpx; }
.sticker.br { bottom: -24rpx; right: -22rpx; }
/* 页边纵向贴（贴在 .page 根容器的左/右边缘中部） */
.sticker.edge-l { left: -32rpx; top: 42%; transform: translateY(-50%); }
.sticker.edge-r { right: -32rpx; top: 42%; transform: translateY(-50%); }
/* 方位与 tilt 同时使用时，tilt 的 rotate 会被覆盖；改用 .tilt-l/.tilt-r 修饰需在方位之后声明，
   故推荐方位类配内联 rotate。这里提供组合兜底：带方位时若额外加 .rot-l/.rot-r 在 transform 末段追加旋转 */
.sticker.edge-l.rot-l { transform: translateY(-50%) rotate(-3deg); }
.sticker.edge-l.rot-r { transform: translateY(-50%) rotate(3deg); }
.sticker.edge-r.rot-l { transform: translateY(-50%) rotate(-3deg); }
.sticker.edge-r.rot-r { transform: translateY(-50%) rotate(3deg); }

/* 档案风容器/噪点/multiply 已废弃：微信端可能白屏；一律 clip-card / double-frame / stitch-strip。 */

/* ===== V2.2 讲述版通用 ===== */
/* 纸·实物铭文引文（四声部之「纸」）：档案物件上本来就有的字 */
.paper-quote {
  margin: 20rpx 24rpx;
  padding: 16rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.9;
  color: #3d3627;
  border-left: 4rpx solid rgba(70, 56, 42, 0.35);
  background: rgba(255, 252, 243, 0.6);
}
/* 舞台与操作指示（括号小字）：看得见，不进音频 */
.stage-note {
  margin: 8rpx 8rpx 0;
  font-size: 22rpx;
  color: rgba(70, 56, 42, 0.66);
}

/* ================ V2.3 【做】动作条（红线9：常显一行动作，关人声可玩） ================ */
.act-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  margin: 22rpx auto;
  padding: 14rpx 22rpx;
  border: 2rpx dashed var(--cinnabar);
  border-radius: 8rpx;
  background: rgba(166, 58, 46, 0.05);
}
.act-strip-tag {
  flex-shrink: 0;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--cinnabar);
  border: 2rpx solid var(--cinnabar);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.act-strip-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--ink);
}
