/* ============================================================
 * 全局设计 token —— 「版痕」铜版画图录（v2.0 · 阶段 2b）
 * 概念：你打开的不是 App，是一册《西洋楼铜版图》的图录。
 * 每屏一张图版（.plate：雕版压痕双细框 + 四角 L 定位标），
 * 下方一行图版说明（.cap），正文像图录文字一样克制（仿宋）。
 * 解谜机关藏在图版之间；全场唯一表演动效 = 落印（.seal-mark）。
 *
 * 8 token / 3 声部（宋·仿宋·楷）/ 3 容器（.plate .sheet 钮×2）
 * 全局 border-radius: 0（雕版 = 锐利）
 * 禁：胶带 回形针 邮戳 干花 装订孔 撕纸 圆形章 吊牌 排线 每屏装饰>1
 *     旧档案容器 旧记录条 旧真纸纹 噪点 multiply  假道具
 * ============================================================ */

page {
  /* ---- 色彩系统（8 token） ---- */
  --paper: #F2EBDB;      /* 纸底 */
  --paper-hi: #FAF6EC;   /* 图版/卡片底 */
  --ink: #2B2118;        /* 正文重墨 */
  --ink-2: #6B5C48;      /* 次要、题头 */
  --ink-3: #9C8E76;      /* 图注、页码、辅助 */
  --rule: #C8BCA2;       /* 全部细线 */
  --cinnabar: #A63A2E;   /* 落印/主确认/当前项（≤2%） */
  --patina: #4A6B64;     /* 史料术语链接（唯一用途） */
  --night: #23282E;      /* 夜景/预览遮罩 */

  /* ---- 旧 token 兼容别名（逐页迁移期，页面 wxss 引用不断） ---- */
  --paper2: var(--paper-hi);
  --paper3: #E7DCC2;
  --ink-deep: var(--ink);
  --ink60: var(--ink-3);
  --olive: var(--ink-2);
  --coffee: var(--ink-2);
  --brass: var(--ink-3);
  --dash: var(--rule);

  --page-gutter: 32rpx;
  --content-max: 666rpx;
  --safe-bottom: env(safe-area-inset-bottom);

  background: var(--paper);
  background-image: linear-gradient(168deg, #F5EFE0 0%, var(--paper) 52%, #EDE4CF 100%);
  color: var(--ink);
  /* 声部二 · 仿宋：全部正文 */
  font-family: "STFangsong", "FangSong", "FangSong_GB2312", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1.9;
}

/* 雕版 = 锐利：全局直角 */
view, text, input, button, textarea, scroll-view, image, picker {
  border-radius: 0;
}

/* ---------- 页面骨架 ---------- */
.page-shell {
  position: relative;
  width: 100%;
  max-width: 100vw;
  min-width: 0;
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}
.page-shell.page-shell {
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  padding-right: var(--page-gutter);
  padding-bottom: calc(48rpx + var(--safe-bottom));
  padding-left: var(--page-gutter);
}
.content-bound {
  width: 100%;
  max-width: var(--content-max);
  box-sizing: border-box;
}
.page-doc {
  height: calc(100% - 48rpx);
  box-sizing: border-box;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
}

/* 任务页（谜题页）：一层纸 + 底部操作栏 */
.task-shell {
  display: flex;
  flex-direction: column;
}
.task-shell .page-doc {
  flex: 1;
  min-height: 0;
  height: auto;
  padding-top: 8rpx;
}
.task-dock {
  flex-shrink: 0;
  padding: 16rpx 0 calc(24rpx + var(--safe-bottom));
  background: var(--paper-hi);
  border-top: 1rpx solid var(--rule);
}
.task-dock .btn-seal {
  width: 100%;
}
.task-dock .btn-line,
.task-dock .ghost-btn {
  width: 100%;
  margin-top: 10rpx;
}
.task-dock .hint {
  margin-bottom: 10rpx;
  font-size: 27rpx;
  color: var(--ink-2);
}

/* 站头条（谜题页页眉） */
.task-kicker {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-2);
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--rule);
  margin-bottom: 18rpx;
}
.task-diary { margin-bottom: 8rpx; }
.task-lead {
  font-size: 29rpx;
  line-height: 1.95;
  color: var(--ink);
  margin-bottom: 16rpx;
}
.task-exam { margin: 18rpx 0; }
.q-label {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}
.q-title {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

/* 选项 */
.opt {
  display: flex;
  gap: 20rpx;
  align-items: baseline;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid var(--rule);
  background: var(--paper-hi);
}
.opt-key {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: var(--ink-2);
  flex-shrink: 0;
}
.opt-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
}
.opt-sel {
  border-color: var(--cinnabar);
  box-shadow: inset 6rpx 0 0 var(--cinnabar);
}
.opt-sel .opt-key { color: var(--cinnabar); }

/* 提示/错误/辅助小字 */
.hint, .hint-copy, .wrong-tip, .cell-desc, .step-copy, .care-note,
.site-name, .site-state, .wp-step-text, .panel-no {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.wrong-tip { color: var(--cinnabar); }
.answer-input, .pwd-input {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 4rpx;
  border: none;
  border-bottom: 1rpx solid var(--ink-2);
  background: none;
  font-family: "STFangsong", "FangSong", "STSong", serif;
  font-size: 30rpx;
  color: var(--ink);
  outline: none;
}

/* ---------- 三声部 ---------- */
/* 声部一 · 宋：题名 / 图版题 / 按钮 / 编号 */
.serif {
  font-family: "STSong", "Songti SC", "SimSun", serif;
}
/* 声部二 · 仿宋：正文（默认即仿宋，此为显式） */
.fangsong {
  font-family: "STFangsong", "FangSong", "FangSong_GB2312", "STSong", "SimSun", serif;
}
/* 声部三 · 楷：手记批注（每屏 ≤1） */
.kaiti {
  font-family: "STKaiti", "KaiTi", serif;
}
.hand, .handnote, .handnote {
  font-family: "Plate21WenKai", "STKaiti", "KaiTi", cursive;
}

/* ---------- 容器一 · .plate 图版框（全场唯一签名容器） ----------
 * 外框 1rpx rule + 内框 2rpx ink（雕版压痕）+ 四角 L 形定位标 */
.plate {
  position: relative;
  background: var(--paper-hi);
  border: 1rpx solid var(--rule);
  padding: 30rpx 26rpx 22rpx;
  margin: 22rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(43, 33, 24, 0.08);
}
.plate::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 2rpx solid var(--ink);
  pointer-events: none;
}
.plate::after {
  content: "";
  position: absolute;
  left: -10rpx;
  right: -10rpx;
  top: -10rpx;
  bottom: -10rpx;
  pointer-events: none;
  background-image:
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink)),
    linear-gradient(var(--ink), var(--ink));
  background-position: left top, left top, right top, right top, left bottom, left bottom, right bottom, right bottom;
  background-size: 18rpx 2rpx, 2rpx 18rpx, 18rpx 2rpx, 2rpx 18rpx, 18rpx 2rpx, 2rpx 18rpx, 18rpx 2rpx, 2rpx 18rpx;
  background-repeat: no-repeat;
}
.plate > view, .plate > text, .plate > image, .plate > scroll-view,
.plate > button, .plate > input, .plate > textarea {
  position: relative;
  z-index: 1;
}

/* 图注行 */
.cap {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--rule);
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}
.cap .no { letter-spacing: 3rpx; color: var(--ink-3); }

/* 图版编号（纯字排，替代旧圆章/吊牌） */
.plateno {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

/* 史料卡变体：左侧 patina 竖线 + 术语链接 */
.plate-src {
  border-left: 4rpx solid var(--patina);
  padding-left: 24rpx;
}
.plate-src .kicker { color: var(--patina); }
.gt-link, .hc-link {
  color: var(--patina);
  border-bottom: 1rpx dashed var(--patina);
}

/* ---------- 容器二 · .sheet 说明纸（仅顶线） ---------- */
.sheet {
  border-top: 1rpx solid var(--rule);
  padding: 22rpx 0 8rpx;
  margin: 22rpx 0;
}
/* 排线分隔细条（cover/handbook/report/waypoint 标题下） */
.rule, .archive-rule {
  height: 2rpx;
  margin: 24rpx 0 16rpx;
  border: none;
  border-top: 1rpx solid var(--rule);
  border-bottom: 1rpx solid rgba(200, 188, 162, 0.5);
}

/* 手记批注：楷体 + 左侧 1rpx 竖细线 */
.handnote, .handnote {
  border-left: 1rpx solid var(--ink-3);
  padding: 4rpx 0 4rpx 22rpx;
  margin: 24rpx 0;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.handnote.olive, .handnote.olive { color: var(--ink-2); }

/* 引文 */
.paper-quote {
  margin: 24rpx 0;
  padding: 6rpx 0 6rpx 26rpx;
  border-left: 4rpx solid var(--ink-2);
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.95;
}
/* 舞台与操作指示（括号小字） */
.stage-note {
  margin: 12rpx 0 0;
  font-size: 23rpx;
  color: var(--ink-3);
}

/* ---------- 按钮（直角） ---------- */
button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
  border-radius: 0;
}
button::after { border: none; }

/* 主按钮 · 落印钮：ink 实底 + 宋体宽字距反白 */
.btn-seal, .seal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 44rpx;
  min-height: 88rpx;
  background: var(--ink);
  color: var(--paper-hi);
  border: 1rpx solid var(--ink);
  border-radius: 0;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-seal:active, .seal-btn:active {
  transform: scale(0.98);
  opacity: 0.82;
}
button.btn-seal[disabled], button.seal-btn[disabled] {
  background: var(--ink);
  color: var(--paper-hi);
  opacity: 0.34;
}

/* 次按钮 · 线钮：细线 + 仿宋 */
.btn-line, .ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 36rpx;
  min-height: 88rpx;
  background: none;
  color: var(--ink-2);
  border: 1rpx solid var(--rule);
  border-radius: 0;
  font-family: "STFangsong", "FangSong", "STSong", serif;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-line:active, .ghost-btn:active {
  transform: scale(0.98);
  opacity: 0.75;
}
button.btn-line[disabled], button.ghost-btn[disabled] {
  opacity: 0.34;
}

/* 跳过钮：细线文字 */
.skip-btn, .skip-line {
  display: block;
  width: auto;
  min-height: 0;
  margin: 14rpx auto 0;
  padding: 8rpx 12rpx;
  background: none;
  border: none;
  border-bottom: 1rpx dotted var(--ink-3);
  border-radius: 0;
  color: var(--ink-2);
  font-size: 26rpx;
}
.skip-btn::after, .skip-line::after { border: none; }

/* ---------- 落印：全场唯一表演动效 ---------- */
.seal-mark {
  position: absolute;
  right: 24rpx;
  bottom: 64rpx;
  z-index: 3;
  width: 106rpx;
  height: 106rpx;
  border: 4rpx solid var(--cinnabar);
  border-radius: 50%;
  color: var(--cinnabar);
  background: rgba(250, 246, 236, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 25rpx;
  letter-spacing: 2rpx;
  line-height: 1.15;
  text-align: center;
  transform: rotate(-7deg);
  animation: sealDrop 0.34s cubic-bezier(0.2, 0.85, 0.3, 1) both;
}
.seal-mark::after {
  content: "";
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  top: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid rgba(166, 58, 46, 0.28);
  border-radius: 50%;
}
@keyframes sealDrop {
  0%   { transform: scale(1.7) rotate(-16deg); opacity: 0; }
  60%  { opacity: 1; }
  100% { transform: scale(1) rotate(-7deg); opacity: 1; }
}

/* ---------- 步骤 / 填答 / 归位 ---------- */
.steps { margin: 14rpx 0; }
.step {
  display: flex;
  gap: 16rpx;
  align-items: baseline;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(200, 188, 162, 0.5);
}
.step-no {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border: 1rpx solid var(--ink-2);
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 21rpx;
  color: var(--ink-2);
}
.step-copy {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink);
}

/* 实体道具提示卡（只提示步骤+回填，不画假道具） */
.prop-prompt {
  position: relative;
  box-sizing: border-box;
  margin: 24rpx 0;
  padding: 20rpx 0 8rpx;
}
.prop-prompt .prop-label {
  display: inline-flex;
  margin-bottom: 14rpx;
}
.prop-prompt .prop-title {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.prop-prompt .prop-steps {
  display: flex;
  flex-direction: column;
}
.prop-prompt .prop-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.prop-prompt .step-no {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border: 1rpx solid var(--patina);
  color: var(--patina);
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
}
.prop-prompt .step-copy {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink);
}
.prop-prompt .prop-note {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: var(--ink-3);
}

/* 缝线条（回填/进度/回收条） */
.stitch-strip {
  position: relative;
  box-sizing: border-box;
  padding: 24rpx 24rpx 20rpx;
  margin: 18rpx 0;
  border: 1rpx solid var(--rule);
  border-left: 6rpx solid var(--patina);
  background: var(--paper-hi);
}

/* 图占位 */
.img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 140rpx;
  border: 1rpx dashed var(--rule);
  color: var(--ink-3);
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  background: rgba(237, 228, 207, 0.4);
}

/* ---------- 【做】动作条（红线9：常显一行动作） ---------- */
.act-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  margin: 22rpx auto;
  padding: 16rpx 22rpx;
  border: 1rpx solid var(--cinnabar);
  background: rgba(166, 58, 46, 0.05);
}
.act-strip-tag {
  flex-shrink: 0;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--cinnabar);
}
.act-strip-text {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink);
}

/* ---------- 弹层离场动画（组件功能性，非装饰） ---------- */
.coach-hit {
  display: inline-block;
}
.coach-host {
  position: fixed !important;
  z-index: 140;
  pointer-events: none;
  overflow: hidden;
}
.overlay-out {
  animation: overlay-out 0.18s ease both;
}
@keyframes overlay-out {
  from { opacity: 1; }
  to   { opacity: 0; }
}

/* 旧装饰类已随版痕 v2 退场：无兼容别名。 */
