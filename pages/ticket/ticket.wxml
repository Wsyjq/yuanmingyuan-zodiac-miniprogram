<view class="ticket">
  <view class="card">
    <view class="kicker">西洋楼铜版图 · 实景解谜</view>
    <view class="title">第二十一图 · 完整考察</view>
    <view class="copy">沿路走一遍：入口、谐奇趣、黄花阵、方外观、海晏堂、蓄水楼、大水法、雨果</view>
    <view class="dash"></view>
    <view class="label">门票</view>
    <view class="price">¥ 19.9</view>
    <view class="note">一次解锁，此账号长期有效。不含景区门票。</view>
    <button class="unlock" hover-class="unlock-hover" disabled="{{busy}}" bindtap="onUnlock">{{label}}</button>
  </view>
  <button class="back" hover-class="back-hover" disabled="{{busy}}" bindtap="onBack">退出</button>
</view>
