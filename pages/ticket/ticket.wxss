page {
  background: #F4EDDC;
}

.ticket {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx 80rpx;
  background: #F4EDDC;
  color: #2E1F0D;
}

.card {
  box-sizing: border-box;
  padding: 48rpx 36rpx 40rpx;
  background: #FBF6EA;
  border: 4rpx solid #2E1F0D;
}

.kicker {
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #4A6B64;
}

.title {
  margin-top: 16rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #2E1F0D;
}

.copy {
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #2E1F0D;
}

.dash {
  margin: 36rpx 0;
  border-top: 4rpx dashed #C0B49A;
}

.label {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #8A7A60;
}

.price {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #A63A2E;
}

.note {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8A7A60;
}

.unlock {
  display: block;
  width: 100%;
  height: 96rpx;
  margin: 36rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  line-height: 96rpx;
  text-align: center;
  background: #6E241C;
  color: #F7F4EC;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  border-radius: 0;
}

.unlock::after {
  border: none;
}

.unlock-hover {
  background: #5A1C16;
}

.back {
  width: auto;
  margin: 40rpx auto 0;
  padding: 0;
  background: transparent;
  color: #2E1F0D;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  line-height: 1.6;
}

.back::after {
  border: none;
}

.back-hover {
  opacity: 0.7;
}
