.demo-entry{position:relative;min-height:100vh;box-sizing:border-box;background:#efe3cc;color:#43362d;font-family:"Noto Serif SC","Songti SC","STSong",serif}.entry-poster{position:absolute;left:0;top:0;width:100%;height:100%}.demo-foreground{position:absolute;left:0;right:0;bottom:0;z-index:1;display:flex;flex-direction:column;align-items:center;padding:0 80rpx calc(56rpx + env(safe-area-inset-bottom))}.entry-start{width:100%;min-height:111rpx;background:#a45442;color:#fef8e7;border-radius:4rpx;font-size:29rpx;font-weight:500;letter-spacing:2rpx}.eyebrow{font-size:24rpx;letter-spacing:5rpx;color:#86775c}.title{font-size:92rpx;letter-spacing:15rpx;margin:36rpx 0}.rule{height:2rpx;background:#978a6e;width:110rpx;margin-bottom:30rpx}.subtitle{font-size:32rpx;line-height:1.9;white-space:pre-line}.cover{width:100%;height:340rpx;margin:42rpx 0;filter:sepia(.3)}button{font-family:inherit}button::after{border:0}.note{display:block;font-size:23rpx;color:#7d7564;line-height:1.9;margin-top:30rpx;white-space:pre-line}

.restart-link{margin-top:16rpx;background:transparent;color:#43362d;font-size:25rpx}
