.demo-entry{position:relative;min-height:100vh;box-sizing:border-box;background:#efe3cc;color:#43362d;font-family:"Noto Serif SC","Songti SC","STSong",serif}.entry-poster{position:absolute;left:0;top:0;width:100%;height:100%}.demo-foreground{position:absolute;left:0;right:0;bottom:0;z-index:1;display:flex;flex-direction:column;align-items:center;padding:0 80rpx calc(56rpx + env(safe-area-inset-bottom))}.entry-start{position:relative;display:flex;align-items:center;justify-content:center;width:496rpx;min-height:95rpx;height:auto;padding:0 72rpx;overflow:visible;line-height:1.2;background:linear-gradient(180deg,#a33b26 0%,#672316 100%);color:#f5dead;border:3rpx solid #e7be7c;border-radius:0;box-shadow:inset 0 0 0 1rpx #c99051;font-size:46rpx;font-weight:400;letter-spacing:0}
.entry-arrow{position:absolute;right:36rpx;top:50%;transform:translateY(-50%);line-height:1}.eyebrow{font-size:24rpx;letter-spacing:5rpx;color:#86775c}.title{font-size:92rpx;letter-spacing:15rpx;margin:36rpx 0}.rule{height:2rpx;background:#978a6e;width:110rpx;margin-bottom:30rpx}.subtitle{font-size:32rpx;line-height:1.9;white-space:pre-line}.cover{width:100%;height:340rpx;margin:42rpx 0;filter:sepia(.3)}button{font-family:inherit}button::after{border:0}.note{display:block;font-size:23rpx;color:#7d7564;line-height:1.9;margin-top:30rpx;white-space:pre-line}

.restart-link{margin-top:16rpx;background:transparent;color:#43362d;font-size:25rpx}
