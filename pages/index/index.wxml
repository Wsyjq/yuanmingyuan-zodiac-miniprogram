<!-- v1.3.1 手账：左侧活页装订孔列（移到容器外，避免 flex 影响 fixed） -->
<view class="binder"></view>

<view class="host-home paper-grain paper-real">
  <!-- 右上角：编号签 + 邮戳贴纸 -->
  <view class="tag-no tag-corner">No.HOST</view>
  <image class="host-postmark" src="/assets/host/st-postmark-02.png" mode="aspectFit" />

  <!-- 拱券顶饰（呼应封面，但更小） -->
  <view class="host-arch arch"></view>

  <!-- 目录标题区 -->
  <view class="host-title serif">考察模块</view>
  <view class="host-sub">西洋楼铜版图 · 实景解谜系列</view>
  <view class="hatch-divider host-divider"></view>

  <!-- 入口卡：第二十一图 -->
  <view class="module-card clip-card tilt-l double-frame" bindtap="goPlate21">
    <view class="corner tl"></view>
    <view class="corner tr"></view>
    <view class="corner bl"></view>
    <view class="corner br"></view>
    <!-- 胶带贴顶 -->
    <view class="tape" style="top:-20rpx; left:50%; margin-left:-90rpx;"></view>
    <!-- 回形针贴右上 -->
    <image class="card-paperclip" src="/assets/host/st-paperclip-02.png" mode="aspectFit" />
    <!-- 缩略铜版画 -->
    <view class="module-thumb double-frame">
      <image class="thumb-img" src="/assets/host/IMG-F06.jpg" mode="aspectFill" />
    </view>
    <!-- 模块信息 -->
    <view class="module-info">
      <view class="module-name serif">第二十一图</view>
      <view class="module-desc">圆明园西洋楼 · 实景解谜</view>
      <view class="module-meta">四站考察 · 记录一幅等待完成的铜版画</view>
    </view>
    <!-- 进入箭头 -->
    <view class="module-enter">
      <text class="enter-text">进入</text>
      <text class="enter-arrow">→</text>
    </view>
  </view>

  <!-- 预留卡：未来模块 -->
  <view class="reserved-card">
    <view class="reserved-text">更多考察模块 · 敬请期待</view>
  </view>

  <!-- 撕纸分隔 -->
  <view class="torn-divider host-torn"></view>

  <!-- 底部次级链接 -->
  <view class="host-foot">
    <view class="foot-link" catchtap="noop">
      <image class="foot-icon" src="/assets/host/ic-notebook-pen-ink.png" mode="aspectFit" />
      <text>考察手册</text>
    </view>
    <view class="foot-dot"></view>
    <view class="foot-link" catchtap="noop">关于</view>
  </view>

  <!-- 考察者手记批注（页边手写） -->
  <view class="note-hand host-note" style="transform: rotate(-1.5deg);">点选模块，开启一趟纸上考察。</view>
</view>
